/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# CDK / media signing keys (never commit private key)
/infra/cdk.out
/infra/cdk.context.json
/infra/cdk-outputs.json
/infra/keys/
/infra/*.js
/infra/*.d.ts
!/infra/jest.config.js
/.swc

# Local SFX / music packs (seeded to S3; not committed)
/public/sfx/
/public/music/
/public/landing/

# Schedule CLI secrets + browser profile
/secrets/
/.playwright/
