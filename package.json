{
  "name": "talking-head-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "remotion:deploy": "tsx scripts/deploy-remotion-lambda.ts",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "seed": "tsx --env-file=.env scripts/seed-global.ts",
    "seed:global-sfx": "tsx --env-file=.env scripts/seed-global-sfx.ts",
    "seed:global-music": "tsx --env-file=.env scripts/seed-global-music.ts",
    "schedule": "tsx --env-file=.env src/schedule/run.ts",
    "schedule:login": "tsx --env-file=.env src/schedule/local/login.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
