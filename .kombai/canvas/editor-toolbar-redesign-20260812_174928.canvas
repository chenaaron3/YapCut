      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  .toolbar-focus:focus-visible { outline: 2px solid #5b8cff; outline-offset: 2px; }\n  .delivery-menu[hidden], .visibility-menu[hidden] { display: none; }\n</style>\n<div class=\"min-h-[760px] w-full bg-[#12141a] px-5 py-4 font-[Inter,sans-serif] text-[#e8eaef]\" data-kid=\"1\" style=\"--page:#12141a;--panel:#1a1d26;--raised:#222632;--border:#2e3444;--muted:#8b93a7;--blue:#5b8cff;--gold:#c9a227;--pink:#fb7185;--teal:#2dd4bf;--purple:#a78bfa;\">\n    <div class=\"mb-2 flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-[#8b93a7]\" data-kid=\"1-1\">\n        <span class=\"h-1.5 w-1.5 rounded-full bg-[#5b8cff]\" data-kid=\"1-1-1\">\n        </span>\n        <span data-kid=\"1-1-2\" data-name=\"breadcrumb current page description\">\n            A · Split export control\n        </span>\n        <span class=\"ml-1 normal-case tracking-normal text-[#596276]\" data-kid=\"1-1-3\" data-name=\"breadcrumb sub-description\">\n            AI stays separate · delivery stays bundled\n        </span>\n    </div>\n    <section aria-label=\"Editor toolbar redesign prototype\" class=\"relative z-30 overflow-visible rounded-lg border border-[#2e3444] bg-[#1a1d26]\" data-kid=\"1-2\" data-name=\"editor toolbar section\">\n        <header class=\"relative z-30 flex h-[72px] items-center justify-between border-b border-[#2e3444] px-5\" data-kid=\"1-2-1\" data-name=\"editor toolbar header\">\n            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-1-1\">\n                <button aria-label=\"Back to projects\" class=\"toolbar-focus flex size-10 shrink-0 items-center justify-center rounded-md border border-[#2e3444] text-[#8b93a7] hover:border-[#5b8cff] hover:text-[#e8eaef]\" data-kid=\"1-2-1-1-1\" title=\"Back to projects\" type=\"button\">\n                    <i class=\"size-4\" data-kid=\"1-2-1-1-1-1\" data-lucide=\"arrow-left\">\n                    </i>\n                </button>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-2-1\">\n                        <span class=\"truncate text-sm font-semibold\" data-kid=\"1-2-1-1-2-1-1\">\n                            Talking head / launch cut\n                        </span>\n                        <span class=\"rounded-full border border-[#2e3444] bg-[#222632] px-2 py-0.5 text-[10px] text-[#8b93a7]\" data-kid=\"1-2-1-1-2-1-2\">\n                            Draft\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-xs text-[#8b93a7]\" data-kid=\"1-2-1-1-2-2\">\n                        1080 × 1920 · 00:42 · last edited just now\n                    </p>\n                </div>\n            </div>\n            <div class=\"relative flex items-center gap-2\" data-kid=\"1-2-1-2\">\n                <span aria-live=\"polite\" class=\"mr-2 hidden items-center gap-2 text-xs text-[#8b93a7] sm:flex\" data-kid=\"1-2-1-2-1\" data-name=\"status message container\" id=\"status-a\">\n                    <span class=\"size-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-1-2-1-1\">\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2\" data-name=\"status message text\" data-reason=\"text updated by script after actions\" id=\"status-text-a\">\n                        Export ready · delivery available\n                    </span>\n                </span>\n                <button class=\"toolbar-focus inline-flex h-11 items-center gap-2 rounded-md border border-[#67568b] bg-[#241f32] px-4 text-sm font-medium text-[#e8eaef] hover:border-[#a78bfa] hover:bg-[#2d2540]\" data-kid=\"1-2-1-2-2\" data-name=\"generate edits button\" id=\"ai-a\" title=\"Generate a new set of edits with AI\" type=\"button\">\n                    <i class=\"size-4 text-[#a78bfa]\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"sparkles\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        Generate edits\n                    </span>\n                </button>\n                <div class=\"relative flex items-stretch\" data-kid=\"1-2-1-2-3\" data-name=\"export control group\">\n                    <button class=\"toolbar-focus inline-flex h-11 items-center gap-2 rounded-l-md bg-[#5b8cff] px-4 text-sm font-semibold text-white shadow-[0_4px_14px_rgba(91,140,255,0.18)] hover:bg-[#6d9aff]\" data-kid=\"1-2-1-2-3-1\" data-name=\"export button\" id=\"export-a\" title=\"Create a cloud video asset\" type=\"button\">\n                        <i class=\"size-4\" data-kid=\"1-2-1-2-3-1-1\" data-lucide=\"cloud-upload\">\n                        </i>\n                        <span data-kid=\"1-2-1-2-3-1-2\">\n                            Export video\n                        </span>\n                    </button>\n                    <button aria-controls=\"delivery-menu-a\" aria-expanded=\"true\" aria-label=\"Open download and schedule actions\" class=\"toolbar-focus flex h-11 w-11 items-center justify-center rounded-r-md border-l border-white/25 bg-[#5b8cff] text-white hover:bg-[#6d9aff]\" data-kid=\"1-2-1-2-3-2\" data-name=\"delivery menu toggle button\" id=\"delivery-toggle-a\" title=\"Download or schedule the exported video\" type=\"button\">\n                        <i class=\"size-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1\" data-lucide=\"chevron-up\" data-name=\"delivery menu chevron icon\" data-reason=\"icon replaced by script on click\" id=\"delivery-chevron-a\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Delivery actions\" class=\"delivery-menu absolute right-0 top-[56px] w-[304px] rounded-lg border border-[#3a4255] bg-[#1a1d26] p-2 shadow-[0_18px_40px_rgba(0,0,0,0.34)]\" data-kid=\"1-2-1-2-3-3\" data-name=\"delivery actions overflow menu\" id=\"delivery-menu-a\" role=\"menu\">\n                        <div class=\"flex items-center justify-between px-3 pb-2 pt-1\" data-kid=\"1-2-1-2-3-3-1\">\n                            <div data-kid=\"1-2-1-2-3-3-1-1\">\n                                <p class=\"text-xs font-semibold\" data-kid=\"1-2-1-2-3-3-1-1-1\">\n                                    Delivery actions\n                                </p>\n                                <p class=\"mt-0.5 text-[11px] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-1-1-2\">\n                                    Export creates the cloud asset used below.\n                                </p>\n                            </div>\n                            <i class=\"size-4 text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-1-2\" data-lucide=\"package-check\">\n                            </i>\n                        </div>\n                        <div class=\"border-t border-[#2e3444] pt-2\" data-kid=\"1-2-1-2-3-3-2\">\n                            <button class=\"delivery-row toolbar-focus flex w-full items-center gap-3 rounded-md px-3 py-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-1-2-3-3-2-1\" data-name=\"download video menu item\" data-status=\"Download started · MP4 and cover image\" type=\"button\">\n                                <span class=\"flex size-8 items-center justify-center rounded-md border border-[#3e4860] bg-[#222632] text-[#5b8cff]\" data-kid=\"1-2-1-2-3-3-2-1-1\">\n                                    <i class=\"size-4\" data-kid=\"1-2-1-2-3-3-2-1-1-1\" data-lucide=\"download\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-3-3-2-1-2\">\n                                    <span class=\"block text-sm font-medium\" data-kid=\"1-2-1-2-3-3-2-1-2-1\">\n                                        Download video\n                                    </span>\n                                    <span class=\"mt-0.5 block text-[11px] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-2-1-2-2\">\n                                        Save the latest cloud export locally\n                                    </span>\n                                </span>\n                                <span class=\"flex items-center gap-1.5 text-[10px] font-medium text-[#2dd4bf]\" data-kid=\"1-2-1-2-3-3-2-1-3\">\n                                    <span class=\"size-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-1-2-3-3-2-1-3-1\">\n                                    </span>\n                                    Ready\n                                </span>\n                            </button>\n                            <button class=\"delivery-row toolbar-focus flex w-full items-center gap-3 rounded-md px-3 py-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-1-2-3-3-2-2\" data-name=\"schedule video menu item\" data-status=\"Already on schedule · no duplicate action needed\" type=\"button\">\n                                <span class=\"flex size-8 items-center justify-center rounded-md border border-[#3e4860] bg-[#222632] text-[#5b8cff]\" data-kid=\"1-2-1-2-3-3-2-2-1\">\n                                    <i class=\"size-4\" data-kid=\"1-2-1-2-3-3-2-2-1-1\" data-lucide=\"calendar-clock\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-3-3-2-2-2\">\n                                    <span class=\"block text-sm font-medium\" data-kid=\"1-2-1-2-3-3-2-2-2-1\">\n                                        Schedule video\n                                    </span>\n                                    <span class=\"mt-0.5 block text-[11px] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-2-2-2-2\">\n                                        Publish to connected platforms after export\n                                    </span>\n                                </span>\n                                <span class=\"flex items-center gap-1.5 text-[10px] font-medium text-[#5b8cff]\" data-kid=\"1-2-1-2-3-3-2-2-3\">\n                                    <span class=\"size-1.5 rounded-full bg-[#5b8cff]\" data-kid=\"1-2-1-2-3-3-2-2-3-1\">\n                                    </span>\n                                    On schedule\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <div class=\"relative z-20 flex h-[68px] items-center justify-between gap-4 border-b border-[#2e3444] bg-[#1a1d26] px-5\" data-kid=\"1-2-2\">\n            <div class=\"flex min-w-0 items-center gap-5\" data-kid=\"1-2-2-1\">\n                <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"text-xs font-semibold uppercase tracking-[0.12em] text-[#596276]\" data-kid=\"1-2-2-1-1-1\">\n                        Transcript\n                    </span>\n                    <span class=\"h-4 w-px bg-[#2e3444]\" data-kid=\"1-2-2-1-1-2\">\n                    </span>\n                    <span class=\"truncate text-sm text-[#8b93a7]\" data-kid=\"1-2-2-1-1-3\" data-name=\"editor section title\">\n                        Project review\n                    </span>\n                </div>\n                <div class=\"relative\" data-kid=\"1-2-2-1-2\">\n                    <button aria-controls=\"visibility-menu-a\" aria-expanded=\"true\" aria-label=\"Show or hide edit types\" class=\"toolbar-focus flex h-10 items-center gap-2 rounded-md border border-[#475065] bg-[#222632] px-3 text-xs font-medium hover:border-[#7180a0]\" data-kid=\"1-2-2-1-2-1\" data-name=\"visibility menu toggle button\" id=\"visibility-toggle-a\" title=\"Show or hide edit markers in the transcript\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-1-2-1-1\">\n                            <span class=\"size-2 rounded-full bg-[#c9a227]\" data-kid=\"1-2-2-1-2-1-1-1\">\n                            </span>\n                            <span class=\"size-2 rounded-full bg-[#fb7185]\" data-kid=\"1-2-2-1-2-1-1-2\">\n                            </span>\n                            <span class=\"size-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-2-1-2-1-1-3\">\n                            </span>\n                        </span>\n                        <span data-kid=\"1-2-2-1-2-1-2\">\n                            7 edit types\n                        </span>\n                        <i class=\"size-3.5 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1-3\" data-lucide=\"chevron-up\" data-name=\"visibility menu chevron icon\" data-reason=\"icon replaced by script on click\" id=\"visibility-chevron-a\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Edit visibility\" class=\"visibility-menu absolute left-0 top-[48px] w-[264px] rounded-lg border border-[#3a4255] bg-[#1a1d26] p-2 shadow-[0_16px_34px_rgba(0,0,0,0.3)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"edit visibility menu\" id=\"visibility-menu-a\" role=\"dialog\">\n                        <div class=\"flex items-center justify-between px-3 pb-2 pt-1\" data-kid=\"1-2-2-1-2-2-1\">\n                            <div data-kid=\"1-2-2-1-2-2-1-1\">\n                                <p class=\"text-xs font-semibold\" data-kid=\"1-2-2-1-2-2-1-1-1\">\n                                    Edit visibility\n                                </p>\n                                <p class=\"mt-0.5 text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-1-1-2\">\n                                    Choose what appears in the transcript\n                                </p>\n                            </div>\n                            <button aria-label=\"Show all edit types\" class=\"toolbar-focus flex size-8 items-center justify-center rounded-md text-[#8b93a7] hover:bg-[#222632]\" data-kid=\"1-2-2-1-2-2-1-2\" title=\"Show all edit types\" type=\"button\">\n                                <i class=\"size-4\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-lucide=\"eye\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"border-t border-[#2e3444] pt-2\" data-kid=\"1-2-2-1-2-2-2\">\n                            <button class=\"visibility-row toolbar-focus flex h-9 w-full items-center gap-2 rounded-md px-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-2-1-2-2-2-1\" type=\"button\">\n                                <span class=\"size-2 rounded-full bg-[#c9a227]\" data-kid=\"1-2-2-1-2-2-2-1-1\">\n                                </span>\n                                <span class=\"flex-1 text-xs\" data-kid=\"1-2-2-1-2-2-2-1-2\">\n                                    B-roll\n                                </span>\n                                <span class=\"text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-2-1-3\">\n                                    1\n                                </span>\n                                <i class=\"size-3.5 text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-2-1-4\" data-lucide=\"eye\">\n                                </i>\n                            </button>\n                            <button class=\"visibility-row toolbar-focus flex h-9 w-full items-center gap-2 rounded-md px-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-2-1-2-2-2-2\" type=\"button\">\n                                <span class=\"size-2 rounded-full bg-[#fb7185]\" data-kid=\"1-2-2-1-2-2-2-2-1\">\n                                </span>\n                                <span class=\"flex-1 text-xs\" data-kid=\"1-2-2-1-2-2-2-2-2\">\n                                    Text effects\n                                </span>\n                                <span class=\"text-[11px] text-[#8b93a7]\" data