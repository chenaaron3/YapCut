s-center gap-3 rounded-md px-3 py-2.5 text-left hover:bg-[#222632]\" data-kid=\"1-2-1-2-4-3-2\" data-status=\"Download is ready\" role=\"menuitem\" type=\"button\">\n                            <span class=\"flex size-8 items-center justify-center rounded-md border border-[#3e4860] bg-[#222632] text-[#5b8cff]\" data-kid=\"1-2-1-2-4-3-2-1\">\n                                <i class=\"size-4\" data-kid=\"1-2-1-2-4-3-2-1-1\" data-lucide=\"download\" data-name=\"download icon\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-4-3-2-2\">\n                                <span class=\"block text-sm font-medium text-[#e8eaef]\" data-kid=\"1-2-1-2-4-3-2-2-1\">\n                                    Download video\n                                </span>\n                                <span class=\"mt-0.5 block text-[11px] leading-4 text-[#8b93a7]\" data-kid=\"1-2-1-2-4-3-2-2-2\">\n                                    Save the latest cloud export locally\n                                </span>\n                            </span>\n                            <span class=\"flex items-center gap-1.5 text-[10px] font-medium text-[#2dd4bf]\" data-kid=\"1-2-1-2-4-3-2-3\">\n                                <span class=\"size-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-1-2-4-3-2-3-1\">\n                                </span>\n                                Ready\n                            </span>\n                        </button>\n                        <button class=\"menu-row flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left hover:bg-[#222632]\" data-kid=\"1-2-1-2-4-3-3\" data-status=\"Already scheduled for today at 4:30 PM\" role=\"menuitem\" type=\"button\">\n                            <span class=\"flex size-8 items-center justify-center rounded-md border border-[#3e4860] bg-[#222632] text-[#5b8cff]\" data-kid=\"1-2-1-2-4-3-3-1\">\n                                <i class=\"size-4\" data-kid=\"1-2-1-2-4-3-3-1-1\" data-lucide=\"calendar-clock\" data-name=\"calendar clock icon\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-4-3-3-2\">\n                                <span class=\"block text-sm font-medium text-[#e8eaef]\" data-kid=\"1-2-1-2-4-3-3-2-1\">\n                                    Schedule video\n                                </span>\n                                <span class=\"mt-0.5 block text-[11px] leading-4 text-[#8b93a7]\" data-kid=\"1-2-1-2-4-3-3-2-2\">\n                                    Publish to connected platforms\n                                </span>\n                            </span>\n                            <span class=\"flex items-center gap-1.5 text-[10px] font-medium text-[#5b8cff]\" data-kid=\"1-2-1-2-4-3-3-3\">\n                                <span class=\"size-1.5 rounded-full bg-[#5b8cff]\" data-kid=\"1-2-1-2-4-3-3-3-1\">\n                                </span>\n                                Scheduled\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"mt-1 flex items-center gap-2 border-t border-[#2e3444] px-3 pb-1 pt-2 text-[10px] text-[#596276]\" data-kid=\"1-2-1-2-4-4\">\n                        <i class=\"size-3.5\" data-kid=\"1-2-1-2-4-4-1\" data-lucide=\"info\">\n                        </i>\n                        <span data-kid=\"1-2-1-2-4-4-2\">\n                            Export creates the cloud asset used by delivery actions.\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <div class=\"relative z-20 flex h-[68px] items-center justify-between gap-4 border-b border-[#2e3444] bg-[#1a1d26] px-5\" data-kid=\"1-2-2\">\n            <div class=\"flex min-w-0 items-center gap-5\" data-kid=\"1-2-2-1\">\n                <div class=\"flex min-w-0 items-center gap-2\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"text-xs font-semibold uppercase tracking-[0.12em] text-[#596276]\" data-kid=\"1-2-2-1-1-1\">\n                        Transcript\n                    </span>\n                    <span class=\"h-4 w-px bg-[#2e3444]\" data-kid=\"1-2-2-1-1-2\">\n                    </span>\n                    <span class=\"truncate text-sm text-[#8b93a7]\" data-kid=\"1-2-2-1-1-3\">\n                        Edit visibility\n                    </span>\n                </div>\n                <div class=\"relative\" data-kid=\"1-2-2-1-2\">\n                    <button aria-controls=\"visibility-menu\" aria-expanded=\"true\" class=\"flex h-10 items-center gap-2 rounded-md border border-[#475065] bg-[#222632] px-3 text-xs font-medium text-[#e8eaef] hover:border-[#7180a0]\" data-kid=\"1-2-2-1-2-1\" id=\"visibility-toggle\" title=\"Show or hide edit types\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-1-2-1-1\">\n                            <span class=\"size-2 rounded-full bg-[#c9a227]\" data-kid=\"1-2-2-1-2-1-1-1\">\n                            </span>\n                            <span class=\"size-2 rounded-full bg-[#fb7185]\" data-kid=\"1-2-2-1-2-1-1-2\">\n                            </span>\n                            <span class=\"size-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-2-1-2-1-1-3\">\n                            </span>\n                        </span>\n                        <span data-kid=\"1-2-2-1-2-1-2\">\n                            7 edit types\n                        </span>\n                        <i class=\"size-3.5 text-[#8b93a7]\" data-kid=\"1-2-2-1-2-1-3\" data-lucide=\"chevron-down\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Edit visibility\" class=\"absolute left-0 top-[48px] w-[264px] rounded-lg border border-[#3a4255] bg-[#1a1d26] p-2 shadow-[0_16px_34px_rgba(0,0,0,0.3)]\" data-kid=\"1-2-2-1-2-2\" id=\"visibility-menu\" role=\"dialog\">\n                        <div class=\"flex items-center justify-between px-3 pb-2 pt-1\" data-kid=\"1-2-2-1-2-2-1\">\n                            <div data-kid=\"1-2-2-1-2-2-1-1\">\n                                <p class=\"text-xs font-semibold text-[#e8eaef]\" data-kid=\"1-2-2-1-2-2-1-1-1\">\n                                    Edit visibility\n                                </p>\n                                <p class=\"mt-0.5 text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-1-1-2\">\n                                    Choose what appears in the transcript\n                                </p>\n                            </div>\n                            <button aria-label=\"Hide all edit types\" class=\"flex size-8 items-center justify-center rounded-md text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-2-2-1-2-2-1-2\" title=\"Hide all edit types\" type=\"button\">\n                                <i class=\"size-4\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-lucide=\"eye\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"border-t border-[#2e3444] pt-2\" data-kid=\"1-2-2-1-2-2-2\">\n                            <button class=\"visibility-row flex h-9 w-full items-center gap-2 rounded-md px-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-2-1-2-2-2-1\" data-label=\"B-roll\" type=\"button\">\n                                <span class=\"size-2 rounded-full bg-[#c9a227]\" data-kid=\"1-2-2-1-2-2-2-1-1\">\n                                </span>\n                                <span class=\"flex-1 text-xs text-[#e8eaef]\" data-kid=\"1-2-2-1-2-2-2-1-2\">\n                                    B-roll\n                                </span>\n                                <span class=\"text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-2-1-3\">\n                                    1\n                                </span>\n                                <i class=\"size-3.5 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-2-1-4\" data-lucide=\"eye\" data-name=\"visibility toggle eye icon\" data-reason=\"icon replaced by script on click\">\n                                </i>\n                            </button>\n                            <button class=\"visibility-row flex h-9 w-full items-center gap-2 rounded-md px-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-2-1-2-2-2-2\" data-label=\"Text effects\" type=\"button\">\n                                <span class=\"size-2 rounded-full bg-[#fb7185]\" data-kid=\"1-2-2-1-2-2-2-2-1\">\n                                </span>\n                                <span class=\"flex-1 text-xs text-[#e8eaef]\" data-kid=\"1-2-2-1-2-2-2-2-2\">\n                                    Text effects\n                                </span>\n                                <span class=\"text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-2-2-3\">\n                                    7\n                                </span>\n                                <i class=\"size-3.5 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-2-2-4\" data-lucide=\"eye\" data-name=\"visibility toggle eye icon\" data-reason=\"icon replaced by script on click\">\n                                </i>\n                            </button>\n                            <button class=\"visibility-row flex h-9 w-full items-center gap-2 rounded-md px-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-2-1-2-2-2-3\" data-label=\"SFX\" type=\"button\">\n                                <span class=\"size-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-2-1-2-2-2-3-1\">\n                                </span>\n                                <span class=\"flex-1 text-xs text-[#e8eaef]\" data-kid=\"1-2-2-1-2-2-2-3-2\">\n                                    SFX\n                                </span>\n                                <span class=\"text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-2-3-3\">\n                                    14\n                                </span>\n                                <i class=\"size-3.5 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-2-3-4\" data-lucide=\"eye\" data-name=\"visibility toggle eye icon\" data-reason=\"icon replaced by script on click\">\n                                </i>\n                            </button>\n                            <button class=\"visibility-row flex h-9 w-full items-center gap-2 rounded-md px-3 text-left hover:bg-[#222632]\" data-kid=\"1-2-2-1-2-2-2-4\" data-label=\"Zoom\" type=\"button\">\n                                <span class=\"size-2 rounded-full bg-[#3b82f6]\" data-kid=\"1-2-2-1-2-2-2-4-1\">\n                                </span>\n                                <span class=\"flex-1 text-xs text-[#e8eaef]\" data-kid=\"1-2-2-1-2-2-2-4-2\">\n                                    Zoom\n                                </span>\n                                <span class=\"text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-2-4-3\">\n                                    10\n                                </span>\n                                <i class=\"size-3.5 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-2-4-4\" data-lucide=\"eye\" data-name=\"visibility toggle eye icon\" data-reason=\"icon replaced by script on click\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"mt-2 border-t border-[#2e3444] px-3 pb-1 pt-2 text-[10px] text-[#596276]\" data-kid=\"1-2-2-1-2-2-3\">\n                            4 more types · muted from this compact view\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-2-2\">\n                <div class=\"mr-2 h-7 w-px bg-[#2e3444]\" data-kid=\"1-2-2-2-1\">\n                </div>\n                <button class=\"flex h-10 items-center gap-2 rounded-md border border-transparent px-3 text-xs font-medium text-[#8b93a7] hover:border-[#2e3444] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-2-2-2-2\" title=\"Open caption style inspector\" type=\"button\">\n                    <i class=\"size-4\" data-kid=\"1-2-2-2-2-1\" data-lucide=\"type\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-2-2\">\n                        Captions\n                    </span>\n                </button>\n                <button aria-label=\"Open project settings\" class=\"flex h-10 items-center gap-2 rounded-md border border-transparent px-3 text-xs font-medium text-[#8b93a7] hover:border-[#2e3444] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-2-2-2-3\" title=\"Open project settings\" type=\"button\">\n                    <i class=\"size-4\" data-kid=\"1-2-2-2-3-1\" data-lucide=\"settings-2\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-3-2\">\n                        Settings\n                    </span>\n                </button>\n                <span class=\"ml-1 flex h-8 items-center gap-1.5 rounded-full border border-[#2e3444] bg-[#222632] px-3 text-xs text-[#8b93a7]\" data-kid=\"1-2-2-2-4\" title=\"All changes saved\">\n                    <span class=\"size-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-2-2-4-1\">\n                    </span>\n                    Saved\n                </span>\n            </div>\n        </div>\n        <div class=\"grid h-[184px] grid-cols-[190px_minmax(0,1fr)_260px] bg-[#12141a]\" data-kid=\"1-2-3\">\n            <aside class=\"border-r border-[#2e3444] bg-[#1a1d26] p-4\" data-kid=\"1-2-3-1\">\n                <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-3-1-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#596276]\" data-kid=\"1-2-3-1-1-1\">\n                        Edits\n                    </span>\n                    <span class=\"text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-1-2\">\n                        7 types\n                    </span>\n                </div>\n                <div class=\"space-y-2 text-xs text-[#8b93a7]\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"size-2 rounded-full bg-[#c9a227]\" data-kid=\"1-2-3-1-2-1-1\">\n                        </span>\n                        B-roll\n                        <span class=\"ml-auto text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-2-1-2\">\n                            1\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-2\">\n                        <span class=\"size-2 rounded-full bg-[#fb7185]\" data-kid=\"1-2-3-1-2-2-1\">\n                        </span>\n                        Text effects\n                        <span class=\"ml-auto text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-2-2-2\">\n                            7\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-3\">\n                        <span class=\"size-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-3-1-2-3-1\">\n                        </span>\n                        SFX\n                        <span class=\"ml-auto text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-2-3-2\">\n                            14\n                        </span>\n                    </div>\n                </div>\n            </aside>\n            <main class=\"overflow-hidden p-5\" data-kid=\"1-2-3-2\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#596276]\" data-kid=\"1-2-3-2-1-1\">\n                        Transcript\n                    </span>\n                    <span class=\"text-[11px] text-[#596276]\" data-kid=\"1-2-3-2-1-2\">\n                        00:12.4\n                    </span>\n                </div>\n                <p class=\"max-w-[640px] text-[16px] leading-8 text-[#8b93a7]\" data-kid=\"1-2-3-2-2\">\n                    Build a clean first cut from the transcript, then use the controls above to refine the moments that matter.\n                </p>\n                <div class=\"mt-4 flex gap-1.5\" data-kid=\"1-2-3-2-3\">\n                    <span class=\"h-1.5 w-16 rounded-full bg-[#2e3444]\" data-kid=\"1-2-3-2-3-1\">\n                    </span>\n                    <span class=\"h-1.5 w-28 rounded-full bg-[#2e3444]\" data-kid=\"1-2-3-2-3-2\">\n                    </span>\n                    <span class=\"h-1.5 w-20 rounded-full bg-[#5b8cff]/60\" data-kid=\"1-2-3-2-3-3\">\n                    </span>\n                    <span class=\"h-1.5 w-36 rounded-full bg-[#2e3444]\" data-kid=\"1-2-3-2-3-4\">\n                    </span>\n                </div>\n            </main>\n            <aside class=\"border-l border-[#2e3444] bg-[#0d0f14] p-4\" data-kid=\"1-2-3-3\">\n                <div class=\"flex h-full items-center justify-center rounded-md border border-[#2e3444] bg-[#12141a]\" data-kid=\"1-2-3-3-1\">\n                    <div class=\"text-center\" data-kid=\"1-2-3-3-1-1\">\n                        <div class=\"mx-auto mb-3 flex size-10 items-center justify-center rounded-full border border-[#475065] text-[#e8eaef]\" data-kid=\"1-2-3-3-1-1-1\">\n                            <i class=\"ml-0.5 size-4 fill-current\" data-kid=\"1-2-3-3-1-1-1-1\" data-lucide=\"play\" data-name=\"play icon\">\n                            </i>\n                        </div>\n                        <span class=\"text-[10px] uppercase tracking-[0.14em] text-[#596276]\" data-kid=\"1-2-3-3-1-1-2\">\n                            Preview\n                        </span>\n                    </div>\n                </div>\n            </aside>\n        </div>\n    </section>\n    <script>\n        lucide.createIcons();\n    const more = document.getElementById('more-actions');\n    const overflow = document.getElementById('overflow-menu');\n    const chevron = document.getElementById('more-chevron');\n    const status = document.getElementById('action-status');\n    const statusText = document.getElementById('action-status-text');\n    const visibility = document.getElementById('visibility-toggle');\n    const visibilityMenu = document.getElementById('visibility-menu');\n\n    more.addEventListener('click', () => {\n      const isOpen = !overflow.classList.contains('hidden');\n      overflow.classList.toggle('hidden', isOpen);\n      more.setAttribute('aria-expanded', String(!isOpen));\n      chevron.setAttribute('data-lucide', isOpen ? 'chevron-down' : 'chevron-up');\n      lucide.createIcons();\n    });\n\n    visibility.addEventListener('click', () => {\n      const isOpen = !visibilityMenu.classList.contains('hidden');\n      visibilityMenu.classList.toggle('hidden', isOpen);\n      visibility.setAttribute('aria-expanded', String(!isOpen));\n    });\n\n    document.querySelectorAll('.menu-row').forEach((row) => {\n      row.addEventListener('click', () => {\n        status.classList.remove('hidden');\n        statusText.textContent = row.getAttribute('data-status') || 'Action updated';\n        overflow.classList.add('hidden');\n        more.setAttribute('aria-expanded', 'false');\n        chevron.setAttribute('data-lucide', 'chevron-down');\n        lucide.createIcons();\n      });\n    });\n\n    document.querySelectorAll('.visibility-row').forEach((row) => {\n      row.addEventListener('click', () => {\n        row.classList.toggle('bg-[#222632]');\n        const icon = row.querySelector('[data-lucide]');\n        if (icon) icon.setAttribute('data-lucide', row.classList.contains('bg-[#222632]') ? 'eye-off' : 'eye');\n        lucide.createIcons();\n      });\n    });\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-08-12T17:52:59.707656+00:00",
      "modified": "2026-08-12T17:53:30.117312+00:00",
