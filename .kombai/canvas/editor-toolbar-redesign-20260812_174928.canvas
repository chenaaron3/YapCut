ize-3.5 text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2-2-4-4\" data-lucide=\"eye\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"mt-2 border-t border-[#2e3444] px-3 pb-1 pt-2 text-[10px] text-[#596276]\" data-kid=\"1-2-2-1-2-2-3\">\n                            4 more types · muted from compact view\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-2-2\">\n                <div class=\"mr-2 h-7 w-px bg-[#2e3444]\" data-kid=\"1-2-2-2-1\">\n                </div>\n                <button class=\"toolbar-focus flex h-10 items-center gap-2 rounded-md border border-transparent px-3 text-xs font-medium text-[#8b93a7] hover:border-[#2e3444] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-2-2-2-2\" title=\"Open caption style inspector\" type=\"button\">\n                    <i class=\"size-4\" data-kid=\"1-2-2-2-2-1\" data-lucide=\"captions\" data-name=\"caption style icon\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-2-2\">\n                        Captions\n                    </span>\n                </button>\n                <button aria-label=\"Open project settings\" class=\"toolbar-focus flex h-10 items-center gap-2 rounded-md border border-transparent px-3 text-xs font-medium text-[#8b93a7] hover:border-[#2e3444] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-2-2-2-3\" title=\"Open project settings\" type=\"button\">\n                    <i class=\"size-4\" data-kid=\"1-2-2-2-3-1\" data-lucide=\"settings-2\">\n                    </i>\n                    <span data-kid=\"1-2-2-2-3-2\">\n                        Settings\n                    </span>\n                </button>\n                <span class=\"ml-1 flex h-8 items-center gap-1.5 rounded-full border border-[#2e3444] bg-[#222632] px-3 text-xs text-[#8b93a7]\" data-kid=\"1-2-2-2-4\" title=\"All changes saved\">\n                    <span class=\"size-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-2-2-4-1\">\n                    </span>\n                    Saved\n                </span>\n            </div>\n        </div>\n        <div class=\"grid h-[184px] grid-cols-[190px_minmax(0,1fr)_260px] bg-[#12141a]\" data-kid=\"1-2-3\">\n            <aside class=\"border-r border-[#2e3444] bg-[#1a1d26] p-4\" data-kid=\"1-2-3-1\">\n                <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-3-1-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#596276]\" data-kid=\"1-2-3-1-1-1\">\n                        Edits\n                    </span>\n                    <span class=\"text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-1-2\">\n                        7 types\n                    </span>\n                </div>\n                <div class=\"space-y-2 text-xs text-[#8b93a7]\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"size-2 rounded-full bg-[#c9a227]\" data-kid=\"1-2-3-1-2-1-1\">\n                        </span>\n                        B-roll\n                        <span class=\"ml-auto text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-2-1-2\">\n                            1\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-2\">\n                        <span class=\"size-2 rounded-full bg-[#fb7185]\" data-kid=\"1-2-3-1-2-2-1\">\n                        </span>\n                        Text effects\n                        <span class=\"ml-auto text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-2-2-2\">\n                            7\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-3\">\n                        <span class=\"size-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-3-1-2-3-1\">\n                        </span>\n                        SFX\n                        <span class=\"ml-auto text-[10px] text-[#596276]\" data-kid=\"1-2-3-1-2-3-2\">\n                            14\n                        </span>\n                    </div>\n                </div>\n            </aside>\n            <main class=\"overflow-hidden p-5\" data-kid=\"1-2-3-2\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#596276]\" data-kid=\"1-2-3-2-1-1\">\n                        Transcript\n                    </span>\n                    <span class=\"text-[11px] text-[#596276]\" data-kid=\"1-2-3-2-1-2\">\n                        00:12.4\n                    </span>\n                </div>\n                <p class=\"max-w-[640px] text-[16px] leading-8 text-[#8b93a7]\" data-kid=\"1-2-3-2-2\">\n                    Build a clean first cut from the transcript, then use the controls above to refine the moments that matter.\n                </p>\n                <div class=\"mt-4 flex gap-1.5\" data-kid=\"1-2-3-2-3\">\n                    <span class=\"h-1.5 w-16 rounded-full bg-[#2e3444]\" data-kid=\"1-2-3-2-3-1\">\n                    </span>\n                    <span class=\"h-1.5 w-28 rounded-full bg-[#2e3444]\" data-kid=\"1-2-3-2-3-2\">\n                    </span>\n                    <span class=\"h-1.5 w-20 rounded-full bg-[#5b8cff]/60\" data-kid=\"1-2-3-2-3-3\">\n                    </span>\n                    <span class=\"h-1.5 w-36 rounded-full bg-[#2e3444]\" data-kid=\"1-2-3-2-3-4\">\n                    </span>\n                </div>\n            </main>\n            <aside class=\"border-l border-[#2e3444] bg-[#0d0f14] p-4\" data-kid=\"1-2-3-3\">\n                <div class=\"flex h-full items-center justify-center rounded-md border border-[#2e3444] bg-[#12141a]\" data-kid=\"1-2-3-3-1\">\n                    <div class=\"text-center\" data-kid=\"1-2-3-3-1-1\">\n                        <div class=\"mx-auto mb-3 flex size-10 items-center justify-center rounded-full border border-[#475065]\" data-kid=\"1-2-3-3-1-1-1\" data-name=\"preview play button\">\n                            <i class=\"size-4\" data-kid=\"1-2-3-3-1-1-1-1\" data-lucide=\"play\" data-name=\"play icon\">\n                            </i>\n                        </div>\n                        <span class=\"text-[10px] uppercase tracking-[0.14em] text-[#596276]\" data-kid=\"1-2-3-3-1-1-2\">\n                            Preview\n                        </span>\n                    </div>\n                </div>\n            </aside>\n        </div>\n    </section>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    (() => {\n    lucide.createIcons();\n    const deliveryToggle = document.getElementById('delivery-toggle-a');\n    const deliveryMenu = document.getElementById('delivery-menu-a');\n    const deliveryChevron = document.getElementById('delivery-chevron-a');\n    const visibilityToggle = document.getElementById('visibility-toggle-a');\n    const visibilityMenu = document.getElementById('visibility-menu-a');\n    const visibilityChevron = document.getElementById('visibility-chevron-a');\n    const status = document.getElementById('status-a');\n    const statusText = document.getElementById('status-text-a');\n    const setDelivery = (open) => { deliveryMenu.hidden = !open; deliveryToggle.setAttribute('aria-expanded', String(open)); deliveryChevron.setAttribute('data-lucide', open ? 'chevron-up' : 'chevron-down'); lucide.createIcons(); };\n    const setVisibility = (open) => { visibilityMenu.hidden = !open; visibilityToggle.setAttribute('aria-expanded', String(open)); visibilityChevron.setAttribute('data-lucide', open ? 'chevron-up' : 'chevron-down'); lucide.createIcons(); };\n    deliveryToggle.addEventListener('click', (event) => { event.stopPropagation(); setDelivery(deliveryMenu.hidden); });\n    visibilityToggle.addEventListener('click', (event) => { event.stopPropagation(); setVisibility(visibilityMenu.hidden); });\n    document.querySelectorAll('.delivery-row').forEach((row) => row.addEventListener('click', () => { status.classList.remove('hidden'); statusText.textContent = row.dataset.status || 'Delivery action updated'; setDelivery(false); }));\n    document.getElementById('ai-a').addEventListener('click', () => { status.classList.remove('hidden'); statusText.textContent = 'AI edit pass queued'; });\n    document.getElementById('export-a').addEventListener('click', () => { status.classList.remove('hidden'); statusText.textContent = 'Export queued to cloud'; });\n    document.querySelectorAll('.visibility-row').forEach((row) => row.addEventListener('click', () => { row.classList.toggle('bg-[#222632]'); const icon = row.querySelector('[data-lucide]'); if (icon) icon.setAttribute('data-lucide', row.classList.contains('bg-[#222632]') ? 'eye-off' : 'eye'); lucide.createIcons(); }));\n    document.addEventListener('click', (event) => { if (!deliveryMenu.contains(event.target) && !deliveryToggle.contains(event.target)) setDelivery(false); if (!visibilityMenu.contains(event.target) && !visibilityToggle.contains(event.target)) setVisibility(false); });\n    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { setDelivery(false); setVisibility(false); } });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-12T17:52:59.707656+00:00",
      "modified": "2026-08-12T17:58:34.095926+00:00",
