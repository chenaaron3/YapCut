span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex h-[68px] items-center justify-end bg-[#12141a] px-5\" data-kid=\"1-1-2-2-2\">\n                    <span class=\"inline-flex items-center gap-2 rounded-md border border-[#2e3444] bg-[#1a1d26] px-3 py-2 text-[11px] text-[#6f7788]\" data-kid=\"1-1-2-2-2-1\">\n                        <i class=\"size-3.5\" data-kid=\"1-1-2-2-2-1-1\" data-lucide=\"monitor-play\">\n                        </i>\n                        Preview\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid h-[148px] grid-cols-[700px_minmax(0,1fr)] bg-[#12141a]\" data-kid=\"1-1-2-3\">\n                <div class=\"border-r border-[#2e3444] bg-[#1a1d26] px-5 py-4\" data-kid=\"1-1-2-3-1\">\n                    <div class=\"mb-3 flex items-center justify-between text-[10px] font-semibold uppercase tracking-[0.13em] text-[#6f7788]\" data-kid=\"1-1-2-3-1-1\">\n                        <span data-kid=\"1-1-2-3-1-1-1\">\n                            Transcript\n                        </span>\n                        <span data-kid=\"1-1-2-3-1-1-2\">\n                            00:18 / 00:42\n                        </span>\n                    </div>\n                    <p class=\"max-w-[610px] text-[16px] leading-8 text-[#b7becd]\" data-kid=\"1-1-2-3-1-2\">\n                        <span class=\"text-[#e8eaef]\" data-kid=\"1-1-2-3-1-2-1\">\n                            The final cut starts here\n                        </span>\n                        <span class=\"mx-1 border-b-2 border-[#c9a227] pb-0.5\" data-kid=\"1-1-2-3-1-2-2\">\n                            with a clear idea\n                        </span>\n                        <span class=\"mx-1 border-b-2 border-[#fb7185] pb-0.5\" data-kid=\"1-1-2-3-1-2-3\">\n                            and a sharper hook.\n                        </span>\n                    </p>\n                </div>\n                <div class=\"relative flex items-center justify-center bg-black\" data-kid=\"1-1-2-3-2\">\n                    <div class=\"flex h-[108px] w-[184px] items-center justify-center border border-[#2e3444] bg-[#0b0d11] text-[11px] text-[#6f7788]\" data-kid=\"1-1-2-3-2-1\">\n                        <i class=\"mr-2 size-3.5\" data-kid=\"1-1-2-3-2-1-1\" data-lucide=\"play\">\n                        </i>\n                        Media preview\n                    </div>\n                    <span class=\"absolute bottom-3 right-4 text-[10px] uppercase tracking-[0.12em] text-[#4e5666]\" data-kid=\"1-1-2-3-2-2\">\n                        Player\n                    </span>\n                </div>\n            </div>\n        </section>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    (() => { lucide.createIcons(); const dt=document.getElementById('delivery-toggle-c'),dm=document.getElementById('delivery-menu-c'),dc=document.getElementById('delivery-chevron-c'),vt=document.getElementById('visibility-toggle-c'),vm=document.getElementById('visibility-menu-c'),vc=document.getElementById('visibility-chevron-c'),status=document.getElementById('status-c'),count=document.getElementById('visibility-count-c'); const setDelivery=(open)=>{dm.hidden=!open;dt.setAttribute('aria-expanded',String(open));dc.setAttribute('data-lucide',open?'chevron-up':'chevron-down');lucide.createIcons();}; const setVisibility=(open)=>{vm.hidden=!open;vt.setAttribute('aria-expanded',String(open));vc.setAttribute('data-lucide',open?'chevron-up':'chevron-down');lucide.createIcons();}; dt.addEventListener('click',(e)=>{e.stopPropagation();setDelivery(dm.hidden);}); vt.addEventListener('click',(e)=>{e.stopPropagation();setVisibility(vm.hidden);}); document.getElementById('visibility-close-c').addEventListener('click',()=>setVisibility(false)); document.querySelectorAll('.delivery-row').forEach((row)=>row.addEventListener('click',()=>{status.textContent=row.dataset.status||'Delivery action updated';setDelivery(false);})); document.getElementById('ai-c').addEventListener('click',()=>{status.textContent='AI edit pass queued';}); document.getElementById('export-c').addEventListener('click',()=>{status.textContent='Export queued to cloud';}); document.querySelectorAll('.visibility-row').forEach((row)=>row.addEventListener('click',()=>{const next=row.dataset.visible!=='true';row.dataset.visible=String(next);row.setAttribute('aria-pressed',String(next));const icon=row.querySelector('[data-lucide]');if(icon)icon.setAttribute('data-lucide',next?'eye':'eye-off');const rows=[...document.querySelectorAll('.visibility-row')];count.textContent=rows.filter((r)=>r.dataset.visible==='true').length+' of '+rows.length+' visible';lucide.createIcons();})); document.addEventListener('click',(e)=>{if(!dm.contains(e.target)&&!dt.contains(e.target))setDelivery(false);if(!vm.contains(e.target)&&!vt.contains(e.target))setVisibility(false);}); document.addEventListener('keydown',(e)=>{if(e.key==='Escape'){setDelivery(false);setVisibility(false);}}); })();\n</script>\n",
