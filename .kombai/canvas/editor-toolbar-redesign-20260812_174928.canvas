      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  .toolbar-focus:focus-visible { outline: 2px solid #5b8cff; outline-offset: 2px; }\n  .delivery-menu[hidden], .visibility-menu[hidden] { display: none; }\n  .command-row:hover { background: #222632; }\n</style>\n<div class=\"min-h-[760px] w-full bg-[#12141a] p-6 font-[Inter,sans-serif] text-[#e8eaef]\" data-kid=\"1\">\n    <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-1\">\n        <div class=\"mb-3 flex items-center gap-2 text-[12px] font-medium tracking-[0.04em] text-[#8b93a7]\" data-kid=\"1-1-1\">\n            <span class=\"inline-flex h-5 items-center rounded-full border border-[#2e3444] bg-[#1a1d26] px-2.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#b7becd]\" data-kid=\"1-1-1-1\">\n                C\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"command sheet title\">\n                Split delivery command sheet\n            </span>\n            <span class=\"ml-1 text-[11px] text-[#596276]\" data-kid=\"1-1-1-3\" data-name=\"command sheet metadata label\">\n                AI remains separate from Export\n            </span>\n        </div>\n        <section aria-label=\"Editor toolbar redesign prototype\" class=\"relative z-30 overflow-visible rounded-lg border border-[#2e3444] bg-[#12141a]\" data-kid=\"1-1-2\">\n            <header class=\"relative z-30 flex h-[72px] items-center justify-between border-b border-[#2e3444] bg-[#1a1d26] px-5\" data-kid=\"1-1-2-1\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-2-1-1\">\n                    <button aria-label=\"Back to projects\" class=\"toolbar-focus inline-flex h-10 w-10 items-center justify-center rounded-md text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-1-2-1-1-1\" title=\"Back to projects\" type=\"button\">\n                        <i class=\"size-4\" data-kid=\"1-1-2-1-1-1-1\" data-lucide=\"arrow-left\">\n                        </i>\n                    </button>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-1-1-2\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-1-2-1\">\n                            <span class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#6f7788]\" data-kid=\"1-1-2-1-1-2-1-1\">\n                                Editor\n                            </span>\n                            <span class=\"h-1 w-1 rounded-full bg-[#5b8cff]\" data-kid=\"1-1-2-1-1-2-1-2\">\n                            </span>\n                            <span class=\"text-[13px] font-medium\" data-kid=\"1-1-2-1-1-2-1-3\">\n                                Talking head · 01\n                            </span>\n                        </div>\n                        <p aria-live=\"polite\" class=\"mt-1 truncate text-xs text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"status update message\" data-reason=\"text replaced by action handler script\" id=\"status-c\">\n                            Last export ready · cloud asset available\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-2\">\n                    <button class=\"toolbar-focus inline-flex h-11 items-center gap-2 rounded-md border border-[#67568b] bg-[#241f32] px-4 text-[13px] font-medium hover:border-[#a78bfa] hover:bg-[#2d2540]\" data-kid=\"1-1-2-1-2-1\" data-name=\"generate edits action button\" id=\"ai-c\" title=\"Generate a new set of edits with AI\" type=\"button\">\n                        <i class=\"size-4 text-[#a78bfa]\" data-kid=\"1-1-2-1-2-1-1\" data-lucide=\"sparkles\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-2-1-2\">\n                            Generate edits\n                        </span>\n                    </button>\n                    <div class=\"relative flex items-stretch\" data-kid=\"1-1-2-1-2-2\" data-name=\"export and delivery action group\">\n                        <button aria-label=\"Export video to the cloud\" class=\"toolbar-focus inline-flex h-11 items-center gap-2 rounded-l-md bg-[#5b8cff] px-5 text-[13px] font-semibold text-white hover:bg-[#6c99ff]\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"primary export button\" id=\"export-c\" title=\"Export video to the cloud\" type=\"button\">\n                            <i class=\"size-4\" data-kid=\"1-1-2-1-2-2-1-1\" data-lucide=\"cloud-upload\">\n                            </i>\n                            <span data-kid=\"1-1-2-1-2-2-1-2\">\n                                Export video\n                            </span>\n                        </button>\n                        <button aria-controls=\"delivery-menu-c\" aria-expanded=\"true\" aria-label=\"Open download and schedule actions\" class=\"toolbar-focus flex h-11 w-11 items-center justify-center rounded-r-md border-l border-white/25 bg-[#5b8cff] text-white hover:bg-[#6c99ff]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"delivery actions menu toggle button\" data-reason=\"icon replaced by script on toggle\" id=\"delivery-toggle-c\" title=\"Download or schedule the exported video\" type=\"button\">\n                            <i class=\"size-4\" data-kid=\"1-1-2-1-2-2-2-1\" data-lucide=\"chevron-up\" id=\"delivery-chevron-c\">\n                            </i>\n                        </button>\n                        <div aria-label=\"Delivery actions\" class=\"delivery-menu absolute right-0 top-[58px] w-[420px] rounded-lg border border-[#465066] bg-[#1a1d26] p-3 shadow-[0_18px_42px_rgba(0,0,0,0.34)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-3\" data-name=\"delivery actions menu container\" data-reason=\"menu visibility toggled by script\" id=\"delivery-menu-c\" role=\"menu\">\n                            <div class=\"border-b border-[#2e3444] px-2 pb-3\" data-kid=\"1-1-2-1-2-2-3-1\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-1-2-2-3-1-1\">\n                                    <div data-kid=\"1-1-2-1-2-2-3-1-1-1\">\n                                        <h2 class=\"text-sm font-semibold\" data-kid=\"1-1-2-1-2-2-3-1-1-1-1\">\n                                            Delivery actions\n                                        </h2>\n                                        <p class=\"mt-0.5 text-[11px] text-[#8b93a7]\" data-kid=\"1-1-2-1-2-2-3-1-1-1-2\">\n                                            Export is the cloud step. The chevron contains what happens next.\n                                        </p>\n                                    </div>\n                                    <span class=\"rounded border border-[#2e3444] px-1.5 py-0.5 text-[10px] uppercase tracking-[0.1em] text-[#6f7788]\" data-kid=\"1-1-2-1-2-2-3-1-1-2\">\n                                        2 actions\n                                    </span>\n                                </div>\n                                <div class=\"mt-2 flex items-center gap-2 text-xs text-[#b7becd]\" data-kid=\"1-1-2-1-2-2-3-1-2\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-1-2-1-2-2-3-1-2-1\">\n                                    </span>\n                                    Export ready — video and cover available\n                                </div>\n                            </div>\n                            <div class=\"mt-2 space-y-1\" data-kid=\"1-1-2-1-2-2-3-2\">\n                                <button class=\"command-row delivery-row toolbar-focus flex w-full items-center gap-3 rounded-md px-2.5 py-3 text-left\" data-kid=\"1-1-2-1-2-2-3-2-1\" data-name=\"download video command row\" data-status=\"Download started · MP4 and cover image\" type=\"button\">\n                                    <span class=\"inline-flex h-9 