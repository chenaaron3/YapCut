      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  .command-row:focus-visible,\n  .toolbar-control:focus-visible,\n  .icon-control:focus-visible,\n  .visibility-row:focus-visible {\n    outline: 2px solid #5b8cff;\n    outline-offset: 2px;\n  }\n  .visibility-row[data-visible=\"false\"] .visibility-dot {\n    opacity: .35;\n  }\n  .visibility-row[data-visible=\"false\"] .visibility-name,\n  .visibility-row[data-visible=\"false\"] .visibility-count {\n    color: #6f7788;\n  }\n  .visibility-row[data-visible=\"false\"] .visibility-icon {\n    color: #6f7788;\n  }\n</style>\n<div class=\"min-h-[390px] w-full bg-[#12141a] p-6 text-[#e8eaef]\" data-kid=\"1\" style=\"font-family: Inter, ui-sans-serif, system-ui, sans-serif;\">\n    <div class=\"mx-auto max-w-[1200px]\" data-kid=\"1-1\">\n        <div class=\"mb-3 flex items-center gap-2 text-[12px] font-medium tracking-[0.04em] text-[#8b93a7]\" data-kid=\"1-1-1\">\n            <span class=\"inline-flex h-5 items-center rounded-full border border-[#2e3444] bg-[#1a1d26] px-2.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#b7becd]\" data-kid=\"1-1-1-1\">\n                C\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                Command sheet\n            </span>\n        </div>\n        <section aria-label=\"Editor toolbar redesign prototype\" class=\"relative overflow-visible rounded-lg border border-[#2e3444] bg-[#12141a]\" data-kid=\"1-1-2\">\n            <header class=\"relative z-30 flex h-[72px] items-center justify-between border-b border-[#2e3444] bg-[#1a1d26] px-5\" data-kid=\"1-1-2-1\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-2-1-1\">\n                    <button aria-label=\"Back to projects\" class=\"icon-control inline-flex h-10 w-10 items-center justify-center rounded-md border border-transparent text-[#8b93a7] hover:border-[#2e3444] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-1-2-1-1-1\" title=\"Back to projects\" type=\"button\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-1-1-1\" data-lucide=\"arrow-left\">\n                        </i>\n                    </button>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-1-1-2\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-1-2-1\">\n                            <span class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#6f7788]\" data-kid=\"1-1-2-1-1-2-1-1\">\n                                Editor\n                            </span>\n                            <span class=\"h-1 w-1 rounded-full bg-[#5b8cff]\" data-kid=\"1-1-2-1-1-2-1-2\">\n                            </span>\n                            <span class=\"text-[13px] font-medium text-[#e8eaef]\" data-kid=\"1-1-2-1-1-2-1-3\">\n                                Talking head · 01\n                            </span>\n                        </div>\n                        <p class=\"mt-1 truncate text-[12px] text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"status update message\" data-reason=\"text replaced by action handler script\" id=\"inline-status\">\n                            Last export ready · cloud asset available\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"relative\" data-kid=\"1-1-2-1-2-1\">\n                        <button aria-controls=\"project-actions-menu\" aria-expanded=\"true\" aria-label=\"Open project actions\" class=\"toolbar-control inline-flex h-11 items-center gap-2 rounded-md border border-[#465066] bg-[#1a1d26] px-4 text-[13px] font-medium text-[#e8eaef] hover:border-[#69758f] hover:bg-[#222632]\" data-kid=\"1-1-2-1-2-1-1\" id=\"more-actions\" title=\"More project actions\" type=\"button\">\n                            <i class=\"h-4 w-4 text-[#b7becd]\" data-kid=\"1-1-2-1-2-1-1-1\" data-lucide=\"ellipsis\">\n                            </i>\n                            <span data-kid=\"1-1-2-1-2-1-1-2\">\n                                More actions\n                            </span>\n                            <span class=\"inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-[#2e3444] px-1.5 text-[11px] font-semibold text-[#e8eaef]\" data-kid=\"1-1-2-1-2-1-1-3\">\n                                3\n                            </span>\n                            <i class=\"ml-0.5 h-4 w-4 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-1-4\" data-lucide=\"chevron-down\" data-name=\"more actions menu dropdown arrow\" data-reason=\"icon replaced by script on toggle\">\n                            </i>\n                        </button>\n                        <div aria-label=\"Project actions\" class=\"absolute right-0 top-[58px] w-[420px] rounded-lg border border-[#465066] bg-[#1a1d26] p-3 shadow-[0_18px_42px_rgba(0,0,0,0.34)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"project actions menu container\" data-reason=\"menu visibility toggled by script\" id=\"project-actions-menu\" role=\"menu\">\n                            <div class=\"border-b border-[#2e3444] px-2 pb-3\" data-kid=\"1-1-2-1-2-1-2-1\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-1-2-1-2-1-1\">\n                                    <h2 class=\"text-[14px] font-semibold text-[#e8eaef]\" data-kid=\"1-1-2-1-2-1-2-1-1-1\">\n                                        Project actions\n                                    </h2>\n                                    <span class=\"rounded border border-[#2e3444] px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-[0.1em] text-[#6f7788]\" data-kid=\"1-1-2-1-2-1-2-1-1-2\">\n                                        ⌘ K\n                                    </span>\n                                </div>\n                                <div class=\"mt-2 flex items-center gap-2 text-[12px] text-[#b7becd]\" data-kid=\"1-1-2-1-2-1-2-1-2\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-1-2-1-2-1-2-1-2-1\">\n                                    </span>\n                                    <span data-kid=\"1-1-2-1-2-1-2-1-2-2\">\n                                        Export ready — video and cover available\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"mt-2 space-y-1\" data-kid=\"1-1-2-1-2-1-2-2\">\n                                <button class=\"command-row flex w-full items-center gap-3 rounded-md px-2.5 py-3 text-left hover:bg-[#222632]\" data-action=\"generate\" data-kid=\"1-1-2-1-2-1-2-2-1\" role=\"menuitem\" type=\"button\">\n                                    <span class=\"inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#5b8cff]/12 text-[#7da4ff]\" data-kid=\"1-1-2-1-2-1-2-2-1-1\">\n                                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-2-1-2-2-1-1-1\" data-lucide=\"sparkles\">\n                                        </i>\n                                    </span>\n                                    <span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-2-1-2-2-1-2\">\n                                        <span class=\"block text-[13px] font-medium text-[#e8eaef]\" data-kid=\"1-1-2-1-2-1-2-2-1-2-1\">\n                                            Generate edits\n                                        </span>\n                                        <span class=\"mt-0.5 block text-[11px] leading-4 text-[#8b93a7]\" data-kid=\"1-1-2-1-2-1-2-2-1-2-2\">\n                                            Use AI to create a first pass from the transcript\n                                        </span>\n                                    </span>\n                                    <span class=\"inline-flex shrink-0 items-center gap-1 rounded border border-[#465066] px-2 py-1 text-[11px] font-medium text-[#b7becd]\" data-kid=\"1-1-2-1-2-1-2-2-1-3\">\n                                        Run\n                                        <i class=\"h-3 w-3\" data-kid=\"1-1-2-1-2-1-2-2-1-3-1\" data-lucide=\"arrow-up-right\">\n                                        </i>\n                                    </span>\n                                </button>\n                                <button class=\"command-row flex w-full items-center gap-3 rounded-md px-2.5 py-3 text-left hover:bg-[#222632]\" data-action=\"download\" data-kid=\"1-1-2-1-2-1-2-2-2\" role=\"menuitem\" type=\"button\">\n                                    <span class=\"inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#222632] text-[#b7becd]\" data-kid=\"1-1-2-1-2-1-2-2-2-1\">\n                                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-2-1-2-2-2-1-1\" data-lucide=\"download\">\n                                        </i>\n                                    </span>\n                                    <span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-2-1-2-2-2-2\">\n                                        <span class=\"block text-[13px] font-medium text-[#e8eaef]\" data-kid=\"1-1-2-1-2-1-2-2-2-2-1\">\n                                            Download video\n                                        </span>\n                                        <span class=\"mt-0.5 block text-[11px] leading-4 text-[#8b93a7]\" data-kid=\"1-1-2-1-2-1-2-2-2-2-2\">\n                                            Save the latest cloud export to your device\n                                        </span>\n                                    </span>\n                                    <span class=\"inline-flex shrink-0 items-center gap-1 rounded border border-[#2dd4bf]/40 bg-[#2dd4bf]/10 px-2 py-1 text-[11px] font-medium text-[#78e5d4]\" data-kid=\"1-1-2-1-2-1-2-2-2-3\">\n                                        Ready · MP4\n                                        <i class=\"h-3 w-3\" data-kid=\"1-1-2-1-2-1-2-2-2-3-1\" data-lucide=\"check\">\n                                        </i>\n                                    </span>\n                                </button>\n                                <button class=\"command-row flex w-full items-center gap-3 rounded-md px-2.5 py-3 text-left hover:bg-[#222632]\" data-action=\"schedule\" data-kid=\"1-1-2-1-2-1-2-2-3\" role=\"menuitem\" type=\"button\">\n                                    <span class=\"inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#222632] text-[#b7becd]\" data-kid=\"1-1-2-1-2-1-2-2-3-1\">\n                                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-2-1-2-2-3-1-1\" data-lucide=\"calendar-clock\">\n                                        </i>\n                                    </span>\n                                    <span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-2-1-2-2-3-2\">\n                                        <span class=\"block text-[13px] font-medium text-[#e8eaef]\" data-kid=\"1-1-2-1-2-1-2-2-3-2-1\">\n                                            Schedule video\n                                        </span>\n                                        <span class=\"mt-0.5 block text-[11px] leading-4 text-[#8b93a7]\" data-kid=\"1-1-2-1-2-1-2-2-3-2-2\">\n                                            Publish to connected platforms after export\n                                        </span>\n                                    </span>\n                                    <span class=\"inline-flex shrink-0 items-center gap-1 rounded border border-[#2dd4bf]/40 bg-[#2dd4bf]/10 px-2 py-1 text-[11px] font-medium text-[#78e5d4]\" data-kid=\"1-1-2-1-2-1-2-2-3-3\">\n                                        <i class=\"h-3 w-3\" data-kid=\"1-1-2-1-2-1-2-2-3-3-1\" data-lucide=\"check\">\n                                        </i>\n                                        On schedule\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                    <button aria-label=\"Export video\" class=\"toolbar-control inline-flex h-11 items-center gap-2 rounded-md bg-[#5b8cff] px-5 text-[13px] font-semibold text-white hover:bg-[#6c99ff]\" data-kid=\"1-1-2-1-2-2\" title=\"Export video to the cloud\" type=\"button\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-2-2-1\" data-lucide=\"cloud-upload\">\n                        </i>\n                        <span data-kid=\"1-1-2-1-2-2-2\">\n                            Export video\n                        </span>\n                    </button>\n                </div>\n            </header>\n            <div class=\"relative z-20 grid grid-cols-[700px_minmax(0,1fr)] border-b border-[#2e3444]\" data-kid=\"1-1-2-2\">\n                <div class=\"relative flex h-[68px] min-w-0 items-center justify-between border-r border-[#2e3444] bg-[#1a1d26] px-4\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-2-1-1\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-1-1-1\">\n                            <span class=\"truncate text-[14px] font-medium text-[#e8eaef]\" data-kid=\"1-1-2-2-1-1-1-1\">\n                                Talking head · 01\n                            </span>\n                            <span class=\"rounded border border-[#2e3444] bg-[#222632] px-1.5 py-0.5 text-[10px] font-medium text-[#8b93a7]\" data-kid=\"1-1-2-2-1-1-1-2\">\n                                Transcript\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[11px] text-[#6f7788]\" data-kid=\"1-1-2-2-1-1-2\">\n                            Select words to add or adjust edits\n                        </p>\n                    </div>\n                    <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-2-2-1-2\">\n                        <div class=\"relative\" data-kid=\"1-1-2-2-1-2-1\">\n                            <button aria-controls=\"visibility-menu\" aria-expanded=\"true\" aria-label=\"Edit visibility, 6 types\" class=\"toolbar-control inline-flex h-11 items-center gap-2 rounded-md border border-[#465066] bg-[#222632] px-3 text-[12px] font-medium text-[#e8eaef] hover:border-[#69758f]\" data-kid=\"1-1-2-2-1-2-1-1\" id=\"visibility-control\" title=\"Show or hide edit types\" type=\"button\">\n                                <i class=\"h-4 w-4 text-[#b7becd]\" data-kid=\"1-1-2-2-1-2-1-1-1\" data-lucide=\"eye\">\n                                </i>\n                                <span data-kid=\"1-1-2-2-1-2-1-1-2\">\n                                    Edit visibility\n                                </span>\n                                <span class=\"text-[#8b93a7]\" data-kid=\"1-1-2-2-1-2-1-1-3\">\n                                    6\n                                </span>\n                                <span aria-hidden=\"true\" class=\"flex items-center gap-0.5\" data-kid=\"1-1-2-2-1-2-1-1-4\">\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#c9a227]\" data-kid=\"1-1-2-2-1-2-1-1-4-1\">\n                                    </span>\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#fb7185]\" data-kid=\"1-1-2-2-1-2-1-1-4-2\">\n                                    </span>\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-1-2-2-1-2-1-1-4-3\">\n                                    </span>\n                                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#3b82f6]\" data-kid=\"1-1-2-2-1-2-1-1-4-4\">\n                                    </span>\n                                </span>\n                                <i class=\"ml-0.5 h-3.5 w-3.5 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-1-5\" data-lucide=\"chevron-up\" data-name=\"visibility menu chevron icon\" data-reason=\"icon replaced by script on toggle\">\n                                </i>\n                            </button>\n                            <div aria-label=\"Edit visibility controls\" class=\"absolute right-0 top-[58px] w-[286px] rounded-lg border border-[#465066] bg-[#1a1d26] p-3 shadow-[0_16px_34px_rgba(0,0,0,0.3)]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"edit visibility controls container\" data-reason=\"menu visibility toggled by script\" id=\"visibility-menu\" role=\"dialog\">\n                                <div class=\"flex items-center justify-between border-b border-[#2e3444] px-1 pb-2.5\" data-kid=\"1-1-2-2-1-2-1-2-1\">\n                                    <div data-kid=\"1-1-2-2-1-2-1-2-1-1\">\n                                        <h2 class=\"text-[13px] font-semibold text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-1-1-1\">\n                                            Visible edit types\n                                        </h2>\n                                        <p class=\"mt-0.5 text-[11px] text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2-1-1-2\" data-name=\"visible edit types count label\" data-reason=\"text updated when visibility toggled\" id=\"visibility-count\">\n                                            6 of 6 visible\n                                        </p>\n                                    </div>\n                                    <button aria-label=\"Close edit visibility\" class=\"icon-control inline-flex h-8 w-8 items-center justify-center rounded-md text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-1-2\" id=\"visibility-close\" title=\"Close edit visibility\" type=\"button\">\n                                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-2-1-2-1-2-1-2-1\" data-lucide=\"x\">\n                                        </i>\n                                    </button>\n                                </div>\n                                <div class=\"mt-2 space-y-0.5\" data-kid=\"1-1-2-2-1-2-1-2-2\">\n                                    <button aria-pressed=\"true\" class=\"visibility-row flex w-full items-center gap-2.5 rounded-md px-1.5 py-2 text-left hover:bg-[#222632]\" data-kid=\"1-1-2-2-1-2-1-2-2-1\" data-toggle-visibility=\"\" data-visible=\"true\" type=\"button\">\n                                        <span class=\"visibility-dot h-2 w-2 rounded-full bg-[#c9a227]\" data-kid=\"1-1-2-2-1-2-1-2-2-1-1\">\n                                        </span>\n                                        <span class=\"visibility-name min-w-0 flex-1 text-[12px] text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-2-1-2\">\n                                            B-roll\n                                        </span>\n                                        <span class=\"visibility-count text-[11px] text-[#8b93a7]\" data-kid=\"1-1-2-2-1-2-1-2-2-1-3\">\n                                            1\n                                        </span>\n                                        <i class=\"visibility-icon h-3.5 w-3.5 text-[#b7becd]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2-2-1-4\" data-lucide=\"eye\" data-name=\"visibility eye icon\" data-reason=\"icon replaced by script on toggle\">\n                                        </i>\n                                    </button>\n                                    <button aria-pressed=\"true\" class=\"visibility-row flex w-full items-center gap-2.5 rounded-md px-1.5 py-2 text-left hover:bg-[#222632]\" data-kid=\"1-1-2-2-1-2-1-2-2-2\" data-toggle-visibility=\"\" data-visible=\"true\" type=\"button\">\n                                        <span class=\"visibility-dot h-2 w-2 rounded-full bg-[#fb7185]\" data-kid=\"1-1-2-2-1-2-1-2-2-2-1\">\n                                        </span>\n                                        <span class=\"visibility-name min-w-0 flex-1 text-[12px] text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-2-2-2\">\n                                            Text effects\n                                        </span>\n                                        <span class=\"visibility-count text-[11px] text-[#8b93a7]\" data-kid=\"1-1-2-2-1-2-1-2-2-2-3\">\n                                            1\n                                        </span>\n                                        <i class=\"visibility-icon h-3.5 w-3.5 text-[#b7becd]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2-2-2-4\" data-lucide=\"eye\" data-name=\"visibility eye icon\" data-reason=\"icon replaced by script on toggle\">\n                                        </i>\n                                    </button>\n                                    <button aria-pressed=\"true\" class=\"visibility-row flex w-full items-center gap-2.5 rounded-md px-1.5 py-2 text-left hover:bg-[#222632]\" data-kid=\"1-1-2-2-1-2-1-2-2-3\" data-toggle-visibility=\"\" data-visible=\"true\" type=\"button\">\n                                        <span class=\"visibility-dot h-2 w-2 rounded-full bg-[#fb7185]\" data-kid=\"1-1-2-2-1-2-1-2-2-3-1\">\n                                        </span>\n                                        <span class=\"visibility-name min-w-0 flex-1 text-[12px] text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-2-3-2\">\n                                            Quote effects\n                                        </span>\n                                        <span class=\"visibility-count text-[11px] text-[#8b93a7]\" data-kid=\"1-1-2-2-1-2-1-2-2-3-3\">\n                                            7\n                                        </span>\n                                        <i class=\"visibility-icon h-3.5 w-3.5 text-[#b7becd]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2-2-3-4\" data-lucide=\"eye\" data-name=\"visibility eye icon\" data-reason=\"icon replaced by script on toggle\">\n                                        </i>\n                                    </button>\n                                    <button aria-pressed=\"true\" class=\"visibility-row flex w-full items-center gap-2.5 rounded-md px-1.5 py-2 text-left hover:bg-[#222632]\" data-kid=\"1-1-2-2-1-2-1-2-2-4\" data-toggle-visibility=\"\" data-visible=\"true\" type=\"button\">\n                                        <span class=\"visibility-dot h-2 w-2 rounded-full bg-[#fb7185]\" data-kid=\"1-1-2-2-1-2-1-2-2-4-1\">\n                                        </span>\n                                        <span class=\"visibility-name min-w-0 flex-1 text-[12px] text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-2-4-2\">\n                                            Listicles\n                                        </span>\n                                        <span class=\"visibility-count text-[11px] text-[#8b93a7]\" data-kid=\"1-1-2-2-1-2-1-2-2-4-3\">\n                                            4\n                                        </span>\n                                        <i class=\"visibility-icon h-3.5 w-3.5 text-[#b7becd]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2-2-4-4\" data-lucide=\"eye\" data-name=\"visibility eye icon\" data-reason=\"icon replaced by script on toggle\">\n                                        </i>\n                                    </button>\n                                    <button aria-pressed=\"true\" class=\"visibility-row flex w-full items-center gap-2.5 rounded-md px-1.5 py-2 text-left hover:bg-[#222632]\" data-kid=\"1-1-2-2-1-2-1-2-2-5\" data-toggle-visibility=\"\" data-visible=\"true\" type=\"button\">\n                                        <span class=\"visibility-dot h-2 w-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-1-2-2-1-2-1-2-2-5-1\">\n                                        </span>\n                                        <span class=\"visibility-name min-w-0 flex-1 text-[12px] text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-2-5-2\">\n                                            Sound effects\n                                        </span>\n                                        <span class=\"visibility-count text-[11px] text-[#8b93a7]\" data-kid=\"1-1-2-2-1-2-1-2-2-5-3\">\n                                            14\n                                        </span>\n                                        <i class=\"visibility-icon h-3.5 w-3.5 text-[#b7becd]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2-2-5-4\" data-lucide=\"eye\" data-name=\"visibility eye icon\" data-reason=\"icon replaced by script on toggle\">\n                                        </i>\n                                    </button>\n                                    <button aria-pressed=\"true\" class=\"visibility-row flex w-full items-center gap-2.5 rounded-md px-1.5 py-2 text-left hover:bg-[#222632]\" data-kid=\"1-1-2-2-1-2-1-2-2-6\" data-toggle-visibility=\"\" data-visible=\"true\" type=\"button\">\n                                        <span class=\"visibility-dot h-2 w-2 rounded-full bg-[#3b82f6]\" data-kid=\"1-1-2-2-1-2-1-2-2-6-1\">\n                                        </span>\n                                        <span class=\"visibility-name min-w-0 flex-1 text-[12px] text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-1-2-2-6-2\">\n                                            Zooms\n                                        </span>\n                                        <span class=\"visibility-count text-[11px] text-[#8b93a7]\" data-kid=\"1-1-2-2-1-2-1-2-2-6-3\">\n                                            10\n                                        </span>\n                                        <i class=\"visibility-icon h-3.5 w-3.5 text-[#b7becd]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2-2-6-4\" data-lucide=\"eye\" data-name=\"visibility eye icon\" data-reason=\"icon replaced by script on toggle\">\n                                        </i>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                        <span class=\"h-7 w-px bg-[#2e3444]\" data-kid=\"1-1-2-2-1-2-2\">\n                        </span>\n                        <button aria-label=\"Open caption settings\" class=\"toolbar-control inline-flex h-11 items-center gap-2 rounded-md border border-transparent px-3 text-[12px] font-medium text-[#b7becd] hover:border-[#2e3444] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-3\" title=\"Open caption settings\" type=\"button\">\n                            <i class=\"h-4 w-4\" data-kid=\"1-1-2-2-1-2-3-1\" data-lucide=\"captions\">\n                            </i>\n                            <span data-kid=\"1-1-2-2-1-2-3-2\">\n                                Captions\n                            </span>\n                        </button>\n                        <button aria-label=\"Open project settings\" class=\"icon-control inline-flex h-11 w-11 items-center justify-center rounded-md border border-transparent text-[#b7becd] hover:border-[#2e3444] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-1-2-2-1-2-4\" title=\"Project settings\" type=\"button\">\n                            <i class=\"h-4 w-4\" data-kid=\"1-1-2-2-1-2-4-1\" data-lucide=\"settings-2\">\n                            </i>\n                        </button>\n                        <div aria-label=\"Project saved status\" class=\"flex h-11 items-center gap-2 rounded-md border border-[#2e3444] bg-[#222632] px-3 text-[12px] text-[#b7becd]\" data-kid=\"1-1-2-2-1-2-5\">\n                            <i class=\"h-4 w-4 text-[#2dd4bf]\" data-kid=\"1-1-2-2-1-2-5-1\" data-lucide=\"cloud-check\">\n                            </i>\n                            <span data-kid=\"1-1-2-2-1-2-5-2\">\n                                Saved\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"flex h-[68px] items-center justify-end bg-[#12141a] px-5\" data-kid=\"1-1-2-2-2\">\n                    <span class=\"inline-flex items-center gap-2 rounded-md border border-[#2e3444] bg-[#1a1d26] px-3 py-2 text-[11px] text-[#6f7788]\" data-kid=\"1-1-2-2-2-1\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-2-2-2-1-1\" data-lucide=\"monitor-play\">\n                        </i>\n                        Preview\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid h-[148px] grid-cols-[700px_minmax(0,1fr)] bg-[#12141a]\" data-kid=\"1-1-2-3\">\n                <div class=\"border-r border-[#2e3444] bg-[#1a1d26] px-5 py-4\" data-kid=\"1-1-2-3-1\">\n                    <div class=\"mb-3 flex items-center justify-between text-[10px] font-semibold uppercase tracking-[0.13em] text-[#6f7788]\" data-kid=\"1-1-2-3-1-1\">\n                        <span data-kid=\"1-1-2-3-1-1-1\">\n                            Transcript\n                        </span>\n                        <span data-kid=\"1-1-2-3-1-1-2\">\n                            00:18 / 00:42\n                        </span>\n                    </div>\n                    <p class=\"max-w-[610px] text-[16px] leading-8 text-[#b7becd]\" data-kid=\"1-1-2-3-1-2\">\n                        <span class=\"text-[#e8eaef]\" data-kid=\"1-1-2-3-1-2-1\">\n                            The final cut starts here\n                        </span>\n                        <span class=\"mx-1 border-b-2 border-[#c9a227] pb-0.5\" data-kid=\"1-1-2-3-1-2-2\">\n                            with a clear idea\n                        </span>\n                        <span class=\"mx-1 border-b-2 border-[#fb7185] pb-0.5\" data-kid=\"1-1-2-3-1-2-3\">\n                            and a sharper hook.\n                        </span>\n                    </p>\n                </div>\n                <div class=\"relative flex items-center justify-center bg-black\" data-kid=\"1-1-2-3-2\">\n                    <div class=\"flex h-[108px] w-[184px] items-center justify-center border border-[#2e3444] bg-[#0b0d11] text-[11px] text-[#6f7788]\" data-kid=\"1-1-2-3-2-1\">\n                        <i class=\"mr-2 h-3.5 w-3.5\" data-kid=\"1-1-2-3-2-1-1\" data-lucide=\"play\">\n                        </i>\n                        Media preview\n                    </div>\n                    <span class=\"absolute bottom-3 right-4 text-[10px] uppercase tracking-[0.12em] text-[#4e5666]\" data-kid=\"1-1-2-3-2-2\">\n                        Player\n                    </span>\n                </div>\n            </div>\n        </section>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n\n  const moreButton = document.getElementById('more-actions');\n  const projectMenu = document.getElementById('project-actions-menu');\n  const visibilityButton = document.getElementById('visibility-control');\n  const visibilityMenu = document.getElementById('visibility-menu');\n  const visibilityClose = document.getElementById('visibility-close');\n  const inlineStatus = document.getElementById('inline-status');\n  const visibilityCount = document.getElementById('visibility-count');\n\n  const setProjectMenu = (open) => {\n    projectMenu.classList.toggle('hidden', !open);\n    moreButton.setAttribute('aria-expanded', String(open));\n  };\n\n  const setVisibilityMenu = (open) => {\n    visibilityMenu.classList.toggle('hidden', !open);\n    visibilityButton.setAttribute('aria-expanded', String(open));\n    visibilityButton.querySelector('[data-lucide=\"chevron-up\"], [data-lucide=\"chevron-down\"]')?.replaceWith(Object.assign(document.createElement('i'), { dataset: { lucide: open ? 'chevron-up' : 'chevron-down' }, className: 'ml-0.5 h-3.5 w-3.5 text-[#8b93a7]' }));\n    lucide.createIcons();\n  };\n\n  moreButton.addEventListener('click', (event) => {\n    event.stopPropagation();\n    setProjectMenu(moreButton.getAttribute('aria-expanded') !== 'true');\n  });\n\n  visibilityButton.addEventListener('click', (event) => {\n    event.stopPropagation();\n    setVisibilityMenu(visibilityButton.getAttribute('aria-expanded') !== 'true');\n  });\n\n  visibilityClose.addEventListener('click', () => setVisibilityMenu(false));\n\n  document.querySelectorAll('[data-action]').forEach((row) => {\n    row.addEventListener('click', () => {\n      const action = row.getAttribute('data-action');\n      inlineStatus.textContent = action === 'generate' ? 'AI edit pass queued' : action === 'download' ? 'Download started · MP4' : 'Already on schedule · ready to publish';\n      setProjectMenu(false);\n    });\n  });\n\n  const updateVisibilityCount = () => {\n    const rows = [...document.querySelectorAll('[data-toggle-visibility]')];\n    const visible = rows.filter((row) => row.dataset.visible === 'true').length;\n    visibilityCount.textContent = visible + ' of ' + rows.length + ' visible';\n  };\n\n  document.querySelectorAll('[data-toggle-visibility]').forEach((row) => {\n    row.addEventListener('click', () => {\n      const next = row.dataset.visible !== 'true';\n      row.dataset.visible = String(next);\n      row.setAttribute('aria-pressed', String(next));\n      const icon = row.querySelector('.visibility-icon');\n      if (icon) {\n        icon.setAttribute('data-lucide', next ? 'eye' : 'eye-off');\n        lucide.createIcons();\n      }\n      updateVisibilityCount();\n    });\n  });\n\n  document.addEventListener('click', (event) => {\n    if (!projectMenu.contains(event.target) && !moreButton.contains(event.target)) setProjectMenu(false);\n    if (!visibilityMenu.contains(event.target) && !visibilityButton.contains(event.target)) setVisibilityMenu(false);\n  });\n\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape') {\n      setProjectMenu(false);\n      setVisibilityMenu(false);\n    }\n  });\n</script>\n",
