    },
    "var_b34fdd8fed96": {
      "type": "variant",
      "label": "B · Status-led overflow",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  .proto-root {\n    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;\n    color: var(--text);\n  }\n\n  .menu-shadow {\n    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.34), 0 2px 8px rgba(0, 0, 0, 0.22);\n  }\n\n  .focus-ring:focus-visible {\n    outline: 2px solid var(--blue);\n    outline-offset: 2px;\n  }\n\n  .vertical-rail {\n    position: relative;\n  }\n\n  .vertical-rail::before {\n    content: '';\n    position: absolute;\n    left: 10px;\n    top: 19px;\n    bottom: 19px;\n    width: 1px;\n    background: var(--border);\n  }\n\n  .rail-dot {\n    position: relative;\n    z-index: 1;\n    box-shadow: 0 0 0 4px var(--raised);\n  }\n\n  .popover-panel[hidden],\n  .menu-panel[hidden] {\n    display: none;\n  }\n</style>\n<div class=\"proto-root min-h-[360px] w-full bg-[var(--page)] p-6\" data-kid=\"1\" style=\"--page:#12141a;--panel:#1a1d26;--raised:#222632;--border:#2e3444;--text:#e8eaef;--muted:#8b93a7;--blue:#5b8cff;--gold:#c9a227;--pink:#fb7185;--teal:#2dd4bf;--purple:#a78bfa;\">\n    <div class=\"mb-3 flex items-center gap-2 px-1\" data-kid=\"1-1\">\n        <span class=\"text-[12px] font-semibold tracking-[0.12em] text-[var(--text)]\" data-kid=\"1-1-1\">\n            B · Status-led overflow\n        </span>\n        <span class=\"h-px w-10 bg-[var(--border)]\" data-kid=\"1-1-2\">\n        </span>\n        <span class=\"text-[11px] text-[var(--muted)]\" data-kid=\"1-1-3\">\n            Calmer action hierarchy\n        </span>\n    </div>\n    <section aria-label=\"Editor toolbar redesign prototype\" class=\"relative overflow-visible rounded-md border border-[var(--border)] bg-[var(--panel)]\" data-kid=\"1-2\">\n        <header class=\"flex h-[72px] items-center justify-between border-b border-[var(--border)] px-5\" data-kid=\"1-2-1\">\n            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-1-1\">\n                <div aria-hidden=\"true\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-[var(--border)] bg-[var(--raised)] text-[var(--blue)]\" data-kid=\"1-2-1-1-1\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-1-1\" data-lucide=\"play-square\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-2-1\">\n                        <span class=\"truncate text-[14px] font-semibold text-[var(--text)]\" data-kid=\"1-2-1-1-2-1-1\">\n                            Talking head / Draft 04\n                        </span>\n                        <span class=\"rounded-sm border border-[var(--border)] px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-[0.11em] text-[var(--muted)]\" data-kid=\"1-2-1-1-2-1-2\">\n                            Editor\n                        </span>\n                    </div>\n                    <div class=\"mt-1 flex items-center gap-2 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-1-1-2-2\">\n                        <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-2-2-1\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--teal)]\" data-kid=\"1-2-1-1-2-2-1-1\">\n                            </span>\n                            Export ready\n                        </span>\n                        <span class=\"text-[var(--border)]\" data-kid=\"1-2-1-1-2-2-2\">\n                            ·\n                        </span>\n                        <span data-kid=\"1-2-1-1-2-2-3\">\n                            1080 × 1920 · MP4\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-2\">\n                <span aria-live=\"polite\" class=\"hidden max-w-[170px] truncate rounded-sm border border-[var(--border)] bg-[var(--raised)] px-2.5 py-2 text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-inline-status=\"\" data-kid=\"1-2-1-2-1\" data-name=\"inline status message\" data-reason=\"text replaced and visibility toggled by script\">\n                </span>\n                <button aria-label=\"Export video to the cloud\" class=\"focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-md bg-[var(--blue)] px-4 text-[13px] font-semibold text-white shadow-sm transition-colors hover:bg-[#6d9aff]\" data-export=\"\" data-kid=\"1-2-1-2-2\" title=\"Create a cloud video asset\" type=\"button\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"cloud-upload\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        Export video\n                    </span>\n                </button>\n                <button aria-controls=\"more-actions-menu\" aria-expanded=\"true\" aria-label=\"More actions\" class=\"focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-md border border-[var(--border)] bg-transparent px-3.5 text-[13px] font-medium text-[var(--text)] transition-colors hover:border-[var(--muted)] hover:bg-[var(--raised)]\" data-kid=\"1-2-1-2-3\" data-menu-trigger=\"\" title=\"Open more project actions\" type=\"button\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-3-1\" data-lucide=\"ellipsis\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-3-2\">\n                        More actions\n                    </span>\n                    <i class=\"h-3.5 w-3.5 text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-3\" data-lucide=\"chevron-down\" data-menu-chevron=\"\" data-name=\"chevron up/down icon\" data-reason=\"icon type attribute replaced by script on menu open/close\">\n                    </i>\n                </button>\n                <div aria-label=\"More actions\" class=\"menu-panel absolute right-0 top-[56px] z-30 w-[360px] overflow-hidden rounded-md border border-[var(--border)] bg-[var(--raised)] menu-shadow\" data-kid=\"1-2-1-2-4\" data-menu=\"\" id=\"more-actions-menu\" role=\"menu\">\n                    <div class=\"flex items-center justify-between border-b border-[var(--border)] px-4 py-3\" data-kid=\"1-2-1-2-4-1\">\n                        <div data-kid=\"1-2-1-2-4-1-1\">\n                            <p class=\"text-[13px] font-semibold text-[var(--text)]\" data-kid=\"1-2-1-2-4-1-1-1\">\n                                Project actions\n                            </p>\n                            <p class=\"mt-0.5 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-1-1-2\">\n                                Create first, then deliver your export\n                            </p>\n                        </div>\n                        <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[var(--teal)]/30 bg-[var(--teal)]/10 px-2 py-1 text-[10px] font-medium text-[var(--teal)]\" data-kid=\"1-2-1-2-4-1-2\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--teal)]\" data-kid=\"1-2-1-2-4-1-2-1\">\n                            </span>\n                            Ready\n                        </span>\n                    </div>\n                    <div class=\"vertical-rail px-3 py-2\" data-kid=\"1-2-1-2-4-2\">\n                        <div class=\"mb-1 flex items-center gap-2 px-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-2-1\">\n                            <span class=\"rail-dot h-2.5 w-2.5 rounded-full border border-[var(--blue)] bg-[var(--raised)]\" data-kid=\"1-2-1-2-4-2-1-1\">\n                            </span>\n                            Create\n                        </div>\n                        <button class=\"focus-ring relative flex w-full items-center gap-3 rounded-sm px-2 py-3 text-left transition-colors hover:bg-[var(--panel)]\" data-kid=\"1-2-1-2-4-2-2\" data-menu-item=\"generate\" role=\"menuitem\" title=\"Generate a new set of edits with AI\" type=\"button\">\n                            <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border border-[var(--blue)]/30 bg-[var(--blue)]/10 text-[var(--blue)]\" data-kid=\"1-2-1-2-4-2-2-1\">\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-4-2-2-1-1\" data-lucide=\"sparkles\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-4-2-2-2\">\n                                <span class=\"block text-[13px] font-medium text-[var(--text)]\" data-kid=\"1-2-1-2-4-2-2-2-1\">\n                                    Generate edits\n                                </span>\n                                <span class=\"mt-0.5 block truncate text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-2-2-2-2\">\n                                    Draft a fresh cut from this transcript\n                                </span>\n                            </span>\n                            <span class=\"rounded-full border border-[var(--blue)]/30 px-2 py-1 text-[10px] font-medium text-[var(--blue)]\" data-kid=\"1-2-1-2-4-2-2-3\">\n                                AI\n                            </span>\n                        </button>\n                        <div class=\"mb-1 mt-2 flex items-center gap-2 px-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-2-3\">\n                            <span class=\"rail-dot h-2.5 w-2.5 rounded-full border border-[var(--teal)] bg-[var(--raised)]\" data-kid=\"1-2-1-2-4-2-3-1\">\n                            </span>\n                            Delivery\n                        </div>\n                        <button class=\"focus-ring relative flex w-full items-center gap-3 rounded-sm px-2 py-3 text-left transition-colors hover:bg-[var(--panel)]\" data-kid=\"1-2-1-2-4-2-4\" data-menu-item=\"download\" role=\"menuitem\" title=\"Download the exported video file locally\" type=\"button\">\n                            <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border border-[var(--border)] bg-[var(--panel)] text-[var(--text)]\" data-kid=\"1-2-1-2-4-2-4-1\">\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-4-2-4-1-1\" data-lucide=\"download\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-4-2-4-2\">\n                                <span class=\"block text-[13px] font-medium text-[var(--text)]\" data-kid=\"1-2-1-2-4-2-4-2-1\">\n                                    Download video\n                                </span>\n                                <span class=\"mt-0.5 block truncate text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-2-4-2-2\">\n                                    Save MP4 and cover image locally\n                                </span>\n                            </span>\n                            <span class=\"rounded-full border border-[var(--teal)]/30 bg-[var(--teal)]/10 px-2 py-1 text-[10px] font-medium text-[var(--teal)]\" data-kid=\"1-2-1-2-4-2-4-3\">\n                                Ready\n                            </span>\n                        </button>\n                        <button class=\"focus-ring relative flex w-full items-center gap-3 rounded-sm px-2 py-3 text-left transition-colors hover:bg-[var(--panel)]\" data-kid=\"1-2-1-2-4-2-5\" data-menu-item=\"schedule\" role=\"menuitem\" title=\"View the publish schedule status\" type=\"button\">\n                            <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border border-[var(--border)] bg-[var(--panel)] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-2-5-1\">\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-4-2-5-1-1\" data-lucide=\"calendar-check-2\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-4-2-5-2\">\n                                <span class=\"block text-[13px] font-medium text-[var(--text)]\" data-kid=\"1-2-1-2-4-2-5-2-1\">\n                                    Publish schedule\n                                </span>\n                                <span class=\"mt-0.5 block truncate text-[11px] text-[var(--muted)]\" data-kid=\"1-2-1-2-4-2-5-2-2\">\n                                    Your export is queued for publishing\n                                </span>\n                            </span>\n                            <span class=\"rounded-full border border-[var(--teal)]/30 bg-[var(--teal)]/10 px-2 py-1 text-[10px] font-medium text-[var(--teal)]\" data-kid=\"1-2-1-2-4-2-5-3\">\n                                On schedule\n                            </span>\n                        </button>\n                    </div>\n                    <div aria-live=\"polite\" class=\"border-t border-[var(--border)] px-4 py-2.5 text-[11px] text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-4-3\" data-menu-feedback=\"\" data-name=\"menu feedback text\" data-reason=\"text replaced by menu interaction script\">\n                        Export exists · video and cover are ready\n                    </div>\n                </div>\n            </div>\n        </header>\n        <div class=\"flex h-[68px] items-center justify-between border-b border-[var(--border)] bg-[var(--panel)] px-5\" data-kid=\"1-2-2\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-2-1\">\n                <i class=\"h-4 w-4 shrink-0 text-[var(--muted)]\" data-kid=\"1-2-2-1-1\" data-lucide=\"file-video-2\">\n                </i>\n                <div class=\"min-w-0\" data-kid=\"1-2-2-1-2\">\n                    <span class=\"block truncate text-[14px] font-medium text-[var(--text)]\" data-kid=\"1-2-2-1-2-1\">\n                        Interview with Maya Chen\n                    </span>\n                    <span class=\"mt-0.5 block text-[11px] text-[var(--muted)]\" data-kid=\"1-2-2-1-2-2\">\n                        Transcript · 04:38 · 7 edit types\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-2-2-2\">\n                <div class=\"relative\" data-kid=\"1-2-2-2-1\">\n                    <button aria-controls=\"edit-visibility-popover\" aria-expanded=\"false\" aria-label=\"Edit visibility, 7 edit types\" class=\"focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-md border border-[var(--border)] bg-[var(--raised)] px-3 text-[12px] font-medium text-[var(--text)] transition-colors hover:border-[var(--muted)]\" data-kid=\"1-2-2-2-1-1\" data-visibility-trigger=\"\" title=\"Show or hide edit markers in the transcript\" type=\"button\">\n                        <i class=\"h-4 w-4 text-[var(--muted)]\" data-kid=\"1-2-2-2-1-1-1\" data-lucide=\"eye\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-1-1-2\">\n                            Edit visibility\n                        </span>\n                        <span class=\"rounded-full bg-[var(--panel)] px-1.5 py-0.5 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-2-2-1-1-3\">\n                            7\n                        </span>\n                        <span aria-hidden=\"true\" class=\"flex items-center gap-0.5\" data-kid=\"1-2-2-2-1-1-4\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--gold)]\" data-kid=\"1-2-2-2-1-1-4-1\">\n                            </span>\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--pink)]\" data-kid=\"1-2-2-2-1-1-4-2\">\n                            </span>\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--teal)]\" data-kid=\"1-2-2-2-1-1-4-3\">\n                            </span>\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--blue)]\" data-kid=\"1-2-2-2-1-1-4-4\">\n                            </span>\n                        </span>\n                        <i class=\"h-3.5 w-3.5 text-[var(--muted)]\" data-kid=\"1-2-2-2-1-1-5\" data-lucide=\"chevron-down\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Edit visibility\" class=\"popover-panel absolute right-0 top-[54px] z-20 w-[264px] overflow-hidden rounded-md border border-[var(--border)] bg-[var(--raised)] menu-shadow\" data-kid=\"1-2-2-2-1-2\" data-visibility-popover=\"\" hidden=\"\" id=\"edit-visibility-popover\" role=\"dialog\">\n                        <div class=\"flex items-center justify-between border-b border-[var(--border)] px-3 py-2.5\" data-kid=\"1-2-2-2-1-2-1\">\n                            <span class=\"text-[12px] font-semibold text-[var(--text)]\" data-kid=\"1-2-2-2-1-2-1-1\">\n                                Edit visibility\n                            </span>\n                            <button aria-label=\"Close edit visibility\" class=\"focus-ring rounded-sm p-1 text-[var(--muted)] hover:bg-[var(--panel)] hover:text-[var(--text)]\" data-kid=\"1-2-2-2-1-2-1-2\" data-visibility-close=\"\" type=\"button\">\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-2-1-2-1-2-1\" data-lucide=\"x\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"space-y-1 p-2\" data-kid=\"1-2-2-2-1-2-2\">\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-[12px] hover:bg-[var(--panel)]\" data-kid=\"1-2-2-2-1-2-2-1\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-1-1\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--gold)]\" data-kid=\"1-2-2-2-1-2-2-1-1-1\">\n                                    </span>\n                                    B-roll\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-2-2-1-2-2-1-2\">\n                                    1\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-[12px] hover:bg-[var(--panel)]\" data-kid=\"1-2-2-2-1-2-2-2\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-2-1\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--pink)]\" data-kid=\"1-2-2-2-1-2-2-2-1-1\">\n                                    </span>\n                                    VFX\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-2-2-1-2-2-2-2\">\n                                    7\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-[12px] hover:bg-[var(--panel)]\" data-kid=\"1-2-2-2-1-2-2-3\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-3-1\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--teal)]\" data-kid=\"1-2-2-2-1-2-2-3-1-1\">\n                                    </span>\n                                    SFX\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-2-2-1-2-2-3-2\">\n                                    14\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-[12px] hover:bg-[var(--panel)]\" data-kid=\"1-2-2-2-1-2-2-4\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-4-1\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[var(--blue)]\" data-kid=\"1-2-2-2-1-2-2-4-1-1\">\n                                    </span>\n                                    Zoom\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-2-2-1-2-2-4-2\">\n                                    10\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <span aria-hidden=\"true\" class=\"h-7 w-px bg-[var(--border)]\" data-kid=\"1-2-2-2-2\">\n                </span>\n                <div aria-label=\"Project tools\" class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-2-3\">\n                    <button aria-label=\"Open Captions inspector\" class=\"focus-ring inline-flex min-h-[44px] items-center gap-2 rounded-md bg-[var(--blue)]/12 px-3 text-[12px] font-semibold text-[var(--text)] ring-1 ring-inset ring-[var(--blue)]/35 transition-colors hover:bg-[var(--blue)]/20\" data-kid=\"1-2-2-2-3-1\" title=\"Open caption style inspector\" type=\"button\">\n                        <i class=\"h-4 w-4 text-[var(--blue)]\" data-kid=\"1-2-2-2-3-1-1\" data-lucide=\"captions\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-3-1-2\">\n                            Captions\n                        </span>\n                    </button>\n                    <button aria-label=\"Project settings\" class=\"focus-ring inline-flex min-h-[44px] w-11 items-center justify-center rounded-md text-[var(--muted)] transition-colors hover:bg-[var(--raised)] hover:text-[var(--text)]\" data-kid=\"1-2-2-2-3-2\" title=\"Open project settings\" type=\"button\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-2-2-3-2-1\" data-lucide=\"settings-2\">\n                        </i>\n                    </button>\n                    <span class=\"inline-flex min-h-[32px] items-center gap-1.5 rounded-full border border-[var(--border)] bg-[var(--raised)] px-2.5 text-[11px] font-medium text-[var(--muted)]\" data-kid=\"1-2-2-2-3-3\" title=\"All changes are saved\">\n                        <i class=\"h-3.5 w-3.5 text-[var(--teal)]\" data-kid=\"1-2-2-2-3-3-1\" data-lucide=\"check\">\n                        </i>\n                        Saved\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"grid h-[148px] grid-cols-[1.35fr_0.9fr] gap-px bg-[var(--border)]\" data-kid=\"1-2-3\">\n            <div class=\"bg-[var(--panel)] px-6 py-5\" data-kid=\"1-2-3-1\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-3-1-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-1\">\n                        Transcript workspace\n                    </span>\n                    <span class=\"text-[11px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-2\">\n                        00:42.18\n                    </span>\n                </div>\n                <div class=\"space-y-2.5 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"w-8 shrink-0 text-right text-[11px] text-[var(--border)]\" data-kid=\"1-2-3-1-2-1-1\">\n                            00:40\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-2\">\n                            When the cut feels intentional, the story gets easier to follow.\n                        </span>\n                    </div>\n                    <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-2\">\n                        <span class=\"w-8 shrink-0 text-right text-[11px] text-[var(--border)]\" data-kid=\"1-2-3-1-2-2-1\">\n                            00:42\n                        </span>\n                        <span class=\"text-[var(--text)]\" data-kid=\"1-2-3-1-2-2-2\">\n                            The editor should make the next action obvious.\n                        </span>\n                    </div>\n                    <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-3\">\n                        <span class=\"w-8 shrink-0 text-right text-[11px] text-[var(--border)]\" data-kid=\"1-2-3-1-2-3-1\">\n                            00:44\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-3-2\">\n                            Review the markers, refine captions, then export.\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"bg-[#0d1015] px-5 py-4\" data-kid=\"1-2-3-2\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--muted)]\" data-kid=\"1-2-3-2-1-1\">\n                        Preview\n                    </span>\n                    <span class=\"rounded-sm border border-[var(--border)] px-1.5 py-0.5 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-3-2-1-2\">\n                        9:16\n                    </span>\n                </div>\n                <div class=\"relative h-[84px] overflow-hidden rounded-sm border border-[var(--border)] bg-[#151c26]\" data-kid=\"1-2-3-2-2\">\n                    <div class=\"absolute inset-x-10 top-0 h-full bg-[#223346]\" data-kid=\"1-2-3-2-2-1\">\n                    </div>\n                    <div class=\"absolute bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-sm bg-black/60 px-2 py-1 text-[10px] font-semibold uppercase text-white\" data-kid=\"1-2-3-2-2-2\">\n                        the next action\n                    </div>\n                    <div class=\"absolute left-3 top-3 h-2 w-2 rounded-full bg-[var(--teal)]\" data-kid=\"1-2-3-2-2-3\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    (() => {\n    const menuTrigger = document.querySelector('[data-menu-trigger]');\n    const menu = document.querySelector('[data-menu]');\n    const menuChevron = document.querySelector('[data-menu-chevron]');\n    const inlineStatus = document.querySelector('[data-inline-status]');\n    const menuFeedback = document.querySelector('[data-menu-feedback]');\n    const visibilityTrigger = document.querySelector('[data-visibility-trigger]');\n    const visibilityPopover = document.querySelector('[data-visibility-popover]');\n\n    const setMenuOpen = (open) => {\n      menu.hidden = !open;\n      menuTrigger.setAttribute('aria-expanded', String(open));\n      menuChevron.setAttribute('data-lucide', open ? 'chevron-up' : 'chevron-down');\n      lucide.createIcons();\n    };\n\n    const showStatus = (message) => {\n      inlineStatus.textContent = message;\n      inlineStatus.classList.remove('hidden');\n      window.setTimeout(() => inlineStatus.classList.add('hidden'), 2600);\n    };\n\n    menuTrigger.addEventListener('click', (event) => {\n      event.stopPropagation();\n      setMenuOpen(menu.hidden);\n    });\n\n    document.querySelectorAll('[data-menu-item]').forEach((item) => {\n      item.addEventListener('click', () => {\n        const action = item.getAttribute('data-menu-item');\n        if (action === 'generate') {\n          menuFeedback.textContent = 'Generating edits… the menu will stay available.';\n          showStatus('Generating edits…');\n        } else if (action === 'download') {\n          menuFeedback.textContent = 'Download started · MP4 and cover image';\n          showStatus('Download started');\n          setMenuOpen(false);\n        } else {\n          menuFeedback.textContent = 'Already on schedule · no duplicate action needed';\n          showStatus('Already on schedule');\n        }\n      });\n    });\n\n    visibilityTrigger.addEventListener('click', (event) => {\n      event.stopPropagation();\n      const open = visibilityPopover.hidden;\n      visibilityPopover.hidden = !open;\n      visibilityTrigger.setAttribute('aria-expanded', String(open));\n    });\n\n    document.querySelector('[data-visibility-close]').addEventListener('click', () => {\n      visibilityPopover.hidden = true;\n      visibilityTrigger.setAttribute('aria-expanded', 'false');\n    });\n\n    document.addEventListener('click', (event) => {\n      if (!menu.contains(event.target) && !menuTrigger.contains(event.target)) setMenuOpen(false);\n      if (!visibilityPopover.contains(event.target) && !visibilityTrigger.contains(event.target)) {\n        visibilityPopover.hidden = true;\n        visibilityTrigger.setAttribute('aria-expanded', 'false');\n      }\n    });\n\n    document.querySelector('[data-export]').addEventListener('click', () => showStatus('Export queued to cloud'));\n    lucide.createIcons();\n  })();\n</script>\n",
