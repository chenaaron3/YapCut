    },
    "var_b34fdd8fed96": {
      "type": "variant",
      "label": "B · Status-led overflow",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  .toolbar-focus:focus-visible { outline: 2px solid #5b8cff; outline-offset: 2px; }\n  .delivery-menu[hidden], .visibility-menu[hidden] { display: none; }\n  .delivery-rail { position: relative; }\n  .delivery-rail::before { content: ''; position: absolute; left: 12px; top: 27px; bottom: 27px; width: 1px; background: #2e3444; }\n</style>\n<div class=\"min-h-[760px] w-full bg-[#12141a] p-6 font-[Inter,sans-serif] text-[#e8eaef]\" data-kid=\"1\" style=\"--panel:#1a1d26;--raised:#222632;--border:#2e3444;--muted:#8b93a7;--blue:#5b8cff;--gold:#c9a227;--pink:#fb7185;--teal:#2dd4bf;--purple:#a78bfa;\">\n    <div class=\"mb-3 flex items-center gap-2 px-1\" data-kid=\"1-1\">\n        <span class=\"text-[12px] font-semibold tracking-[0.12em]\" data-kid=\"1-1-1\">\n            B · Status-led split control\n        </span>\n        <span class=\"h-px w-10 bg-[#2e3444]\" data-kid=\"1-1-2\">\n        </span>\n        <span class=\"text-[11px] text-[#8b93a7]\" data-kid=\"1-1-3\">\n            AI is independent · delivery states stay together\n        </span>\n    </div>\n    <section aria-label=\"Editor toolbar redesign prototype\" class=\"relative z-30 overflow-visible rounded-md border border-[#2e3444] bg-[#1a1d26]\" data-kid=\"1-2\">\n        <header class=\"relative z-30 flex h-[72px] items-center justify-between border-b border-[#2e3444] px-5\" data-kid=\"1-2-1\" data-name=\"editor toolbar header container\">\n            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-1-1\">\n                <div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-[#2e3444] bg-[#222632] text-[#5b8cff]\" data-kid=\"1-2-1-1-1\">\n                    <i class=\"size-4\" data-kid=\"1-2-1-1-1-1\" data-lucide=\"play-square\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-2-1\">\n                        <span class=\"truncate text-[14px] font-semibold\" data-kid=\"1-2-1-1-2-1-1\">\n                            Talking head / Draft 04\n                        </span>\n                        <span class=\"rounded-sm border border-[#2e3444] px-1.5 py-0.5 text-[10px] uppercase tracking-[0.11em] text-[#8b93a7]\" data-kid=\"1-2-1-1-2-1-2\">\n                            Editor\n                        </span>\n                    </div>\n                    <div class=\"mt-1 flex items-center gap-2 text-xs text-[#8b93a7]\" data-kid=\"1-2-1-1-2-2\">\n                        <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-2-2-1\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-1-1-2-2-1-1\">\n                            </span>\n                            Export ready\n                        </span>\n                        <span class=\"text-[#2e3444]\" data-kid=\"1-2-1-1-2-2-2\">\n                            ·\n                        </span>\n                        <span data-kid=\"1-2-1-1-2-2-3\">\n                            1080 × 1920 · MP4\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative flex shrink-0 items-center gap-2\" data-kid=\"1-2-1-2\">\n                <span aria-live=\"polite\" class=\"mr-1 hidden max-w-[180px] truncate rounded-sm border border-[#2e3444] bg-[#222632] px-2.5 py-2 text-[11px] text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1\" data-name=\"inline status message\" data-reason=\"text and visibility toggled by script\" id=\"status-b\">\n                </span>\n                <button class=\"toolbar-focus inline-flex min-h-[44px] items-center gap-2 rounded-md border border-[#67568b] bg-[#241f32] px-4 text-[13px] font-medium hover:border-[#a78bfa] hover:bg-[#2d2540]\" data-kid=\"1-2-1-2-2\" id=\"ai-b\" title=\"Generate a new set of edits with AI\" type=\"button\">\n                    <i class=\"size-4 text-[#a78bfa]\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"sparkles\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        Generate edits\n                    </span>\n                </button>\n                <div class=\"relative flex items-stretch\" data-kid=\"1-2-1-2-3\">\n                    <button aria-label=\"Export video to the cloud\" class=\"toolbar-focus inline-flex min-h-[44px] items-center gap-2 rounded-l-md bg-[#5b8cff] px-4 text-[13px] font-semibold text-white hover:bg-[#6d9aff]\" data-kid=\"1-2-1-2-3-1\" id=\"export-b\" title=\"Create a cloud video asset\" type=\"button\">\n                        <i class=\"size-4\" data-kid=\"1-2-1-2-3-1-1\" data-lucide=\"cloud-upload\">\n                        </i>\n                        <span data-kid=\"1-2-1-2-3-1-2\">\n                            Export video\n                        </span>\n                    </button>\n                    <button aria-controls=\"delivery-menu-b\" aria-expanded=\"true\" aria-label=\"Open download and schedule actions\" class=\"toolbar-focus flex min-h-[44px] w-11 items-center justify-center rounded-r-md border-l border-white/25 bg-[#5b8cff] text-white hover:bg-[#6d9aff]\" data-kid=\"1-2-1-2-3-2\" id=\"delivery-toggle-b\" title=\"Download or schedule the exported video\" type=\"button\">\n                        <i class=\"size-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-2-1\" data-lucide=\"chevron-up\" data-name=\"delivery menu chevron icon\" data-reason=\"icon type attribute replaced by script on menu open/close\" id=\"delivery-chevron-b\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Delivery actions\" class=\"delivery-menu absolute right-0 top-[56px] w-[360px] overflow-hidden rounded-md border border-[#2e3444] bg-[#222632] shadow-[0_18px_46px_rgba(0,0,0,0.34)]\" data-kid=\"1-2-1-2-3-3\" data-name=\"delivery actions menu\" id=\"delivery-menu-b\" role=\"menu\">\n                        <div class=\"flex items-center justify-between border-b border-[#2e3444] px-4 py-3\" data-kid=\"1-2-1-2-3-3-1\">\n                            <div data-kid=\"1-2-1-2-3-3-1-1\">\n                                <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-1-2-3-3-1-1-1\">\n                                    Delivery actions\n                                </p>\n                                <p class=\"mt-0.5 text-[11px] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-1-1-2\">\n                                    Export once, then download or publish.\n                                </p>\n                            </div>\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#2dd4bf]/30 bg-[#2dd4bf]/10 px-2 py-1 text-[10px] font-medium text-[#2dd4bf]\" data-kid=\"1-2-1-2-3-3-1-2\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-1-2-3-3-1-2-1\">\n                                </span>\n                                Ready\n                            </span>\n                        </div>\n                        <div class=\"delivery-rail px-3 py-2\" data-kid=\"1-2-1-2-3-3-2\">\n                            <div class=\"mb-1 flex items-center gap-2 px-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-2-1\">\n                                <span class=\"relative z-10 h-2.5 w-2.5 rounded-full border border-[#2dd4bf] bg-[#222632]\" data-kid=\"1-2-1-2-3-3-2-1-1\">\n                                </span>\n                                Delivery\n                            </div>\n                            <button class=\"delivery-row toolbar-focus relative flex w-full items-center gap-3 rounded-sm px-2 py-3 text-left hover:bg-[#1a1d26]\" data-kid=\"1-2-1-2-3-3-2-2\" data-status=\"Download started · MP4 and cover image\" type=\"button\">\n                                <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border border-[#2e3444] bg-[#1a1d26] text-[#e8eaef]\" data-kid=\"1-2-1-2-3-3-2-2-1\">\n                                    <i class=\"size-4\" data-kid=\"1-2-1-2-3-3-2-2-1-1\" data-lucide=\"download\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-3-3-2-2-2\">\n                                    <span class=\"block text-[13px] font-medium\" data-kid=\"1-2-1-2-3-3-2-2-2-1\">\n                                        Download video\n                                    </span>\n                                    <span class=\"mt-0.5 block text-[11px] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-2-2-2-2\">\n                                        Save MP4 and cover image locally\n                                    </span>\n                                </span>\n                                <span class=\"rounded-full border border-[#2dd4bf]/30 bg-[#2dd4bf]/10 px-2 py-1 text-[10px] font-medium text-[#2dd4bf]\" data-kid=\"1-2-1-2-3-3-2-2-3\">\n                                    Ready\n                                </span>\n                            </button>\n                            <button class=\"delivery-row toolbar-focus relative flex w-full items-center gap-3 rounded-sm px-2 py-3 text-left hover:bg-[#1a1d26]\" data-kid=\"1-2-1-2-3-3-2-3\" data-status=\"Already on schedule · no duplicate action needed\" type=\"button\">\n                                <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border border-[#2e3444] bg-[#1a1d26] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-2-3-1\">\n                                    <i class=\"size-4\" data-kid=\"1-2-1-2-3-3-2-3-1-1\" data-lucide=\"calendar-check-2\">\n                                    </i>\n                                </span>\n                                <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-3-3-2-3-2\">\n                                    <span class=\"block text-[13px] font-medium\" data-kid=\"1-2-1-2-3-3-2-3-2-1\">\n                                        Schedule video\n                                    </span>\n                                    <span class=\"mt-0.5 block text-[11px] text-[#8b93a7]\" data-kid=\"1-2-1-2-3-3-2-3-2-2\">\n                                        Your export is queued for publishing\n                                    </span>\n                                </span>\n                                <span class=\"rounded-full border border-[#2dd4bf]/30 bg-[#2dd4bf]/10 px-2 py-1 text-[10px] font-medium text-[#2dd4bf]\" data-kid=\"1-2-1-2-3-3-2-3-3\">\n                                    On schedule\n                                </span>\n                            </button>\n                        </div>\n                        <div aria-live=\"polite\" class=\"border-t border-[#2e3444] px-4 py-2.5 text-[11px] text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-3-3\" data-name=\"delivery feedback text\" data-reason=\"text replaced by menu interaction script\" id=\"feedback-b\">\n                            Export exists · video and cover are ready\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <div class=\"flex h-[68px] items-center justify-between border-b border-[#2e3444] bg-[#1a1d26] px-5\" data-kid=\"1-2-2\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-2-1\">\n                <i class=\"size-4 shrink-0 text-[#8b93a7]\" data-kid=\"1-2-2-1-1\" data-lucide=\"file-video-2\">\n                </i>\n                <div class=\"min-w-0\" data-kid=\"1-2-2-1-2\">\n                    <span class=\"block truncate text-[14px] font-medium\" data-kid=\"1-2-2-1-2-1\">\n                        Interview with Maya Chen\n                    </span>\n                    <span class=\"mt-0.5 block text-[11px] text-[#8b93a7]\" data-kid=\"1-2-2-1-2-2\">\n                        Transcript · 04:38 · 7 edit types\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-2-2-2\">\n                <div class=\"relative\" data-kid=\"1-2-2-2-1\">\n                    <button aria-controls=\"visibility-menu-b\" aria-expanded=\"false\" aria-label=\"Edit visibility, 7 edit types\" class=\"toolbar-focus inline-flex min-h-[44px] items-center gap-2 rounded-md border border-[#2e3444] bg-[#222632] px-3 text-xs font-medium hover:border-[#8b93a7]\" data-kid=\"1-2-2-2-1-1\" id=\"visibility-toggle-b\" title=\"Show or hide edit markers in the transcript\" type=\"button\">\n                        <i class=\"size-4 text-[#8b93a7]\" data-kid=\"1-2-2-2-1-1-1\" data-lucide=\"eye\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-1-1-2\">\n                            Edit visibility\n                        </span>\n                        <span class=\"rounded-full bg-[#1a1d26] px-1.5 py-0.5 text-[10px] text-[#8b93a7]\" data-kid=\"1-2-2-2-1-1-3\">\n                            7\n                        </span>\n                        <span aria-hidden=\"true\" class=\"flex items-center gap-0.5\" data-kid=\"1-2-2-2-1-1-4\">\n                            <span class=\"size-1.5 rounded-full bg-[#c9a227]\" data-kid=\"1-2-2-2-1-1-4-1\">\n                            </span>\n                            <span class=\"size-1.5 rounded-full bg-[#fb7185]\" data-kid=\"1-2-2-2-1-1-4-2\">\n                            </span>\n                            <span class=\"size-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-2-2-1-1-4-3\">\n                            </span>\n                            <span class=\"size-1.5 rounded-full bg-[#3b82f6]\" data-kid=\"1-2-2-2-1-1-4-4\">\n                            </span>\n                        </span>\n                        <i class=\"size-3.5 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-5\" data-lucide=\"chevron-down\" data-name=\"visibility menu chevron icon\" data-reason=\"icon type attribute replaced by script on menu open/close\" id=\"visibility-chevron-b\">\n                        </i>\n                    </button>\n                    <div aria-label=\"Edit visibility\" class=\"visibility-menu absolute right-0 top-[54px] z-20 w-[264px] overflow-hidden rounded-md border border-[#2e3444] bg-[#222632] shadow-[0_16px_34px_rgba(0,0,0,0.3)]\" data-kid=\"1-2-2-2-1-2\" data-name=\"edit visibility popover\" hidden=\"\" id=\"visibility-menu-b\" role=\"dialog\">\n                        <div class=\"flex items-center justify-between border-b border-[#2e3444] px-3 py-2.5\" data-kid=\"1-2-2-2-1-2-1\">\n                            <span class=\"text-xs font-semibold\" data-kid=\"1-2-2-2-1-2-1-1\">\n                                Edit visibility\n                            </span>\n                            <button aria-label=\"Close edit visibility\" class=\"toolbar-focus rounded-sm p-1 text-[#8b93a7] hover:bg-[#1a1d26]\" data-kid=\"1-2-2-2-1-2-1-2\" title=\"Close edit visibility\" type=\"button\">\n                                <i class=\"size-3.5\" data-kid=\"1-2-2-2-1-2-1-2-1\" data-lucide=\"x\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"space-y-1 p-2\" data-kid=\"1-2-2-2-1-2-2\">\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-xs hover:bg-[#1a1d26]\" data-kid=\"1-2-2-2-1-2-2-1\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-1-1\">\n                                    <span class=\"size-2 rounded-full bg-[#c9a227]\" data-kid=\"1-2-2-2-1-2-2-1-1-1\">\n                                    </span>\n                                    B-roll\n                                </span>\n                                <span class=\"text-[#8b93a7]\" data-kid=\"1-2-2-2-1-2-2-1-2\">\n                                    1\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-xs hover:bg-[#1a1d26]\" data-kid=\"1-2-2-2-1-2-2-2\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-2-1\">\n                                    <span class=\"size-2 rounded-full bg-[#fb7185]\" data-kid=\"1-2-2-2-1-2-2-2-1-1\">\n                                    </span>\n                                    VFX\n                                </span>\n                                <span class=\"text-[#8b93a7]\" data-kid=\"1-2-2-2-1-2-2-2-2\">\n                                    7\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-xs hover:bg-[#1a1d26]\" data-kid=\"1-2-2-2-1-2-2-3\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-3-1\">\n                                    <span class=\"size-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-2-2-1-2-2-3-1-1\">\n                                    </span>\n                                    SFX\n                                </span>\n                                <span class=\"text-[#8b93a7]\" data-kid=\"1-2-2-2-1-2-2-3-2\">\n                                    14\n                                </span>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm px-2 py-2 text-xs hover:bg-[#1a1d26]\" data-kid=\"1-2-2-2-1-2-2-4\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-4-1\">\n                                    <span class=\"size-2 rounded-full bg-[#3b82f6]\" data-kid=\"1-2-2-2-1-2-2-4-1-1\">\n                                    </span>\n                                    Zoom\n                                </span>\n                                <span class=\"text-[#8b93a7]\" data-kid=\"1-2-2-2-1-2-2-4-2\">\n                                    10\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <span aria-hidden=\"true\" class=\"h-7 w-px bg-[#2e3444]\" data-kid=\"1-2-2-2-2\">\n                </span>\n                <div aria-label=\"Project tools\" class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-2-3\">\n                    <button class=\"toolbar-focus inline-flex min-h-[44px] items-center gap-2 rounded-md bg-[#5b8cff]/12 px-3 text-xs font-semibold text-[#e8eaef] ring-1 ring-inset ring-[#5b8cff]/35 hover:bg-[#5b8cff]/20\" data-kid=\"1-2-2-2-3-1\" title=\"Open caption style inspector\" type=\"button\">\n                        <i class=\"size-4 text-[#5b8cff]\" data-kid=\"1-2-2-2-3-1-1\" data-lucide=\"captions\">\n                        </i>\n                        <span data-kid=\"1-2-2-2-3-1-2\">\n                            Captions\n                        </span>\n                    </button>\n                    <button aria-label=\"Open project settings\" class=\"toolbar-focus inline-flex min-h-[44px] w-11 items-center justify-center rounded-md text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef]\" data-kid=\"1-2-2-2-3-2\" title=\"Open project settings\" type=\"button\">\n                        <i class=\"size-4\" data-kid=\"1-2-2-2-3-2-1\" data-lucide=\"settings-2\">\n                        </i>\n                    </button>\n                    <span class=\"inline-flex min-h-[32px] items-center gap-1.5 rounded-full border border-[#2e3444] bg-[#222632] px-2.5 text-[11px] font-medium text-[#8b93a7]\" data-kid=\"1-2-2-2-3-3\" title=\"All changes are saved\">\n                        <i class=\"size-3.5 text-[#2dd4bf]\" data-kid=\"1-2-2-2-3-3-1\" data-lucide=\"check\">\n                        </i>\n                        Saved\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"grid h-[148px] grid-cols-[1.35fr_0.9fr] gap-px bg-[#2e3444]\" data-kid=\"1-2-3\">\n            <div class=\"bg-[#1a1d26] px-6 py-5\" data-kid=\"1-2-3-1\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-3-1-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#8b93a7]\" data-kid=\"1-2-3-1-1-1\">\n                        Transcript workspace\n                    </span>\n                    <span class=\"text-[11px] text-[#8b93a7]\" data-kid=\"1-2-3-1-1-2\">\n                        00:42.18\n                    </span>\n                </div>\n                <div class=\"space-y-2.5 text-[13px] leading-5 text-[#8b93a7]\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-1\">\n                        <span class=\"w-8 shrink-0 text-right text-[11px] text-[#2e3444]\" data-kid=\"1-2-3-1-2-1-1\">\n                            00:40\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-2\">\n                            When the cut feels intentional, the story gets easier to follow.\n                        </span>\n                    </div>\n                    <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-2\">\n                        <span class=\"w-8 shrink-0 text-right text-[11px] text-[#2e3444]\" data-kid=\"1-2-3-1-2-2-1\">\n                            00:42\n                        </span>\n                        <span class=\"text-[#e8eaef]\" data-kid=\"1-2-3-1-2-2-2\">\n                            The editor should make the next action obvious.\n                        </span>\n                    </div>\n                    <div class=\"flex gap-3\" data-kid=\"1-2-3-1-2-3\">\n                        <span class=\"w-8 shrink-0 text-right text-[11px] text-[#2e3444]\" data-kid=\"1-2-3-1-2-3-1\">\n                            00:44\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-3-2\">\n                            Review markers, refine captions, then export.\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"bg-[#0d1015] px-5 py-4\" data-kid=\"1-2-3-2\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-3-2-1\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[0.14em] text-[#8b93a7]\" data-kid=\"1-2-3-2-1-1\">\n                        Preview\n                    </span>\n                    <span class=\"rounded-sm border border-[#2e3444] px-1.5 py-0.5 text-[10px] text-[#8b93a7]\" data-kid=\"1-2-3-2-1-2\">\n                        9:16\n                    </span>\n                </div>\n                <div class=\"relative h-[84px] overflow-hidden rounded-sm border border-[#2e3444] bg-[#151c26]\" data-kid=\"1-2-3-2-2\">\n                    <div class=\"absolute inset-x-10 top-0 h-full bg-[#223346]\" data-kid=\"1-2-3-2-2-1\">\n                    </div>\n                    <div class=\"absolute bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-sm bg-black/60 px-2 py-1 text-[10px] font-semibold uppercase text-white\" data-kid=\"1-2-3-2-2-2\">\n                        the next action\n                    </div>\n                    <div class=\"absolute left-3 top-3 h-2 w-2 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-3-2-2-3\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    (() => { lucide.createIcons(); const dt=document.getElementById('delivery-toggle-b'), dm=document.getElementById('delivery-menu-b'), dc=document.getElementById('delivery-chevron-b'), vt=document.getElementById('visibility-toggle-b'), vm=document.getElementById('visibility-menu-b'), vc=document.getElementById('visibility-chevron-b'), status=document.getElementById('status-b'), feedback=document.getElementById('feedback-b'); const setDelivery=(open)=>{dm.hidden=!open;dt.setAttribute('aria-expanded',String(open));dc.setAttribute('data-lucide',open?'chevron-up':'chevron-down');lucide.createIcons();}; const setVisibility=(open)=>{vm.hidden=!open;vt.setAttribute('aria-expanded',String(open));vc.setAttribute('data-lucide',open?'chevron-up':'chevron-down');lucide.createIcons();}; dt.addEventListener('click',(e)=>{e.stopPropagation();setDelivery(dm.hidden);}); vt.addEventListener('click',(e)=>{e.stopPropagation();setVisibility(vm.hidden);}); document.querySelectorAll('.delivery-row').forEach((row)=>row.addEventListener('click',()=>{const message=row.dataset.status||'Delivery action updated';status.textContent=message;status.classList.remove('hidden');feedback.textContent=message;setDelivery(false);})); document.getElementById('ai-b').addEventListener('click',()=>{status.textContent='AI edit pass queued';status.classList.remove('hidden');}); document.getElementById('export-b').addEventListener('click',()=>{status.textContent='Export queued to cloud';status.classList.remove('hidden');}); document.addEventListener('click',(e)=>{if(!dm.contains(e.target)&&!dt.contains(e.target))setDelivery(false);if(!vm.contains(e.target)&&!vt.contains(e.target))setVisibility(false);}); document.addEventListener('keydown',(e)=>{if(e.key==='Escape'){setDelivery(false);setVisibility(false);}}); })();\n</script>\n",
