      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"min-h-[420px] w-full overflow-visible bg-[#12141a] px-5 py-4 font-[Inter,sans-serif] text-[#e8eaef]\" data-kid=\"1\">\n    <div class=\"mb-2 flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-[#8b93a7]\" data-kid=\"1-1\">\n        <span class=\"h-1.5 w-1.5 rounded-full bg-[#5b8cff]\" data-kid=\"1-1-1\">\n        </span>\n        <span data-kid=\"1-1-2\">\n            A · Compact overflow\n        </span>\n        <span class=\"ml-1 normal-case tracking-normal text-[#596276]\" data-kid=\"1-1-3\">\n            delivery stays primary, utilities stay quiet\n        </span>\n    </div>\n    <section class=\"relative z-30 overflow-visible rounded-lg border border-[#2e3444] bg-[#1a1d26]\" data-kid=\"1-2\">\n        <header class=\"flex h-[72px] items-center justify-between border-b border-[#2e3444] px-5\" data-kid=\"1-2-1\">\n            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-1-1\">\n                <button aria-label=\"Back to projects\" class=\"flex size-10 shrink-0 items-center justify-center rounded-md border border-[#2e3444] text-[#8b93a7] hover:border-[#5b8cff] hover:text-[#e8eaef]\" data-kid=\"1-2-1-1-1\" title=\"Back to projects\">\n                    <i class=\"size-4\" data-kid=\"1-2-1-1-1-1\" data-lucide=\"arrow-left\" data-name=\"back arrow icon\">\n                    </i>\n                </button>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-2-1\">\n                        <span class=\"truncate text-sm font-semibold text-[#e8eaef]\" data-kid=\"1-2-1-1-2-1-1\">\n                            Talking head / launch cut\n                        </span>\n                        <span class=\"rounded-full border border-[#2e3444] bg-[#222632] px-2 py-0.5 text-[10px] font-medium text-[#8b93a7]\" data-kid=\"1-2-1-1-2-1-2\">\n                            Draft\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-xs text-[#8b93a7]\" data-kid=\"1-2-1-1-2-2\">\n                        1080 × 1920 · 00:42 · last edited just now\n                    </p>\n                </div>\n            </div>\n            <div class=\"relative flex items-center gap-2\" data-kid=\"1-2-1-2\">\n                <div aria-live=\"polite\" class=\"mr-2 hidden items-center gap-2 text-xs text-[#8b93a7] sm:flex\" data-kid=\"1-2-1-2-1\" data-name=\"action status indicator container\" id=\"action-status\">\n                    <span class=\"size-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"1-2-1-2-1-1\">\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2\" data-name=\"action status text\" data-reason=\"text updated when menu action is selected\" id=\"action-status-text\">\n                        Ready to export\n                    </span>\n                </div>\n                <button aria-controls=\"overflow-menu\" aria-expanded=\"true\" class=\"flex h-11 items-center gap-2 rounded-md border border-[#475065] bg-[#222632] px-4 text-sm font-medium text-[#e8eaef] hover:border-[#7180a0] hover:bg-[#2a3040]\" data-kid=\"1-2-1-2-2\" id=\"more-actions\" title=\"More project actions\" type=\"button\">\n                    <i class=\"size-4 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"ellipsis\" data-name=\"more actions ellipsis icon\" data-reason=\"icon replaced by script on click\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        More actions\n                    </span>\n                    <i class=\"size-4 text-[#8b93a7]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-3\" data-lucide=\"chevron-down\" data-name=\"more actions chevron icon\" data-reason=\"icon replaced by script on click\" id=\"more-chevron\">\n                    </i>\n                </button>\n                <button class=\"flex h-11 items-center gap-2 rounded-md bg-[#5b8cff] px-5 text-sm font-semibold text-white shadow-[0_4px_14px_rgba(91,140,255,0.18)] hover:bg-[#6d9aff]\" data-kid=\"1-2-1-2-3\" title=\"Export the video to the cloud\" type=\"button\">\n                    <i class=\"size-4\" data-kid=\"1-2-1-2-3-1\" data-lucide=\"cloud-upload\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-3-2\">\n                        Export video\n                    </span>\n                </button>\n                <div aria-label=\"More project actions\" class=\"absolute right-[118px] top-[60px] w-[300px] rounded-lg border border-[#3a4255] bg-[#1a1d26] p-2 shadow-[0_18px_40px_rgba(0,0,0,0.34)]\" data-kid=\"1-2-1-2-4\" data-name=\"more actions overflow menu\" id=\"overflow-menu\" role=\"menu\">\n                    <div class=\"flex items-center justify-between px-3 pb-2 pt-1\" data-kid=\"1-2-1-2-4-1\">\n                        <span class=\"text-[11px] font-semibold uppercase tracking-[0.12em] text-[#8b93a7]\" data-kid=\"1-2-1-2-4-1-1\">\n                            More actions\n                        </span>\n                        <span class=\"rounded-full border border-[#2e3444] px-2 py-0.5 text-[10px] text-[#596276]\" data-kid=\"1-2-1-2-4-1-2\">\n                            ⌘ K\n                        </span>\n                    </div>\n                    <div class=\"border-t border-[#2e3444] pt-2\" data-kid=\"1-2-1-2-4-2\">\n                        <p class=\"px-3 pb-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#596276]\" data-kid=\"1-2-1-2-4-2-1\">\n                            Create\n                        </p>\n                        <button class=\"menu-row flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left hover:bg-[#222632]\" data-kid=\"1-2-1-2-4