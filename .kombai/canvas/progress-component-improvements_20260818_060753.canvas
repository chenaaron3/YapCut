      "html": "<div class=\"min-h-[760px] w-full bg-[#450E16] p-6 text-[#F5F9CE]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Cormorant Garamond',Georgia,serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n    @keyframes ember-live-pulse {\n      0%, 100% { box-shadow: 0 0 0 0 rgba(255,161,2,.32); }\n      50% { box-shadow: 0 0 0 7px rgba(255,161,2,0); }\n    }\n    @keyframes ember-signal-shimmer {\n      0%, 14% { background-position: 140% 0; }\n      32%, 100% { background-position: -40% 0; }\n    }\n    .broadcast-live-pulse { animation: ember-live-pulse 1.8s ease-out infinite; }\n    .broadcast-shimmer {\n      background-image: linear-gradient(90deg, transparent 0%, rgba(245,249,206,.2) 48%, rgba(255,161,2,.55) 50%, rgba(245,249,206,.2) 52%, transparent 100%);\n      background-size: 220% 100%;\n      animation: ember-signal-shimmer 4.2s ease-in-out infinite;\n    }\n    @media (prefers-reduced-motion: reduce) {\n      .broadcast-live-pulse, .broadcast-shimmer { animation: none; }\n    }\n    </style>\n    <main class=\"mx-auto flex min-h-[708px] w-full max-w-[436px] items-center justify-center\" data-kid=\"1-1\" data-name=\"main content wrapper\">\n        <section aria-labelledby=\"broadcast-title\" class=\"w-full overflow-hidden rounded-[24px] border-2 border-[#450E16] bg-[#F5F9CE] text-[#450E16] shadow-[9px_10px_0_#000]\" data-kid=\"1-1-1\" data-name=\"broadcast status dashboard card\">\n            <div class=\"relative overflow-hidden px-6 pt-6 pb-7 sm:px-7\" data-kid=\"1-1-1-1\" data-name=\"dashboard header area\">\n                <div aria-hidden=\"true\" class=\"pointer-events-none absolute -top-16 right-[-70px] h-44 w-44 rounded-full bg-[#FFA102]/15 blur-3xl\" data-kid=\"1-1-1-1-1\" data-name=\"decorative glow orb\">\n                </div>\n                <div class=\"relative flex items-center justify-between gap-3\" data-kid=\"1-1-1-1-2\" data-name=\"status badge container\">\n                    <p class=\"m-0 font-mono text-[10px] font-semibold tracking-[.22em] text-[#DD5533] uppercase\" data-kid=\"1-1-1-1-2-1\" data-name=\"create label text\">\n                        CREATE\n                    </p>\n                    <div class=\"flex items-center gap-2 rounded-full border border-[#450E16]/20 bg-[#450E16]/[.04] px-2.5 py-1.5\" data-kid=\"1-1-1-1-2-2\" data-name=\"live status indicator\">\n                        <span aria-hidden=\"true\" class=\"grid size-4 place-items-center rounded-full bg-[#FFA102] text-[#450E16]\" data-kid=\"1-1-1-1-2-2-1\" data-name=\"radio icon background\">\n                            <i class=\"size-2.5\" data-kid=\"1-1-1-1-2-2-1-1\" data-lucide=\"radio\" data-name=\"radio icon\" style=\"width:10px;height:10px;stroke-width:2.5\">\n                            </i>\n                        </span>\n                        <span class=\"font-mono text-[9px] font-semibold tracking-[.12em] text-[#432E6F] uppercase\" data-kid=\"1-1-1-1-2-2-2\" data-name=\"live status label text\">\n                            LIVE\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative mt-5 flex items-end justify-between gap-4\" data-kid=\"1-1-1-1-3\" data-name=\"headline and global progress area\">\n                    <h1 class=\"m-0 max-w-[225px] text-[clamp(2.9rem,13vw,4.3rem)] font-bold leading-[.78] tracking-[-.065em]\" data-kid=\"1-1-1-1-3-1\" data-name=\"broadcast title\" id=\"broadcast-title\">\n                        Building your\n                        <br data-kid=\"1-1-1-1-3-1-1\" data-name=\"title line break\"/>\n                        edit\n                    </h1>\n                    <div aria-label=\"Overall edit creation progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"38\" class=\"shrink-0 text-right\" data-dynamic=\"true\" data-kid=\"1-1-1-1-3-2\" data-name=\"overall progress indicator\" data-reason=\"progress percentage text updated by script\" role=\"progressbar\">\n                        <p class=\"m-0 text-[clamp(3.3rem,16vw,5rem)] font-semibold leading-[.74] tracking-[-.06em] text-[#DD5533] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-1-1-1-3-2-1\" data-name=\"overall progress percentage text\" data-reason=\"text updated to match current progress\">\n                            38%\n                        </p>\n                        <p class=\"mt-2 mb-0 font-mono text-[8px] font-semibold tracking-[.1em] text-[#432E6F]/70 uppercase\" data-kid=\"1-1-1-1-3-2-2\" data-name=\"global progress label text\">\n                            global progress\n                        </p>\n                    </div>\n                </div>\n                <div aria-hidden=\"true\" class=\"mt-7\" data-kid=\"1-1-1-1-4\" data-name=\"overall pipeline progress bar\">\n                    <div class=\"h-2 overflow-hidden rounded-full bg-[#450E16]/15\" data-kid=\"1-1-1-1-4-1\" data-name=\"progress bar track\">\n                        <div class=\"broadcast-shimmer h-full w-[38%] rounded-full bg-[#FFA102]\" data-dynamic=\"true\" data-kid=\"1-1-1-1-4-1-1\" data-name=\"progress bar fill\" data-reason=\"width updated by script to reflect progress percentage\">\n                        </div>\n                    </div>\n                    <div class=\"mt-2 flex items-center justify-between font-mono text-[8px] tracking-[.12em] text-[#432E6F]/65 uppercase\" data-kid=\"1-1-1-1-4-2\" data-name=\"progress details text\">\n                        <span data-kid=\"1-1-1-1-4-2-1\" data-name=\"pipeline label text\">\n                            overall pipeline\n                        </span>\n                        <span data-dynamic=\"true\" data-kid=\"1-1-1-1-4-2-2\" data-name=\"pipeline status count text\" data-reason=\"text updated to match progress ratio\">\n                            38 / 100\n                        </span>\n                    </div>\n                </div>\n                <div aria-live=\"polite\" class=\"mt-6 flex items-start gap-3 border-l-2 border-[#FFA102] pl-3\" data-kid=\"1-1-1-1-5\" data-name=\"current activity alert\">\n                    <span aria-hidden=\"true\" class=\"mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-[#FFA102] text-[#450E16]\" data-kid=\"1-1-1-1-5-1\" data-name=\"activity icon background\">\n                        <i class=\"size-3.5\" data-kid=\"1-1-1-1-5-1-1\" data-lucide=\"audio-lines\" data-name=\"activity icon\" style=\"width:14px;height:14px;stroke-width:2.3\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-1-1-1-5-2\" data-name=\"activity details container\">\n                        <p class=\"m-0 font-mono text-[9px] font-semibold tracking-[.15em] text-[#DD5533] uppercase\" data-kid=\"1-1-1-1-5-2-1\" data-name=\"current activity label\">\n                            NOW · MEDIA\n                        </p>\n                        <p class=\"mt-1 mb-0 text-[1.2rem] leading-none text-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-1-1-5-2-2\" data-name=\"current activity status text\" data-reason=\"status text updated by script\">\n                            Transcribing audio…\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"border-t-2 border-[#450E16]/10 px-6 pt-5 pb-6 sm:px-7\" data-kid=\"1-1-1-2\" data-name=\"pipeline stages section\">\n                <div class=\"mb-5 flex items-center justify-between gap-3\" data-kid=\"1-1-1-2-1\" data-name=\"stages section header\">\n                    <p class=\"m-0 font-mono text-[9px] font-semibold tracking-[.18em] text-[#432E6F] uppercase\" data-kid=\"1-1-1-2-1-1\" data-name=\"pipeline label\">\n                        PROCESS SIGNAL\n                    </p>\n                    <p class=\"m-0 font-mono text-[8px] tracking-[.12em] text-[#432E6F]/60 uppercase\" data-kid=\"1-1-1-2-1-2\" data-name=\"pipeline type description\">\n                        2-stage pipeline\n                    </p>\n                </div>\n                <ol aria-label=\"Edit creation stages\" class=\"relative m-0 list-none space-y-5 p-0\" data-kid=\"1-1-1-2-2\" data-name=\"stages list\">\n                    <span aria-hidden=\"true\" class=\"absolute top-5 bottom-5 left-[15px] w-px bg-[#450E16]/15\" data-kid=\"1-1-1-2-2-1\" data-name=\"stages vertical background track\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"absolute top-5 left-[15px] h-[104px] w-px bg-[#FFA102]\" data-kid=\"1-1-1-2-2-2\" data-name=\"stages active indicator track\">\n                    </span>\n                    <li class=\"relative flex gap-4\" data-kid=\"1-1-1-2-2-3\" data-name=\"transcribe stage item\">\n                        <div class=\"broadcast-live-pulse relative z-10 grid size-8 shrink-0 place-items-center rounded-full border-2 border-[#FFA102] bg-[#FFA102] text-[#450E16]\" data-kid=\"1-1-1-2-2-3-1\" data-name=\"transcribe stage icon container\">\n                            <i class=\"size-4\" data-kid=\"1-1-1-2-2-3-1-1\" data-lucide=\"audio-lines\" data-name=\"transcribe stage icon\" style=\"width:16px;height:16px;stroke-width:2.3\">\n                            </i>\n                        </div>\n                        <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-1-1-2-2-3-2\" data-name=\"transcribe stage details\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-1-2-2-3-2-1\" data-name=\"transcribe stage header\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-1-2-2-3-2-1-1\" data-name=\"transcribe stage title container\">\n                                    <p class=\"m-0 font-mono text-[8px] font-semibold tracking-[.16em] text-[#DD5533] uppercase\" data-kid=\"1-1-1-2-2-3-2-1-1-1\" data-name=\"transcribe stage status label\">\n                                        NOW\n                                    </p>\n                                    <h2 class=\"mt-1 mb-0 text-[1.45rem] font-semibold leading-none\" data-kid=\"1-1-1-2-2-3-2-1-1-2\" data-name=\"transcribe stage name\">\n                                        Transcribe\n                                    </h2>\n                                </div>\n                                <span class=\"shrink-0 rounded-full border border-[#FFA102]/60 bg-[#FFA102]/12 px-2 py-1 font-mono text-[9px] font-semibold tracking-[.06em] text-[#450E16] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-3-2-1-2\" data-name=\"transcribe progress label\" data-reason=\"progress label updated by script\">\n                                    63% local\n                                </span>\n                            </div>\n                            <div aria-label=\"Transcribe stage progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"63\" class=\"mt-3 h-1.5 overflow-hidden rounded-full bg-[#450E16]/10\" data-kid=\"1-1-1-2-2-3-2-2\" data-name=\"transcribe progress bar\" role=\"progressbar\">\n                                <div class=\"broadcast-shimmer h-full w-[63%] rounded-full bg-[#FFA102]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-3-2-2-1\" data-name=\"transcribe progress bar fill\" data-reason=\"width updated by script\">\n                                </div>\n                            </div>\n                            <div class=\"mt-2 flex items-center justify-between font-mono text-[8px] tracking-[.1em] text-[#432E6F]/60 uppercase\" data-kid=\"1-1-1-2-2-3-2-3\" data-name=\"transcribe progress footer\">\n                                <span data-kid=\"1-1-1-2-2-3-2-3-1\" data-name=\"transcribe stage label\">\n                                    current stage\n                                </span>\n                                <span data-dynamic=\"true\" data-kid=\"1-1-1-2-2-3-2-3-2\" data-name=\"transcribe progress count\" data-reason=\"count text updated by script\">\n                                    media · 63 / 100\n                                </span>\n                            </div>\n                        </div>\n                    </li>\n                    <li class=\"relative flex gap-4\" data-kid=\"1-1-1-2-2-4\" data-name=\"ai analysis stage item\">\n                        <div class=\"relative z-10 grid size-8 shrink-0 place-items-center rounded-full border-2 border-[#450E16]/20 bg-[#F5F9CE] text-[#432E6F]/55\" data-kid=\"1-1-1-2-2-4-1\" data-name=\"ai analysis stage icon container\">\n                            <i class=\"size-4\" data-kid=\"1-1-1-2-2-4-1-1\" data-lucide=\"sparkles\" data-name=\"ai analysis stage icon\" style=\"width:16px;height:16px;stroke-width:2\">\n                            </i>\n                        </div>\n                        <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-1-1-2-2-4-2\" data-name=\"ai analysis stage details\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-1-2-2-4-2-1\" data-name=\"ai analysis stage header\">\n                                <div class=\"min-w-0\" data-kid=\"1-1-1-2-2-4-2-1-1\" data-name=\"ai analysis stage title container\">\n                                    <p class=\"m-0 font-mono text-[8px] font-semibold tracking-[.16em] text-[#432E6F]/55 uppercase\" data-kid=\"1-1-1-2-2-4-2-1-1-1\" data-name=\"ai analysis stage status label\">\n                                        NEXT\n                                    </p>\n                                    <h2 class=\"mt-1 mb-0 text-[1.45rem] font-semibold leading-none text-[#432E6F]/70\" data-kid=\"1-1-1-2-2-4-2-1-1-2\" data-name=\"ai analysis stage name\">\n                                        AI analysis\n                                    </h2>\n                                </div>\n                                <span class=\"shrink-0 rounded-full border border-[#450E16]/15 px-2 py-1 font-mono text-[9px] tracking-[.06em] text-[#432E6F]/65 uppercase\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-4-2-1-2\" data-name=\"ai analysis progress label\" data-reason=\"label text updated by script\">\n                                    Waiting\n                                </span>\n                            </div>\n                            <div aria-label=\"AI analysis stage progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"0\" class=\"mt-3 h-1.5 overflow-hidden rounded-full bg-[#450E16]/[.07]\" data-kid=\"1-1-1-2-2-4-2-2\" data-name=\"ai analysis progress bar\" role=\"progressbar\">\n                                <div class=\"h-full w-0 rounded-full bg-[#FFA102]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-4-2-2-1\" data-name=\"ai analysis progress bar fill\" data-reason=\"width updated by script\">\n                                </div>\n                            </div>\n                            <div class=\"mt-2 flex items-center justify-between font-mono text-[8px] tracking-[.1em] text-[#432E6F]/50 uppercase\" data-kid=\"1-1-1-2-2-4-2-3\" data-name=\"ai analysis progress footer\">\n                                <span data-kid=\"1-1-1-2-2-4-2-3-1\" data-name=\"ai analysis stage label\">\n                                    queued next\n                                </span>\n                                <span data-dynamic=\"true\" data-kid=\"1-1-1-2-2-4-2-3-2\" data-name=\"ai analysis progress count\" data-reason=\"count text updated by script\">\n                                    ai_analysis · 0 / 100\n                                </span>\n                            </div>\n                        </div>\n                    </li>\n                </ol>\n            </div>\n            <div class=\"flex items-center justify-between gap-3 border-t-2 border-[#450E16]/10 bg-[#450E16]/[.035] px-6 py-3.5 sm:px-7\" data-kid=\"1-1-1-3\" data-name=\"dashboard footer\">\n                <span class=\"font-mono text-[8px] font-semibold tracking-[.16em] text-[#432E6F] uppercase\" data-kid=\"1-1-1-3-1\" data-name=\"pipeline status title\">\n                    LIVE PIPELINE\n                </span>\n                <span class=\"flex items-center gap-1.5 font-mono text-[8px] tracking-[.1em] text-[#432E6F]/60 uppercase\" data-kid=\"1-1-1-3-2\" data-name=\"connection status indicator\">\n                    <span class=\"size-1.5 rounded-full bg-[#FFA102]\" data-kid=\"1-1-1-3-2-1\" data-name=\"connection dot indicator\">\n                    </span>\n                    connected\n                </span>\n            </div>\n        </section>\n    </main>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        lucide.createIcons({attrs:{'aria-hidden':'true'}});\n    </script>\n</div>\n",
