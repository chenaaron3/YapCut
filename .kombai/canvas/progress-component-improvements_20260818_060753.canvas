      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n  .font-cormorant { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .font-jetbrains { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n  @keyframes focus-pulse {\n    0%, 100% { opacity: .45; transform: scale(1); }\n    50% { opacity: 1; transform: scale(1.18); }\n  }\n  .focus-pulse { animation: focus-pulse 1.8s ease-in-out infinite; }\n  @media (prefers-reduced-motion: reduce) {\n    .focus-pulse { animation: none; opacity: 1; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    window.addEventListener('load', function () { if (window.lucide) window.lucide.createIcons(); });\n</script>\n<main class=\"flex min-h-[760px] w-full items-center justify-center bg-[#450E16] px-5 py-8 text-[#450E16]\" data-kid=\"1\" data-name=\"progress dashboard main container\">\n    <section aria-labelledby=\"progress-title\" aria-live=\"polite\" class=\"relative w-full max-w-[416px] overflow-hidden rounded-[24px] border-2 border-[#450E16] bg-[#F5F9CE] shadow-[8px_9px_0_#000]\" data-kid=\"1-1\" data-name=\"progress card\">\n        <div aria-hidden=\"true\" class=\"pointer-events-none absolute -top-20 right-[-55px] h-[220px] w-[220px] rounded-full bg-[#FFA102]/10 blur-2xl\" data-kid=\"1-1-1\" data-name=\"decorative blurred orb\">\n        </div>\n        <div class=\"relative border-b border-[#450E16]/15 px-6 pt-7 pb-5 sm:px-7\" data-kid=\"1-1-2\" data-name=\"progress card header\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-2-1\" data-name=\"header top row\">\n                <p class=\"font-jetbrains m-0 text-[10px] font-semibold tracking-[.22em] text-[#DD5533] uppercase\" data-kid=\"1-1-2-1-1\" data-name=\"status label\">\n                    Create\n                </p>\n                <span class=\"font-jetbrains rounded-full border border-[#432E6F]/30 px-2.5 py-1.5 text-[9px] font-semibold tracking-[.12em] text-[#432E6F] uppercase\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"page counter label\" data-reason=\"value updated by script\">\n                    1 of 2\n                </span>\n            </div>\n            <div class=\"mt-3 flex items-end justify-between gap-4\" data-kid=\"1-1-2-2\" data-name=\"header main row\">\n                <h1 class=\"font-cormorant m-0 max-w-[235px] text-[clamp(2.65rem,11vw,3.7rem)] font-semibold leading-[.86] tracking-[-.045em]\" data-kid=\"1-1-2-2-1\" data-name=\"main title\" id=\"progress-title\">\n                    Building your edit\n                </h1>\n                <div class=\"shrink-0 text-right\" data-kid=\"1-1-2-2-2\" data-name=\"overall progress indicator group\">\n                    <p class=\"font-jetbrains m-0 text-[9px] font-semibold tracking-[.14em] text-[#432E6F]/65 uppercase\" data-kid=\"1-1-2-2-2-1\" data-name=\"overall label\">\n                        Overall\n                    </p>\n                    <p class=\"font-cormorant m-0 mt-0.5 text-[3.25rem] font-semibold leading-none tracking-[-.06em] text-[#DD5533]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-2\" data-name=\"overall percentage text\" data-reason=\"value updated by script\">\n                        38%\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-5\" data-kid=\"1-1-2-3\" data-name=\"overall progress bar container\">\n                <div aria-label=\"Overall create progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"38\" aria-valuetext=\"38 percent overall\" class=\"h-1.5 overflow-hidden rounded-full bg-[#450E16]/15\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1\" data-name=\"overall progress bar\" data-reason=\"aria attributes and width updated by script\" role=\"progressbar\">\n                    <div class=\"h-full w-[38%] rounded-full bg-[#FFA102]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-1\" data-name=\"overall progress bar fill\" data-reason=\"width updated by script\">\n                    </div>\n                </div>\n                <div class=\"mt-2 flex items-center justify-between gap-3\" data-kid=\"1-1-2-3-2\" data-name=\"progress detail text group\">\n                    <p aria-live=\"polite\" class=\"font-cormorant m-0 text-[1.05rem] leading-tight text-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2-1\" data-name=\"status message\" data-reason=\"text updated by script\">\n                        Transcribing audio…\n                    </p>\n                    <span class=\"font-jetbrains text-[8px] tracking-[.12em] text-[#432E6F]/55 uppercase\" data-kid=\"1-1-2-3-2-2\" data-name=\"processing state label\">\n                        processing\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"px-6 py-5 sm:px-7 sm:py-6\" data-kid=\"1-1-3\" data-name=\"task steps container\">\n            <article class=\"relative overflow-hidden rounded-[20px] border-2 border-[#450E16] bg-[#FFFBD9] p-4 shadow-[4px_5px_0_rgba(69,14,22,.16)] sm:p-5\" data-kid=\"1-1-3-1\" data-name=\"active task step card\">\n                <div aria-hidden=\"true\" class=\"absolute inset-x-0 top-0 h-1 bg-[#FFA102]\" data-kid=\"1-1-3-1-1\" data-name=\"active step indicator line\">\n                </div>\n                <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-3-1-2\" data-name=\"active step info row\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-3-1-2-1\" data-name=\"active step icon container\">\n                        <span class=\"grid size-11 shrink-0 place-items-center rounded-full border border-[#FFA102] bg-[#FFA102]/20 text-[#DD5533]\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"icon wrapper\">\n                            <i aria-hidden=\"true\" class=\"size-5\" data-kid=\"1-1-3-1-2-1-1-1\" data-lucide=\"audio-lines\" data-name=\"audio lines icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-1-3-1-2-1-2\" data-name=\"active step label group\">\n                            <p class=\"font-jetbrains m-0 text-[9px] font-semibold tracking-[.16em] text-[#DD5533] uppercase\" data-kid=\"1-1-3-1-2-1-2-1\" data-name=\"now creating label\">\n                                Now creating\n                            </p>\n                            <p class=\"font-cormorant m-0 mt-0.5 text-[1.65rem] font-semibold leading-none\" data-kid=\"1-1-3-1-2-1-2-2\" data-name=\"step name\">\n                                Transcribe\n                            </p>\n                        </div>\n                    </div>\n                    <span aria-label=\"Transcribe is currently active\" class=\"relative grid size-3 place-items-center\" data-kid=\"1-1-3-1-2-2\" data-name=\"active status pulse\">\n                        <span class=\"focus-pulse absolute size-3 rounded-full bg-[#FFA102]\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"pulse circle outer\">\n                        </span>\n                        <span class=\"relative size-1.5 rounded-full bg-[#450E16]\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"pulse circle inner\">\n                        </span>\n                    </span>\n                </div>\n                <div class=\"mt-5 flex items-end justify-between gap-3\" data-kid=\"1-1-3-1-3\" data-name=\"active step progress detail row\">\n                    <p class=\"font-cormorant m-0 text-[1.15rem] leading-tight text-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-3-1\" data-name=\"active step status message\" data-reason=\"text updated by script\">\n                        Transcribing audio…\n                    </p>\n                    <p class=\"font-cormorant m-0 text-[2.35rem] font-semibold leading-none tracking-[-.04em] text-[#DD5533]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-3-2\" data-name=\"active step percentage text\" data-reason=\"value updated by script\">\n                        63%\n                    </p>\n                </div>\n                <div aria-label=\"Transcribe progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"63\" aria-valuetext=\"63 percent transcribed\" class=\"mt-3 h-3 overflow-hidden rounded-full bg-[#450E16]/10\" data-dynamic=\"true\" data-kid=\"1-1-3-1-4\" data-name=\"active step progress bar\" data-reason=\"aria attributes and width updated by script\" role=\"progressbar\">\n                    <div class=\"h-full w-[63%] rounded-full bg-[#FFA102]\" data-dynamic=\"true\" data-kid=\"1-1-3-1-4-1\" data-name=\"active step progress bar fill\" data-reason=\"width updated by script\">\n                    </div>\n                </div>\n                <div class=\"mt-3 flex items-center justify-between gap-3\" data-kid=\"1-1-3-1-5\" data-name=\"active step footer\">\n                    <span class=\"font-jetbrains text-[8px] tracking-[.13em] text-[#432E6F]/60 uppercase\" data-kid=\"1-1-3-1-5-1\" data-name=\"stage label\">\n                        Stage 01\n                    </span>\n                    <span class=\"font-jetbrains text-[8px] font-semibold tracking-[.13em] text-[#FFA102] uppercase\" data-dynamic=\"true\" data-kid=\"1-1-3-1-5-2\" data-name=\"status label\" data-reason=\"text updated by script\">\n                        In progress\n                    </span>\n                </div>\n            </article>\n            <div aria-hidden=\"true\" class=\"ml-[22px] h-4 w-px bg-[#450E16]/20\" data-kid=\"1-1-3-2\" data-name=\"step connector line\">\n            </div>\n            <article class=\"rounded-[20px] border border-[#450E16]/18 bg-[#F5F9CE] p-4 sm:p-5\" data-kid=\"1-1-3-3\" data-name=\"queued task step card\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-3-3-1\" data-name=\"queued step info row\">\n                    <span class=\"grid size-11 shrink-0 place-items-center rounded-full border border-[#450E16]/20 text-[#432E6F]/65\" data-kid=\"1-1-3-3-1-1\" data-name=\"queued step icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"size-5\" data-kid=\"1-1-3-3-1-1-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-1-3-3-1-2\" data-name=\"queued step content container\">\n                        <div class=\"flex items-baseline justify-between gap-3\" data-kid=\"1-1-3-3-1-2-1\" data-name=\"queued step top row\">\n                            <div data-kid=\"1-1-3-3-1-2-1-1\" data-name=\"queued step label group\">\n                                <p class=\"font-jetbrains m-0 text-[9px] font-semibold tracking-[.16em] text-[#432E6F]/55 uppercase\" data-kid=\"1-1-3-3-1-2-1-1-1\" data-name=\"up next label\">\n                                    Up next\n                                </p>\n                                <p class=\"font-cormorant m-0 mt-0.5 text-[1.65rem] font-semibold leading-none text-[#432E6F]/70\" data-kid=\"1-1-3-3-1-2-1-1-2\" data-name=\"queued step name\">\n                                    AI analysis\n                                </p>\n                            </div>\n                            <span class=\"font-cormorant shrink-0 text-[1.2rem] text-[#432E6F]/55\" data-dynamic=\"true\" data-kid=\"1-1-3-3-1-2-1-2\" data-name=\"queued step status label\" data-reason=\"text updated by script\">\n                                Waiting\n                            </span>\n                        </div>\n                        <div aria-label=\"AI analysis progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"0\" aria-valuetext=\"Waiting to start\" class=\"mt-4 h-1 overflow-hidden rounded-full bg-[#450E16]/10\" data-dynamic=\"true\" data-kid=\"1-1-3-3-1-2-2\" data-name=\"queued step progress bar\" data-reason=\"aria attributes updated by script\" role=\"progressbar\">\n                            <div class=\"h-full w-0 rounded-full bg-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-3-3-1-2-2-1\" data-name=\"queued step progress bar fill\" data-reason=\"width updated by script\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </div>\n    </section>\n</main>\n",
