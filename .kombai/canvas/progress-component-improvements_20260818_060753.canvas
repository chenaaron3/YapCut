      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n\n  @keyframes signal-pulse {\n    0%, 100% { transform: scale(1); opacity: .78; }\n    50% { transform: scale(1.08); opacity: 1; }\n  }\n\n  @keyframes signal-shimmer {\n    0%, 100% { background-position: 140% 0; }\n    45% { background-position: -40% 0; }\n  }\n\n  .signal-pulse { animation: signal-pulse 1.8s ease-in-out infinite; }\n  .signal-shimmer {\n    background-size: 220% 100%;\n    animation: signal-shimmer 3.2s ease-in-out infinite;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .signal-pulse, .signal-shimmer { animation: none; }\n  }\n</style>\n<main class=\"min-h-[720px] bg-[#450E16] px-5 py-7 font-['Cormorant_Garamond'] text-[#450E16] sm:py-10\" data-kid=\"1\" data-name=\"page layout container\">\n    <section aria-labelledby=\"signal-title\" class=\"mx-auto w-full max-w-[420px] overflow-hidden rounded-[24px] border-2 border-[#450E16] bg-[#F5F9CE] shadow-[8px_10px_0_#1E0910]\" data-kid=\"1-1\" data-name=\"pipeline status card\">\n        <div class=\"relative px-6 pt-7 pb-6 sm:px-8 sm:pt-8 sm:pb-7\" data-kid=\"1-1-1\" data-name=\"status summary section\">\n            <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-x-0 top-0 h-36 bg-[radial-gradient(ellipse_at_top,#FFA10233,transparent_70%)]\" data-kid=\"1-1-1-1\" data-name=\"gradient background overlay\">\n            </div>\n            <div class=\"relative flex items-center justify-between gap-4\" data-kid=\"1-1-1-2\" data-name=\"pipeline identity header\">\n                <p class=\"m-0 font-['JetBrains_Mono'] text-[10px] font-bold tracking-[.22em] text-[#DD5533] uppercase\" data-kid=\"1-1-1-2-1\" data-name=\"pipeline type label\">\n                    Create\n                </p>\n                <p class=\"m-0 font-['JetBrains_Mono'] text-[9px] font-medium tracking-[.14em] text-[#432E6F]/70 uppercase\" data-kid=\"1-1-1-2-2\" data-name=\"pipeline description label\">\n                    Weighted pipeline\n                </p>\n            </div>\n            <div class=\"relative mt-3 flex items-end justify-between gap-4\" data-kid=\"1-1-1-3\" data-name=\"pipeline main title area\">\n                <h1 class=\"m-0 max-w-[245px] text-[clamp(2.65rem,12vw,4rem)] font-bold leading-[.86] tracking-[-.055em]\" data-kid=\"1-1-1-3-1\" data-name=\"pipeline headline text\" id=\"signal-title\">\n                    Building your\n                    <br data-kid=\"1-1-1-3-1-1\" data-name=\"headline line break\"/>\n                    edit\n                </h1>\n                <p class=\"m-0 shrink-0 pb-0.5 text-[clamp(3.3rem,14vw,4.75rem)] font-semibold leading-[.78] tracking-[-.07em] text-[#DD5533] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-1-1-3-2\" data-name=\"overall completion percentage\" data-reason=\"value updated by progress tracking script\">\n                    38%\n                </p>\n            </div>\n            <div aria-label=\"Overall weighted pipeline progress\" class=\"relative mt-7\" data-kid=\"1-1-1-4\" data-name=\"overall progress tracker\">\n                <div class=\"mb-2 flex items-end justify-between gap-3 font-['JetBrains_Mono'] text-[8px] font-semibold tracking-[.12em] uppercase\" data-kid=\"1-1-1-4-1\" data-name=\"progress markers labels container\">\n                    <span class=\"text-[#450E16]\" data-kid=\"1-1-1-4-1-1\" data-name=\"media stage label\">\n                        Media · 0—60%\n                    </span>\n                    <span class=\"text-[#432E6F]/65\" data-kid=\"1-1-1-4-1-2\" data-name=\"ai analysis stage label\">\n                        AI analysis · 60—100%\n                    </span>\n                </div>\n                <div aria-label=\"Overall weighted create progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"38\" class=\"relative h-3 overflow-visible rounded-full bg-[#450E16]/12\" data-dynamic=\"true\" data-kid=\"1-1-1-4-2\" data-name=\"overall progress bar\" data-reason=\"aria-valuenow updated by script\" role=\"progressbar\">\n                    <div class=\"signal-shimmer h-full w-[38%] rounded-full bg-[linear-gradient(90deg,#FFA102_0%,#FAD979_48%,#FFA102_100%)]\" data-dynamic=\"true\" data-kid=\"1-1-1-4-2-1\" data-name=\"overall progress fill\" data-reason=\"width updated by script\">\n                    </div>\n                    <span aria-hidden=\"true\" class=\"absolute top-1/2 left-[60%] h-5 w-px -translate-y-1/2 bg-[#450E16]/55\" data-kid=\"1-1-1-4-2-2\" data-name=\"stage boundary line\">\n                    </span>\n                    <span aria-hidden=\"true\" class=\"absolute top-1/2 left-[60%] size-2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[#F5F9CE] bg-[#450E16]\" data-kid=\"1-1-1-4-2-3\" data-name=\"stage boundary indicator\">\n                    </span>\n                </div>\n                <div class=\"mt-2 flex items-center justify-between gap-3 font-['JetBrains_Mono'] text-[8px] tracking-[.11em] uppercase\" data-kid=\"1-1-1-4-3\" data-name=\"overall progress metrics\">\n                    <span class=\"text-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-1-4-3-1\" data-name=\"overall progress count\" data-reason=\"text updated by script\">\n                        38 / 100 overall\n                    </span>\n                    <span class=\"text-[#432E6F]/60\" data-kid=\"1-1-1-4-3-2\" data-name=\"stage boundary notice\">\n                        stage boundary at 60\n                    </span>\n                </div>\n            </div>\n            <div aria-atomic=\"true\" aria-live=\"polite\" class=\"mt-5 flex items-center justify-between gap-3\" data-dynamic=\"true\" data-kid=\"1-1-1-5\" data-name=\"live status update container\" data-reason=\"content rewritten by status script\">\n                <p class=\"m-0 text-[1.28rem] leading-none text-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-1-5-1\" data-name=\"transcription status text\" data-reason=\"text updated by script\">\n                    Transcribing audio…\n                </p>\n                <span class=\"shrink-0 rounded-full border border-[#432E6F]/25 bg-[#432E6F]/[.06] px-2.5 py-1 font-['JetBrains_Mono'] text-[8px] font-semibold tracking-[.12em] text-[#432E6F] uppercase\" data-kid=\"1-1-1-5-2\" data-name=\"live status pill\">\n                    Live\n                </span>\n            </div>\n        </div>\n        <div class=\"border-t-2 border-[#450E16]/10 px-6 py-6 sm:px-8 sm:py-7\" data-kid=\"1-1-2\" data-name=\"pipeline stages section\">\n            <ol aria-label=\"Create pipeline stages\" class=\"m-0 list-none p-0\" data-kid=\"1-1-2-1\" data-name=\"stages list\">\n                <li class=\"relative flex gap-4 pb-7\" data-kid=\"1-1-2-1-1\" data-name=\"transcribe stage item\">\n                    <span aria-hidden=\"true\" class=\"absolute top-10 bottom-[-1.75rem] left-[15px] w-px bg-[#FFA102]\" data-kid=\"1-1-2-1-1-1\" data-name=\"stage vertical connector line\">\n                    </span>\n                    <div class=\"signal-pulse relative z-10 grid size-8 shrink-0 place-items-center rounded-full bg-[#FFA102] text-[#450E16] ring-1 ring-[#FFA102] ring-offset-4 ring-offset-[#F5F9CE]\" data-kid=\"1-1-2-1-1-2\" data-name=\"active stage icon container\">\n                        <i aria-hidden=\"true\" class=\"size-[17px]\" data-kid=\"1-1-2-1-1-2-1\" data-lucide=\"audio-lines\" data-name=\"audio lines icon\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-1-2-1-1-3\" data-name=\"transcribe stage details\">\n                        <div class=\"flex items-baseline justify-between gap-3\" data-kid=\"1-1-2-1-1-3-1\" data-name=\"transcribe stage header\">\n                            <div data-kid=\"1-1-2-1-1-3-1-1\" data-name=\"transcribe stage label group\">\n                                <p class=\"m-0 text-[1.45rem] font-semibold leading-none\" data-kid=\"1-1-2-1-1-3-1-1-1\" data-name=\"transcribe stage name\">\n                                    Transcribe\n                                </p>\n                                <p class=\"m-0 mt-1 font-['JetBrains_Mono'] text-[8px] tracking-[.1em] text-[#432E6F] uppercase\" data-kid=\"1-1-2-1-1-3-1-1-2\" data-name=\"transcribe stage sublabel\">\n                                    Active · media stage\n                                </p>\n                            </div>\n                            <p class=\"m-0 shrink-0 text-[1.2rem] font-semibold leading-none text-[#DD5533] tabular-nums\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-3-1-2\" data-name=\"transcribe stage completion percentage\" data-reason=\"value updated by progress script\">\n                                63%\n                            </p>\n                        </div>\n                        <div aria-label=\"Transcribe stage progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"63\" class=\"mt-3 h-2 overflow-hidden rounded-full bg-[#450E16]/10\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-3-2\" data-name=\"transcribe stage progress bar\" data-reason=\"aria-valuenow updated by script\" role=\"progressbar\">\n                            <div class=\"h-full w-[63%] rounded-full bg-[#FFA102]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-3-2-1\" data-name=\"transcribe stage progress fill\" data-reason=\"width updated by script\">\n                            </div>\n                        </div>\n                        <div class=\"mt-2 flex justify-between gap-3 font-['JetBrains_Mono'] text-[8px] tracking-[.09em] text-[#432E6F]/65 uppercase\" data-kid=\"1-1-2-1-1-3-3\" data-name=\"transcribe stage metrics\">\n                            <span data-kid=\"1-1-2-1-1-3-3-1\" data-name=\"transcribe stage metric label\">\n                                Local stage progress\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-1-1-3-3-2\" data-name=\"transcribe stage progress count\" data-reason=\"text updated by script\">\n                                63 / 100\n                            </span>\n                        </div>\n                    </div>\n                </li>\n                <li class=\"relative flex gap-4\" data-kid=\"1-1-2-1-2\" data-name=\"ai analysis stage item\">\n                    <div class=\"relative z-10 grid size-8 shrink-0 place-items-center rounded-full border-2 border-[#432E6F]/25 bg-[#F5F9CE] text-[#432E6F]/65\" data-kid=\"1-1-2-1-2-1\" data-name=\"ai stage icon container\">\n                        <i aria-hidden=\"true\" class=\"size-[16px]\" data-kid=\"1-1-2-1-2-1-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1 pt-0.5 opacity-65\" data-kid=\"1-1-2-1-2-2\" data-name=\"ai stage details\">\n                        <div class=\"flex items-baseline justify-between gap-3\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"ai stage header\">\n                            <div data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"ai stage label group\">\n                                <p class=\"m-0 text-[1.45rem] leading-none text-[#432E6F]\" data-kid=\"1-1-2-1-2-2-1-1-1\" data-name=\"ai stage name\">\n                                    AI analysis\n                                </p>\n                                <p class=\"m-0 mt-1 font-['JetBrains_Mono'] text-[8px] tracking-[.1em] text-[#432E6F]/70 uppercase\" data-kid=\"1-1-2-1-2-2-1-1-2\" data-name=\"ai stage sublabel\">\n                                    Queued · next stage\n                                </p>\n                            </div>\n                            <p class=\"m-0 shrink-0 text-[1.05rem] leading-none text-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-1-2\" data-name=\"ai stage status text\" data-reason=\"text updated by progress script\">\n                                Waiting\n                            </p>\n                        </div>\n                        <div aria-label=\"AI analysis stage progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"0\" class=\"mt-3 h-2 overflow-hidden rounded-full bg-[#450E16]/[.07]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"ai stage progress bar\" data-reason=\"aria-valuenow updated by script\" role=\"progressbar\">\n                            <div class=\"h-full w-0 rounded-full bg-[#432E6F]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-2-1\" data-name=\"ai stage progress fill\" data-reason=\"width updated by script\">\n                            </div>\n                        </div>\n                        <div class=\"mt-2 flex justify-between gap-3 font-['JetBrains_Mono'] text-[8px] tracking-[.09em] text-[#432E6F]/50 uppercase\" data-kid=\"1-1-2-1-2-2-3\" data-name=\"ai stage metrics\">\n                            <span data-kid=\"1-1-2-1-2-2-3-1\" data-name=\"ai stage metric label\">\n                                Not started\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-3-2\" data-name=\"ai stage progress count\" data-reason=\"text updated by script\">\n                                0 / 100\n                            </span>\n                        </div>\n                    </div>\n                </li>\n            </ol>\n            <div class=\"mt-6 flex items-start gap-2 border-t border-[#450E16]/10 pt-4\" data-kid=\"1-1-2-2\" data-name=\"info section\">\n                <i aria-hidden=\"true\" class=\"mt-0.5 size-[14px] shrink-0 text-[#432E6F]/65\" data-kid=\"1-1-2-2-1\" data-lucide=\"info\" data-name=\"info icon\">\n                </i>\n                <p class=\"m-0 max-w-[34ch] font-['JetBrains_Mono'] text-[9px] leading-[1.45] tracking-[.02em] text-[#432E6F]/70\" data-kid=\"1-1-2-2-2\" data-name=\"info description text\">\n                    Overall progress is weighted across stages; each row shows progress within its own stage.\n                </p>\n            </div>\n        </div>\n    </section>\n</main>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    if (window.lucide) window.lucide.createIcons({ attrs: { 'stroke-width': 1.8 } });\n</script>\n",
