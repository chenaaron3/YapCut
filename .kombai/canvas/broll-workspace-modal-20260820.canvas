      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n</style>\n<div class=\"relative min-h-[100dvh] overflow-hidden bg-[#12141a] font-['Cormorant_Garamond'] text-[#f5f9ce]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"absolute inset-0 opacity-40\" data-kid=\"1-1\" data-name=\"background layout helper container\">\n        <div class=\"absolute inset-x-0 top-0 h-14 border-b border-[#2e3444] bg-[#161922]\" data-kid=\"1-1-1\" data-name=\"top header skeleton bar\">\n            <div class=\"flex h-full items-center gap-5 px-8\" data-kid=\"1-1-1-1\" data-name=\"header contents container\">\n                <div class=\"h-2.5 w-24 rounded-full bg-[#2e3444]\" data-kid=\"1-1-1-1-1\" data-name=\"logo placeholder circle\">\n                </div>\n                <div class=\"h-2 w-44 rounded-full bg-[#222632]\" data-kid=\"1-1-1-1-2\" data-name=\"navigation link placeholder\">\n                </div>\n                <div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-1-1-1-3\" data-name=\"user profile section container\">\n                    <div class=\"size-7 rounded-full border border-[#453239]\" data-kid=\"1-1-1-1-3-1\" data-name=\"profile picture placeholder\">\n                    </div>\n                    <div class=\"h-2 w-20 rounded-full bg-[#2e3444]\" data-kid=\"1-1-1-1-3-2\" data-name=\"username placeholder\">\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute inset-x-0 top-14 bottom-36 flex\" data-kid=\"1-1-2\" data-name=\"side navigation skeleton container\">\n            <div class=\"w-56 border-r border-[#2e3444] bg-[#151820] p-6\" data-kid=\"1-1-2-1\" data-name=\"sidebar skeleton container\">\n                <div class=\"mb-8 h-3 w-20 rounded-full bg-[#2e3444]\" data-kid=\"1-1-2-1-1\" data-name=\"sidebar title placeholder\">\n                </div>\n                <div class=\"space-y-4\" data-kid=\"1-1-2-1-2\" data-name=\"sidebar menu links container\">\n                    <div class=\"h-9 rounded-lg bg-[#222632]\" data-kid=\"1-1-2-1-2-1\" data-name=\"active menu link placeholder\">\n                    </div>\n                    <div class=\"h-9 rounded-lg bg-[#1b1e27]\" data-kid=\"1-1-2-1-2-2\" data-name=\"menu link placeholder 1\">\n                    </div>\n                    <div class=\"h-9 rounded-lg bg-[#1b1e27]\" data-kid=\"1-1-2-1-2-3\" data-name=\"menu link placeholder 2\">\n                    </div>\n                    <div class=\"h-9 rounded-lg bg-[#1b1e27]\" data-kid=\"1-1-2-1-2-4\" data-name=\"menu link placeholder 3\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex-1 p-10\" data-kid=\"1-1-2-2\" data-name=\"content area skeleton container\">\n                <div class=\"h-3 w-40 rounded-full bg-[#2e3444]\" data-kid=\"1-1-2-2-1\" data-name=\"content title placeholder\">\n                </div>\n                <div class=\"mt-6 grid grid-cols-3 gap-5 opacity-60\" data-kid=\"1-1-2-2-2\" data-name=\"content grid skeleton\">\n                    <div class=\"aspect-video rounded-xl border border-[#2e3444] bg-[#1a1d26]\" data-kid=\"1-1-2-2-2-1\" data-name=\"grid image placeholder 1\">\n                    </div>\n                    <div class=\"aspect-video rounded-xl border border-[#2e3444] bg-[#1a1d26]\" data-kid=\"1-1-2-2-2-2\" data-name=\"grid image placeholder 2\">\n                    </div>\n                    <div class=\"aspect-video rounded-xl border border-[#2e3444] bg-[#1a1d26]\" data-kid=\"1-1-2-2-2-3\" data-name=\"grid image placeholder 3\">\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute inset-x-0 bottom-0 h-36 border-t border-[#2e3444] bg-[#161922] p-5\" data-kid=\"1-1-3\" data-name=\"bottom bar skeleton container\">\n            <div class=\"mb-4 h-2 w-32 rounded-full bg-[#2e3444]\" data-kid=\"1-1-3-1\" data-name=\"bottom action label placeholder\">\n            </div>\n            <div class=\"h-8 rounded-lg bg-[#222632]\" data-kid=\"1-1-3-2\" data-name=\"bottom action button placeholder\">\n            </div>\n        </div>\n    </div>\n    <div aria-hidden=\"true\" class=\"absolute inset-0 bg-[#450e16]/30\" data-kid=\"1-2\" data-name=\"background overlay tint\">\n    </div>\n    <main class=\"relative z-[300] mx-auto my-6 flex h-auto max-h-[calc(100dvh-2rem)] w-[min(1120px,calc(100vw-3rem))] flex-col overflow-hidden rounded-[16px] border border-[#453239] bg-[#1a1d26] shadow-[0_20px_48px_rgba(0,0,0,0.38)] md:my-[clamp(1.5rem,4vh,3rem)] md:h-[min(650px,calc(100dvh-3rem))]\" data-kid=\"1-3\" data-name=\"main modal container\">\n        <header class=\"flex shrink-0 items-start justify-between gap-8 border-b border-[#453239] px-7 py-6 sm:px-8\" data-kid=\"1-3-1\" data-name=\"modal header\">\n            <div class=\"min-w-0\" data-kid=\"1-3-1-1\" data-name=\"modal title group\">\n                <h1 class=\"m-0 text-[clamp(1.8rem,2.8vw,2.45rem)] leading-[0.9] font-semibold tracking-[-0.045em] text-[#f5f9ce]\" data-kid=\"1-3-1-1-1\" data-name=\"modal headline\">\n                    Generate B-roll\n                </h1>\n                <p class=\"mt-3 max-w-[60ch] text-[clamp(0.98rem,1.3vw,1.12rem)] leading-snug text-[#c4b8a8]\" data-kid=\"1-3-1-1-2\" data-name=\"modal description text\">\n                    Prompt for a still. Attach one existing image to keep its subject or look.\n                </p>\n            </div>\n            <button aria-label=\"Close Generate B-roll\" class=\"group -mr-2 -mt-2 grid size-10 shrink-0 place-items-center rounded-[8px] text-[#c4b8a8] outline-none transition-colors hover:bg-[#222632] hover:text-[#f5f9ce] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-1-2\" data-name=\"close modal button\" title=\"Close\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"size-5\" data-kid=\"1-3-1-2-1\" data-lucide=\"x\" data-name=\"x icon\">\n                </i>\n            </button>\n        </header>\n        <div class=\"grid min-h-0 flex-1 grid-cols-1 md:grid-cols-[44%_56%]\" data-kid=\"1-3-2\" data-name=\"modal main content area\">\n            <section class=\"flex min-h-0 flex-col gap-5 overflow-y-auto border-b border-[#453239] px-7 py-6 sm:px-8 md:border-r md:border-b-0\" data-kid=\"1-3-2-1\" data-name=\"prompt input section\">\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-3-2-1-1\" data-name=\"prompt input group\">\n                    <label class=\"font-['JetBrains_Mono'] text-[10px] font-medium tracking-[0.16em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-2-1-1-1\" data-name=\"prompt label\" for=\"broll-prompt\">\n                        Prompt\n                    </label>\n                    <textarea class=\"min-h-[122px] w-full resize-none rounded-[8px] border border-[#614f40] bg-[#161922] px-4 py-3 text-[1.08rem] leading-[1.24] text-[#f5f9ce] outline-none placeholder:text-[#75677f] focus-visible:border-[#ffa102] focus-visible:ring-2 focus-visible:ring-[#ffa102]/45 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-2-1-1-2\" data-name=\"prompt text area\" id=\"broll-prompt\" rows=\"4\" spellcheck=\"false\">A ceramic coffee mug, centered, warm side light</textarea>\n                </div>\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-3-2-1-2\" data-name=\"reference image section\">\n                    <span class=\"font-['JetBrains_Mono'] text-[10px] font-medium tracking-[0.16em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-2-1-2-1\" data-name=\"reference label\">\n                        Reference\n                    </span>\n                    <button class=\"flex h-12 w-full items-center justify-center gap-2 rounded-[8px] border border-dashed border-[#614f40] bg-transparent px-4 text-[1rem] text-[#c4b8a8] outline-none transition-colors hover:border-[#ffa102]/70 hover:bg-[#222632]/60 hover:text-[#f5f9ce] focus-visible:border-[#ffa102] focus-visible:ring-2 focus-visible:ring-[#ffa102]/35 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-2-1-2-2\" data-name=\"attach reference button\" title=\"Attach an existing B-roll image\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-2-1-2-2-1\" data-lucide=\"plus\" data-name=\"plus icon\">\n                        </i>\n                        <span data-kid=\"1-3-2-1-2-2-2\" data-name=\"attach button text\">\n                            Attach from B-roll\n                        </span>\n                    </button>\n                </div>\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-3-2-1-3\" data-name=\"size selection section\">\n                    <span class=\"font-['JetBrains_Mono'] text-[10px] font-medium tracking-[0.16em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-2-1-3-1\" data-name=\"size label\">\n                        Size\n                    </span>\n                    <div aria-label=\"Image size\" class=\"flex w-fit overflow-hidden rounded-[8px] border border-[#614f40] bg-[#161922] p-0.5\" data-kid=\"1-3-2-1-3-2\" data-name=\"size options group\" role=\"group\">\n                        <button aria-pressed=\"true\" class=\"size-option h-9 min-w-16 rounded-[6px] bg-[#ffa102] px-3 text-[1rem] font-medium text-[#450e16] outline-none transition-colors focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-1 focus-visible:ring-offset-[#161922]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3-2-1\" data-name=\"size option button 9:16\" data-reason=\"aria-pressed and classes toggled by script on click\" type=\"button\">\n                            9:16\n                        </button>\n                        <button aria-pressed=\"false\" class=\"size-option h-9 min-w-16 rounded-[6px] px-3 text-[1rem] font-medium text-[#c4b8a8] outline-none transition-colors hover:bg-[#222632] hover:text-[#f5f9ce] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-1 focus-visible:ring-offset-[#161922]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3-2-2\" data-name=\"size option button 1:1\" data-reason=\"aria-pressed and classes toggled by script on click\" type=\"button\">\n                            1:1\n                        </button>\n                        <button aria-pressed=\"false\" class=\"size-option h-9 min-w-16 rounded-[6px] px-3 text-[1rem] font-medium text-[#c4b8a8] outline-none transition-colors hover:bg-[#222632] hover:text-[#f5f9ce] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-1 focus-visible:ring-offset-[#161922]\" data-dynamic=\"true\" data-kid=\"1-3-2-1-3-2-3\" data-name=\"size option button 16:9\" data-reason=\"aria-pressed and classes toggled by script on click\" type=\"button\">\n                            16:9\n                        </button>\n                    </div>\n                </div>\n                <button class=\"mt-auto flex h-11 w-full items-center justify-center gap-2 rounded-[8px] bg-[#ffa102] px-5 text-[1.08rem] font-semibold text-[#450e16] outline-none transition-colors hover:bg-[#e99700] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-2-1-4\" data-name=\"generate button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-2-1-4-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                    </i>\n                    <span data-kid=\"1-3-2-1-4-2\" data-name=\"generate button text\">\n                        Generate\n                    </span>\n                </button>\n            </section>\n            <section class=\"flex min-h-[320px] min-w-0 flex-col gap-5 overflow-y-auto px-7 py-6 sm:px-8\" data-kid=\"1-3-2-2\" data-name=\"results display section\">\n                <div class=\"flex shrink-0 items-center justify-between gap-4\" data-kid=\"1-3-2-2-1\" data-name=\"results header\">\n                    <h2 class=\"m-0 font-['JetBrains_Mono'] text-[10px] font-medium tracking-[0.16em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-2-2-1-1\" data-name=\"results title\">\n                        Results\n                    </h2>\n                    <button class=\"h-10 shrink-0 rounded-[8px] border border-[#75677f] bg-transparent px-4 text-[0.98rem] text-[#c4b8a8] outline-none transition-colors hover:border-[#ffa102] hover:text-[#f5f9ce] focus-visible:border-[#ffa102] focus-visible:ring-2 focus-visible:ring-[#ffa102]/40 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-2-2-1-2\" data-name=\"add to library button\" title=\"Add the selected variant to the B-roll library\" type=\"button\">\n                        Add to library\n                    </button>\n                </div>\n                <p class=\"m-0 text-[1rem] leading-snug text-[#c4b8a8]\" data-kid=\"1-3-2-2-2\" data-name=\"empty state description text\">\n                    Variants show here. Pick one, then add it to B-roll.\n                </p>\n                <div class=\"flex min-h-[250px] flex-1 items-center justify-center rounded-[12px] border border-[#453239] bg-[#161922]/60 px-6 py-10\" data-kid=\"1-3-2-2-3\" data-name=\"empty results state container\">\n                    <div class=\"flex flex-col items-center gap-4 text-center\" data-kid=\"1-3-2-2-3-1\" data-name=\"empty state icon and text group\">\n                        <span class=\"grid size-10 place-items-center rounded-full border border-[#614f40] text-[#75677f]\" data-kid=\"1-3-2-2-3-1-1\" data-name=\"empty state icon wrapper\">\n                            <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-2-2-3-1-1-1\" data-lucide=\"crosshair\" data-name=\"crosshair icon\">\n                            </i>\n                        </span>\n                        <p class=\"m-0 text-[1.08rem] text-[#75677f]\" data-kid=\"1-3-2-2-3-1-2\" data-name=\"empty state text\">\n                            Your variants will appear here.\n                        </p>\n                    </div>\n                </div>\n            </section>\n        </div>\n    </main>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        lucide.createIcons();\n    const sizeOptions = document.querySelectorAll('.size-option');\n    sizeOptions.forEach((option) => {\n      option.addEventListener('click', () => {\n        sizeOptions.forEach((item) => {\n          item.setAttribute('aria-pressed', item === option ? 'true' : 'false');\n          item.classList.toggle('bg-[#ffa102]', item === option);\n          item.classList.toggle('text-[#450e16]', item === option);\n          item.classList.toggle('text-[#c4b8a8]', item !== option);\n        });\n      });\n    });\n    </script>\n</div>\n",
