      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  .broll-stage {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .broll-mono {\n    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  .broll-scanline {\n    background-image: repeating-linear-gradient(\n      90deg,\n      transparent 0,\n      transparent 76px,\n      rgba(117, 103, 127, 0.1) 77px,\n      transparent 78px\n    );\n  }\n\n  .broll-result-action {\n    transform: translateY(5px);\n  }\n\n  .group:hover .broll-result-action,\n  .group:focus-within .broll-result-action,\n  .broll-demo-hover .broll-result-action {\n    transform: translateY(0);\n    opacity: 1;\n  }\n\n  @media (max-width: 767px) {\n    .broll-stage {\n      align-items: flex-start;\n      padding: 12px;\n    }\n  }\n</style>\n<main class=\"broll-stage relative flex min-h-[100dvh] items-center justify-center overflow-hidden bg-[#12141a] px-6 py-6 text-[#f5f9ce]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 overflow-hidden opacity-90\" data-kid=\"1-1\" data-name=\"dimmed editor backdrop\">\n        <div class=\"absolute inset-x-0 top-0 h-14 border-b border-[#453239]/60 bg-[#1a1d26]\" data-kid=\"1-1-1\" data-name=\"editor header silhouette\">\n            <div class=\"flex h-full items-center justify-between px-7\" data-kid=\"1-1-1-1\">\n                <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1-1\">\n                    <div class=\"grid size-7 place-items-center rounded-[8px] border border-[#453239] bg-[#222632] text-[15px] text-[#ffa102]\" data-kid=\"1-1-1-1-1-1\">\n                        T\n                    </div>\n                    <div class=\"h-2 w-32 rounded-full bg-[#453239]/70\" data-kid=\"1-1-1-1-1-2\">\n                    </div>\n                    <div class=\"h-2 w-16 rounded-full bg-[#453239]/40\" data-kid=\"1-1-1-1-1-3\">\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"size-7 rounded-full border border-[#453239]/80\" data-kid=\"1-1-1-1-2-1\">\n                    </div>\n                    <div class=\"size-7 rounded-full border border-[#453239]/80\" data-kid=\"1-1-1-1-2-2\">\n                    </div>\n                    <div class=\"h-7 w-20 rounded-[8px] bg-[#222632]\" data-kid=\"1-1-1-1-2-3\">\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute inset-x-0 top-14 bottom-0 broll-scanline\" data-kid=\"1-1-2\">\n        </div>\n        <div class=\"absolute top-28 left-6 w-44 space-y-3 opacity-70\" data-kid=\"1-1-3\">\n            <div class=\"h-3 w-24 rounded-full bg-[#453239]/70\" data-kid=\"1-1-3-1\">\n            </div>\n            <div class=\"h-24 rounded-[12px] border border-[#453239]/70 bg-[#1a1d26]\" data-kid=\"1-1-3-2\">\n            </div>\n            <div class=\"h-3 w-32 rounded-full bg-[#453239]/50\" data-kid=\"1-1-3-3\">\n            </div>\n            <div class=\"h-14 rounded-[12px] border border-[#453239]/60 bg-[#1a1d26]\" data-kid=\"1-1-3-4\">\n            </div>\n        </div>\n        <div class=\"absolute right-8 bottom-12 left-8 h-20 rounded-[12px] border border-[#453239]/60 bg-[#1a1d26]/90\" data-kid=\"1-1-4\">\n            <div class=\"flex h-full items-center gap-3 px-5\" data-kid=\"1-1-4-1\">\n                <div class=\"h-8 w-28 rounded-[6px] bg-[#222632]\" data-kid=\"1-1-4-1-1\">\n                </div>\n                <div class=\"h-8 w-44 rounded-[6px] bg-[#432e6f]/40\" data-kid=\"1-1-4-1-2\">\n                </div>\n                <div class=\"h-8 w-36 rounded-[6px] bg-[#bc2d29]/35\" data-kid=\"1-1-4-1-3\">\n                </div>\n                <div class=\"h-8 w-52 rounded-[6px] bg-[#222632]\" data-kid=\"1-1-4-1-4\">\n                </div>\n                <div class=\"h-8 w-24 rounded-[6px] bg-[#2dd4bf]/20\" data-kid=\"1-1-4-1-5\">\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute inset-0 bg-[#450e16]/38 backdrop-blur-[2px]\" data-kid=\"1-1-5\">\n        </div>\n    </div>\n    <section aria-labelledby=\"broll-title\" aria-modal=\"true\" class=\"relative z-[300] flex h-[min(760px,calc(100dvh-48px))] max-h-[calc(100dvh-48px)] w-[min(1320px,calc(100%-48px))] min-w-0 flex-col overflow-hidden rounded-[16px] border border-[#453239] bg-[#1a1d26] text-[#f5f9ce] shadow-[0_20px_48px_rgba(0,0,0,0.7)]\" data-kid=\"1-2\" data-name=\"populated generate B-roll dialog\" role=\"dialog\">\n        <header class=\"flex shrink-0 items-start justify-between gap-8 px-8 pt-7 pb-6 max-md:px-5 max-md:pt-5 max-md:pb-4\" data-kid=\"1-2-1\">\n            <div class=\"min-w-0\" data-kid=\"1-2-1-1\">\n                <h1 class=\"text-[clamp(2rem,3vw,2.8rem)] leading-[0.98] font-semibold tracking-[-0.035em] text-[#f5f9ce]\" data-kid=\"1-2-1-1-1\" id=\"broll-title\">\n                    Generate B-roll\n                </h1>\n                <p class=\"mt-3 max-w-[62ch] text-[clamp(1rem,1.5vw,1.22rem)] leading-[1.25] text-[#c4b8a8]\" data-kid=\"1-2-1-1-2\">\n                    Prompt for a still. Attach one existing image to keep its subject or look.\n                </p>\n            </div>\n            <button aria-label=\"Close generate B-roll dialog\" class=\"group grid size-10 shrink-0 place-items-center rounded-[10px] text-[#f5f9ce] outline-none transition-colors hover:bg-[#222632] hover:text-[#ffa102] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-2-1-2\" title=\"Close\" type=\"button\">\n                <i class=\"size-6 stroke-[1.5]\" data-kid=\"1-2-1-2-1\" data-lucide=\"x\">\n                </i>\n            </button>\n        </header>\n        <div class=\"grid min-h-0 flex-1 grid-cols-[minmax(380px,0.72fr)_minmax(0,1fr)] border-t border-[#453239] max-md:block max-md:overflow-y-auto\" data-kid=\"1-2-2\">\n            <form class=\"flex min-h-0 flex-col gap-7 overflow-y-auto border-r border-[#453239] px-8 py-7 max-md:border-r-0 max-md:border-b max-md:px-5 max-md:py-6\" data-kid=\"1-2-2-1\" onsubmit=\"return false\">\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-2-2-1-1\">\n                    <label class=\"broll-mono text-[11px] font-medium tracking-[0.13em] text-[#c4b8a8]\" data-kid=\"1-2-2-1-1-1\" for=\"broll-prompt\">\n                        PROMPT\n                    </label>\n                    <textarea aria-label=\"B-roll generation prompt\" class=\"min-h-[214px] w-full resize-none rounded-[16px] border-2 border-[#ffa102] bg-[#171922] px-5 py-4 text-[1.28rem] leading-[1.22] text-[#f5f9ce] outline-none shadow-[0_0_0_4px_rgba(255,161,2,0.12)] placeholder:text-[#75677f] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-2-2-1-1-2\" id=\"broll-prompt\">A ceramic coffee mug, centered, warm side light</textarea>\n                </div>\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-2-2-1-2\">\n                    <label class=\"broll-mono text-[11px] font-medium tracking-[0.13em] text-[#c4b8a8]\" data-kid=\"1-2-2-1-2-1\" for=\"broll-reference\">\n                        REFERENCE\n                    </label>\n                    <button aria-label=\"Attach a reference image from B-roll\" class=\"flex min-h-16 w-full items-center justify-center gap-3 rounded-[14px] border border-dashed border-[#75677f]/65 bg-transparent px-4 text-[1.1rem] text-[#c4b8a8] outline-none transition-colors hover:border-[#ffa102] hover:bg-[#222632]/50 hover:text-[#f5f9ce] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-2-2-1-2-2\" id=\"broll-reference\" type=\"button\">\n                        <i class=\"size-5 stroke-[1.5]\" data-kid=\"1-2-2-1-2-2-1\" data-lucide=\"plus\">\n                        </i>\n                        <span data-kid=\"1-2-2-1-2-2-2\">\n                            Attach from B-roll\n                        </span>\n                    </button>\n                </div>\n                <div class=\"mt-auto flex items-end justify-between gap-3 max-sm:flex-wrap\" data-kid=\"1-2-2-1-3\" data-name=\"generate prompt layout container\">\n                    <fieldset class=\"flex shrink-0 flex-col gap-2\" data-kid=\"1-2-2-1-3-1\" data-name=\"size settings group\">\n                        <legend class=\"broll-mono text-[11px] font-medium tracking-[0.13em] text-[#c4b8a8]\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"size legend label\">\n                            SIZE\n                        </legend>\n                        <div aria-label=\"Generated image size\" class=\"flex w-fit overflow-hidden rounded-[12px] border border-[#453239] bg-[#171922]\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"size selection control group\" role=\"group\">\n                            <button aria-label=\"Horizontal 16 by 9\" aria-pressed=\"false\" class=\"grid size-12 place-items-center border-r border-[#453239] bg-transparent text-[#f5f9ce] outline-none transition-colors hover:bg-[#222632] focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-inset\" data-kid=\"1-2-2-1-3-1-2-1\" data-name=\"horizontal 16:9 size button\" data-size-option=\"horizontal\" title=\"Horizontal 16:9\" type=\"button\">\n                                <i class=\"size-6 stroke-[1.5]\" data-kid=\"1-2-2-1-3-1-2-1-1\" data-lucide=\"rectangle-horizontal\" data-name=\"horizontal rectangle icon\">\n                                </i>\n                            </button>\n                            <button aria-label=\"Square 1 by 1\" aria-pressed=\"false\" class=\"grid size-12 place-items-center border-r border-[#453239] bg-transparent text-[#f5f9ce] outline-none transition-colors hover:bg-[#222632] focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-inset\" data-kid=\"1-2-2-1-3-1-2-2\" data-name=\"square 1:1 size button\" data-size-option=\"square\" title=\"Square 1:1\" type=\"button\">\n                                <i class=\"size-6 stroke-[1.5]\" data-kid=\"1-2-2-1-3-1-2-2-1\" data-lucide=\"square\" data-name=\"square icon\">\n                                </i>\n                            </button>\n                            <button aria-label=\"Vertical 9 by 16\" aria-pressed=\"true\" class=\"grid size-12 place-items-center bg-[#ffa102] text-[#450e16] outline-none transition-colors hover:bg-[#ffaf2b] focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-[#f5f9ce] focus-visible:ring-inset\" data-kid=\"1-2-2-1-3-1-2-3\" data-name=\"vertical 9:16 size button\" data-size-option=\"vertical\" title=\"Vertical 9:16\" type=\"button\">\n                                <i class=\"size-6 stroke-[1.5]\" data-kid=\"1-2-2-1-3-1-2-3-1\" data-lucide=\"rectangle-vertical\" data-name=\"vertical rectangle icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </fieldset>\n                    <button aria-label=\"Generate B-roll variants\" class=\"flex min-h-12 min-w-32 flex-1 items-center justify-center gap-2 rounded-[12px] border border-[#bc7720] bg-[#a97022] px-4 py-2.5 text-[1.06rem] font-semibold text-[#1d1414] outline-none transition-colors hover:bg-[#c17d27] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26] max-sm:min-w-0\" data-kid=\"1-2-2-1-3-2\" data-name=\"generate variants button\" type=\"submit\">\n                        <i class=\"size-4.5 stroke-[1.7]\" data-kid=\"1-2-2-1-3-2-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-1-3-2-2\" data-name=\"generate button label\">\n                            Generate\n                        </span>\n                    </button>\n                </div>\n            </form>\n            <section aria-label=\"Generated B-roll results\" class=\"flex min-h-0 flex-col px-8 py-7 max-md:min-h-[460px] max-md:px-5 max-md:py-6\" data-kid=\"1-2-2-2\" data-name=\"results display section\">\n                <div aria-label=\"Generated B-roll results\" aria-live=\"polite\" class=\"grid min-h-0 flex-1 grid-cols-2 gap-4 overflow-hidden max-sm:grid-cols-1 max-sm:overflow-y-auto\" data-kid=\"1-2-2-2-1\" data-name=\"generated results grid container\">\n                    <article class=\"group relative min-h-0 overflow-hidden rounded-[12px] border border-[#453239] bg-[#171922] focus-within:border-[#ffa102]\" data-added=\"true\" data-kid=\"1-2-2-2-1-1\" data-name=\"first variant result card\" data-result-card=\"\" data-result-id=\"broll-mug-01\">\n                        <img alt=\"Ceramic coffee mug in warm side light — Nick Harsell on Unsplash\" class=\"absolute inset-0 size-full object-cover\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"first variant image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1630783098843-956335ee5275?auto=format&w=720&q=80&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-[#450e16]/18\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"first variant card overlay\">\n                        </div>\n                        <button aria-label=\"Mug variant already added to library\" class=\"absolute right-3 bottom-3 grid size-11 place-items-center rounded-full border border-[#ffa102] bg-[#1a1d26]/92 text-[#f5f9ce] outline-none focus-visible:ring-2 focus-visible:ring-[#f5f9ce] focus-visible:ring-offset-2 focus-visible:ring-offset-[#450e16]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-3\" data-name=\"first variant added state indicator\" data-reason=\"button style and icon replaced after click\" disabled=\"\" title=\"Already added to library\" type=\"button\">\n                            <i class=\"size-5 stroke-[1.8] text-[#ffa102]\" data-kid=\"1-2-2-2-1-1-3-1\" data-lucide=\"check\" data-name=\"checkmark icon\">\n                            </i>\n                        </button>\n                    </article>\n                    <article class=\"group broll-demo-hover relative min-h-0 overflow-hidden rounded-[12px] border border-[#453239] bg-[#171922] focus-within:border-[#ffa102]\" data-added=\"false\" data-kid=\"1-2-2-2-1-2\" data-name=\"second variant result card\" data-result-card=\"\" data-result-id=\"broll-mug-02\">\n                        <img alt=\"Ceramic coffee mug on a warm wooden surface — Annie Spratt on Unsplash\" class=\"absolute inset-0 size-full object-cover\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"second variant image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1495100497150-fe209c585f50?auto=format&w=720&q=80&fit=crop\"/>\n                        <div class=\"absolute inset-0 bg-[#450e16]/28 opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"second variant card overlay\">\n                        </div>\n                        <button aria-label=\"Add mug variant to library\" class=\"broll-result-action absolute right-3 bottom-3 grid size-11 place-items-center rounded-full border border-[#ffa102] bg-[#ffa102] text-[#450e16] opacity-0 outline-none transition-[opacity,transform,background-color] group-hover:opacity-100 group-focus-within:opacity-100 hover:bg-[#ffaf2b] focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-[#f5f9ce] focus-visible:ring-offset-2 focus-visible:ring-offset-[#450e14]\" data-add-result=\"\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"second variant add to library button\" data-reason=\"button style and icon replaced after click\" title=\"Add to library\" type=\"button\">\n                            <i class=\"size-5 stroke-[1.8]\" data-kid=\"1-2-2-2-1-2-3-1\" data-lucide=\"plus\" data-name=\"plus icon\">\n                            </i>\n                        </button>\n                    </article>\n                </div>\n            </section>\n        </div>\n    </section>\n</main>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const renderIcons = () => {\n    if (window.lucide) window.lucide.createIcons({ attrs: { 'aria-hidden': 'true' } });\n  };\n\n  renderIcons();\n\n  document.querySelectorAll('[data-size-option]').forEach((option) => {\n    option.addEventListener('click', () => {\n      document.querySelectorAll('[data-size-option]').forEach((item) => {\n        item.setAttribute('aria-pressed', item === option ? 'true' : 'false');\n        item.classList.toggle('bg-[#ffa102]', item === option);\n        item.classList.toggle('text-[#450e16]', item === option);\n        item.classList.toggle('hover:bg-[#ffaf2b]', item === option);\n        item.classList.toggle('bg-transparent', item !== option);\n        item.classList.toggle('text-[#f5f9ce]', item !== option);\n        item.classList.toggle('hover:bg-[#222632]', item !== option);\n      });\n    });\n  });\n\n  document.querySelectorAll('[data-add-result]').forEach((button) => {\n    button.addEventListener('click', () => {\n      const card = button.closest('[data-result-card]');\n      if (!card || card.dataset.added === 'true') return;\n\n      card.dataset.added = 'true';\n      button.disabled = true;\n      button.setAttribute('aria-label', 'Mug variant already added to library');\n      button.setAttribute('title', 'Already added to library');\n      button.classList.remove('border-[#ffa102]', 'bg-[#ffa102]', 'text-[#450e16]', 'hover:bg-[#ffaf2b]');\n      button.classList.add('border-[#ffa102]', 'bg-[#1a1d26]', 'text-[#f5f9ce]', 'cursor-default');\n      button.innerHTML = '<i class=\"size-5 stroke-[1.8] text-[#ffa102]\" data-lucide=\"check\"></i>';\n      renderIcons();\n    });\n  });\n</script>\n",
