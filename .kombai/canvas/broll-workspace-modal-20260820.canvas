      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .broll-caret {\n    animation: broll-caret 1.1s steps(1, end) infinite;\n  }\n  @keyframes broll-caret {\n    0%, 48% { opacity: 1; }\n    49%, 100% { opacity: 0; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .broll-caret { animation: none; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"relative min-h-[100dvh] overflow-hidden bg-[#12141a] font-['Cormorant_Garamond'] text-[#f5f9ce] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 opacity-45\" data-kid=\"1-1\" data-name=\"background decorative elements container\">\n        <div class=\"absolute inset-x-0 top-0 h-14 border-b border-[#453239]/60 bg-[#1a1d26]\" data-kid=\"1-1-1\" data-name=\"top header decorative border\">\n        </div>\n        <div class=\"absolute top-0 left-0 h-full w-16 border-r border-[#453239]/45 bg-[#161922]\" data-kid=\"1-1-2\" data-name=\"left sidebar decorative border\">\n        </div>\n        <div class=\"absolute top-20 right-10 h-56 w-64 rounded-[12px] border border-[#453239]/35 bg-[#1a1d26]/55\" data-kid=\"1-1-3\" data-name=\"decorative floating rectangular panel\">\n        </div>\n        <div class=\"absolute right-14 bottom-12 left-24 h-24 rounded-[10px] border border-[#453239]/30 bg-[#1a1d26]/40\" data-kid=\"1-1-4\" data-name=\"decorative bottom horizontal strip\">\n        </div>\n        <div class=\"absolute top-[86px] right-[352px] left-[104px] h-px bg-[#453239]/35\" data-kid=\"1-1-5\" data-name=\"decorative horizontal separator line\">\n        </div>\n        <div class=\"absolute right-[340px] bottom-[178px] left-[102px] h-px bg-[#453239]/25\" data-kid=\"1-1-6\" data-name=\"decorative lower horizontal separator line\">\n        </div>\n        <div class=\"absolute top-[124px] left-[103px] h-2 w-20 rounded-full bg-[#453239]/40\" data-kid=\"1-1-7\" data-name=\"decorative small pill shape\">\n        </div>\n        <div class=\"absolute top-[124px] left-[198px] h-2 w-32 rounded-full bg-[#453239]/25\" data-kid=\"1-1-8\" data-name=\"decorative medium pill shape\">\n        </div>\n        <div class=\"absolute right-[382px] bottom-[128px] h-2 w-40 rounded-full bg-[#453239]/25\" data-kid=\"1-1-9\" data-name=\"decorative large pill shape\">\n        </div>\n        <div class=\"absolute bottom-[128px] left-[124px] h-2 w-24 rounded-full bg-[#c9a227]/15\" data-kid=\"1-1-10\" data-name=\"decorative highlighted pill shape\">\n        </div>\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 bg-[#450e16]/38\" data-kid=\"1-2\" data-name=\"overlay background color layer\">\n    </div>\n    <main class=\"relative z-10 flex min-h-[100dvh] items-center justify-center p-4 sm:p-6 lg:p-8\" data-kid=\"1-3\" data-name=\"main page content area\">\n        <section aria-label=\"Generate B-roll\" class=\"flex h-[min(720px,calc(100dvh-2rem))] max-h-[calc(100dvh-2rem)] min-h-[560px] w-full max-w-[1240px] flex-col overflow-hidden rounded-[16px] border border-[#453239] bg-[#1a1d26] shadow-[0_20px_48px_rgba(0,0,0,0.7)] sm:h-[min(720px,calc(100dvh-3rem))] lg:h-[720px]\" data-kid=\"1-3-1\" data-name=\"generate b-roll application card\">\n            <header class=\"flex shrink-0 items-start justify-between gap-6 border-b border-[#453239] px-6 pt-6 pb-5 sm:px-8 sm:pt-7 sm:pb-6\" data-kid=\"1-3-1-1\" data-name=\"card header section\">\n                <div class=\"min-w-0\" data-kid=\"1-3-1-1-1\" data-name=\"title and description container\">\n                    <h1 class=\"text-[clamp(2rem,3.2vw,2.75rem)] leading-[0.95] font-semibold tracking-[-0.035em] text-[#f5f9ce]\" data-kid=\"1-3-1-1-1-1\" data-name=\"main page headline\">\n                        Generate B-roll\n                    </h1>\n                    <p class=\"mt-3 max-w-[58ch] text-[1.05rem] leading-[1.35] text-[#c4b8a8]\" data-kid=\"1-3-1-1-1-2\" data-name=\"headline description text\">\n                        Prompt for a still. Attach one existing image to keep its subject or look.\n                    </p>\n                </div>\n                <button aria-label=\"Close Generate B-roll\" class=\"group grid size-10 shrink-0 place-items-center rounded-full text-[#f5f9ce] outline-none hover:bg-[#222632] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-1-1-2\" data-name=\"close button\" title=\"Close\" type=\"button\">\n                    <i class=\"size-5 stroke-[1.7] transition-transform duration-200 group-hover:rotate-90\" data-kid=\"1-3-1-1-2-1\" data-lucide=\"x\" data-name=\"close icon\">\n                    </i>\n                </button>\n            </header>\n            <div class=\"grid min-h-0 flex-1 grid-cols-1 overflow-y-auto md:grid-cols-[minmax(260px,0.86fr)_minmax(0,2fr)] md:overflow-hidden\" data-kid=\"1-3-1-2\" data-name=\"card body grid container\">\n                <form aria-label=\"B-roll prompt controls\" class=\"flex min-h-0 flex-col gap-6 border-b border-[#453239] px-6 py-6 sm:px-8 md:border-r md:border-b-0\" data-kid=\"1-3-1-2-1\" data-name=\"prompt control form\">\n                    <div class=\"flex flex-col gap-2\" data-kid=\"1-3-1-2-1-1\" data-name=\"prompt input group\">\n                        <label class=\"font-['JetBrains_Mono'] text-[0.69rem] font-medium tracking-[0.14em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-1-2-1-1-1\" data-name=\"prompt label\" for=\"broll-prompt\">\n                            Prompt\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-3-1-2-1-1-2\" data-name=\"prompt textarea wrapper\">\n                            <textarea aria-label=\"B-roll prompt\" class=\"min-h-[158px] w-full resize-none rounded-[10px] border border-[#ffa102] bg-[#161922] px-4 py-3 text-[1.15rem] leading-[1.42] text-[#f5f9ce] caret-transparent outline-none ring-2 ring-[#ffa102]/25 ring-offset-2 ring-offset-[#1a1d26] placeholder:text-[#75677f] focus-visible:ring-2 focus-visible:ring-[#ffa102]\" data-kid=\"1-3-1-2-1-1-2-1\" data-name=\"b-roll prompt textarea\" id=\"broll-prompt\" readonly=\"\">A ceramic coffee mug, centered, warm side light</textarea>\n                            <span aria-hidden=\"true\" class=\"broll-caret pointer-events-none absolute top-4 left-4 h-6 w-px bg-[#ffa102]\" data-dynamic=\"true\" data-kid=\"1-3-1-2-1-1-2-2\" data-name=\"blinking input caret\" data-reason=\"opacity toggled by animation\">\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col gap-2\" data-kid=\"1-3-1-2-1-2\" data-name=\"reference input group\">\n                        <span class=\"font-['JetBrains_Mono'] text-[0.69rem] font-medium tracking-[0.14em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"reference label\">\n                            Reference\n                        </span>\n                        <button class=\"group flex min-h-[58px] items-center justify-center gap-2 rounded-[10px] border border-dashed border-[#75677f]/70 bg-transparent px-4 text-[1rem] text-[#c4b8a8] outline-none hover:border-[#ffa102] hover:text-[#f5f9ce] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"attach reference button\" type=\"button\">\n                            <i class=\"size-4 stroke-[1.6] transition-transform duration-200 group-hover:rotate-90\" data-kid=\"1-3-1-2-1-2-2-1\" data-lucide=\"plus\" data-name=\"plus icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-2-1-2-2-2\" data-name=\"attach button text\">\n                                Attach from B-roll\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"flex flex-col gap-2\" data-kid=\"1-3-1-2-1-3\" data-name=\"size selection group\">\n                        <span class=\"font-['JetBrains_Mono'] text-[0.69rem] font-medium tracking-[0.14em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-1-2-1-3-1\" data-name=\"size label\">\n                            Size\n                        </span>\n                        <div aria-label=\"Image size\" class=\"flex w-fit overflow-hidden rounded-[10px] border border-[#75677f]/75\" data-kid=\"1-3-1-2-1-3-2\" data-name=\"aspect ratio button group\" role=\"group\">\n                            <button aria-pressed=\"true\" class=\"min-w-[72px] border-r border-[#ffa102] bg-[#ffa102] px-4 py-2.5 text-[1rem] font-medium text-[#450e16] outline-none focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-[#f5f9ce] focus-visible:ring-inset\" data-kid=\"1-3-1-2-1-3-2-1\" data-name=\"9:16 aspect ratio button\" type=\"button\">\n                                9:16\n                            </button>\n                            <button aria-pressed=\"false\" class=\"min-w-[72px] border-r border-[#75677f]/75 bg-transparent px-4 py-2.5 text-[1rem] text-[#f5f9ce] outline-none hover:bg-[#222632] focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-inset\" data-kid=\"1-3-1-2-1-3-2-2\" data-name=\"1:1 aspect ratio button\" type=\"button\">\n                                1:1\n                            </button>\n                            <button aria-pressed=\"false\" class=\"min-w-[72px] bg-transparent px-4 py-2.5 text-[1rem] text-[#f5f9ce] outline-none hover:bg-[#222632] focus-visible:z-10 focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-inset\" data-kid=\"1-3-1-2-1-3-2-3\" data-name=\"16:9 aspect ratio button\" type=\"button\">\n                                16:9\n                            </button>\n                        </div>\n                    </div>\n                    <button class=\"mt-auto flex min-h-[48px] w-full items-center justify-center gap-2 rounded-[10px] bg-[#ffa102] px-5 py-3 text-[1.08rem] font-semibold text-[#450e16] outline-none shadow-[0_8px_20px_rgba(255,161,2,0.12)] hover:bg-[#f3?] focus-visible:ring-2 focus-visible:ring-[#f5f9ce] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26] active:translate-y-px\" data-kid=\"1-3-1-2-1-4\" data-name=\"generate button\" type=\"button\">\n                        <i class=\"size-4 stroke-[1.8]\" data-kid=\"1-3-1-2-1-4-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                        </i>\n                        <span data-kid=\"1-3-1-2-1-4-2\" data-name=\"generate button text\">\n                            Generate\n                        </span>\n                    </button>\n                </form>\n                <section aria-label=\"B-roll results\" class=\"flex min-h-[390px] min-w-0 flex-col gap-4 px-6 py-6 sm:px-8 md:min-h-0\" data-kid=\"1-3-1-2-2\" data-name=\"b-roll results section\">\n                    <div class=\"flex shrink-0 items-start justify-between gap-4\" data-kid=\"1-3-1-2-2-1\" data-name=\"results header\">\n                        <div class=\"min-w-0\" data-kid=\"1-3-1-2-2-1-1\" data-name=\"results header text container\">\n                            <h2 class=\"font-['JetBrains_Mono'] text-[0.72rem] font-medium tracking-[0.14em] text-[#c4b8a8] uppercase\" data-kid=\"1-3-1-2-2-1-1-1\" data-name=\"results title\">\n                                Results\n                            </h2>\n                            <p class=\"mt-2 text-[1rem] leading-[1.35] text-[#c4b8a8]\" data-kid=\"1-3-1-2-2-1-1-2\" data-name=\"results description text\">\n                                Variants show here. Pick one, then add it to B-roll.\n                            </p>\n                        </div>\n                        <button class=\"shrink-0 rounded-[9px] border border-[#75677f] bg-transparent px-3.5 py-2 text-[0.95rem] font-medium text-[#f5f9ce] outline-none hover:border-[#ffa102] hover:text-[#ffa102] focus-visible:ring-2 focus-visible:ring-[#ffa102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"1-3-1-2-2-1-2\" data-name=\"add to library button\" type=\"button\">\n                            Add to library\n                        </button>\n                    </div>\n                    <div class=\"flex min-h-0 flex-1 items-center justify-center rounded-[12px] border border-[#453239] bg-[#161922] px-6 py-10\" data-kid=\"1-3-1-2-2-2\" data-name=\"results placeholder container\">\n                        <div class=\"flex max-w-[260px] flex-col items-center text-center\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"placeholder illustration\">\n                            <div class=\"relative mb-5 grid size-14 place-items-center rounded-[12px] border border-[#75677f]/70 text-[#c4b8a8]\" data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"scan icon\">\n                                <i class=\"size-7 stroke-[1.15]\" data-kid=\"1-3-1-2-2-2-1-1-1\" data-lucide=\"scan-line\" data-name=\"scan line icon\">\n                                </i>\n                                <i class=\"absolute -top-2 -right-2 size-4 bg-[#161922] stroke-[1.6] text-[#ffa102]\" data-kid=\"1-3-1-2-2-2-1-1-2\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                                </i>\n                            </div>\n                            <p class=\"text-[1.2rem] leading-none text-[#f5f9ce]\" data-kid=\"1-3-1-2-2-2-1-2\" data-name=\"placeholder title text\">\n                                Variants show here\n                            </p>\n                            <p class=\"mt-2 text-[0.98rem] leading-[1.35] text-[#c4b8a8]\" data-kid=\"1-3-1-2-2-2-1-3\" data-name=\"placeholder description text\">\n                                Pick one to add it to B-roll.\n                            </p>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </section>\n    </main>\n    <script>\n        if (window.lucide) window.lucide.createIcons({ attrs: { 'aria-hidden': 'true' } });\n    </script>\n</div>\n",
