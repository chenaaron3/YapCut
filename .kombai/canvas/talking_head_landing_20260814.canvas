      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --ember-cream: #f5f9ce;\n    --ember-ink: #450e16;\n    --ember-purple: #432e6f;\n    --ember-orange: #ffa102;\n    --ember-tomato: #dd5533;\n    --ember-crimson: #bc2d29;\n    --ember-muted: #75677f;\n    --ember-line: rgba(69, 14, 22, .18);\n  }\n\n  .ember-page {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    background: var(--ember-cream);\n    color: var(--ember-ink);\n  }\n\n  .ember-mono {\n    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  .ember-display {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-weight: 700;\n    letter-spacing: -.065em;\n  }\n\n  .ember-grain {\n    background-image: radial-gradient(rgba(245, 249, 206, .17) .65px, transparent .65px);\n    background-size: 8px 8px;\n  }\n\n  .ember-diagonal {\n    background: linear-gradient(124deg, rgba(255, 161, 2, .95) 0%, rgba(221, 85, 51, .74) 42%, rgba(67, 46, 111, .96) 100%);\n  }\n\n  .ember-card-shadow {\n    box-shadow: 8px 9px 0 rgba(69, 14, 22, .92), 0 20px 48px rgba(69, 14, 22, .2);\n  }\n\n  .ember-card-shadow-soft {\n    box-shadow: 0 20px 48px rgba(69, 14, 22, .2);\n  }\n\n  .ember-icon {\n    display: inline-flex;\n    width: 1.1rem;\n    height: 1.1rem;\n    flex: 0 0 auto;\n    align-items: center;\n    justify-content: center;\n    line-height: 1;\n  }\n\n  .ember-orbit {\n    animation: ember-orbit 8s ease-in-out infinite alternate;\n  }\n\n  .ember-nav-item {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: .75rem;\n    text-align: left;\n    color: rgba(69, 14, 22, .42);\n  }\n\n  .ember-nav-item.is-active {\n    color: var(--ember-ink);\n  }\n\n  .ember-nav-dot {\n    display: grid;\n    width: 2rem;\n    height: 2rem;\n    place-items: center;\n    border: 1.5px solid rgba(69, 14, 22, .32);\n    border-radius: 999px;\n    font: 600 .7rem/1 'JetBrains Mono', monospace;\n  }\n\n  .ember-nav-item.is-active .ember-nav-dot {\n    border-color: var(--ember-orange);\n    background: var(--ember-orange);\n    color: var(--ember-ink);\n    box-shadow: 0 0 0 6px rgba(255, 161, 2, .18);\n  }\n\n  .ember-story-panel {\n    position: absolute;\n    inset: 0;\n    visibility: hidden;\n    opacity: 0;\n  }\n\n  .ember-story-panel:first-child {\n    visibility: visible;\n    opacity: 1;\n  }\n\n  .ember-finder-file,\n  .ember-story-cursor,\n  .ember-story-check,\n  .ember-story-mark,\n  .ember-story-chip,\n  .ember-change-menu,\n  .ember-new-chip,\n  .ember-download-toast {\n    will-change: transform, opacity;\n  }\n\n  .ember-story-cursor {\n    position: absolute;\n    z-index: 40;\n    display: grid;\n    width: 2.65rem;\n    height: 2.65rem;\n    place-items: center;\n    border: 2px solid var(--ember-ink);\n    border-radius: 999px;\n    background: var(--ember-orange);\n    color: var(--ember-ink);\n    box-shadow: 5px 6px 0 rgba(69, 14, 22, .92);\n  }\n\n  .ember-story-check {\n    visibility: hidden;\n    opacity: 0;\n    transform: scale(.65);\n  }\n\n  .ember-story-mark,\n  .ember-story-chip,\n  .ember-change-menu,\n  .ember-new-chip,\n  .ember-download-toast {\n    visibility: hidden;\n    opacity: 0;\n  }\n\n  .ember-story-pin {\n    position: sticky;\n    top: 1.5rem;\n  }\n\n  .ember-workflow-stage {\n    min-height: 620px;\n  }\n\n  @keyframes ember-orbit {\n    from { transform: translate3d(0, 0, 0) rotate(-2deg); }\n    to { transform: translate3d(0, -14px, 0) rotate(3deg); }\n  }\n\n  @media (max-width: 767px) {\n    .ember-workflow-stage {\n      min-height: 690px;\n    }\n\n    .ember-story-cursor {\n      transform: scale(.82);\n    }\n  }\n</style>\n<div class=\"ember-page min-h-[100dvh] overflow-x-hidden selection:bg-[#FFA102] selection:text-[#450E16]\" data-kid=\"2\" data-name=\"page layout container\" id=\"ember-page\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none fixed inset-0 z-0 opacity-30 ember-grain\" data-kid=\"2-1\" data-name=\"background grain texture overlay\">\n    </div>\n    <header class=\"relative z-30 border-b border-[#F5F9CE]/20 bg-[#BC2D29] text-[#F5F9CE]\" data-kid=\"2-2\" data-name=\"header navigation container\">\n        <nav aria-label=\"Primary navigation\" class=\"mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-6 py-5 sm:px-10 lg:px-14\" data-kid=\"2-2-1\" data-name=\"primary navigation menu\">\n            <a aria-label=\"Talking Head home\" class=\"flex items-center gap-3 text-lg font-semibold leading-none no-underline\" data-kid=\"2-2-1-1\" data-name=\"talking head home link\" href=\"#product\">\n                <span class=\"grid h-9 w-9 -rotate-6 place-items-center rounded-[8px] border-2 border-[#450E16] bg-[#FFA102] text-sm font-bold text-[#450E16] shadow-[4px_4px_0_#450E16]\" data-kid=\"2-2-1-1-1\" data-name=\"site logo badge\">\n                    TH\n                </span>\n                <span data-kid=\"2-2-1-1-2\" data-name=\"site name text\">\n                    talking head\n                </span>\n            </a>\n            <div class=\"hidden items-center gap-8 text-sm font-semibold md:flex\" data-kid=\"2-2-1-2\" data-name=\"navigation links group\">\n                <a class=\"no-underline opacity-75 hover:opacity-100\" data-kid=\"2-2-1-2-1\" data-name=\"demo navigation link\" href=\"#demo\">\n                    Demo\n                </a>\n                <a class=\"no-underline opacity-75 hover:opacity-100\" data-kid=\"2-2-1-2-2\" data-name=\"product navigation link\" href=\"#features\">\n                    Product\n                </a>\n                <a class=\"no-underline opacity-75 hover:opacity-100\" data-kid=\"2-2-1-2-3\" data-name=\"how it works navigation link\" href=\"#how-it-works\">\n                    How it works\n                </a>\n            </div>\n            <div class=\"flex items-center gap-4 text-sm font-semibold\" data-kid=\"2-2-1-3\" data-name=\"header actions group\">\n                <a class=\"hidden no-underline opacity-75 hover:opacity-100 sm:inline\" data-kid=\"2-2-1-3-1\" data-name=\"sign in action link\" href=\"#cta\">\n                    Sign in\n                </a>\n                <a class=\"inline-flex items-center gap-2 rounded-[16px] border-2 border-[#450E16] bg-[#FFA102] px-4 py-2.5 text-[#450E16] shadow-[4px_4px_0_#450E16] no-underline hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none\" data-kid=\"2-2-1-3-2\" data-name=\"try the editor action button\" href=\"#cta\">\n                    Try the editor\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ember-icon text-[15px]\" data-kid=\"2-2-1-3-2-1\" data-name=\"arrow icon\" style=\"color:#450E16;width:15px;height:15px\">\n                    </i>\n                </a>\n            </div>\n        </nav>\n    </header>\n    <main class=\"relative z-10\" data-kid=\"2-3\" data-name=\"page content area\">\n        <section aria-labelledby=\"hero-title\" class=\"relative overflow-hidden bg-[#450E16] text-[#F5F9CE]\" data-kid=\"2-3-1\" data-name=\"hero section\" id=\"product\">\n            <div aria-hidden=\"true\" class=\"ember-diagonal absolute -top-52 left-[36%] h-[900px] w-24 rotate-[-42deg] opacity-25 blur-[1px]\" data-kid=\"2-3-1-1\" data-name=\"decorative diagonal graphic\">\n            </div>\n            <div aria-hidden=\"true\" class=\"ember-orbit absolute top-16 right-[8%] h-28 w-28 rounded-full border-2 border-[#FFA102]/50\" data-kid=\"2-3-1-2\" data-name=\"orbit animation ring\">\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute top-24 right-[12%] h-3 w-3 rounded-full bg-[#FFA102]\" data-kid=\"2-3-1-3\" data-name=\"floating dot\">\n            </div>\n            <div class=\"relative mx-auto grid max-w-[1280px] items-center gap-14 px-6 py-20 sm:px-10 sm:py-28 lg:grid-cols-[1fr_320px] lg:gap-24 lg:px-14 lg:py-32\" data-kid=\"2-3-1-4\" data-name=\"hero content grid\">\n                <div data-kid=\"2-3-1-4-1\" data-name=\"hero text container\">\n                    <p class=\"ember-mono mb-7 inline-flex items-center gap-2 rounded-[8px] border border-[#FFA102] px-3 py-2 text-[10px] font-semibold uppercase tracking-[.18em] text-[#FFA102]\" data-kid=\"2-3-1-4-1-1\" data-name=\"hero label badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#FFA102]\" data-kid=\"2-3-1-4-1-1-1\" data-name=\"badge dot\">\n                        </span>\n                        Built for vertical Shorts\n                    </p>\n                    <h1 class=\"ember-display m-0 max-w-[920px] text-[clamp(4.5rem,11vw,10rem)] leading-[.78]\" data-kid=\"2-3-1-4-1-2\" data-name=\"hero main headline\">\n                        Edit videos\n                        <br data-kid=\"2-3-1-4-1-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-[#FFA102]\" data-kid=\"2-3-1-4-1-2-2\" data-name=\"highlighted text\">\n                            like you read\n                        </span>\n                        <br data-kid=\"2-3-1-4-1-2-3\" data-name=\"headline line break\"/>\n                        text.\n                    </h1>\n                    <p class=\"mt-8 max-w-[470px] text-xl leading-[1.18] text-[#F5F9CE]/75 sm:text-2xl\" data-kid=\"2-3-1-4-1-3\" data-name=\"hero subheadline text\">\n                        Vertical talking-head edits, from words to ready-to-post.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-3\" data-kid=\"2-3-1-4-1-4\" data-name=\"hero action links container\">\n                        <a class=\"inline-flex items-center gap-2 rounded-[24px] border-2 border-[#450E16] bg-[#F5F9CE] px-5 py-3.5 text-sm font-semibold text-[#450E16] shadow-[6px_6px_0_#FFA102] no-underline hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[3px_3px_0_#FFA102]\" data-kid=\"2-3-1-4-1-4-1\" data-name=\"see shortcut call-to-action button\" href=\"#demo\">\n                            See the shortcut\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-down ember-icon text-[15px]\" data-kid=\"2-3-1-4-1-4-1-1\" data-name=\"arrow icon\" style=\"color:#450E16;width:15px;height:15px\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-[24px] border-2 border-[#F5F9CE]/55 px-5 py-3.5 text-sm font-semibold text-[#F5F9CE] no-underline hover:border-[#FFA102] hover:text-[#FFA102]\" data-kid=\"2-3-1-4-1-4-2\" data-name=\"how it works navigation link\" href=\"#how-it-works\">\n                            How it works\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right ember-icon text-[15px]\" data-kid=\"2-3-1-4-1-4-2-1\" data-name=\"arrow icon\" style=\"color:#FFA102;width:15px;height:15px\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"ember-mono mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[10px] uppercase tracking-[.12em] text-[#F5F9CE]/50\" data-kid=\"2-3-1-4-1-5\" data-name=\"hero feature tags\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"2-3-1-4-1-5-1\" data-name=\"feature tag\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#FFA102]\" data-kid=\"2-3-1-4-1-5-1-1\" data-name=\"feature dot\">\n                            </span>\n                            9:16 only\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"2-3-1-4-1-5-2\" data-name=\"feature tag\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#2DD4BF]\" data-kid=\"2-3-1-4-1-5-2-1\" data-name=\"feature dot\">\n                            </span>\n                            Human in control\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"2-3-1-4-1-5-3\" data-name=\"feature tag\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#A78BFA]\" data-kid=\"2-3-1-4-1-5-3-1\" data-name=\"feature dot\">\n                            </span>\n                            AI first pass\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative mx-auto w-full max-w-[286px] lg:mx-0\" data-kid=\"2-3-1-4-2\" data-name=\"hero visual showcase\">\n                    <div aria-hidden=\"true\" class=\"absolute -inset-10 rounded-full bg-[#FFA102]/20 blur-3xl\" data-kid=\"2-3-1-4-2-1\" data-name=\"visual background blur\">\n                    </div>\n                    <div class=\"relative rotate-[3deg] overflow-hidden rounded-[24px] border-2 border-[#FFA102] bg-[#BC2D29] p-3 shadow-[10px_12px_0_rgba(69,14,22,.85)]\" data-kid=\"2-3-1-4-2-2\" data-name=\"visual showcase container\">\n                        <div class=\"ember-mono mb-3 flex items-center justify-between text-[9px] uppercase tracking-[.16em] text-[#F5F9CE]/70\" data-kid=\"2-3-1-4-2-2-1\" data-name=\"showcase header\">\n                            <span data-kid=\"2-3-1-4-2-2-1-1\" data-name=\"showcase label text\">\n                                short_014 / 9:16\n                            </span>\n                            <span class=\"text-[#FFA102]\" data-kid=\"2-3-1-4-2-2-1-2\" data-name=\"showcase status label\">\n                                AI ready\n                            </span>\n                        </div>\n                        <div class=\"relative aspect-[9/16] overflow-hidden rounded-[16px] border-2 border-[#450E16] bg-[#450E16]\" data-kid=\"2-3-1-4-2-2-2\" data-name=\"video preview frame\">\n                            <img alt=\"Creator recording a vertical talking-head Short, by abdullah ali on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"2-3-1-4-2-2-2-1\" data-name=\"preview image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1698509423508-971fc81ebaa8?auto=format&w=720&q=80&fit=crop\"/>\n                            <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(69,14,22,.08),rgba(69,14,22,.85))]\" data-kid=\"2-3-1-4-2-2-2-2\" data-name=\"frame gradient overlay\">\n                            </div>\n                            <div class=\"absolute top-4 right-4 left-4 flex items-center justify-between\" data-kid=\"2-3-1-4-2-2-2-3\" data-name=\"video metadata bar\">\n                                <span class=\"rounded-full border border-[#F5F9CE]/35 bg-[#450E16]/65 px-2 py-1 text-[9px] font-semibold uppercase tracking-[.12em]\" data-kid=\"2-3-1-4-2-2-2-3-1\" data-name=\"label badge\">\n                                    RAW → CUT\n                                </span>\n                                <span class=\"rounded-full bg-[#FFA102] px-2 py-1 text-[9px] font-bold text-[#450E16]\" data-kid=\"2-3-1-4-2-2-2-3-2\" data-name=\"video duration badge\">\n                                    00:28\n                                </span>\n                            </div>\n                            <div class=\"absolute right-4 bottom-4 left-4 rounded-[16px] border-2 border-[#450E16] bg-[#F5F9CE] px-3 py-3 text-center text-[#450E16]\" data-kid=\"2-3-1-4-2-2-2-4\" data-name=\"preview caption card\">\n                                <p class=\"ember-mono m-0 text-[8px] uppercase tracking-[.16em]\" data-kid=\"2-3-1-4-2-2-2-4-1\" data-name=\"caption label\">\n                                    caption / emphasis\n                                </p>\n                                <p class=\"mt-2 mb-0 text-2xl font-semibold leading-none\" data-kid=\"2-3-1-4-2-2-2-4-2\" data-name=\"caption text\">\n                                    Make it\n                                    <span class=\"text-[#DD5533]\" data-kid=\"2-3-1-4-2-2-2-4-2-1\" data-name=\"caption highlighted text\">\n                                        land.\n                                    </span>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"absolute -right-8 top-14 rotate-[8deg] rounded-[16px] border-2 border-[#450E16] bg-[#FFA102] px-3 py-2 text-[#450E16] shadow-[5px_5px_0_#450E16]\" data-kid=\"2-3-1-4-2-3\" data-name=\"drag hint badge\">\n                        <span class=\"ember-mono text-[9px] font-semibold uppercase tracking-[.12em]\" data-kid=\"2-3-1-4-2-3-1\" data-name=\"drag hint text\">\n                            drag edits here\n                        </span>\n                    </div>\n                    <div class=\"absolute -bottom-5 -left-12 -rotate-[8deg] rounded-[16px] border-2 border-[#450E16] bg-[#2DD4BF] px-3 py-2 text-[#450E16] shadow-[5px_5px_0_#450E16]\" data-kid=\"2-3-1-4-2-4\" data-name=\"shorts feature badge\">\n                        <i aria-hidden=\"true\" class=\"ti ti-device-mobile ember-icon mr-1 text-[14px]\" data-kid=\"2-3-1-4-2-4-1\" data-name=\"mobile icon\" style=\"color:#450E16;width:14px;height:14px\">\n                        </i>\n                        <span class=\"ember-mono text-[9px] font-semibold uppercase tracking-[.12em]\" data-kid=\"2-3-1-4-2-4-2\" data-name=\"shorts text\">\n                            shorts first\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"demo-title\" class=\"bg-[#F5F9CE] px-6 py-24 sm:px-10 lg:px-14 lg:py-32\" data-kid=\"2-3-2\" data-name=\"demo section\" id=\"demo\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"2-3-2-1\" data-name=\"demo layout container\">\n                <div class=\"flex flex-col justify-between gap-6 lg:flex-row lg:items-end\" data-kid=\"2-3-2-1-1\" data-name=\"demo header container\">\n                    <div data-kid=\"2-3-2-1-1-1\" data-name=\"demo section label\">\n                        <p class=\"ember-mono mb-3 text-[10px] font-semibold uppercase tracking-[.2em] text-[#DD5533]\" data-kid=\"2-3-2-1-1-1-1\" data-name=\"demo section title\">\n                            The shortcut\n                        </p>\n                        <h2 class=\"ember-display m-0 max-w-[760px] text-[clamp(3.8rem,8vw,8rem)] leading-[.78]\" data-kid=\"2-3-2-1-1-1-2\" data-name=\"demo section headline\" id=\"demo-title\">\n                            Raw in.\n                            <br data-kid=\"2-3-2-1-1-1-2-1\" data-name=\"headline line break\"/>\n                            <span class=\"text-[#DD5533]\" data-kid=\"2-3-2-1-1-1-2-2\" data-name=\"highlighted demo text\">\n                                Ready out.\n                            </span>\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[250px] text-xl leading-[1.12] text-[#432E6F]\" data-kid=\"2-3-2-1-1-2\" data-name=\"demo subheadline text\">\n                        One AI click turns a vertical take into a starting point.\n                    </p>\n                </div>\n                <div class=\"mt-16 grid items-center gap-8 lg:grid-cols-[1fr_150px_1fr] lg:gap-10\" data-kid=\"2-3-2-1-2\" data-name=\"demo comparison grid\">\n                    <article class=\"mx-auto w-full max-w-[270px] rotate-[-2deg] rounded-[24px] border-2 border-[#450E16] bg-[#BC2D29] p-3 text-[#F5F9CE] ember-card-shadow\" data-kid=\"2-3-2-1-2-1\" data-name=\"raw footage card\">\n                        <div class=\"ember-mono flex items-center justify-between border-b border-[#F5F9CE]/25 pb-3 text-[9px] uppercase tracking-[.14em]\" data-kid=\"2-3-2-1-2-1-1\" data-name=\"raw footage header\">\n                            <span data-kid=\"2-3-2-1-2-1-1-1\" data-name=\"label text\">\n                                Before / raw\n                            </span>\n                            <span class=\"text-[#FFA102]\" data-kid=\"2-3-2-1-2-1-1-2\" data-name=\"raw timestamp label\">\n                                03:12:42\n                            </span>\n                        </div>\n                        <div class=\"relative mt-3 aspect-[9/16] overflow-hidden rounded-[16px] border-2 border-[#450E16] bg-[#450E16]\" data-kid=\"2-3-2-1-2-1-2\" data-name=\"raw video frame\">\n                            <img alt=\"Raw vertical talking-head footage, by abdullah ali on Unsplash\" class=\"h-full w-full object-cover grayscale brightness-75\" data-kid=\"2-3-2-1-2-1-2-1\" data-name=\"raw video preview image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1698509423508-971fc81ebaa8?auto=format&w=720&q=80&fit=crop\"/>\n                            <div class=\"absolute inset-0 bg-[#450E16]/30\" data-kid=\"2-3-2-1-2-1-2-2\" data-name=\"frame overlay\">\n                            </div>\n                            <span class=\"ember-mono absolute top-4 left-4 rounded-[8px] border border-[#F5F9CE]/50 bg-[#450E16]/70 px-2 py-1 text-[8px] uppercase tracking-[.12em]\" data-kid=\"2-3-2-1-2-1-2-3\" data-name=\"raw label\">\n                                Raw footage\n                            </span>\n                            <span class=\"absolute right-4 bottom-5 left-4 rounded-[8px] border border-[#F5F9CE]/25 bg-[#450E16]/75 px-3 py-2 text-lg leading-none text-[#F5F9CE]/75\" data-kid=\"2-3-2-1-2-1-2-4\" data-name=\"filler transcript text\">\n                                “um... so...”\n                            </span>\n                        </div>\n                        <div class=\"mt-3 rounded-[12px] border-2 border-[#450E16] bg-[#450E16] p-2\" data-kid=\"2-3-2-1-2-1-3\" data-name=\"raw footage timeline visual\">\n                            <div cl