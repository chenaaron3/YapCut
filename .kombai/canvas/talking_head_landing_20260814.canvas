            <svg aria-hidden=\"true\" class=\"absolute inset-0 h-full w-full\" data-kid=\"2-5-3-2-2-2-4\" fill=\"none\" viewbox=\"0 0 430 220\">\n                            <path d=\"M30 25 C110 100 250 52 400 185 M45 185 C145 85 280 152 404 29\" stroke=\"#fb7185\" stroke-linecap=\"round\" stroke-width=\"8\">\n                            </path>\n                        </svg>\n                    </div>\n                    <p class=\"font-satoshi mt-5 text-sm leading-[1.35] text-[#f6f0e5]/58\" data-kid=\"2-5-3-2-2-3\">\n                        Built for talking heads. We stripped out the complicated features other editors make you learn first.\n                    </p>\n                </article>\n                <article class=\"relative border-4 border-[#12141a] bg-[#a78bfa] p-6 text-[#12141a] lg:col-span-5 lg:rotate-[1.5deg]\" data-kid=\"2-5-3-2-3\">\n                    <span class=\"font-satoshi text-[11px] font-black uppercase tracking-[0.2em]\" data-kid=\"2-5-3-2-3-1\">\n                        03 / auto captions\n                    </span>\n                    <h3 class=\"font-tanker mt-3 text-5xl leading-[.84] tracking-[-0.03em]\" data-kid=\"2-5-3-2-3-2\">\n                        Say it.\n                        <br data-kid=\"2-5-3-2-3-2-1\"/>\n                        Style it.\n                    </h3>\n                    <div class=\"mt-9 border-4 border-[#12141a] bg-[#12141a] p-4 text-[#f6f0e5]\" data-kid=\"2-5-3-2-3-3\">\n                        <div class=\"mb-5 flex justify-between text-[10px] font-black uppercase tracking-[0.12em] text-[#f6f0e5]/50\" data-kid=\"2-5-3-2-3-3-1\">\n                            <span data-kid=\"2-5-3-2-3-3-1-1\">\n                                Caption presets\n                            </span>\n                            <span class=\"text-[#2dd4bf]\" data-kid=\"2-5-3-2-3-3-1-2\">\n                                Auto ✓\n                            </span>\n                        </div>\n                        <p class=\"font-satoshi text-3xl font-black uppercase leading-[.93]\" data-kid=\"2-5-3-2-3-3-2\">\n                            The\n                            <span class=\"text-[#2dd4bf]\" data-kid=\"2-5-3-2-3-3-2-1\">\n                                point\n                            </span>\n                            <br data-kid=\"2-5-3-2-3-3-2-2\"/>\n                            is to\n                            <span class=\"bg-[#fb7185] px-1 text-[#12141a]\" data-kid=\"2-5-3-2-3-3-2-3\">\n                                connect.\n                            </span>\n                        </p>\n                        <div class=\"mt-5 grid grid-cols-3 gap-2 text-center text-[10px] font-black uppercase\" data-kid=\"2-5-3-2-3-3-3\">\n                            <span class=\"border-2 border-[#2dd4bf] py-2 text-[#2dd4bf]\" data-kid=\"2-5-3-2-3-3-3-1\">\n                                emphasis\n                            </span>\n                            <span class=\"border-2 border-[#c9a227] py-2 text-[#c9a227]\" data-kid=\"2-5-3-2-3-3-3-2\">\n                                quotes\n                            </span>\n                            <span class=\"border-2 border-[#38bdf8] py-2 text-[#38bdf8]\" data-kid=\"2-5-3-2-3-3-3-3\">\n                                titles\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"font-script absolute right-5 bottom-4 rotate-[-8deg] text-2xl\" data-kid=\"2-5-3-2-3-4\">\n                        your voice, louder\n                    </span>\n                </article>\n                <article class=\"relative border-4 border-[#12141a] bg-[#c9a227] p-6 text-[#12141a] sticker-shadow lg:col-span-7 lg:-mt-12 lg:rotate-[-1deg]\" data-kid=\"2-5-3-2-4\">\n                    <div class=\"flex items-start justify-between gap-6\" data-kid=\"2-5-3-2-4-1\">\n                        <div data-kid=\"2-5-3-2-4-1-1\">\n                            <span class=\"font-satoshi text-[11px] font-black uppercase tracking-[0.2em]\" data-kid=\"2-5-3-2-4-1-1-1\">\n                                04 / the whole kit\n                            </span>\n                            <h3 class=\"font-tanker mt-3 text-5xl leading-[.84] tracking-[-0.03em] sm:text-6xl\" data-kid=\"2-5-3-2-4-1-1-2\">\n                                Zoom. SFX.\n                                <br data-kid=\"2-5-3-2-4-1-1-2-1\"/>\n                                B-roll. VFX.\n                                <br data-kid=\"2-5-3-2-4-1-1-2-2\"/>\n                                Text overlay.\n                            </h3>\n                        </div>\n                        <i aria-hidden=\"true\" class=\"ti ti-sparkles text-5xl\" data-kid=\"2-5-3-2-4-1-2\" style=\"color:#12141a;width:48px;height:48px\">\n                        </i>\n                    </div>\n                    <div class=\"mt-8 flex flex-wrap gap-3\" data-kid=\"2-5-3-2-4-2\">\n                        <span class=\"border-4 border-[#12141a] bg-[#3b82f6] px-4 py-3 font-satoshi text-xs font-black uppercase sticker-shadow-sm\" data-kid=\"2-5-3-2-4-2-1\">\n                            ↗ Zoom\n                        </span>\n                        <span class=\"border-4 border-[#12141a] bg-[#2dd4bf] px-4 py-3 font-satoshi text-xs font-black uppercase sticker-shadow-sm\" data-kid=\"2-5-3-2-4-2-2\">\n                            ♫ SFX\n                        </span>\n                        <span class=\"border-4 border-[#12141a] bg-[#fb7185] px-4 py-3 font-satoshi text-xs font-black uppercase sticker-shadow-sm\" data-kid=\"2-5-3-2-4-2-3\">\n                            ▣ B-roll\n                        </span>\n                        <span class=\"border-4 border-[#12141a] bg-[#a78bfa] px-4 py-3 font-satoshi text-xs font-black uppercase sticker-shadow-sm\" data-kid=\"2-5-3-2-4-2-4\">\n                            ✦ VFX\n                        </span>\n                        <span class=\"border-4 border-[#12141a] bg-[#f6f0e5] px-4 py-3 font-satoshi text-xs font-black uppercase sticker-shadow-sm\" data-kid=\"2-5-3-2-4-2-5\">\n                            T Text overlay\n                        </span>\n                    </div>\n                    <p class=\"font-comico mt-8 max-w-[520px] text-2xl leading-[1.05]\" data-kid=\"2-5-3-2-4-3\">\n                        All the useful bits. None of the\n                        <span class=\"scribble\" data-kid=\"2-5-3-2-4-3-1\">\n                            editor gymnastics.\n                        </span>\n                    </p>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"how-title\" class=\"relative border-y-4 border-[#f6f0e5]/10 bg-[#f6f0e5] px-6 py-24 text-[#12141a] sm:px-10 lg:px-14 lg:py-36\" data-kid=\"2-5-4\" id=\"how-it-works\">\n            <div class=\"mx-auto max-w-[1280px]\" data-kid=\"2-5-4-1\">\n                <div class=\"flex flex-col justify-between gap-8 lg:flex-row lg:items-end\" data-kid=\"2-5-4-1-1\">\n                    <div data-kid=\"2-5-4-1-1-1\">\n                        <p class=\"font-satoshi mb-3 text-xs font-black uppercase tracking-[0.2em] text-[#fb7185]\" data-kid=\"2-5-4-1-1-1-1\">\n                            The simple loop\n                        </p>\n                        <h2 class=\"font-tanker text-[clamp(3.5rem,7vw,7.4rem)] leading-[.84] tracking-[-0.04em]\" data-kid=\"2-5-4-1-1-1-2\" id=\"how-title\">\n                            Four moves.\n                            <br data-kid=\"2-5-4-1-1-1-2-1\"/>\n                            <span class=\"text-[#3b82f6]\" data-kid=\"2-5-4-1-1-1-2-2\">\n                                That’s it.\n                            </span>\n                        </h2>\n                    </div>\n                    <p class=\"font-comico max-w-[320px] rotate-[2deg] text-2xl leading-[1.05]\" data-kid=\"2-5-4-1-1-2\">\n                        From raw thought to ready-to-post, without leaving the words.\n                    </p>\n                </div>\n                <div class=\"relative mt-20\" data-kid=\"2-5-4-1-2\">\n                    <svg aria-hidden=\"true\" class=\"pointer-events-none absolute inset-x-0 top-14 hidden h-[430px] w-full lg:block\" data-kid=\"2-5-4-1-2-1\" fill=\"none\" viewbox=\"0 0 1200 430\">\n                        <path d=\"M115 100 C295 6 410 16 525 105 C644 197 744 280 897 209 C1030 148 1066 92 1120 105\" stroke=\"#12141a\" stroke-dasharray=\"14 14\" stroke-linecap=\"round\" stroke-width=\"5\">\n                        </path>\n                        <path d=\"M1106 90 L1134 106 L1107 122\" stroke=\"#12141a\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"5\">\n                        </path>\n                    </svg>\n                    <div class=\"relative grid gap-7 md:grid-cols-2 lg:grid-cols-4\" data-kid=\"2-5-4-1-2-2\">\n                        <article class=\"relative border-4 border-[#12141a] bg-[#2dd4bf] p-5 sticker-shadow-sm lg:mt-10 lg:rotate-[-2deg]\" data-kid=\"2-5-4-1-2-2-1\">\n                            <span class=\"font-tanker absolute top-1 right-3 text-8xl leading-none text-[#12141a]/10\" data-kid=\"2-5-4-1-2-2-1-1\">\n                                01\n                            </span>\n                            <div class=\"relative\" data-kid=\"2-5-4-1-2-2-1-2\">\n                                <span class=\"grid h-12 w-12 place-items-center border-4 border-[#12141a] bg-[#f6f0e5] text-2xl\" data-kid=\"2-5-4-1-2-2-1-2-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-upload\" data-kid=\"2-5-4-1-2-2-1-2-1-1\" style=\"color:#12141a;width:25px;height:25px\">\n                                    </i>\n                                </span>\n                                <h3 class=\"font-satoshi mt-12 text-xl font-black uppercase\" data-kid=\"2-5-4-1-2-2-1-2-2\">\n                                    Upload the raw\n                                </h3>\n                                <p class=\"font-satoshi mt-3 text-sm leading-[1.35] text-[#12141a]/70\" data-kid=\"2-5-4-1-2-2-1-2-3\">\n                                    Drop in the video of you talking. No prep. No bins. No project ceremony.\n                                </p>\n                                <div class=\"mt-5 border-2 border-dashed border-[#12141a] p-3 text-center font-satoshi text-[10px] font-black uppercase\" data-kid=\"2-5-4-1-2-2-1-2-4\">\n                                    drop .mp4 here\n                                </div>\n                            </div>\n                        </article>\n                        <article class=\"relative border-4 border-[#12141a] bg-[#a78bfa] p-5 sticker-shadow-sm md:mt-14 lg:-mt-4 lg:rotate-[2deg]\" data-kid=\"2-5-4-1-2-2-2\">\n                            <span class=\"font-tanker absolute top-1 right-3 text-8xl leading-none text-[#12141a]/10\" data-kid=\"2-5-4-1-2-2-2-1\">\n                                02\n                            </span>\n                            <div class=\"relative\" data-kid=\"2-5-4-1-2-2-2-2\">\n                                <span class=\"grid h-12 w-12 place-items-center border-4 border-[#12141a] bg-[#f6f0e5] text-2xl\" data-kid=\"2-5-4-1-2-2-2-2-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-robot\" data-kid=\"2-5-4-1-2-2-2-2-1-1\" style=\"color:#12141a;width:25px;height:25px\">\n                                    </i>\n                                </span>\n                                <h3 class=\"font-satoshi mt-12 text-xl font-black uppercase\" data-kid=\"2-5-4-1-2-2-2-2-2\">\n                                    Let AI take first pass\n                                </h3>\n                                <p class=\"font-satoshi mt-3 text-sm leading-[1.35] text-[#12141a]/70\" data-kid=\"2-5-4-1-2-2-2-2-3\">\n                                    Transcription, captions, title, zooms, SFX and VFX land on the words automatically.\n                                </p>\n                                <div class=\"mt-5 flex items-center gap-2 border-2 border-[#12141a] bg-[#f6f0e5] p-3 font-satoshi text-[10px] font-black uppercase\" data-dynamic=\"true\" data-kid=\"2-5-4-1-2-2-2-2-4\" data-name=\"analyzing state indicator\" data-reason=\"pulsing animation state via JS\">\n                                    <span class=\"h-2 w-2 animate-pulse rounded-full bg-[#fb7185]\" data-dynamic=\"true\" data-kid=\"2-5-4-1-2-2-2-2-4-1\" data-name=\"pulsing indicator dot\" data-reason=\"animation state via JS\">\n                                    </span>\n                                    analyzing your voice...\n                                </div>\n                            </div>\n                        </article>\n                        <article class=\"relative border-4 border-[#12141a] bg-[#fb7185] p-5 sticker-shadow-sm lg:mt-16 lg:rotate-[-1deg]\" data-kid=\"2-5-4-1-2-2-3\">\n                            <span class=\"font-tanker absolute top-1 right-3 text-8xl leading-none text-[#12141a]/10\" data-kid=\"2-5-4-1-2-2-3-1\">\n                                03\n                            </span>\n                            <div class=\"relative\" data-kid=\"2-5-4-1-2-2-3-2\">\n                                <span class=\"grid h-12 w-12 place-items-center border-4 border-[#12141a] bg-[#f6f0e5] text-2xl\" data-kid=\"2-5-4-1-2-2-3-2-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-pencil\" data-kid=\"2-5-4-1-2-2-3-2-1-1\" style=\"color:#12141a;width:25px;height:25px\">\n                                    </i>\n                                </span>\n                                <h3 class=\"font-satoshi mt-12 text-xl font-black uppercase\" data-kid=\"2-5-4-1-2-2-3-2-2\">\n                                    Make it yours\n                                </h3>\n                                <p class=\"font-satoshi mt-3 text-sm leading-[1.35] text-[#12141a]/70\" data-kid=\"2-5-4-1-2-2-3-2-3\">\n                                    Clean up the pass in a full editor that stays close to the transcript and out of your way.\n                                </p>\n                                <div class=\"mt-5 border-2 border-[#12141a] bg-[#12141a] p-3 font-comico text-lg text-[#f6f0e5]\" data-kid=\"2-5-4-1-2-2-3-2-4\">\n                                    click word → edit happens\n                                </div>\n                            </div>\n                        </article>\n                        <article class=\"relative border-4 border-[#12141a] bg-[#3b82f6] p-5 text-[#f6f0e5] sticker-shadow-sm md:mt-8 lg:mt-2 lg:rotate-[2deg]\" data-kid=\"2-5-4-1-2-2-4\">\n                            <span class=\"font-tanker absolute top-1 right-3 text-8xl leading-none text-[#12141a]/20\" data-kid=\"2-5-4-1-2-2-4-1\">\n                                04\n                            </span>\n                            <div class=\"relative\" data-kid=\"2-5-4-1-2-2-4-2\">\n                                <span class=\"grid h-12 w-12 place-items-center border-4 border-[#12141a] bg-[#f6f0e5] text-2xl\" data-kid=\"2-5-4-1-2-2-4-2-1\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-download\" data-kid=\"2-5-4-1-2-2-4-2-1-1\" style=\"color:#12141a;width:25px;height:25px\">\n                                    </i>\n                                </span>\n                                <h3 class=\"font-satoshi mt-12 text-xl font-black uppercase\" data-kid=\"2-5-4-1-2-2-4-2-2\">\n                                    Export + post\n                                </h3>\n                                <p class=\"font-satoshi mt-3 text-sm leading-[1.35] text-[#f6f0e5]/75\" data-kid=\"2-5-4-1-2-2-4-2-3\">\n                                    Hit export, grab your finished video and get back to the part where people hear you.\n                                </p>\n                                <div class=\"mt-5 border-2 border-[#12141a] bg-[#2dd4bf] p-3 text-center font-satoshi text-[10px] font-black uppercase text-[#12141a]\" data-kid=\"2-5-4-1-2-2-4-2-4\">\n                                    1080p / ready ✓\n                                </div>\n                            </div>\n                        </article>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-title\" class=\"relative overflow-hidden bg-[#fb7185] px-6 py-24 text-[#12141a] sm:px-10 lg:px-14 lg:py-36\" data-kid=\"2-5-5\" id=\"cta\">\n            <div aria-hidden=\"true\" class=\"absolute -top-24 -right-20 h-80 w-80 rounded-full border-[28px] border-[#12141a]/10\" data-kid=\"2-5-5-1\">\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute bottom-[-120px] left-[-70px] h-72 w-72 rounded-full border-[34px] border-[#f6f0e5]/15\" data-kid=\"2-5-5-2\">\n            </div>\n            <div class=\"relative mx-auto max-w-[1280px] text-center\" data-kid=\"2-5-5-3\">\n                <p class=\"font-satoshi text-xs font-black uppercase tracking-[0.2em]\" data-kid=\"2-5-5-3-1\">\n                    The next take starts here\n                </p>\n                <h2 class=\"font-tanker mx-auto mt-5 max-w-[1100px] text-[clamp(4rem,10vw,10rem)] leading-[.82] tracking-[-0.05em]\" data-kid=\"2-5-5-3-2\" id=\"cta-title\">\n                    Make the words\n                    <br data-kid=\"2-5-5-3-2-1\"/>\n                    <span class=\"text-[#f6f0e5]\" data-kid=\"2-5-5-3-2-2\">\n                        do more.\n                    </span>\n                </h2>\n                <div class=\"mt-11 flex flex-col items-center justify-center gap-4 sm:flex-row\" data-kid=\"2-5-5-3-3\">\n                    <a class=\"font-satoshi border-4 border-[#12141a] bg-[#f6f0e5] px-7 py-5 text-sm font-black uppercase tracking-[0.1em] text-[#12141a] sticker-shadow-sm hover:translate-x-1 hover:translate-y-1 hover:shadow-none\" data-kid=\"2-5-5-3-3-1\" href=\"#top\">\n                        Try Talking Head free ↗\n                    </a>\n                    <span class=\"font-satoshi text-xs font-black uppercase tracking-[0.12em] text-[#12141a]/65\" data-kid=\"2-5-5-3-3-2\">\n                        No credit card. Just your voice.\n                    </span>\n                </div>\n                <p class=\"font-comico mt-9 text-xl\" data-kid=\"2-5-5-3-4\">\n                    No timeline maze. No 47-tab learning curve.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t-4 border-[#f6f0e5]/10 bg-[#12141a] px-6 py-8 sm:px-10 lg:px-14\" data-kid=\"2-6\" id=\"faq\">\n        <div class=\"mx-auto flex max-w-[1280px] flex-col justify-between gap-5 text-xs font-bold uppercase tracking-[0.14em] text-[#f6f0e5]/45 sm:flex-row sm:items-center\" data-kid=\"2-6-1\">\n            <span class=\"font-satoshi text-[#f6f0e5]\" data-kid=\"2-6-1-1\">\n                talking\n                <span class=\"text-[#2dd4bf]\" data-kid=\"2-6-1-1-1\">\n                    head\n                </span>\n                © 2026\n            </span>\n            <div class=\"flex gap-6\" data-kid=\"2-6-1-2\">\n                <a class=\"hover:text-[#2dd4bf]\" data-kid=\"2-6-1-2-1\" href=\"#features\">\n                    Product\n                </a>\n                <a class=\"hover:text-[#2dd4bf]\" data-kid=\"2-6-1-2-2\" href=\"#how-it-works\">\n                    Why it works\n                </a>\n                <a class=\"hover:text-[#2dd4bf]\" data-kid=\"2-6-1-2-3\" href=\"#faq\">\n                    FAQ\n                </a>\n            </div>\n            <span data-kid=\"2-6-1-3\">\n                Made for the talking parts.\n            </span>\n        </div>\n    </footer>\n</div>\n",
