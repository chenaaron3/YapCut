      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @font-face { font-family: \"Tanker\"; src: url(\"/api/local/images/public/fonts/Tanker-Regular.woff2\") format(\"woff2\"); font-weight: 400; font-display: swap; }\n  @font-face { font-family: \"Satoshi\"; src: url(\"/api/local/images/public/fonts/Satoshi-Black.woff2\") format(\"woff2\"); font-weight: 900; font-display: swap; }\n  @font-face { font-family: \"Comico\"; src: url(\"/api/local/images/public/fonts/Comico-Regular.woff2\") format(\"woff2\"); font-weight: 400; font-display: swap; }\n  @font-face { font-family: \"Dancing Script\"; src: url(\"/api/local/images/public/fonts/DancingScript-Bold.woff2\") format(\"woff2\"); font-weight: 700; font-display: swap; }\n  .font-tanker { font-family: \"Tanker\", Impact, sans-serif; }\n  .font-satoshi { font-family: \"Satoshi\", \"IBM Plex Sans\", sans-serif; }\n  .font-comico { font-family: \"Comico\", \"IBM Plex Sans\", sans-serif; }\n  .font-script { font-family: \"Dancing Script\", cursive; }\n  .grain { background-image: radial-gradient(rgba(246,240,229,.11) .7px, transparent .7px); background-size: 9px 9px; }\n  .scribble { text-decoration: underline; text-decoration-thickness: 5px; text-underline-offset: 6px; text-decoration-color: #2dd4bf; }\n  .sticker-shadow { box-shadow: 8px 8px 0 #0b0d11; }\n  .sticker-shadow-sm { box-shadow: 5px 5px 0 #0b0d11; }\n  .bob { animation: bob 4.5s ease-in-out infinite; }\n  .bob-delay { animation: bob 5.2s ease-in-out 500ms infinite; }\n  @keyframes bob { 0%,100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-8px) rotate(1deg); } }\n</style>\n<div class=\"min-h-screen overflow-hidden bg-[#12141a] text-[#f6f0e5] selection:bg-[#2dd4bf] selection:text-[#12141a]\" data-kid=\"2\" style=\"--ink:#12141a; --paper:#f6f0e5; --coral:#fb7185; --mint:#2dd4bf; --violet:#a78bfa; --blue:#3b82f6; --gold:#c9a227; --cyan:#38bdf8;\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none fixed inset-0 opacity-20 grain\" data-kid=\"2-1\">\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute top-0 left-1/2 h-[760px] w-[760px] -translate-x-1/2 rounded-full bg-[#a78bfa]/10 blur-3xl\" data-kid=\"2-2\">\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute top-[820px] -right-48 h-[580px] w-[580px] rounded-full bg-[#2dd4bf]/8 blur-3xl\" data-kid=\"2-3\">\n    </div>\n    <header class=\"relative z-20 mx-auto flex max-w-[1280px] items-center justify-between px-6 py-6 sm:px-10 lg:px-14\" data-kid=\"2-4\">\n        <a aria-label=\"Talking Head home\" class=\"font-satoshi flex items-center gap-3 text-[15px] font-black uppercase tracking-[-0.04em]\" data-kid=\"2-4-1\" href=\"#top\">\n            <span class=\"grid h-9 w-9 rotate-[-8deg] place-items-center border-4 border-[#12141a] bg-[#2dd4bf] text-[#12141a] sticker-shadow-sm\" data-kid=\"2-4-1-1\">\n                TH\n            </span>\n            <span data-kid=\"2-4-1-2\">\n                talking\n                <br data-kid=\"2-4-1-2-1\"/>\n                <span class=\"text-[#2dd4bf]\" data-kid=\"2-4-1-2-2\">\n                    head\n                </span>\n            </span>\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"hidden items-center gap-8 text-xs font-bold uppercase tracking-[0.18em] text-[#f6f0e5]/65 md:flex\" data-kid=\"2-4-2\">\n            <a class=\"hover:text-[#2dd4bf]\" data-kid=\"2-4-2-1\" href=\"#features\">\n                Product\n            </a>\n            <a class=\"hover:text-[#2dd4bf]\" data-kid=\"2-4-2-2\" href=\"#how-it-works\">\n                Why it works\n            </a>\n            <a class=\"hover:text-[#2dd4bf]\" data-kid=\"2-4-2-3\" href=\"#faq\">\n                FAQ\n            </a>\n        </nav>\n        <div class=\"flex items-center gap-3\" data-kid=\"2-4-3\">\n            <a class=\"hidden text-xs font-bold uppercase tracking-[0.16em] text-[#f6f0e5]/65 hover:text-[#f6f0e5] sm:inline\" data-kid=\"2-4-3-1\" href=\"#demo\">\n                Sign in\n            </a>\n            <a class=\"font-satoshi rotate-[2deg] border-4 border-[#12141a] bg-[#fb7185] px-4 py-3 text-xs font-black uppercase tracking-[0.12em] text-[#12141a] sticker-shadow-sm hover:translate-x-1 hover:translate-y-1 hover:shadow-none\" data-kid=\"2-4-3-2\" href=\"#cta\">\n                Try the editor\n                <span class=\"ml-1\" data-kid=\"2-4-3-2-1\">\n                    ↗\n                </span>\n            </a>\n        </div>\n    </header>\n    <main class=\"relative z-10\" data-kid=\"2-5\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"relative mx-auto max-w-[1280px] px-6 pt-14 pb-28 sm:px-10 sm:pt-20 lg:px-14 lg:pt-24 lg:pb-36\" data-kid=\"2-5-1\">\n            <div class=\"absolute top-16 right-10 hidden h-32 w-32 rounded-full border-4 border-[#fb7185] lg:block\" data-kid=\"2-5-1-1\">\n            </div>\n            <div class=\"absolute top-24 right-24 hidden h-4 w-4 rounded-full bg-[#c9a227] lg:block\" data-kid=\"2-5-1-2\">\n            </div>\n            <div class=\"max-w-[1080px]\" data-kid=\"2-5-1-3\">\n                <p class=\"font-satoshi mb-7 inline-flex -rotate-[2deg] items-center gap-2 border-2 border-[#2dd4bf] px-3 py-2 text-[11px] font-black uppercase tracking-[0.19em] text-[#2dd4bf]\" data-kid=\"2-5-1-3-1\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#2dd4bf]\" data-kid=\"2-5-1-3-1-1\">\n                    </span>\n                    Made for people who talk to camera\n                </p>\n                <h1 class=\"font-tanker max-w-[1160px] text-[clamp(4rem,10.5vw,9.8rem)] leading-[.83] tracking-[-0.045em] text-[#f6f0e5]\" data-kid=\"2-5-1-3-2\" id=\"hero-title\">\n                    Edit videos\n                    <br data-kid=\"2-5-1-3-2-1\"/>\n                    <span class=\"text-[#fb7185]\" data-kid=\"2-5-1-3-2-2\">\n                        like you read\n                    </span>\n                    <br data-kid=\"2-5-1-3-2-3\"/>\n                    text.\n                </h1>\n                <div class=\"mt-9 grid max-w-[980px] gap-8 lg:grid-cols-[1fr_330px] lg:items-end\" data-kid=\"2-5-1-3-3\">\n                    <p class=\"font-satoshi max-w-[720px] text-lg leading-[1.35] text-[#f6f0e5]/72 sm:text-2xl\" data-kid=\"2-5-1-3-3-1\">\n                        Editing a simple talking-head video can eat an entire afternoon. Talking Head gives you a human-first drag-and-drop canvas where\n                        <span class=\"text-[#2dd4bf]\" data-kid=\"2-5-1-3-3-1-1\">\n                            AI is your sidekick\n                        </span>\n                        , not your boss.\n                    </p>\n                    <div class=\"flex flex-wrap gap-3 lg:justify-end\" data-kid=\"2-5-1-3-3-2\">\n                        <a class=\"font-satoshi border-4 border-[#f6f0e5] bg-[#f6f0e5] px-5 py-4 text-sm font-black uppercase tracking-[0.08em] text-[#12141a] sticker-shadow-sm hover:translate-x-1 hover:translate-y-1 hover:shadow-none\" data-kid=\"2-5-1-3-3-2-1\" href=\"#demo\">\n                            Start free\n                            <span class=\"ml-2\" data-kid=\"2-5-1-3-3-2-1-1\">\n                                →\n                            </span>\n                        </a>\n                        <a class=\"font-satoshi border-4 border-[#38bdf8] px-5 py-4 text-sm font-black uppercase tracking-[0.08em] text-[#38bdf8] hover:bg-[#38bdf8] hover:text-[#12141a]\" data-kid=\"2-5-1-3-3-2-2\" href=\"#demo\">\n                            Watch the magic\n                            <span class=\"ml-2\" data-kid=\"2-5-1-3-3-2-2-1\">\n                                ▶\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"relative mt-20 min-h-[310px] sm:mt-24 sm:min-h-[350px]\" data-kid=\"2-5-1-4\">\n                <div class=\"absolute left-[2%] top-4 z-10 w-[250px] -rotate-[7deg] border-4 border-[#12141a] bg-[#f6f0e5] p-4 text-[#12141a] sticker-shadow sm:left-[6%] sm:w-[320px]\" data-kid=\"2-5-1-4-1\">\n                    <div class=\"font-satoshi mb-3 flex items-center justify-between text-[10px] font-black uppercase tracking-[0.18em]\" data-kid=\"2-5-1-4-1-1\">\n                        <span data-kid=\"2-5-1-4-1-1-1\">\n                            Transcript / 00:14\n                        </span>\n                        <span class=\"text-[#fb7185]\" data-kid=\"2-5-1-4-1-1-2\">\n                            ● REC\n                        </span>\n                    </div>\n                    <p class=\"font-comico text-2xl leading-[1.08]\" data-kid=\"2-5-1-4-1-2\">\n                        The\n                        <span class=\"border-b-4 border-[#fb7185]\" data-kid=\"2-5-1-4-1-2-1\">\n                            good\n                        </span>\n                        part is when it\n                        <span class=\"bg-[#2dd4bf] px-1\" data-kid=\"2-5-1-4-1-2-2\">\n                            clicks.\n                        </span>\n                    </p>\n                    <div aria-label=\"Audio waveform\" class=\"mt-4 flex items-end gap-1\" data-kid=\"2-5-1-4-1-3\">\n                        <span class=\"h-3 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-1\">\n                        </span>\n                        <span class=\"h-7 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-2\">\n                        </span>\n                        <span class=\"h-5 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-3\">\n                        </span>\n                        <span class=\"h-10 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-4\">\n                        </span>\n                        <span class=\"h-4 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-5\">\n                        </span>\n                        <span class=\"h-8 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-6\">\n                        </span>\n                        <span class=\"h-3 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-7\">\n                        </span>\n                        <span class=\"h-6 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-8\">\n                        </span>\n                        <span class=\"h-11 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-9\">\n                        </span>\n                        <span class=\"h-4 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-10\">\n                        </span>\n                        <span class=\"h-8 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-11\">\n                        </span>\n                        <span class=\"h-3 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-12\">\n                        </span>\n                        <span class=\"h-6 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-13\">\n                        </span>\n                        <span class=\"h-4 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-14\">\n                        </span>\n                        <span class=\"h-9 w-1 bg-[#12141a]\" data-kid=\"2-5-1-4-1-3-15\">\n                        </span>\n                    </div>\n                </div>\n                <div class=\"bob absolute top-0 right-[8%] z-20 flex rotate-[7deg] items-center gap-2 border-4 border-[#12141a] bg-[#3b82f6] px-4 py-3 text-sm font-black text-[#12141a] sticker-shadow-sm sm:right-[17%]\" data-kid=\"2-5-1-4-2\">\n                    <span class=\"text-lg\" data-kid=\"2-5-1-4-2-1\">\n                        ⌁\n                    </span>\n                    ZOOM IN\n                </div>\n                <div class=\"bob-delay absolute top-[104px] right-[2%] z-20 flex -rotate-[5deg] items-center gap-2 border-4 border-[#12141a] bg-[#2dd4bf] px-4 py-3 text-sm font-black text-[#12141a] sticker-shadow-sm sm:right-[9%]\" data-kid=\"2-5-1-4-3\">\n                    <i aria-hidden=\"true\" class=\"ti ti-volume\" data-kid=\"2-5-1-4-3-1\" style=\"color:#12141a;width:18px;height:18px\">\n                    </i>\n                    SFX DROP\n                </div>\n                <div class=\"absolute bottom-6 left-[19%] z-20 -rotate-[3deg] border-4 border-[#12141a] bg-[#a78bfa] px-4 py-3 text-[#12141a] sticker-shadow-sm sm:left-[29%]\" data-kid=\"2-5-1-4-4\">\n                    <span class=\"font-satoshi text-[10px] font-black uppercase tracking-[0.16em]\" data-kid=\"2-5-1-4-4-1\">\n                        CAPTION STYLE\n                    </span>\n                    <p class=\"font-comico text-xl leading-none\" data-kid=\"2-5-1-4-4-2\">\n                        Make it\n                        <span class=\"underline decoration-[#fb7185] decoration-4 underline-offset-2\" data-kid=\"2-5-1-4-4-2-1\">\n                            land.\n                        </span>\n                    </p>\n                </div>\n                <div class=\"absolute right-[22%] bottom-2 z-30 hidden -rotate-[11deg] items-center gap-3 border-4 border-[#12141a] bg-[#c9a227] px-4 py-3 text-[#12141a] sticker-shadow-sm sm:flex\" data-kid=\"2-5-1-4-5\">\n                    <i aria-hidden=\"true\" class=\"ti ti-mouse-2 text-xl\" data-kid=\"2-5-1-4-5-1\" style=\"color:#12141a;width:22px;height:22px\">\n                    </i>\n                    <span class=\"font-satoshi text-[11px] font-black uppercase tracking-[0.1em]\" data-kid=\"2-5-1-4-5-2\">\n                        drag here\n                    </span>\n                </div>\n                <div class=\"font-script absolute bottom-[-15px] right-[4%] z-30 rotate-[-8deg] text-2xl text-[#fb7185] sm:right-[9%] sm:text-3xl\" data-kid=\"2-5-1-4-6\">\n                    Just drag it here!\n                    <span class=\"text-[#c9a227]\" data-kid=\"2-5-1-4-6-1\">\n                        ✦\n                    </span>\n                </div>\n                <div class=\"absolute bottom-[-42px] left-1/2 z-0 hidden h-[150px] w-[80%] -translate-x-1/2 rotate-[-2deg] border-4 border-dashed border-[#f6f0e5]/20 lg:block\" data-kid=\"2-5-1-4-7\">\n                </div>\n                <div class=\"absolute right-[34%] top-[72px] hidden h-20 w-14 rotate-[12deg] border-l-4 border-t-4 border-[#fb7185] lg:block\" data-kid=\"2-5-1-4-8\">\n                </div>\n            </div>\n            <div class=\"mt-16 flex items-center gap-5 text-xs uppercase tracking-[0.15em] text-[#f6f0e5]/45 sm:mt-20\" data-kid=\"2-5-1-5\">\n                <span class=\"h-px w-12 bg-[#f6f0e5]/25\" data-kid=\"2-5-1-5-1\">\n                </span>\n                <span data-kid=\"2-5-1-5-2\">\n                    Words in. Better videos out.\n                </span>\n                <span class=\"h-px flex-1 bg-[#f6f0e5]/25\" data-kid=\"2-5-1-5-3\">\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"demo-title\" class=\"relative border-y-4 border-[#f6f0e5]/10 bg-[#171b24] px-6 py-24 sm:px-10 lg:px-14 lg:py-32\" data-kid=\"2-5-2\" id=\"demo\">\n            <div class=\"mx-auto max-w-[1280px]\" data-kid=\"2-5-2-1\">\n                <div class=\"mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end\" data-kid=\"2-5-2-1-1\">\n                    <div data-kid=\"2-5-2-1-1-1\">\n                        <p class=\"font-satoshi mb-3 text-xs font-black uppercase tracking-[0.2em] text-[#fb7185]\" data-kid=\"2-5-2-1-1-1-1\">\n                            The before / after\n                        </p>\n                        <h2 class=\"font-tanker text-[clamp(3rem,6vw,6.8rem)] leading-[.84] tracking-[-0.04em] text-[#f6f0e5]\" data-kid=\"2-5-2-1-1-1-2\" id=\"demo-title\">\n                            3 hours of misery\n                            <span class=\"text-[#c9a227]\" data-kid=\"2-5-2-1-1-1-2-1\">\n                                →\n                            </span>\n                            <br data-kid=\"2-5-2-1-1-1-2-2\"/>\n                            <span class=\"text-[#2dd4bf]\" data-kid=\"2-5-2-1-1-1-2-3\">\n                                3 minutes of joy.\n                            </span>\n                        </h2>\n                    </div>\n                    <p class=\"font-comico max-w-[290px] rotate-[2deg] text-xl leading-[1.15] text-[#f6f0e5]/65\" data-kid=\"2-5-2-1-1-2\">\n                        One click to get the first pass. Your taste stays in charge.\n                    </p>\n                </div>\n                <div class=\"grid items-center gap-7 lg:grid-cols-[1fr_118px_1fr]\" data-kid=\"2-5-2-1-2\">\n                    <article class=\"relative rotate-[-1.5deg] border-4 border-[#12141a] bg-[#d8d1c5] p-3 text-[#12141a] sticker-shadow\" data-kid=\"2-5-2-1-2-1\">\n                        <div class=\"flex items-center justify-between border-b-4 border-[#12141a] pb-3\" data-kid=\"2-5-2-1-2-1-1\">\n                            <span class=\"font-satoshi text-[11px] font-black uppercase tracking-[0.18em]\" data-kid=\"2-5-2-1-2-1-1-1\">\n                                Before / raw footage\n                            </span>\n                            <span class=\"font-satoshi text-[11px] font-black text-[#fb7185]\" data-kid=\"2-5-2-1-2-1-1-2\">\n                                03:12:42\n                            </span>\n                        </div>\n                        <div class=\"relative mt-3 aspect-video overflow-hidden border-4 border-[#12141a] bg-[#626570]\" data-kid=\"2-5-2-1-2-1-2\">\n                            <img alt=\"Creator portrait by abdullah ali on Unsplash\" class=\"h-full w-full object-cover grayscale brightness-75 contrast-75\" data-kid=\"2-5-2-1-2-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1698509423508-971fc81ebaa8?auto=format&w=900&q=80&fit=crop\"/>\n                            <div class=\"absolute inset-0 bg-[#12141a]/35\" data-kid=\"2-5-2-1-2-1-2-2\">\n                            </div>\n                            <div class=\"absolute top-3 left-3 border-2 border-[#f6f0e5] px-2 py-1 font-satoshi text-[10px] font-black uppercase tracking-[0.16em] text-[#f6f0e5]\" data-kid=\"2-5-2-1-2-1-2-3\">\n                                RAW / UNTOUCHED\n                            </div>\n                            <div class=\"absolute right-3 bottom-3 font-comico text-2xl text-[#f6f0e5]/70\" data-kid=\"2-5-2-1-2-1-2-4\">\n                                um... so...\n                            </div>\n                        </div>\n                        <div class=\"relative mt-4 h-16 overflow-hidden border-4 border-[#12141a] bg-[#1b1e27] p-2\" data-kid=\"2-5-2-1-2-1-3\">\n                            <div class=\"absolute inset-x-2 top-4 flex gap-1\" data-kid=\"2-5-2-1-2-1-3-1\">\n                                <span class=\"h-3 w-[17%] bg-[#fb7185]\" data-kid=\"2-5-2-1-2-1-3-1-1\">\n                                </span>\n                                <span class=\"h-3 w-[8%] bg-[#a78bfa]\" data-kid=\"2-5-2-1-2-1-3-1-2\">\n                                </span>\n                                <span class=\"h-3 w-[24%] bg-[#3b82f6]\" data-kid=\"2-5-2-1-2-1-3-1-3\">\n                                </span>\n                                <span class=\"h-3 w-[13%] bg-[#2dd4bf]\" data-kid=\"2-5-2-1-2-1-3-1-4\">\n                                </span>\n                                <span class=\"h-3 w-[31%] bg-[#c9a227]\" data-kid=\"2-5-2-1-2-1-3-1-5\">\n                                </span>\n                            </div>\n                            <div class=\"absolute inset-x-2 bottom-3 flex gap-1\" data-kid=\"2-5-2-1-2-1-3-2\">\n                                <span class=\"h-2 w-[27%] bg-[#555b69]\" data-kid=\"2-5-2-1-2-1-3-2-1\">\n                                </span>\n                                <span class=\"h-2 w-[14%] bg-[#555b69]\" data-kid=\"2-5-2-1-2-1-3-2-2\">\n                                </sp