         </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"rounded-[16px] border border-[#F5F9CE]/20 bg-[#BC2D29] p-5 sm:p-7\" data-kid=\"2-3-4-1-2-1-2-4-2-2\">\n                                        <p class=\"ember-mono m-0 text-[9px] uppercase tracking-[.15em] text-[#F5F9CE]/55\" data-kid=\"2-3-4-1-2-1-2-4-2-2-1\">\n                                            final render\n                                        </p>\n                                        <h4 class=\"mt-4 mb-0 text-3xl font-semibold\" data-kid=\"2-3-4-1-2-1-2-4-2-2-2\">\n                                            The cut is yours.\n                                        </h4>\n                                        <p class=\"mt-3 mb-0 max-w-[380px] text-lg leading-[1.15] text-[#F5F9CE]/65\" data-kid=\"2-3-4-1-2-1-2-4-2-2-3\">\n                                            A clean 9:16 video with captions, emphasis, and the moments you chose.\n                                        </p>\n                                        <button aria-label=\"Export video\" class=\"ember-export-button mt-7 inline-flex items-center gap-2 rounded-[16px] border-2 border-[#450E16] bg-[#FFA102] px-5 py-3 text-sm font-semibold text-[#450E16] shadow-[5px_6px_0_#450E16]\" data-dynamic=\"true\" data-export-button=\"\" data-kid=\"2-3-4-1-2-1-2-4-2-2-4\" data-name=\"export video action button\" data-reason=\"triggers file download and shows toast on click\" type=\"button\">\n                                            <i aria-hidden=\"true\" class=\"ti ti-download ember-icon text-[16px]\" data-kid=\"2-3-4-1-2-1-2-4-2-2-4-1\" style=\"color:#450E16;width:16px;height:16px\">\n                                            </i>\n                                            Export 1080 × 1920\n                                        </button>\n                                        <div class=\"ember-download-toast mt-4 inline-flex items-center gap-2 rounded-[8px] border border-[#2DD4BF] bg-[#2DD4BF]/15 px-3 py-2 text-[9px] uppercase tracking-[.12em] text-[#9DEEE1]\" data-download-toast=\"\" data-kid=\"2-3-4-1-2-1-2-4-2-2-5\">\n                                            <i aria-hidden=\"true\" class=\"ti ti-check ember-icon text-[13px]\" data-kid=\"2-3-4-1-2-1-2-4-2-2-5-1\" style=\"color:#9DEEE1;width:13px;height:13px\">\n                                            </i>\n                                            download started\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"ember-story-cursor\" data-kid=\"2-3-4-1-2-1-2-4-3\" data-story-cursor=\"3\" style=\"left:58%;top:70%\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-mouse-2 ember-icon text-[20px]\" data-kid=\"2-3-4-1-2-1-2-4-3-1\" style=\"color:#450E16;width:20px;height:20px\">\n                                    </i>\n                                </div>\n                                <p class=\"ember-mono absolute right-8 bottom-7 left-8 m-0 text-[9px] uppercase tracking-[.16em] text-[#F5F9CE]/45\" data-kid=\"2-3-4-1-2-1-2-4-4\">\n                                    1080 × 1920 · captions on · ready to share.\n                                </p>\n                            </article>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-title\" class=\"relative overflow-hidden bg-[#DD5533] px-6 py-24 text-[#450E16] sm:px-10 lg:px-14 lg:py-36\" data-kid=\"2-3-5\" data-name=\"cta section\" id=\"cta\">\n            <div aria-hidden=\"true\" class=\"absolute -top-28 right-[-5%] h-80 w-80 rounded-full border-[26px] border-[#F5F9CE]/20\" data-kid=\"2-3-5-1\" data-name=\"cta decorative circle\">\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute bottom-[-120px] left-[-70px] h-72 w-72 rounded-full border-[34px] border-[#450E16]/10\" data-kid=\"2-3-5-2\" data-name=\"cta decorative circle\">\n            </div>\n            <div class=\"relative mx-auto max-w-[1180px] text-center\" data-kid=\"2-3-5-3\" data-name=\"cta content container\">\n                <p class=\"ember-mono text-[10px] font-semibold uppercase tracking-[.2em]\" data-kid=\"2-3-5-3-1\" data-name=\"cta section label\">\n                    Make the words do more\n                </p>\n                <h2 class=\"ember-display mx-auto mt-5 max-w-[900px] text-[clamp(4rem,9vw,9.5rem)] leading-[.78]\" data-kid=\"2-3-5-3-2\" data-name=\"cta section headline\" id=\"cta-title\">\n                    Your next Short is already in the transcript.\n                </h2>\n                <a class=\"mt-10 inline-flex items-center gap-2 rounded-[24px] border-2 border-[#450E16] bg-[#F5F9CE] px-6 py-4 text-sm font-semibold text-[#450E16] shadow-[6px_7px_0_#450E16] no-underline hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[3px_3px_0_#450E16]\" data-kid=\"2-3-5-3-3\" data-name=\"cta call-to-action button\" href=\"#product\">\n                    Try Talking Head free\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ember-icon text-[15px]\" data-kid=\"2-3-5-3-3-1\" style=\"color:#450E16;width:15px;height:15px\">\n                    </i>\n                </a>\n                <p class=\"mt-6 text-lg text-[#450E16]/65\" data-kid=\"2-3-5-3-4\" data-name=\"cta subheadline text\">\n                    No timeline maze. No 47-tab learning curve.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t-2 border-[#F5F9CE]/20 bg-[#450E16] px-6 py-7 text-[#F5F9CE] sm:px-10 lg:px-14\" data-kid=\"2-4\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1280px] flex-col justify-between gap-4 text-sm sm:flex-row sm:items-center\" data-kid=\"2-4-1\" data-name=\"footer container\">\n            <span class=\"font-semibold\" data-kid=\"2-4-1-1\" data-name=\"footer brand name\">\n                talking head\n            </span>\n            <span class=\"ember-mono text-[9px] uppercase tracking-[.14em] text-[#F5F9CE]/50\" data-kid=\"2-4-1-2\" data-name=\"footer tagline\">\n                Edit less. Say more.\n            </span>\n            <span class=\"ember-mono text-[9px] uppercase tracking-[.14em] text-[#F5F9CE]/50\" data-kid=\"2-4-1-3\" data-name=\"footer copyright info\">\n                © 2026 Talking Head\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  (() => {\n    const story = document.querySelector('[data-story]');\n    const pin = document.querySelector('[data-story-pin]');\n    const panels = Array.from(document.querySelectorAll('[data-story-panel]'));\n    const navItems = Array.from(document.querySelectorAll('[data-story-nav]'));\n    const stage = document.querySelector('[data-story-stage]');\n    if (!story || !pin || panels.length !== 4 || navItems.length !== 4 || !stage) return;\n\n    const setActive = (index) => {\n      navItems.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex === index));\n    };\n\n    const media = gsap.matchMedia();\n    media.add({ reduceMotion: '(prefers-reduced-motion: reduce)' }, ({ conditions }) => {\n      if (conditions.reduceMotion) {\n        gsap.set(panels, { autoAlpha: 0 });\n        gsap.set(panels[0], { autoAlpha: 1 });\n        setActive(0);\n        return;\n      }\n\n      gsap.set(panels, { autoAlpha: 0 });\n      gsap.set(panels[0], { autoAlpha: 1 });\n      gsap.set('[data-story-check], [data-story-mark], [data-change-menu], [data-new-chip], [data-download-toast]', { autoAlpha: 0, scale: .8 });\n      gsap.set('[data-word=\"1\"]', { autoAlpha: 0, y: 18 });\n      gsap.set('[data-story-cursor=\"0\"]', { x: 0, y: 0, scale: 1 });\n      gsap.set('[data-story-cursor=\"2\"]', { x: 0, y: 0, scale: 1 });\n      gsap.set('[data-story-cursor=\"3\"]', { x: 0, y: 0, scale: 1 });\n\n      const timeline = gsap.timeline({\n        scrollTrigger: {\n          trigger: story,\n          start: 'top top',\n          end: () => '+=' + (window.innerWidth < 768 ? 2600 : 3000),\n          scrub: 1,\n          anticipatePin: 1,\n          invalidateOnRefresh: true,\n        },\n        defaults: { ease: 'power2.out' },\n      });\n\n      timeline\n        .to('[data-story-cursor=\"0\"]', { scale: .78, duration: .12 })\n        .to('[data-story-cursor=\"0\"]', { scale: 1, duration: .12 })\n        .to('[data-finder-file]', { x: () => stage.clientWidth * .42, duration: .9, ease: 'power1.inOut' })\n        .to('[data-story-cursor=\"0\"]', { x: () => stage.clientWidth * .42, y: -6, duration: .9, ease: 'power1.inOut' }, '<')\n        .to('[data-story-check]', { autoAlpha: 1, scale: 1, duration: .28, ease: 'back.out(1.8)' })\n        .to(panels[0], { autoAlpha: 0, duration: .34 }, '+=.35')\n        .to(panels[1], { autoAlpha: 1, duration: .34 }, '<')\n        .to('[data-word=\"1\"]', { autoAlpha: 1, y: 0, stagger: .13, duration: .35 }, '+=.1')\n        .to('[data-story-mark=\"zoom\"]', { autoAlpha: 1, y: 0, scale: 1, duration: .25 }, '+=.15')\n        .to('[data-story-mark=\"sfx\"]', { autoAlpha: 1, y: 0, scale: 1, duration: .25 })\n        .to('[data-story-mark=\"emphasis\"]', { autoAlpha: 1, y: 0, scale: 1, duration: .25 })\n        .to(panels[1], { autoAlpha: 0, duration: .34 }, '+=.45')\n        .to(panels[2], { autoAlpha: 1, duration: .34 }, '<')\n        .to('[data-story-cursor=\"2\"]', { scale: .78, duration: .12 })\n        .to('[data-story-cursor=\"2\"]', { scale: 1, duration: .12 })\n        .to('[data-story-cursor=\"2\"]', { x: () => stage.clientWidth * .25, y: -45, duration: .65, ease: 'power1.inOut' })\n        .to('[data-change-menu]', { autoAlpha: 1, scale: 1, duration: .3, ease: 'back.out(1.6)' })\n        .to('[data-story-cursor=\"2\"]', { x: () => stage.clientWidth * .49, y: 82, duration: .65, ease: 'power1.inOut' })\n        .to('[data-new-chip]', { autoAlpha: 1, scale: 1, duration: .28, ease: 'back.out(1.6)' })\n        .to(panels[2], { autoAlpha: 0, duration: .34 }, '+=.45')\n        .to(panels[3], { autoAlpha: 1, duration: .34 }, '<')\n        .to('[data-story-cursor=\"3\"]', { scale: .78, duration: .12 })\n        .to('[data-story-cursor=\"3\"]', { scale: 1, duration: .12 })\n        .to('[data-story-cursor=\"3\"]', { x: () => stage.clientWidth * .1, y: 40, duration: .65, ease: 'power1.inOut' })\n        .to('[data-export-button]', { scale: .94, duration: .14 })\n        .to('[data-export-button]', { scale: 1, duration: .14 })\n        .to('[data-download-toast]', { autoAlpha: 1, scale: 1, duration: .3, ease: 'back.out(1.6)' });\n\n      timeline.eventCallback('onUpdate', () => {\n        const index = Math.min(3, Math.floor(timeline.progress() * 4));\n        setActive(index);\n      });\n\n      navItems.forEach((item, index) => {\n        item.addEventListener('click', () => {\n          const maxScroll = story.offsetTop + story.offsetHeight - window.innerHeight;\n          const target = story.offsetTop + Math.max(0, maxScroll - story.offsetTop) * (index / 3);\n          window.scrollTo({ top: target, behavior: 'smooth' });\n        });\n      });\n\n      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });\n      return () => timeline.kill();\n    });\n\n    const exportButton = document.querySelector('[data-export-button]');\n    const downloadToast = document.querySelector('[data-download-toast]');\n    exportButton?.addEventListener('click', () => {\n      const file = new Blob([], { type: 'video/mp4' });\n      const link = document.createElement('a');\n      link.href = URL.createObjectURL(file);\n      link.download = 'talking-head-short-014.mp4';\n      link.click();\n      URL.revokeObjectURL(link.href);\n      if (downloadToast) {\n        gsap.to(downloadToast, { autoAlpha: 1, scale: 1, duration: .3, ease: 'back.out(1.6)' });\n      }\n    });\n  })();\n</script>\n",
