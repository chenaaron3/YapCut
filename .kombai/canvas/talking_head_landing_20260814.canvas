ures container\">\n                <div class=\"border-t-2 border-[#450E16]/20 pt-16\" data-kid=\"2-3-3-1-1\" data-name=\"features header container\">\n                    <p class=\"ember-mono mb-3 text-[10px] font-semibold uppercase tracking-[.2em] text-[#432E6F]\" data-kid=\"2-3-3-1-1-1\" data-name=\"features section label\">\n                        A smaller toolkit, done right\n                    </p>\n                    <h2 class=\"ember-display m-0 max-w-[780px] text-[clamp(3.6rem,7vw,7.2rem)] leading-[.78]\" data-kid=\"2-3-3-1-1-2\" data-name=\"features section headline\" id=\"features-title\">\n                        Your words are\n                        <span class=\"text-[#DD5533]\" data-kid=\"2-3-3-1-1-2-1\">\n                            the timeline.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"mt-16 grid gap-6 lg:grid-cols-12\" data-kid=\"2-3-3-1-2\" data-name=\"features grid\">\n                    <article class=\"relative overflow-hidden rounded-[24px] border-2 border-[#450E16] bg-[#BC2D29] p-7 text-[#F5F9CE] ember-card-shadow lg:col-span-7 lg:min-h-[420px] lg:rotate-[-1deg]\" data-kid=\"2-3-3-1-2-1\" data-name=\"feature drag and drop card\">\n                        <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-3-3-1-2-1-1\" data-name=\"card header row\">\n                            <div data-kid=\"2-3-3-1-2-1-1-1\" data-name=\"card label text\">\n                                <p class=\"ember-mono m-0 text-[10px] font-semibold uppercase tracking-[.18em] text-[#FFA102]\" data-kid=\"2-3-3-1-2-1-1-1-1\">\n                                    01 / drag + drop\n                                </p>\n                                <h3 class=\"ember-display mt-4 mb-0 max-w-[480px] text-5xl leading-[.82] sm:text-6xl\" data-kid=\"2-3-3-1-2-1-1-1-2\">\n                                    Place the feeling where it lands.\n                                </h3>\n