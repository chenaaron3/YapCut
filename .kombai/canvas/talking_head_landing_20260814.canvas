cle>\n                            <article class=\"ember-story-panel p-1 sm:p-2\" data-kid=\"2-3-4-1-2-1-2-3\" data-name=\"cleanup panel\" data-story-panel=\"2\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-3-4-1-2-1-2-3-1\">\n                                    <div data-kid=\"2-3-4-1-2-1-2-3-1-1\">\n                                        <p class=\"ember-mono m-0 text-[10px] uppercase tracking-[.18em] text-[#DD5533]\" data-kid=\"2-3-4-1-2-1-2-3-1-1-1\">\n                                            03 / human cleanup\n                                        </p>\n                                        <h3 class=\"ember-display mt-4 mb-0 max-w-[640px] text-5xl leading-[.82] sm:text-7xl\" data-kid=\"2-3-4-1-2-1-2-3-1-1-2\">\n                                            Make the pass\n                                            <br data-kid=\"2-3-4-1-2-1-2-3-1-1-2-1\"/>\n                                            <span class=\"text-[#DD5533]\" data-kid=\"2-3-4-1-2-1-2-3-1-1-2-2\">\n                                                your own.\n                                            </span>\n                                        </h3>\n                                    </div>\n                                    <span class=\"rounded-full border border-[#DD5533]/55 px-3 py-2 text-[9px] uppercase tracking-[.12em] text-[#FFB3A1]\" data-kid=\"2-3-4-1-2-1-2-3-1-2\">\n                                        your call\n                                    </span>\n                                </div>\n                                <div class=\"mt-14 rounded-[16px] border border-[#F5F9CE]/20 bg-[#BC2D29] p-5 sm:p-8\" data-kid=\"2-3-4-1-2-1-2-3-2\">\n                                    <div class=\"ember-mono flex items-center justify-between text-[9px] uppercase tracking-[.14em] text-[#F5F9CE]/55\" data-kid=\"2-3-4-1-2-1-2-3-2-1\">\n                                        <span data-kid=\"2-3-4-1-2-1-2-3-2-1-1\">\n                                            edit by word / 00:08\n                                        </span>\n                                        <span class=\"text-[#FFA102]\" data-kid=\"2-3-4-1-2-1-2-3-2-1-2\">\n                                            human in control\n                                        </span>\n                                    </div>\n                                    <p class=\"mt-8 mb-0 flex flex-wrap gap-x-2 gap-y-3 text-[clamp(1.7rem,4vw,3.7rem)] leading-[1.04]\" data-kid=\"2-3-4-1-2-1-2-3-2-2\">\n                                        <span data-kid=\"2-3-4-1-2-1-2-3-2-2-1\">\n                                            The\n                                        </span>\n                                        <button aria-label=\"Selected idea edit\" class=\"rounded-[8px] border border-[#3B82F6] bg-[#3B82F6]/20 px-2 text-[#A9C4FF]\" data-existing-edit=\"\" data-kid=\"2-3-4-1-2-1-2-3-2-2-2\">\n                                            idea\n                                        </button>\n                                        <span data-kid=\"2-3-4-1-2-1-2-3-2-2-3\">\n                                            is\n                                        </span>\n                                        <span class=\"rounded-[8px] border border-[#DD5533] bg-[#DD5533]/20 px-2 text-[#FFB3A1]\" data-kid=\"2-3-4-1-2-1-2-3-2-2-4\">\n                                            already\n                                        </span>\n                                        <span data-kid=\"2-3-4-1-2-1-2-3-2-2-5\">\n                                            there.\n                                        </span>\n                                        <span data-kid=\"2-3-4-1-2-1-2-3-2-2-6\">\n                                            You\n                                        </span>\n                                        <span data-kid=\"2-3-4-1-2-1-2-3-2-2-7\">\n                                            just\n                                        </span>\n                                        <button aria-label=\"Add edit to land\" class=\"rounded-[8px] border border-dashed border-[#F5F9CE]/50 px-2 text-[#F5F9CE]/80\" data-kid=\"2-3-4-1-2-1-2-3-2-2-8\" data-new-word=\"\">\n                                            land.\n                                        </button>\n                                    </p>\n                                    <div class=\"ember-change-menu mt-8 flex flex-wrap items-center gap-2 rounded-[12px] border border-[#FFA102]/40 bg-[#450E16] p-3\" data-change-menu=\"\" data-kid=\"2-3-4-1-2-1-2-3-2-3\">\n                                        <span class=\"ember-mono mr-2 text-[9px] uppercase tracking-[.12em] text-[#F5F9CE]/55\" data-kid=\"2-3-4-1-2-1-2-3-2-3-1\">\n                                            change idea to\n                                        </span>\n                                        <span class=\"rounded-[8px] bg-[#2DD4BF] px-3 py-2 text-[9px] font-semibold uppercase text-[#450E16]\" data-kid=\"2-3-4-1-2-1-2-3-2-3-2\">\n                                            SFX\n                                        </span>\n                                        <span class=\"rounded-[8px] bg-[#FFA102] px-3 py-2 text-[9px] font-semibold uppercase text-[#450E16]\" data-kid=\"2-3-4-1-2-1-2-3-2-3-3\">\n                                            B-roll\n                                        </span>\n                                        <span class=\"rounded-[8px] bg-[#A78BFA] px-3 py-2 text-[9px] font-semibold uppercase text-[#450E16]\" data-kid=\"2-3-4-1-2-1-2-3-2-3-4\">\n                                            Text\n                                        </span>\n                                    </div>\n                                    <div class=\"ember-new-chip mt-3 inline-flex items-center gap-2 rounded-[8px] border border-[#2DD4BF] bg-[#2DD4BF]/15 px-3 py-2 text-[9px] uppercase tracking-[.12em] text-[#9DEEE1]\" data-kid=\"2-3-4-1-2-1-2-3-2-4\" data-new-chip=\"\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-plus ember-icon text-[13px]\" data-kid=\"2-3-4-1-2-1-2-3-2-4-1\" style=\"color:#9DEEE1;width:13px;height:13px\">\n                                        </i>\n                                        SFX added to “land”\n                                    </div>\n                                </div>\n                                <div class=\"ember-story-cursor\" data-kid=\"2-3-4-1-2-1-2-3-3\" data-story-cursor=\"2\" style=\"left:22%;top:56%\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-mouse-2 ember-icon text-[20px]\" data-kid=\"2-3-4-1-2-1-2-3-3-1\" style=\"color:#450E16;width:20px;height:20px\">\n                                    </i>\n                                </div>\n                                <p class=\"ember-mono absolute right-8 bottom-7 left-8 m-0 text-[9px] uppercase tracking-[.16em] text-[#F5F9CE]/45\" data-kid=\"2-3-4-1-2-1-2-3-4\">\n                                    Click an edit. Swap it. Click a word. Add another.\n                                </p>\n                            </article>\n                            <article class=\"ember-story-panel p-1 sm:p-2\" data-kid=\"2-3-4-1-2-1-2-4\" data-name=\"export panel\" data-story-panel=\"3\">\n                                <div class=\"flex items-start justify-between gap-4\" data-kid=\"2-3-4-1-2-1-2-4-1\">\n                                    <div data-kid=\"2-3-4-1-2-1-2-4-1-1\">\n                                        <p class=\"ember-mono m-0 text-[10px] uppercase tracking-[.18em] text-[#A78BFA]\" data-kid=\"2-3-4-1-2-1-2-4-1-1-1\">\n                                            04 / export\n                                        </p>\n                                        <h3 class=\"ember-display mt-4 mb-0 max-w-[640px] text-5xl leading-[.82] sm:text-7xl\" data-kid=\"2-3-4-1-2-1-2-4-