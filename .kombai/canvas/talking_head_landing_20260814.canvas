                        <span class=\"font-mono text-[9px] text-[#687188]\" data-kid=\"2-4-3-2-3-4-1-1\">\n                                TALKING HEAD / ONLY\n                            </span>\n                            <span class=\"rounded-sm bg-[#c9a227]/15 px-2 py-1 text-[9px] font-semibold text-[#ebd36c]\" data-kid=\"2-4-3-2-3-4-1-2\">\n                                FOCUS MODE\n                            </span>\n                        </div>\n                        <div class=\"mt-4 grid grid-cols-4 gap-1.5\" data-kid=\"2-4-3-2-3-4-2\">\n                            <span class=\"h-2 rounded-[2px] bg-[#c9a227]\" data-kid=\"2-4-3-2-3-4-2-1\">\n                            </span>\n                            <span class=\"h-2 rounded-[2px] bg-[#c9a227]/70\" data-kid=\"2-4-3-2-3-4-2-2\">\n                            </span>\n                            <span class=\"h-2 rounded-[2px] bg-[#c9a227]/35\" data-kid=\"2-4-3-2-3-4-2-3\">\n                            </span>\n                            <span class=\"h-2 rounded-[2px] bg-[#2e3444]\" data-kid=\"2-4-3-2-3-4-2-4\">\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-[10px] text-[#a9afbd]\" data-kid=\"2-4-3-2-3-4-3\">\n                            just enough control · zero maze\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-xl border border-[#2e3444] bg-[#1a1d26] p-5 transition-all hover:-translate-y-1 hover:border-[#2dd4bf]/60 lg:col-span-2\" data-kid=\"2-4-3-2-4\">\n                    <div class=\"flex items-start justify-between gap-6\" data-kid=\"2-4-3-2-4-1\">\n                        <div data-kid=\"2-4-3-2-4-1-1\">\n                            <div class=\"mb-4 inline-flex h-9 w-9 items-center justify-center rounded-sm bg-[#2dd4bf]/15 text-[#6ee7d8]\" data-kid=\"2-4-3-2-4-1-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-subtitles text-[18px]\" data-kid=\"2-4-3-2-4-1-1-1-1\" style=\"width:18px;height:18px;color:#6ee7d8;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <h3 class=\"font-satoshi text-xl text-[#e8eaef]\" data-kid=\"2-4-3-2-4-1-1-2\">\n                                Auto captions that sound like you\n                            </h3>\n                            <p class=\"mt-2 max-w-[460px] text-sm leading-6 text-[#8b93a7]\" data-kid=\"2-4-3-2-4-1-1-3\">\n                                Captions, emphasis, quotes and titles are generated from the words — then tuned by you in a few clicks.\n                            </p>\n                        </div>\n                        <span class=\"hidden rounded-sm border border-[#2dd4bf]/35 bg-[#2dd4bf]/10 px-2 py-1 font-mono text-[9px] text-[#6ee7d8] sm:inline-flex\" data-kid=\"2-4-3-2-4-1-2\">\n                            CAPTIONS READY\n                        </span>\n                    </div>\n                    <div class=\"mt-8 grid gap-3 rounded-sm border border-[#2e3444] bg-[#161922] p-4 sm:grid-cols-[1.15fr_0.85fr]\" data-kid=\"2-4-3-2-4-2\">\n                        <div class=\"flex min-h-[112px] items-center justify-center rounded-sm bg-[#0f1218] p-5 text-center\" data-kid=\"2-4-3-2-4-2-1\">\n                            <p class=\"font-satoshi text-xl leading-tight text-white\" data-kid=\"2-4-3-2-4-2-1-1\">\n                                This is the\n                                <br data-kid=\"2-4-3-2-4-2-1-1-1\"/>\n                                <span class=\"text-[#6ee7d8]\" data-kid=\"2-4-3-2-4-2-1-1-2\">\n                                    good part.\n                                </span>\n                            </p>\n                        </div>\n                        <div class=\"space-y-2\" data-kid=\"2-4-3-2-4-2-2\">\n                            <div class=\"flex items-center justify-between rounded-sm border border-[#2dd4bf]/40 bg-[#2dd4bf]/10 px-3 py-2 text-[10px] text-[#6ee7d8]\" data-kid=\"2-4-3-2-4-2-2-1\">\n                                <span data-kid=\"2-4-3-2-4-2-2-1-1\">\n                                    emphasis\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-check text-[13px]\" data-kid=\"2-4-3-2-4-2-2-1-2\" style=\"width:13px;height:13px;color:#6ee7d8;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm border border-[#a78bfa]/40 bg-[#a78bfa]/10 px-3 py-2 text-[10px] text-[#c3b5fd]\" data-kid=\"2-4-3-2-4-2-2-2\">\n                                <span data-kid=\"2-4-3-2-4-2-2-2-1\">\n                                    quote card\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-check text-[13px]\" data-kid=\"2-4-3-2-4-2-2-2-2\" style=\"width:13px;height:13px;color:#c3b5fd;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                            <div class=\"flex items-center justify-between rounded-sm border border-[#c9a227]/40 bg-[#c9a227]/10 px-3 py-2 text-[10px] text-[#ebd36c]\" data-kid=\"2-4-3-2-4-2-2-3\">\n                                <span data-kid=\"2-4-3-2-4-2-2-3-1\">\n                                    title frame\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-check text-[13px]\" data-kid=\"2-4-3-2-4-2-2-3-2\" style=\"width:13px;height:13px;color:#ebd36c;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n            </div>\n            <div class=\"mt-5 flex flex-wrap items-center gap-2 border-t border-[#2e3444] pt-5\" data-kid=\"2-4-3-3\">\n                <span class=\"mr-2 font-mono text-[10px] tracking-[0.14em] text-[#687188]\" data-kid=\"2-4-3-3-1\">\n                    EDIT TYPES\n                </span>\n                <span class=\"inline-flex items-center gap-1.5 rounded-[3px] border border-[#3b82f6]/40 bg-[#3b82f6]/10 px-2 py-1 text-[10px] text-[#86aaff]\" data-kid=\"2-4-3-3-2\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#3b82f6]\" data-kid=\"2-4-3-3-2-1\">\n                    </span>\n                    Zoom\n                </span>\n                <span class=\"inline-flex items-center gap-1.5 rounded-[3px] border border-[#2dd4bf]/40 bg-[#2dd4bf]/10 px-2 py-1 text-[10px] text-[#6ee7d8]\" data-kid=\"2-4-3-3-3\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#2dd4bf]\" data-kid=\"2-4-3-3-3-1\">\n                    </span>\n                    SFX\n                </span>\n                <span class=\"inline-flex items-center gap-1.5 rounded-[3px] border border-[#c9a227]/40 bg-[#c9a227]/10 px-2 py-1 text-[10px] text-[#ebd36c]\" data-kid=\"2-4-3-3-4\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#c9a227]\" data-kid=\"2-4-3-3-4-1\">\n                    </span>\n                    BRoll\n                </span>\n                <span class=\"inline-flex items-center gap-1.5 rounded-[3px] border border-[#fb7185]/40 bg-[#fb7185]/10 px-2 py-1 text-[10px] text-[#ff9aae]\" data-kid=\"2-4-3-3-5\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#fb7185]\" data-kid=\"2-4-3-3-5-1\">\n                    </span>\n                    VFX\n                </span>\n                <span class=\"inline-flex items-center gap-1.5 rounded-[3px] border border-[#a78bfa]/40 bg-[#a78bfa]/10 px-2 py-1 text-[10px] text-[#c3b5fd]\" data-kid=\"2-4-3-3-6\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#a78bfa]\" data-kid=\"2-4-3-3-6-1\">\n                    </span>\n                    Text overlay\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"how-heading\" class=\"border-y border-[#2e3444]/80 bg-[#161922]/75 px-6 py-20 lg:px-10 lg:py-28\" data-kid=\"2-4-4\" id=\"how-it-works\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"2-4-4-1\">\n                <div class=\"max-w-[760px]\" data-kid=\"2-4-4-1-1\">\n                    <p class=\"mb-4 text-[11px] font-semibold tracking-[0.2em] text-[#5b8cff]\" data-kid=\"2-4-4-1-1-1\">\n                        THE FLOW\n                    </p>\n                    <h2 class=\"font-display text-[clamp(2.8rem,5vw,5.3rem)] leading-[0.92] tracking-[-0.065em] text-[#f4f6fb]\" data-kid=\"2-4-4-1-1-2\" id=\"how-heading\">\n                        From upload to export,\n                        <br data-kid=\"2-4-4-1-1-2-1\"/>\n                        <span class=\"text-[#8b93a7]\" data-kid=\"2-4-4-1-1-2-2\">\n                            without the maze.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"relative mt-14 grid gap-4 md:grid-cols-4 md:gap-3\" data-kid=\"2-4-4-1-2\">\n                    <div aria-hidden=\"true\" class=\"absolute top-7 right-[12%] left-[12%] hidden h-px bg-[linear-gradient(90deg,#5b8cff_0%,#5b8cff_37%,#2dd4bf_70%,#2e3444_100%)] md:block\" data-kid=\"2-4-4-1-2-1\">\n                    </div>\n                    <article class=\"relative rounded-xl border border-[#2e3444] bg-[#1a1d26] p-5\" data-kid=\"2-4-4-1-2-2\">\n                        <div class=\"relative z-10 mb-8 flex items-center justify-between\" data-kid=\"2-4-4-1-2-2-1\">\n                            <span class=\"font-satoshi text-4xl tracking-[-0.08em] text-[#2e3444]\" data-kid=\"2-4-4-1-2-2-1-1\">\n                                01\n                            </span>\n                            <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-[#5b8cff] bg-[#1a1d26]\" data-kid=\"2-4-4-1-2-2-1-2\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#5b8cff]\" data-kid=\"2-4-4-1-2-2-1-2-1\">\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-sm bg-[#5b8cff]/15 text-[#86aaff]\" data-kid=\"2-4-4-1-2-2-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-cloud-upload text-[22px]\" data-kid=\"2-4-4-1-2-2-2-1\" style=\"width:22px;height:22px;color:#86aaff;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-satoshi text-lg text-[#e8eaef]\" data-kid=\"2-4-4-1-2-2-3\">\n                            Upload raw video\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-[#8b93a7]\" data-kid=\"2-4-4-1-2-2-4\">\n                            Drop in the clip where you talk. We’ll take it from here.\n                        </p>\n                        <div class=\"mt-6 rounded-sm border border-dashed border-[#5b8cff]/50 bg-[#5b8cff]/[0.06] px-3 py-2 text-center font-mono text-[9px] text-[#86aaff]\" data-kid=\"2-4-4-1-2-2-5\">\n                            MP4 · MOV · WEBM\n                        </div>\n                    </article>\n                    <article class=\"relative rounded-xl border border-[#2e3444] bg-[#1a1d26] p-5\" data-kid=\"2-4-4-1-2-3\">\n                        <div class=\"relative z-10 mb-8 flex items-center justify-between\" data-kid=\"2-4-4-1-2-3-1\">\n                            <span class=\"font-satoshi text-4xl tracking-[-0.08em] text-[#2e3444]\" data-kid=\"2-4-4-1-2-3-1-1\">\n                                02\n                            </span>\n                            <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-[#2dd4bf] bg-[#1a1d26]\" data-kid=\"2-4-4-1-2-3-1-2\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#2dd4bf] shadow-[0_0_10px_rgba(45,212,191,0.8)]\" data-kid=\"2-4-4-1-2-3-1-2-1\">\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-sm bg-[#2dd4bf]/15 text-[#6ee7d8]\" data-kid=\"2-4-4-1-2-3-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-sparkles text-[22px]\" data-kid=\"2-4-4-1-2-3-2-1\" style=\"width:22px;height:22px;color:#6ee7d8;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-satoshi text-lg text-[#e8eaef]\" data-kid=\"2-4-4-1-2-3-3\">\n                            AI makes the first pass\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-[#8b93a7]\" data-kid=\"2-4-4-1-2-3-4\">\n                            Transcription, captions, title, SFX, VFX and Zoom — already placed on the words.\n                        </p>\n                        <div class=\"mt-6 flex items-center gap-1.5\" data-kid=\"2-4-4-1-2-3-5\">\n                            <span class=\"rounded-[3px] bg-[#2dd4bf]/15 px-2 py-1 text-[9px] text-[#6ee7d8]\" data-kid=\"2-4-4-1-2-3-5-1\">\n                                captions\n                            </span>\n                            <span class=\"rounded-[3px] bg-[#3b82f6]/15 px-2 py-1 text-[9px] text-[#86aaff]\" data-kid=\"2-4-4-1-2-3-5-2\">\n                                zoom\n                            </span>\n                            <span class=\"rounded-[3px] bg-[#fb7185]/15 px-2 py-1 text-[9px] text-[#ff9aae]\" data-kid=\"2-4-4-1-2-3-5-3\">\n                                VFX\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"relative rounded-xl border border-[#2e3444] bg-[#1a1d26] p-5\" data-kid=\"2-4-4-1-2-4\">\n                        <div class=\"relative z-10 mb-8 flex items-center justify-between\" data-kid=\"2-4-4-1-2-4-1\">\n                            <span class=\"font-satoshi text-4xl tracking-[-0.08em] text-[#2e3444]\" data-kid=\"2-4-4-1-2-4-1-1\">\n                                03\n                            </span>\n                            <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-[#c9a227] bg-[#1a1d26]\" data-kid=\"2-4-4-1-2-4-1-2\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#c9a227]\" data-kid=\"2-4-4-1-2-4-1-2-1\">\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-sm bg-[#c9a227]/15 text-[#ebd36c]\" data-kid=\"2-4-4-1-2-4-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-adjustments-horizontal text-[22px]\" data-kid=\"2-4-4-1-2-4-2-1\" style=\"width:22px;height:22px;color:#ebd36c;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-satoshi text-lg text-[#e8eaef]\" data-kid=\"2-4-4-1-2-4-3\">\n                            Clean it up yourself\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-[#8b93a7]\" data-kid=\"2-4-4-1-2-4-4\">\n                            You get a full editor to refine the choices, move a moment or make it yours.\n                        </p>\n                        <div class=\"mt-6 flex items-center gap-1 rounded-sm border border-[#2e3444] bg-[#12141a] px-2 py-2\" data-kid=\"2-4-4-1-2-4-5\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#c9a227]\" data-kid=\"2-4-4-1-2-4-5-1\">\n                            </span>\n                            <span class=\"h-1.5 w-8 rounded-full bg-[#c9a227]/50\" data-kid=\"2-4-4-1-2-4-5-2\">\n                            </span>\n                            <span class=\"h-1.5 w-4 rounded-full bg-[#c9a227]/25\" data-kid=\"2-4-4-1-2-4-5-3\">\n                            </span>\n                            <span class=\"ml-auto font-mono text-[9px] text-[#687188]\" data-kid=\"2-4-4-1-2-4-5-4\">\n                                your call\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"relative rounded-xl border border-[#2e3444] bg-[#1a1d26] p-5\" data-kid=\"2-4-4-1-2-5\">\n                        <div class=\"relative z-10 mb-8 flex items-center justify-between\" data-kid=\"2-4-4-1-2-5-1\">\n                            <span class=\"font-satoshi text-4xl tracking-[-0.08em] text-[#2e3444]\" data-kid=\"2-4-4-1-2-5-1-1\">\n                                04\n                            </span>\n                            <span class=\"flex h-5 w-5 items-center justify-center rounded-full border border-[#a78bfa] bg-[#1a1d26]\" data-kid=\"2-4-4-1-2-5-1-2\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#a78bfa]\" data-kid=\"2-4-4-1-2-5-1-2-1\">\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"mb-5 flex h-12 w-12 items-center justify-center rounded-sm bg-[#a78bfa]/15 text-[#c3b5fd]\" data-kid=\"2-4-4-1-2-5-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-download text-[22px]\" data-kid=\"2-4-4-1-2-5-2-1\" style=\"width:22px;height:22px;color:#c3b5fd;display:inline-flex;align-items:center;justify-content:center\">\n                            </i>\n                        </div>\n                        <h3 class=\"font-satoshi text-lg text-[#e8eaef]\" data-kid=\"2-4-4-1-2-5-3\">\n                            Export your video\n                        </h3>\n                        <p class=\"mt-2 text-sm leading-6 text-[#8b93a7]\" data-kid=\"2-4-4-1-2-5-4\">\n                            Render a clean, captioned cut that’s ready for wherever you publish next.\n                        </p>\n                        <div class=\"mt-6 inline-flex items-center gap-2 rounded-sm bg-[#a78bfa]/15 px-3 py-2 text-[9px] font-semibold text-[#c3b5fd]\" data-kid=\"2-4-4-1-2-5-5\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#a78bfa]\" data-kid=\"2-4-4-1-2-5-5-1\">\n                            </span>\n                            1080p · ready to share\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-heading\" class=\"mx-auto max-w-[1280px] px-6 py-20 lg:px-10 lg:py-28\" data-kid=\"2-4-5\" id=\"cta\">\n            <div class=\"relative overflow-hidden rounded-2xl border border-[#5b8cff]/45 bg-[#1a1d26] px-6 py-14 text-center shadow-[0_22px_80px_rgba(0,0,0,0.32)] sm:px-12 lg:py-20\" data-kid=\"2-4-5-1\">\n                <div aria-hidden=\"true\" class=\"absolute -top-28 left-1/2 h-72 w-[560px] -translate-x-1/2 rounded-full bg-[#5b8cff]/18 blur-3xl\" data-kid=\"2-4-5-1-1\">\n                </div>\n                <div aria-hidden=\"true\" class=\"absolute right-[-5%] bottom-[-35%] h-64 w-64 rounded-full bg-[#2dd4bf]/10 blur-3xl\" data-kid=\"2-4-5-1-2\">\n                </div>\n                <div class=\"relative\" data-kid=\"2-4-5-1-3\">\n                    <p class=\"mb-5 text-[11px] font-semibold tracking-[0.2em] text-[#7da4ff]\" data-kid=\"2-4-5-1-3-1\">\n                        MAKE THE NEXT ONE EASIER\n                    </p>\n                    <h2 class=\"font-display mx-auto max-w-[850px] text-[clamp(3rem,6vw,6.4rem)] leading-[0.9] tracking-[-0.07em] text-[#f4f6fb]\" data-kid=\"2-4-5-1-3-2\" id=\"cta-heading\">\n                        Your next video is already in the transcript.\n                    </h2>\n                    <p class=\"mx-auto mt-6 max-w-[540px] text-base leading-7 text-[#a9afbd]\" data-kid=\"2-4-5-1-3-3\">\n                        Stop managing a timeline for the sake of managing a timeline. Start with the words and direct the moment.\n                    </p>\n                    <a class=\"mt-9 inline-flex items-center gap-2 rounded-sm bg-[#5b8cff] px-6 py-3.5 text-sm font-semibold text-white shadow-[0_12px_36px_rgba(91,140,255,0.28)] transition-all hover:-translate-y-0.5 hover:bg-[#6b98ff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#c0d0ff] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-kid=\"2-4-5-1-3-4\" href=\"#product\">\n                        Start creating for free\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"2-4-5-1-3-4-1\" style=\"width:16px;height:16px;color:#ffffff;display:inline-flex;align-items:center;justify-content:center\">\n                        </i>\n                    </a>\n                    <p class=\"mt-4 text-[11px] text-[#687188]\" data-kid=\"2-4-5-1-3-5\">\n                        No credit card · no complicated setup · just your next idea\n                    </p>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"relative z-10 border-t border-[#2e3444]/70 px-6 py-7 lg:px-10\" data-kid=\"2-5\">\n        <div class=\"mx-auto flex max-w-[1280px] flex-col items-start justify-between gap-4 text-[11px] text-[#687188] sm:flex-row sm:items-center\" data-kid=\"2-5-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-5-1-1\">\n                <span class=\"flex h-6 w-6 items-center justify-center rounded-[3px] border border-[#2e3444] text-[9px] font-bold text-[#8b93a7]\" data-kid=\"2-5-1-1-1\">\n                    th\n                </span>\n                <span data-kid=\"2-5-1-1-2\">\n                    Talking Head · edit the words, not the maze.\n                </span>\n            </div>\n            <div class=\"flex items-center gap-5\" data-kid=\"2-5-1-2\">\n                <a class=\"transition-colors hover:text-[#a9afbd]\" data-kid=\"2-5-1-2-1\" href=\"#product\">\n                    Privacy\n                </a>\n                <a class=\"transition-colors hover:text-[#a9afbd]\" data-kid=\"2-5-1-2-2\" href=\"#product\">\n                    Terms\n                </a>\n                <span data-kid=\"2-5-1-2-3\">\n                    © 2026 Talking Head\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
