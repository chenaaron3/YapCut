        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: #100a13;\n  }\n\n  .title-card {\n    --aubergine: #100a13;\n    --chalk: #f5f0e8;\n    --lime: #d8ff32;\n    --lilac: #c4a5ff;\n    --muted: #9c8ea3;\n    position: relative;\n    width: 100%;\n    min-height: 0;\n    aspect-ratio: 16 / 9;\n    overflow: hidden;\n    isolation: isolate;\n    color: var(--chalk);\n    background: var(--aubergine);\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .title-card__frame {\n    position: absolute;\n    z-index: 1;\n    inset: clamp(18px, 2.35vw, 32px);\n    border: 1px solid rgb(245 240 232 / 14%);\n    pointer-events: none;\n  }\n\n  .title-card__frame:after {\n    content: '';\n    position: absolute;\n    right: -1px;\n    bottom: 13%;\n    width: 25%;\n    height: 1px;\n    background: var(--lilac);\n    opacity: .6;\n  }\n\n  .title-card__corner {\n    position: absolute;\n    z-index: 2;\n    width: 9px;\n    height: 9px;\n    border-color: var(--lime);\n    border-style: solid;\n  }\n\n  .title-card__corner--tl {\n    top: -1px;\n    left: -1px;\n    border-width: 2px 0 0 2px;\n  }\n\n  .title-card__corner--br {\n    right: -1px;\n    bottom: -1px;\n    border-width: 0 2px 2px 0;\n  }\n\n  .meta-line {\n    position: absolute;\n    z-index: 4;\n    top: 6.5%;\n    left: 7.3%;\n    display: flex;\n    align-items: center;\n    gap: .75rem;\n    color: var(--muted);\n    font-size: clamp(.56rem, .72vw, .72rem);\n    font-weight: 600;\n    letter-spacing: .17em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .meta-line__index {\n    color: var(--lilac);\n    font-family: 'Space Mono', monospace;\n    font-size: .9em;\n    letter-spacing: .08em;\n  }\n\n  .meta-line__rule {\n    display: block;\n    width: clamp(24px, 3.5vw, 50px);\n    height: 1px;\n    background: var(--lilac);\n  }\n\n  .meta-line__title {\n    color: var(--chalk);\n  }\n\n  .edition {\n    position: absolute;\n    z-index: 4;\n    top: 6.5%;\n    right: 7.3%;\n    color: var(--muted);\n    font-family: 'Space Mono', monospace;\n    font-size: clamp(.5rem, .64vw, .68rem);\n    letter-spacing: .14em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .edition strong {\n    color: var(--lime);\n    font-weight: 700;\n  }\n\n  .lime-rule {\n    position: absolute;\n    z-index: 1;\n    top: 28.5%;\n    left: 0;\n    width: 39%;\n    height: clamp(3px, .38vw, 6px);\n    background: var(--lime);\n    clip-path: polygon(0 0, 100% 0, 97% 100%, 0 100%);\n  }\n\n  .lilac-rule {\n    position: absolute;\n    z-index: 1;\n    bottom: 17.2%;\n    left: 7.3%;\n    width: 19%;\n    height: 1px;\n    background: var(--lilac);\n    transform: rotate(-2deg);\n    transform-origin: left center;\n    opacity: .72;\n  }\n\n  .orbit {\n    position: absolute;\n    z-index: 0;\n    top: -24%;\n    right: -7%;\n    width: 35%;\n    aspect-ratio: 1;\n    border: 1px solid var(--lilac);\n    border-radius: 999px;\n    opacity: .58;\n  }\n\n  .orbit:after {\n    content: '';\n    position: absolute;\n    top: 21%;\n    left: 11%;\n    width: 11px;\n    height: 11px;\n    border: 1px solid var(--lime);\n    border-radius: 50%;\n  }\n\n  .orbit__cut {\n    position: absolute;\n    right: 14%;\n    bottom: 12%;\n    width: 22%;\n    height: 1px;\n    background: var(--lilac);\n    transform: rotate(32deg);\n  }\n\n  .dot-grid {\n    position: absolute;\n    z-index: 2;\n    top: 13.4%;\n    right: 7.3%;\n    display: grid;\n    grid-template-columns: repeat(6, 6px);\n    gap: 8px;\n    transform-origin: top right;\n  }\n\n  .dot {\n    display: block;\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--lilac);\n  }\n\n  .dot:nth-child(4n) {\n    background: var(--chalk);\n  }\n\n  .crosshair {\n    position: absolute;\n    z-index: 2;\n    width: 25px;\n    height: 25px;\n    border: 1px solid var(--lime);\n    border-radius: 50%;\n    opacity: .9;\n  }\n\n  .crosshair:before,\n  .crosshair:after {\n    content: '';\n    position: absolute;\n    display: block;\n    background: var(--lime);\n  }\n\n  .crosshair:before {\n    top: 12px;\n    left: -8px;\n    width: 41px;\n    height: 1px;\n  }\n\n  .crosshair:after {\n    top: -8px;\n    left: 12px;\n    width: 1px;\n    height: 41px;\n  }\n\n  .crosshair--left {\n    bottom: 13.8%;\n    left: 7.3%;\n  }\n\n  .crosshair--small {\n    right: 27.2%;\n    bottom: 12.2%;\n    width: 17px;\n    height: 17px;\n    border-color: var(--lilac);\n    opacity: .62;\n    transform: scale(.7);\n  }\n\n  .crosshair--small:before,\n  .crosshair--small:after {\n    background: var(--lilac);\n  }\n\n  .crosshair--small:before {\n    top: 8px;\n    left: -7px;\n    width: 29px;\n  }\n\n  .crosshair--small:after {\n    top: -7px;\n    left: 8px;\n    height: 29px;\n  }\n\n  .title-lockup {\n    position: absolute;\n    z-index: 3;\n    inset: 0;\n    pointer-events: none;\n  }\n\n  .title-word {\n    position: absolute;\n    display: block;\n    margin: 0;\n    color: var(--chalk);\n    font-family: 'Anton', Impact, sans-serif;\n    font-size: clamp(5rem, 13.6vw, 12.8rem);\n    font-weight: 400;\n    letter-spacing: -.045em;\n    line-height: .78;\n    text-transform: uppercase;\n    white-space: nowrap;\n    transform-origin: center center;\n  }\n\n  .title-word--web {\n    top: 12.2%;\n    left: 7.3%;\n    transform: rotate(-2.5deg);\n  }\n\n  .starter-lockup {\n    position: absolute;\n    top: 32.5%;\n    left: 12.3%;\n    width: 72%;\n  }\n\n  .title-word--starter {\n    position: relative;\n    top: auto;\n    left: auto;\n    display: block;\n    width: max-content;\n    font-size: clamp(5.4rem, 17.5vw, 15.5rem);\n    transform: rotate(.75deg);\n  }\n\n  .title-word--kit {\n    right: 9%;\n    bottom: 9%;\n    color: var(--lime);\n    font-size: clamp(6rem, 17.5vw, 14rem);\n    transform: rotate(-1.8deg);\n  }\n\n  .part-label {\n    position: absolute;\n    z-index: 5;\n    right: auto;\n    top: auto;\n    bottom: -0.9rem;\n    left: 60%;\n    display: inline-flex;\n    align-items: center;\n    min-height: clamp(30px, 3.6vw, 48px);\n    padding: 0 clamp(.7rem, 1.3vw, 1.2rem);\n    color: var(--aubergine);\n    background: var(--lime);\n    box-shadow: 7px 7px 0 var(--lilac);\n    font-size: clamp(.68rem, 1vw, .95rem);\n    font-weight: 700;\n    letter-spacing: .12em;\n    line-height: 1;\n    text-transform: uppercase;\n    transform: rotate(-3deg);\n    transform-origin: center center;\n  }\n\n  .part-label:before {\n    content: '';\n    display: inline-block;\n    width: 5px;\n    height: 5px;\n    margin-right: .55rem;\n    background: var(--aubergine);\n  }\n\n  .side-note {\n    position: absolute;\n    z-index: 4;\n    right: 3.4%;\n    bottom: 17%;\n    color: var(--muted);\n    font-family: 'Space Mono', monospace;\n    font-size: clamp(.48rem, .62vw, .65rem);\n    letter-spacing: .1em;\n    line-height: 1;\n    text-transform: uppercase;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n  }\n\n  .side-note b {\n    color: var(--lilac);\n    font-weight: 700;\n  }\n\n  @media (max-width: 640px) {\n    .title-card {\n      min-height: 100svh;\n      aspect-ratio: auto;\n    }\n\n    .title-card__frame {\n      inset: 14px;\n    }\n\n    .meta-line {\n      top: 7.5%;\n      left: 8%;\n      gap: .45rem;\n      font-size: .52rem;\n    }\n\n    .edition {\n      top: 7.5%;\n      right: 8%;\n      font-size: .47rem;\n    }\n\n    .title-word--web {\n      top: 17%;\n      left: 8%;\n      font-size: clamp(4.2rem, 22vw, 6.6rem);\n    }\n\n    .starter-lockup {\n      top: 34%;\n      left: 8%;\n      width: 92%;\n    }\n\n    .title-word--starter {\n      top: auto;\n      left: auto;\n      font-size: clamp(4.35rem, 25vw, 7.4rem);\n    }\n\n    .title-word--kit {\n      right: 9%;\n      bottom: 14%;\n      font-size: clamp(5rem, 29vw, 8.4rem);\n    }\n\n    .part-label {\n      top: auto;\n      bottom: -0.75rem;\n      left: 54%;\n      min-height: 31px;\n      padding: 0 .68rem;\n      box-shadow: 5px 5px 0 var(--lilac);\n      font-size: .62rem;\n    }\n\n    .dot-grid {\n      top: 13%;\n      right: 8%;\n      grid-template-columns: repeat(4, 5px);\n      gap: 6px;\n      transform: scale(.8);\n    }\n\n    .dot {\n      width: 5px;\n      height: 5px;\n    }\n\n    .lime-rule {\n      top: 30%;\n      width: 48%;\n      height: 3px;\n    }\n\n    .orbit {\n      top: -15%;\n      right: -25%;\n      width: 62%;\n    }\n\n    .crosshair--left {\n      bottom: 18%;\n      left: 8%;\n      transform: scale(.72);\n      transform-origin: left center;\n    }\n\n    .crosshair--small,\n    .side-note {\n      display: none;\n    }\n\n    .lilac-rule {\n      bottom: 20%;\n      left: 8%;\n      width: 26%;\n    }\n  }\n</style>\n<main aria-label=\"Type Collision / Neon title card\" class=\"title-card\" data-kid=\"1\" data-name=\"main title card container\" data-title-card=\"\">\n    <div aria-hidden=\"true\" class=\"title-card__frame\" data-kid=\"1-1\" data-name=\"decorative frame wrapper\">\n        <span class=\"title-card__corner title-card__corner--tl\" data-kid=\"1-1-1\" data-name=\"top left corner accent\">\n        </span>\n        <span class=\"title-card__corner title-card__corner--br\" data-kid=\"1-1-2\" data-name=\"bottom right corner accent\">\n        </span>\n    </div>\n    <p class=\"meta-line\" data-kid=\"1-2\" data-name=\"meta information line\">\n        <span class=\"meta-line__index\" data-kid=\"1-2-1\" data-name=\"meta index number\">\n            001\n        </span>\n        <span aria-hidden=\"true\" class=\"meta-line__rule\" data-kid=\"1-2-2\" data-name=\"decorative line\">\n        </span>\n        <span class=\"meta-line__title\" data-kid=\"1-2-3\" data-name=\"meta title\">\n            Type collision\n        </span>\n    </p>\n    <p class=\"edition\" data-kid=\"1-3\" data-name=\"edition information\">\n        <strong data-kid=\"1-3-1\" data-name=\"neon edition emphasis\">\n            Neon\n        </strong>\n        / title edit\n    </p>\n    <span aria-hidden=\"true\" class=\"lime-rule\" data-kid=\"1-4\" data-name=\"lime accent rule\">\n    </span>\n    <span aria-hidden=\"true\" class=\"lilac-rule\" data-kid=\"1-5\" data-name=\"lilac accent rule\">\n    </span>\n    <span aria-hidden=\"true\" class=\"orbit\" data-kid=\"1-6\" data-name=\"orbital decorative container\">\n        <span class=\"orbit__cut\" data-kid=\"1-6-1\" data-name=\"orbital cut accent\">\n        </span>\n    </span>\n    <div aria-hidden=\"true\" class=\"dot-grid js-dot-grid\" data-dynamic=\"true\" data-kid=\"1-7\" data-name=\"dot grid container\" data-reason=\"injected entrance animation for grid of dots\">\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-1\" data-name=\"dot 1\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-2\" data-name=\"dot 2\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-3\" data-name=\"dot 3\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-4\" data-name=\"dot 4\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-5\" data-name=\"dot 5\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-6\" data-name=\"dot 6\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-7\" data-name=\"dot 7\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-8\" data-name=\"dot 8\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-9\" data-name=\"dot 9\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-10\" data-name=\"dot 10\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-11\" data-name=\"dot 11\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-12\" data-name=\"dot 12\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-13\" data-name=\"dot 13\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-14\" data-name=\"dot 14\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-15\" data-name=\"dot 15\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-16\" data-name=\"dot 16\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-17\" data-name=\"dot 17\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-18\" data-name=\"dot 18\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-19\" data-name=\"dot 19\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-20\" data-name=\"dot 20\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-21\" data-name=\"dot 21\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-22\" data-name=\"dot 22\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-23\" data-name=\"dot 23\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n        <span class=\"dot\" data-dynamic=\"true\" data-kid=\"1-7-24\" data-name=\"dot 24\" data-reason=\"injected entrance animation for grid of dots\">\n        </span>\n    </div>\n    <span aria-hidden=\"true\" class=\"crosshair crosshair--left\" data-kid=\"1-8\" data-name=\"left crosshair icon\">\n    </span>\n    <span aria-hidden=\"true\" class=\"crosshair crosshair--small\" data-kid=\"1-9\" data-name=\"small crosshair icon\">\n    </span>\n    <h1 aria-label=\"Web Starter Kit\" class=\"title-lockup\" data-kid=\"1-10\" data-name=\"title lockup header\" id=\"title-card-heading\">\n        <span aria-hidden=\"true\" class=\"title-word title-word--web js-title-word\" data-dynamic=\"true\" data-kid=\"1-10-1\" data-name=\"web title word\" data-reason=\"injected entrance animation for title word\">\n            Web\n        </span>\n        <span class=\"starter-lockup\" data-kid=\"1-10-2\" data-name=\"starter lockup wrapper\">\n            <span aria-hidden=\"true\" class=\"title-word title-word--starter js-title-word\" data-dynamic=\"true\" data-kid=\"1-10-2-1\" data-name=\"starter title word\" data-reason=\"injected entrance animation for title word\">\n                Starter\n            </span>\n            <span class=\"part-label js-part-label\" data-dynamic=\"true\" data-kid=\"1-10-2-2\" data-name=\"part label\" data-reason=\"injected entrance animation for part label\">\n                Part 1\n            </span>\n        </span>\n        <span aria-hidden=\"true\" class=\"title-word title-word--kit js-title-word\" data-dynamic=\"true\" data-kid=\"1-10-3\" data-name=\"kit title word\" data-reason=\"injected entrance animation for title word\">\n            Kit\n        </span>\n    </h1>\n    <p class=\"side-note\" data-kid=\"1-11\" data-name=\"side note text\">\n        <b data-kid=\"1-11-1\" data-name=\"side note emphasis\">\n            01\n        </b>\n        / text enters frame\n    </p>\n</main>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (() => {\n    const card = document.querySelector('[data-title-card]');\n    if (!card || typeof gsap === 'undefined') return;\n\n    const dotGrid = card.querySelector('.js-dot-grid');\n    const titleWords = card.querySelectorAll('.js-title-word');\n    const partLabel = card.querySelector('.js-part-label');\n    const animatedElements = [dotGrid, ...titleWords, partLabel];\n    const motion = gsap.matchMedia();\n\n    motion.add('(prefers-reduced-motion: reduce)', () => {\n      gsap.set(animatedElements, { opacity: 1 });\n    });\n\n    motion.add('(prefers-reduced-motion: no-preference)', () => {\n      const timeline = gsap.timeline();\n      timeline\n        .from(dotGrid, { opacity: 0, scale: .55, duration: .42, ease: 'power2.out' })\n        .from(titleWords, {\n          opacity: 0,\n          x: (index) => index === 0 ? -54 : index === 1 ? 68 : 54,\n          rotation: (index) => index === 0 ? -7 : index === 1 ? 4 : -5,\n          scale: .92,\n          duration: .62,\n          stagger: .085,\n          ease: 'power3.out'\n        }, '-=.12')\n        .from(partLabel, {\n          opacity: 0,\n          y: -26,\n          scale: .38,\n          rotation: -10,\n          duration: .56,\n          ease: 'back.out(1.8)'\n        }, '-=.14');\n    });\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-12T15:52:33.741922+00:00",
      "modified": "2026-08-12T15:52:33.741922+00:00",
      "id": "var_1a7ada83351a"
    },
    "var_ce8b9c3bc653": {
      "type": "variant",
      "label": "Paper Cut / Editorial",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1855,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n\n.paper-stage {\n  --paper: #f4efe4;\n  --ink: #171513;\n  --tomato: #df4d38;\n  --quiet: #81796e;\n  --hairline: rgba(23, 21, 19, 0.15);\n  font-family: 'IBM Plex Mono', monospace;\n  color: var(--ink);\n  background-color: var(--paper);\n  background-image: linear-gradient(to right, rgba(23, 21, 19, 0.012) 1px, transparent 1px), linear-gradient(to bottom, rgba(23, 21, 19, 0.011) 1px, transparent 1px), radial-gradient(circle at 16% 12%, rgba(255, 255, 255, 0.62), transparent 29%), radial-gradient(circle at 83% 82%, rgba(185, 166, 138, 0.1), transparent 32%);\n  background-size: 72px 72px, 72px 72px, 100% 100%, 100% 100%;\n}\n\n.display-font {\n  font-family: 'DM Serif Display', serif;\n}\n\n.paper-frame {\n  border-color: var(--hairline);\n}\n\n.paper-tick {\n  background: var(--tomato);\n}\n\n.paper-rule {\n  background: var(--tomato);\n  transform-origin: left center;\n}\n\n.title-red-cut {\n  right: -0.3rem;\n  width: auto;\n  background: var(--tomato);\n  mix-blend-mode: multiply;\n  transform: rotate(-1.8deg);\n  transform-origin: center;\n}\n\n.registration-dot {\n  background: var(--tomato);\n}\n\n.registration-ring {\n  border-color: var(--tomato);\n}\n\n.quiet-ink {\n  color: var(--quiet);\n}\n\n.paper-stage p,\n.paper-stage h1,\n.paper-stage h2 {\n  margin: 0;\n}\n</style>\n<main aria-label=\"Paper Cut / Editorial title card\" class=\"paper-stage relative mx-auto aspect-video w-full overflow-hidden\" data-kid=\"1\" data-name=\"editorial title card container\" data-title-card=\"\">\n    <div aria-hidden=\"true\" class=\"paper-frame pointer-events-none absolute inset-[clamp(.75rem,2.2vw,1.75rem)] border\" data-kid=\"1-1\" data-name=\"decorative frame border\">\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute left-[clamp(.75rem,2.2vw,1.75rem)] top-[clamp(.75rem,2.2vw,1.75rem)] h-3 w-px paper-tick\" data-kid=\"1-2\" data-name=\"top-left corner tick mark\">\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute left-[clamp(.75rem,2.2vw,1.75rem)] top-[clamp(.75rem,2.2vw,1.75rem)] h-px w-3 paper-tick\" data-kid=\"1-3\" data-name=\"top-left corner tick mark\">\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute bottom-[clamp(.75rem,2.2vw,1.75rem)] right-[clamp(.75rem,2.2vw,1.75rem)] h-3 w-px paper-tick\" data-kid=\"1-4\" data-name=\"bottom-right corner tick mark\">\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute bottom-[clamp(.75rem,2.2vw,1.75rem)] right-[clamp(.75rem,2.2vw,1.75rem)] h-px w-3 paper-tick\" data-kid=\"1-5\" data-name=\"bottom-right corner tick mark\">\n    </div>\n    <div class=\"relative flex h-full flex-col px-[clamp(1.4rem,7vw,6rem)] py-[clamp(1.35rem,5.2vw,4.25rem)]\" data-kid=\"1-6\" data-name=\"content layout wrapper\">\n        <header class=\"flex items-start justify-between border-t border-[var(--hairline)] pt-4 sm:pt-5\" data-kid=\"1-6-1\" data-name=\"header section\">\n            <div class=\"flex items-start gap-3 sm:gap-4\" data-kid=\"1-6-1-1\" data-name=\"header decorative icon and title container\">\n                <span aria-hidden=\"true\" class=\"js-reg-dot mt-[.18rem] h-2 w-2 shrink-0 rounded-full registration-dot\" data-kid=\"1-6-1-1-1\" data-name=\"registration dot icon\">\n                </span>\n                <div data-kid=\"1-6-1-1-2\" data-name=\"header title container\">\n                    <p class=\"js-kicker text-[clamp(.5rem,.78vw,.72rem)] font-medium leading-none tracking-[.17em]\" data-kid=\"1-6-1-1-2-1\" data-name=\"kicker text\">\n                        SERIES 01 / TITLE STUDY\n                    </p>\n                    <div class=\"mt-3 h-px w-[clamp(5.5rem,12vw,9.5rem)] overflow-hidden bg-[var(--ink)]/10\" data-kid=\"1-6-1-1-2-2\" data-name=\"divider line container\">\n                        <span class=\"js-rule paper-rule block h-full w-full\" data-kid=\"1-6-1-1-2-2-1\" data-name=\"divider line\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <p class=\"hidden text-right text-[clamp(.48rem,.68vw,.64rem)] leading-[1.45] tracking-[.16em] quiet-ink sm:block\" data-kid=\"1-6-1-2\" data-name=\"header metadata text\">\n                PAPER CUT / EDITORIAL\n                <br data-kid=\"1-6-1-2-1\" data-name=\"line break\"/>\n                FRAME 001  —  16:09\n            </p>\n        </header>\n        <section aria-labelledby=\"title-card-heading\" class=\"my-auto w-full max-w-[58rem] pb-[clamp(.2rem,1vw,1rem)] pt-[clamp(2rem,4vw,3.25rem)]\" data-kid=\"1-6-2\" data-name=\"main section\">\n            <p class=\"mb-[clamp(.55rem,1vw,.9rem)] ml-[clamp(.15rem,10vw,8rem)] text-[clamp(.5rem,.75vw,.68rem)] tracking-[.18em] quiet-ink\" data-kid=\"1-6-2-1\" data-name=\"subtitle text\">\n                A SHORT COURSE IN TYPE & MOTION\n            </p>\n            <div class=\"relative ml-[clamp(0rem,5vw,4rem)]\" data-kid=\"1-6-2-2\" data-name=\"main title container\">\n                <div class=\"overflow-hidden\" data-kid=\"1-6-2-2-1\" data-name=\"first title line wrapper\">\n                    <h1 class=\"display-font js-title-line relative z-10 text-[clamp(4.25rem,13.1vw,11.5rem)] leading-[.72] tracking-[-.075em]\" data-kid=\"1-6-2-2-1-1\" data-name=\"hero headline\" id=\"title-card-heading\">\n                        Web\n                    </h1>\n                </div>\n                <div class=\"relative -mt-[clamp(.1rem,.45vw,.5rem)]\" data-kid=\"1-6-2-2-2\" data-name=\"second title line wrapper\">\n                    <div class=\"relative inline-block max-w-full\" data-kid=\"1-6-2-2-2-1\" data-name=\"second title line container\">\n                        <span aria-hidden=\"true\" class=\"title-red-cut pointer-events-none absolute left-[clamp(.45rem,1.5vw,1.25rem)] top-[clamp(1.4rem,3vw,2.65rem)] h-[clamp(2.65rem,6.7vw,5.85rem)]\" data-kid=\"1-6-2-2-2-1-1\" data-name=\"red highlight accent shape\">\n                        </span>\n                        <div class=\"relative z-10 overflow-hidden\" data-kid=\"1-6-2-2-2-1-2\" data-name=\"second title line overflow wrapper\">\n                            <h2 class=\"display-font js-title-line relative inline-block whitespace-nowrap text-[clamp(3.35rem,10.65vw,9.35rem)] leading-[.78] tracking-[-.075em]\" data-kid=\"1-6-2-2-2-1-2-1\" data-name=\"secondary headline\">\n                                Starter Kit\n                            </h2>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-[clamp(1.9rem,3.8vw,3.35rem)] flex justify-start ml-[clamp(7.5rem,36vw,27rem)]\" data-kid=\"1-6-2-3\" data-name=\"footer section wrapper\">\n                <div class=\"flex items-center gap-3 sm:gap-5\" data-kid=\"1-6-2-3-1\" data-name=\"part indicator container\">\n                    <span aria-hidden=\"true\" class=\"h-px w-[clamp(2rem,7vw,5.8rem)] bg-[var(--ink)]/35\" data-kid=\"1-6-2-3-1-1\" data-name=\"decorative line\">\n                    </span>\n                    <p aria-label=\"Part 1\" class=\"js-label border border-[var(--ink)] px-3 py-2 text-[clamp(.53rem,.8vw,.72rem)] font-semibold leading-none tracking-[.17em]\" data-kid=\"1-6-2-3-1-2\" data-name=\"part label button\">\n                        PART 1\n                    </p>\n                </div>\n            </div>\n        </section>\n        <footer class=\"flex items-end justify-between border-b border-[var(--hairline)] pb-4 pt-3 text-[clamp(.48rem,.67vw,.62rem)] tracking-[.16em] quiet-ink sm:pb-5\" data-kid=\"1-6-3\" data-name=\"footer bar\">\n            <p data-kid=\"1-6-3-1\" data-name=\"footer informational text\">\n                WORDS / TYPE / MOTION\n            </p>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-6-3-2\" data-name=\"footer navigation container\">\n                <span aria-hidden=\"true\" class=\"js-reg-dot h-2.5 w-2.5 rounded-full registration-dot\" data-kid=\"1-6-3-2-1\" data-name=\"registration dot icon\">\n                </span>\n                <span aria-hidden=\"true\" class=\"js-reg-dot h-2.5 w-2.5 rounded-full border registration-ring\" data-kid=\"1-6-3-2-2\" data-name=\"registration ring icon\">\n                </span>\n                <span class=\"ml-1\" data-kid=\"1-6-3-2-3\" data-name=\"slide index counter\">\n                    01—03\n                </span>\n            </div>\n        </footer>\n    </div>\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute right-[clamp(1.5rem,9vw,8rem)] top-[clamp(8rem,25vw,13rem)] flex items-center gap-3\" data-kid=\"1-7\" data-name=\"decorative registration dots container\">\n        <span class=\"js-reg-dot h-2 w-2 rounded-full registration-dot\" data-kid=\"1-7-1\" data-name=\"registration dot icon\">\n        </span>\n        <span class=\"js-reg-dot h-1.5 w-1.5 rounded-full registration-dot\" data-kid=\"1-7-2\" data-name=\"registration dot icon\">\n        </span>\n    </div>\n    <span aria-hidden=\"true\" class=\"js-reg-dot pointer-events-none absolute bottom-[clamp(5.25rem,14vw,7.8rem)] left-[clamp(2.5rem,8vw,7rem)] h-1.5 w-1.5 rounded-full registration-dot\" data-kid=\"1-8\" data-name=\"registration dot icon\">\n    </span>\n</main>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (() => {\n  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  const titleLines = document.querySelectorAll('.js-title-line');\n  const registrationDots = document.querySelectorAll('.js-reg-dot');\n\n  if (reduceMotion) {\n    gsap.set('.js-kicker', { x: 0, autoAlpha: 1 });\n    gsap.set('.js-rule', { scaleX: 1 });\n    gsap.set(titleLines, { yPercent: 0, rotation: 0, autoAlpha: 1 });\n    gsap.set('.js-label', { scale: 1, autoAlpha: 1 });\n    gsap.set(registrationDots, { scale: 1, autoAlpha: 1 });\n    return;\n  }\n\n  const timeline = gsap.timeline({ defaults: { ease: 'power2.out' } });\n  timeline\n    .from('.js-kicker', { x: -24, autoAlpha: 0, duration: 0.46 })\n    .from('.js-rule', { scaleX: 0, duration: 0.42 }, '-=0.16')\n    .from(titleLines, { yPercent: 108, rotation: -2, duration: 0.68, stagger: 0.1 }, '-=0.06')\n    .from('.js-label', { scale: 0.84, autoAlpha: 0, duration: 0.42 }, '-=0.2')\n    .from(registrationDots, { scale: 0, autoAlpha: 0, duration: 0.3, stagger: 0.055 }, '-=0.2');\n})();\n</script>\n",
      "comments": [],
      "created": "2026-08-12T15:52:33.736622+00:00",
      "modified": "2026-08-12T15:52:33.736622+00:00",
      "id": "var_ce8b9c3bc653"
    },
    "var_e157309e2341": {
      "type": "variant",
      "label": "Soft Signal / Handwritten",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3710,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,500;6..96,600&family=Caveat:wght@500;600;700&family=DM+Sans:wght@500;600;700&display=swap');\n\n:root {\n  --powder-blue: #b9cfd9;\n  --parchment: #f5ecd9;\n  --paper-edge: #e7d9bf;\n  --charcoal-ink: #29353a;\n  --ink-soft: #6b797d;\n  --butter-yellow: #f1d891;\n  --coral-accent: #df836e;\n}\n\n.signal-card {\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  aspect-ratio: 16 / 9;\n  overflow: hidden;\n  background: radial-gradient(circle at 64% 18%, rgba(255, 255, 255, .13), transparent 38%), var(--powder-blue);\n  color: var(--charcoal-ink);\n  font-family: 'DM Sans', sans-serif;\n}\n\n.signal-card::before,\n.signal-card::after {\n  position: absolute;\n  content: '';\n  pointer-events: none;\n}\n\n.signal-card::before {\n  inset: 10.7% 8.7% 11.4% 10.2%;\n  z-index: -2;\n  background: radial-gradient(circle at 19% 28%, rgba(255, 255, 255, .25), transparent 30%), radial-gradient(circle at 83% 72%, rgba(190, 166, 125, .09), transparent 36%), var(--parchment);\n  box-shadow: 1px 2px 0 var(--paper-edge), -1px 1px 0 var(--paper-edge);\n  clip-path: polygon(.6% 1.4%, 99.7% 0, 100% 98.7%, .3% 100%);\n  transform: rotate(-.75deg);\n}\n\n.signal-card::after {\n  inset: 11.7% 9.5% 12.4% 11%;\n  z-index: -1;\n  border: 1px solid rgba(255, 255, 255, .28);\n  opacity: .7;\n  transform: rotate(-.75deg);\n}\n\n.signal-frame {\n  position: absolute;\n  inset: 4.1%;\n  border: 1px solid var(--ink-soft);\n  opacity: 1;\n}\n\n.signal-tape {\n  position: absolute;\n  top: 16.1%;\n  left: 15.7%;\n  z-index: 0;\n  width: clamp(82px, 8vw, 116px);\n  height: clamp(13px, 1.45vw, 18px);\n  background: var(--butter-yellow);\n  opacity: .62;\n  transform: rotate(-2.8deg);\n}\n\n.signal-kicker {\n  position: absolute;\n  top: 16.7%;\n  left: 15.4%;\n  margin: 0;\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  font-size: clamp(8px, .76vw, 11px);\n  font-weight: 700;\n  line-height: 1;\n  letter-spacing: .2em;\n  transform: rotate(-.75deg);\n}\n\n.signal-kicker::before {\n  display: block;\n  width: clamp(28px, 3.2vw, 47px);\n  height: 1px;\n  background: var(--charcoal-ink);\n  content: '';\n}\n\n.signal-lockup {\n  position: absolute;\n  top: 46.1%;\n  left: 50.5%;\n  margin: 0;\n  width: min(76%, 960px);\n  text-align: center;\n  transform: translate(-50%, -50%) rotate(-.7deg);\n}\n\n.signal-line-mask {\n  overflow: hidden;\n}\n\n.signal-web {\n  display: block;\n  margin-left: 13%;\n  color: var(--charcoal-ink);\n  font-family: 'Caveat', cursive;\n  font-size: clamp(3.4rem, 6.1vw, 6.7rem);\n  font-weight: 600;\n  line-height: .68;\n  text-align: left;\n  letter-spacing: -.02em;\n  transform: rotate(-4deg) translateX(-.08em);\n}\n\n.signal-starter {\n  display: block;\n  margin-top: -.1em;\n  margin-left: 4%;\n  color: var(--charcoal-ink);\n  font-family: 'Caveat', cursive;\n  font-size: clamp(5.1rem, 11.6vw, 10rem);\n  font-weight: 700;\n  line-height: .74;\n  letter-spacing: -.055em;\n  white-space: nowrap;\n  transform: rotate(1.1deg) translateX(.02em);\n}\n\n.signal-seal {\n  position: absolute;\n  top: 33.2%;\n  right: 16.8%;\n  display: grid;\n  width: clamp(90px, 10.6vw, 139px);\n  aspect-ratio: 1.78;\n  place-items: center;\n  border: 1.2px solid var(--charcoal-ink);\n  border-radius: 50%;\n  color: var(--charcoal-ink);\n  font-family: 'Bodoni Moda', serif;\n  font-size: clamp(15px, 1.7vw, 24px);\n  font-weight: 500;\n  line-height: 1;\n  transform: rotate(8deg);\n}\n\n.signal-seal::before {\n  position: absolute;\n  inset: 5px;\n  border: 1px solid var(--ink-soft);\n  border-radius: 50%;\n  content: '';\n  opacity: .62;\n}\n\n.signal-swoosh {\n  position: relative;\n  display: block;\n  width: 58%;\n  height: 20px;\n  margin: .06em auto 0;\n  border-bottom: 2.5px solid var(--charcoal-ink);\n  border-radius: 50%;\n  transform: rotate(-2.4deg) skewX(-13deg) scaleX(1);\n  transform-origin: center;\n}\n\n.signal-swoosh::after {\n  position: absolute;\n  right: 4%;\n  bottom: -5px;\n  width: 19%;\n  height: 7px;\n  border-bottom: 1px solid var(--ink-soft);\n  border-radius: 50%;\n  content: '';\n  transform: rotate(1deg);\n}\n\n.signal-star {\n  position: absolute;\n  top: 21%;\n  right: 17.4%;\n  color: var(--butter-yellow);\n  font-family: 'Bodoni Moda', serif;\n  font-size: clamp(21px, 2.7vw, 37px);\n  line-height: 1;\n  transform: rotate(12deg);\n}\n\n.signal-dot {\n  position: absolute;\n  bottom: 21.7%;\n  left: 20.7%;\n  width: clamp(8px, 1vw, 13px);\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: var(--coral-accent);\n}\n\n.signal-spark {\n  position: absolute;\n  bottom: 24.5%;\n  left: 25.5%;\n  width: 5px;\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: var(--butter-yellow);\n}\n\n.signal-note {\n  position: absolute;\n  bottom: 14.7%;\n  left: 15.4%;\n  margin: 0;\n  color: var(--charcoal-ink);\n  font-size: clamp(8px, .67vw, 10px);\n  font-weight: 700;\n  line-height: 1;\n  letter-spacing: .19em;\n  transform: rotate(-.75deg);\n}\n\n.signal-note b {\n  color: var(--coral-accent);\n  font-weight: 700;\n}\n\n@media (max-width: 640px) {\n  .signal-card::before {\n    inset: 11.2% 6.5% 11.8% 7%;\n  }\n\n  .signal-frame {\n    inset: 4.6%;\n  }\n\n  .signal-kicker {\n    top: 16.4%;\n    left: 12.2%;\n    gap: 7px;\n    letter-spacing: .14em;\n  }\n\n  .signal-kicker::before {\n    width: 24px;\n  }\n\n  .signal-lockup {\n    top: 47%;\n    left: 51%;\n    width: 88%;\n  }\n\n  .signal-web {\n    margin-left: 10%;\n    font-size: clamp(2.7rem, 13vw, 4.3rem);\n  }\n\n  .signal-starter {\n    margin-left: 2%;\n    font-size: clamp(4.1rem, 17.2vw, 6.7rem);\n  }\n\n  .signal-seal {\n    top: 31.2%;\n    right: 11.5%;\n    width: clamp(76px, 22vw, 100px);\n    font-size: clamp(13px, 4vw, 17px);\n  }\n\n  .signal-seal::before {\n    inset: 4px;\n  }\n\n  .signal-swoosh {\n    width: 71%;\n    margin-top: .08em;\n  }\n\n  .signal-star {\n    top: 20.5%;\n    right: 10%;\n    font-size: clamp(18px, 7vw, 28px);\n  }\n\n  .signal-dot {\n    bottom: 21.5%;\n    left: 14%;\n  }\n\n  .signal-spark {\n    bottom: 24%;\n    left: 20%;\n  }\n\n  .signal-note {\n    bottom: 14.8%;\n    left: 12.2%;\n    letter-spacing: .12em;\n  }\n}\n</style>\n\n<main id=\"soft-signal-card\" class=\"signal-card\" aria-label=\"Soft Signal handwritten title card for Web Starter Kit, episode 01\">\n  <div class=\"signal-frame\" aria-hidden=\"true\"></div>\n  <span class=\"signal-tape\" aria-hidden=\"true\"></span>\n\n  <p class=\"signal-kicker\">EPISODE 01</p>\n\n  <h1 class=\"signal-lockup\" aria-label=\"Web Starter Kit\">\n    <span class=\"signal-line-mask\"><span class=\"signal-web signal-title-line\">Web</span></span>\n    <span class=\"signal-line-mask\"><span class=\"signal-starter signal-title-line\">Starter Kit</span></span>\n    <span class=\"signal-swoosh\" aria-hidden=\"true\"></span>\n  </h1>\n\n  <div class=\"signal-seal\" aria-label=\"Part 1\">Part 1</div>\n  <span class=\"signal-star\" aria-hidden=\"true\">✦</span>\n  <span class=\"signal-dot\" aria-hidden=\"true\"></span>\n  <span class=\"signal-spark\" aria-hidden=\"true\"></span>\n  <p class=\"signal-note\">FIELD NOTE <b>/</b> 01</p>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n  (() => {\n    const frame = document.querySelector('.signal-frame');\n    const titleLines = document.querySelectorAll('.signal-title-line');\n    const seal = document.querySelector('.signal-seal');\n    const swoosh = document.querySelector('.signal-swoosh');\n    const marks = document.querySelectorAll('.signal-star, .signal-dot, .signal-spark');\n    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n    if (reducedMotion) {\n      gsap.set(frame, { opacity: 1 });\n      gsap.set(titleLines, { y: 0, opacity: 1 });\n      gsap.set(seal, { opacity: 1, scale: 1, rotation: 8 });\n      gsap.set(swoosh, { opacity: 1, scaleX: 1 });\n      gsap.set(marks, { opacity: 1, scale: 1 });\n      return;\n    }\n\n    const timeline = gsap.timeline({ defaults: { ease: 'power2.out' } });\n    timeline\n      .from(frame, { opacity: 0, duration: .62 })\n      .from(titleLines, { y: '112%', opacity: 0, rotation: -6, stagger: .12, duration: .78, ease: 'power3.out' }, '-=.12')\n      .to(titleLines, { rotation: (index) => index === 0 ? -4 : 1.1, duration: .28, stagger: .07, ease: 'back.out(1.6)' }, '-=.23')\n      .fromTo(seal, { opacity: 0, scale: .56, rotation: -13 }, { opacity: 1, scale: 1, rotation: 8, duration: .72, ease: 'back.out(1.8)' }, '-=.3')\n      .fromTo(swoosh, { opacity: 0, scaleX: 0 }, { opacity: 1, scaleX: 1, duration: .55, ease: 'power2.out' }, '-=.12')\n      .fromTo(marks, { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, duration: .42, stagger: .09, ease: 'back.out(2)' }, '-=.18');\n  })();\n</script>",
      "comments": [],
      "created": "2026-08-12T15:52:33.748589+00:00",
      "modified": "2026-08-12T15:52:33.748589+00:00",
      "id": "var_e157309e2341"
    },
    "var_3d1ed23df5ff": {
      "type": "variant",
      "label": "Type Collision / Neon — Vertical",
      "parentId": "var_1a7ada83351a",
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: #100a13;\n  }\n\n  .title-card {\n    --aubergine: #100a13;\n    --chalk: #f5f0e8;\n    --lime: #d8ff32;\n    --lilac: #c4a5ff;\n    --muted: #9c8ea3;\n    --chalk-rgb: 245 240 232;\n    position: relative;\n    box-sizing: border-box;\n    width: 100%;\n    min-height: 0;\n    aspect-ratio: 9 / 16;\n    isolation: isolate;\n    overflow: hidden;\n    color: var(--chalk);\n    background: var(--aubergine);\n    font-family: 'Space Grotesk', sans-serif;\n  }\n\n  .title-card__frame {\n    position: absolute;\n    z-index: 1;\n    inset: 14px;\n    border: 1px solid rgb(var(--chalk-rgb) / 14%);\n    pointer-events: none;\n  }\n\n  .title-card__frame::before,\n  .title-card__frame::after {\n    content: '';\n    position: absolute;\n    width: 9px;\n    height: 9px;\n    border-color: var(--lime);\n    border-style: solid;\n  }\n\n  .title-card__frame::before {\n    top: -1px;\n    left: -1px;\n    border-width: 2px 0 0 2px;\n  }\n\n  .title-card__frame::after {\n    right: -1px;\n    bottom: -1px;\n    border-width: 0 2px 2px 0;\n  }\n\n  .title-card__frame-mark {\n    position: absolute;\n    right: -1px;\n    bottom: 16%;\n    width: 22%;\n    height: 1px;\n    background: var(--lilac);\n    opacity: .58;\n  }\n\n  .meta-line {\n    position: absolute;\n    z-index: 4;\n    top: 7.8%;\n    left: 8%;\n    display: flex;\n    align-items: center;\n    gap: .45rem;\n    margin: 0;\n    color: var(--muted);\n    font-size: .5rem;\n    font-weight: 600;\n    letter-spacing: .14em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .meta-line__index {\n    color: var(--lilac);\n    font-family: 'Space Mono', monospace;\n    font-size: .9em;\n    letter-spacing: .08em;\n  }\n\n  .meta-line__rule {\n    display: block;\n    width: 24px;\n    height: 1px;\n    background: var(--lilac);\n  }\n\n  .meta-line__title {\n    color: var(--chalk);\n  }\n\n  .edition {\n    position: absolute;\n    z-index: 4;\n    top: 7.8%;\n    right: 8%;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: .16rem;\n    margin: 0;\n    color: var(--muted);\n    font-family: 'Space Mono', monospace;\n    font-size: .46rem;\n    letter-spacing: .09em;\n    line-height: 1.25;\n    text-align: right;\n    text-transform: uppercase;\n  }\n\n  .edition__accent {\n    color: var(--lime);\n    font-family: 'Space Grotesk', sans-serif;\n    font-weight: 700;\n    letter-spacing: .14em;\n  }\n\n  .edition__rest {\n    color: var(--muted);\n  }\n\n  .lime-rule {\n    position: absolute;\n    z-index: 1;\n    top: 30.4%;\n    left: 0;\n    width: 58%;\n    height: 3px;\n    background: var(--lime);\n    clip-path: polygon(0 0, 100% 0, 96% 100%, 0 100%);\n  }\n\n  .lilac-rule {\n    position: absolute;\n    z-index: 1;\n    top: 76.1%;\n    left: 8%;\n    width: 29%;\n    height: 1px;\n    background: var(--lilac);\n    opacity: .72;\n    transform: rotate(-2deg);\n    transform-origin: left center;\n  }\n\n  .orbit {\n    position: absolute;\n    z-index: 0;\n    top: -14%;\n    right: -35%;\n    width: 69%;\n    aspect-ratio: 1;\n    border: 1px solid var(--lilac);\n    border-radius: 999px;\n    opacity: .5;\n  }\n\n  .orbit::after {\n    content: '';\n    position: absolute;\n    top: 20%;\n    left: 11%;\n    width: 8px;\n    height: 8px;\n    border: 1px solid var(--lime);\n    border-radius: 50%;\n  }\n\n  .orbit__cut {\n    position: absolute;\n    right: 13%;\n    bottom: 13%;\n    width: 25%;\n    height: 1px;\n    background: var(--lilac);\n    transform: rotate(32deg);\n  }\n\n  .dot-grid {\n    position: absolute;\n    z-index: 2;\n    top: 15.6%;\n    right: 8.5%;\n    display: grid;\n    grid-template-columns: repeat(4, 5px);\n    gap: 6px;\n    transform-origin: top right;\n  }\n\n  .dot {\n    display: block;\n    width: 5px;\n    height: 5px;\n    border-radius: 50%;\n    background: var(--lilac);\n  }\n\n  .dot:nth-child(4n) {\n    background: var(--chalk);\n  }\n\n  .crosshair {\n    position: absolute;\n    z-index: 2;\n    width: 23px;\n    height: 23px;\n    border: 1px solid var(--lime);\n    border-radius: 50%;\n    opacity: .9;\n  }\n\n  .crosshair::before,\n  .crosshair::after {\n    content: '';\n    position: absolute;\n    display: block;\n    background: var(--lime);\n  }\n\n  .crosshair::before {\n    top: 11px;\n    left: -9px;\n    width: 40px;\n    height: 1px;\n  }\n\n  .crosshair::after {\n    top: -9px;\n    left: 11px;\n    width: 1px;\n    height: 40px;\n  }\n\n  .crosshair--left {\n    top: 74.2%;\n    left: 8.5%;\n  }\n\n  .crosshair__index {\n    position: absolute;\n    top: 27px;\n    left: 29px;\n    color: var(--muted);\n    font-family: 'Space Mono', monospace;\n    font-size: .4rem;\n    letter-spacing: .08em;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .title-lockup {\n    position: absolute;\n    z-index: 3;\n    inset: 0;\n    margin: 0;\n    pointer-events: none;\n  }\n\n  .title-word {\n    position: absolute;\n    display: block;\n    margin: 0;\n    color: var(--chalk);\n    font-family: 'Anton', Impact, sans-serif;\n    font-size: 23vw;\n    font-weight: 400;\n    letter-spacing: -.05em;\n    line-height: .8;\n    text-transform: uppercase;\n    white-space: nowrap;\n    transform-origin: center center;\n  }\n\n  .title-word--web {\n    top: 20.8%;\n    left: 8%;\n    font-size: 24vw;\n    transform: rotate(-2.5deg);\n  }\n\n  .title-word--starter {\n    top: 35.2%;\n    left: 7.5%;\n    font-size: 24.5vw;\n    letter-spacing: -.045em;\n    transform: rotate(.75deg);\n  }\n\n  .title-word--kit {\n    top: 55.2%;\n    right: 8%;\n    color: var(--lime);\n    font-size: 32vw;\n    transform: rotate(-1.8deg);\n  }\n\n  .part-label {\n    position: absolute;\n    z-index: 5;\n    top: 47.6%;\n    left: 57%;\n    display: inline-flex;\n    align-items: center;\n    min-height: 27px;\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0 .62rem;\n    color: var(--aubergine);\n    background: var(--lime);\n    box-shadow: 5px 5px 0 var(--lilac);\n    font-size: .58rem;\n    font-weight: 700;\n    letter-spacing: .11em;\n    line-height: 1;\n    text-transform: uppercase;\n    transform: rotate(-3deg);\n    transform-origin: center center;\n  }\n\n  .part-label::before {\n    content: '';\n    display: inline-block;\n    width: 5px;\n    height: 5px;\n    margin-right: .5rem;\n    background: var(--aubergine);\n  }\n\n  .clearance-note {\n    position: absolute;\n    z-index: 4;\n    left: 8%;\n    bottom: 17.5%;\n    display: flex;\n    align-items: center;\n    gap: .48rem;\n    margin: 0;\n    color: var(--muted);\n    font-family: 'Space Mono', monospace;\n    font-size: .42rem;\n    letter-spacing: .08em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .clearance-note::before {\n    content: '';\n    display: block;\n    width: 29px;\n    height: 1px;\n    background: var(--lilac);\n  }\n\n  .clearance-note__ratio {\n    color: var(--lilac);\n    font-weight: 700;\n  }\n\n  .bottom-open-note {\n    position: absolute;\n    z-index: 4;\n    right: 8%;\n    bottom: 8%;\n    margin: 0;\n    color: var(--muted);\n    font-family: 'Space Mono', monospace;\n    font-size: .38rem;\n    letter-spacing: .08em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .bottom-open-note::before {\n    content: '';\n    display: inline-block;\n    width: 5px;\n    height: 5px;\n    margin-right: .42rem;\n    background: var(--lime);\n  }\n\n  @media (min-width: 641px) {\n    .title-card {\n      max-width: 375px;\n    }\n  }\n</style>\n\n<main aria-label=\"Web Starter Kit, Part 1 portrait title card\" class=\"title-card relative isolate w-full overflow-hidden\" data-title-card=\"portrait-neon\" id=\"portrait-title-card\">\n  <div aria-hidden=\"true\" class=\"title-card__frame\" data-name=\"precise portrait frame\">\n    <span class=\"title-card__frame-mark\"></span>\n  </div>\n\n  <p class=\"meta-line\" data-name=\"portrait meta line\">\n    <span class=\"meta-line__index\">001</span>\n    <span aria-hidden=\"true\" class=\"meta-line__rule\"></span>\n    <span class=\"meta-line__title\">Type collision</span>\n  </p>\n\n  <p aria-label=\"Neon / title edit\" class=\"edition\" data-name=\"portrait edition note\">\n    <span class=\"edition__accent\">Neon</span>\n    <span class=\"edition__rest\">/ title edit</span>\n  </p>\n\n  <span aria-hidden=\"true\" class=\"lime-rule\"></span>\n  <span aria-hidden=\"true\" class=\"lilac-rule\"></span>\n\n  <span aria-hidden=\"true\" class=\"orbit\" data-name=\"clipped upper right orbit\">\n    <span class=\"orbit__cut\"></span>\n  </span>\n\n  <div aria-hidden=\"true\" class=\"dot-grid js-dot-grid\" data-name=\"upper right dot grid\">\n    <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n    <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n    <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n    <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n    <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n    <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n  </div>\n\n  <span aria-hidden=\"true\" class=\"crosshair crosshair--left\" data-name=\"lower left crosshair\">\n    <span class=\"crosshair__index\">75%</span>\n  </span>\n\n  <h1 aria-label=\"Web Starter Kit\" class=\"title-lockup\" id=\"title-card-heading\" data-name=\"vertical title lockup\">\n    <span aria-hidden=\"true\" class=\"title-word title-word--web js-title-word\">Web</span>\n    <span aria-hidden=\"true\" class=\"title-word title-word--starter js-title-word\">Starter</span>\n    <span aria-hidden=\"true\" class=\"title-word title-word--kit js-title-word\">Kit</span>\n    <span aria-label=\"Part 1\" class=\"part-label js-part-label\">Part 1</span>\n  </h1>\n\n  <p class=\"clearance-note\" data-name=\"center safe zone note\">\n    <span class=\"clearance-note__ratio\">9:16</span>\n    <span>/ text enters frame</span>\n  </p>\n  <p class=\"bottom-open-note\">caption / control clearance</p>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script>\n  (() => {\n    const card = document.querySelector('[data-title-card=\"portrait-neon\"]');\n    if (!card || typeof gsap === 'undefined') return;\n\n    const dotGrid = card.querySelector('.js-dot-grid');\n    const titleWords = card.querySelectorAll('.js-title-word');\n    const partLabel = card.querySelector('.js-part-label');\n    const animatedElements = [dotGrid, ...titleWords, partLabel];\n    const motion = gsap.matchMedia();\n\n    motion.add('(prefers-reduced-motion: reduce)', () => {\n      gsap.set(animatedElements, { autoAlpha: 1 });\n    });\n\n    motion.add('(prefers-reduced-motion: no-preference)', () => {\n      const timeline = gsap.timeline();\n      timeline\n        .from(dotGrid, {\n          autoAlpha: 0,\n          scale: .55,\n          duration: .42,\n          ease: 'power2.out'\n        })\n        .from(titleWords, {\n          autoAlpha: 0,\n          x: (index) => index === 0 ? -42 : index === 1 ? 58 : 48,\n          rotation: (index) => index === 0 ? -6 : index === 1 ? 4 : -5,\n          duration: .58,\n          stagger: .075,\n          ease: 'power3.out'\n        }, '-=.1')\n        .from(partLabel, {\n          autoAlpha: 0,\n          y: -22,\n          scale: .38,\n          rotation: -10,\n          duration: .54,\n          ease: 'back.out(1.8)'\n        }, '-=.12');\n    });\n  })();\n</script>",
      "comments": [],
      "created": "2026-08-12T15:57:25.548377+00:00",
      "modified": "2026-08-12T15:57:25.548377+00:00",
