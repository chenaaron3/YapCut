    },
    "var_e2a3282b5ba5": {
      "type": "variant",
      "label": "Player Controls — Tactile Scan",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1736,
        "y": 0,
        "w": 768,
        "h": 1024
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"min-h-screen w-full bg-[#090b0f] font-[Inter,ui-sans-serif,system-ui,sans-serif] text-[#e8eaef]\" data-kid=\"1\" data-name=\"page wrapper\">\n    <main class=\"mx-auto flex w-full max-w-[768px] flex-col overflow-hidden bg-[#0b0c10] shadow-2xl shadow-black/30\" data-kid=\"1-1\" data-name=\"video player card\">\n        <section aria-label=\"Video preview\" class=\"relative aspect-[560/610] w-full overflow-hidden bg-black\" data-kid=\"1-1-1\" data-name=\"video preview section\">\n            <img alt=\"Talking-head video preview with a white caption reading Three Basic Japanese Greetings\" class=\"absolute inset-0 h-full w-full object-cover object-top\" data-kid=\"1-1-1-1\" data-name=\"video thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/player-reference.png\"/>\n            <div class=\"pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/10 to-transparent\" data-kid=\"1-1-1-2\" data-name=\"video overlay gradient\">\n            </div>\n        </section>\n        <section aria-label=\"Player controls\" class=\"relative border-t border-[#2e3444] bg-[#1a1d26]\" data-kid=\"1-1-2\" data-name=\"player controls section\">\n            <div class=\"relative h-[38px] border-b border-[#2e3444] px-5\" data-kid=\"1-1-2-1\" data-name=\"scrubber container\">\n                <div aria-label=\"Video progress\" aria-valuemax=\"39.2\" aria-valuemin=\"0\" aria-valuenow=\"1.9\" class=\"group absolute inset-x-5 top-0 flex h-full cursor-pointer items-center outline-none focus-visible:ring-2 focus-visible:ring-[#2dd4bf] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1\" data-name=\"video progress slider\" data-reason=\"aria-valuenow updated by script during playback/seek\" id=\"scrubber\" role=\"slider\" tabindex=\"0\">\n                    <div aria-hidden=\"true\" class=\"flex w-full items-center justify-between gap-[3px]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1\" data-name=\"scrubber marks container\" data-reason=\"children injected by script\" id=\"scrubber-marks\">\n                    </div>\n                    <div class=\"pointer-events-none absolute inset-y-0\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2\" data-name=\"scrubber handle\" data-reason=\"style left property updated by script during seek\" style=\"left: 5%;\">\n                        <div class=\"absolute -top-1 left-1/2 h-[30px] w-px -translate-x-1/2 bg-[#2dd4bf] shadow-[0_0_10px_rgba(45,212,191,0.65)]\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"scrubber handle line\">\n                        </div>\n                        <div class=\"absolute left-1/2 top-[3px] -translate-x-1/2 border-x-[4px] border-t-[5px] border-x-transparent border-t-[#2dd4bf]\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"scrubber handle indicator\">\n                        </div>\n                        <div class=\"absolute left-1/2 top-[-31px] -translate-x-1/2 whitespace-nowrap rounded-md border border-[#2e3444] bg-[#222632] px-2 py-1 font-mono text-[10px] font-medium tabular-nums text-[#e8eaef] shadow-lg shadow-black/25\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-3\" data-name=\"scrubber timestamp label\" data-reason=\"text updated by script during seek\">\n                            0:01.9\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex min-h-[82px] items-center justify-between gap-4 px-5 py-3\" data-kid=\"1-1-2-2\" data-name=\"transport and utility bar\">\n                <div aria-label=\"Transport\" class=\"flex min-w-0 flex-1 items-center gap-1\" data-kid=\"1-1-2-2-1\" data-name=\"transport buttons group\">\n                    <button aria-label=\"Skip back 1 second\" class=\"flex h-10 w-10 items-center justify-center rounded-lg text-[#8b93a7] outline-none transition-colors hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:ring-2 focus-visible:ring-[#2dd4bf]\" data-kid=\"1-1-2-2-1-1\" data-name=\"skip back button\" title=\"Skip back 1 second\" type=\"button\">\n                        <i class=\"h-[17px] w-[17px]\" data-kid=\"1-1-2-2-1-1-1\" data-lucide=\"skip-back\" data-name=\"skip back icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Play\" aria-pressed=\"false\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#2dd4bf] text-[#0b0c10] shadow-[0_0_0_4px_rgba(45,212,191,0.12)] outline-none transition-transform hover:scale-[1.04] focus-visible:ring-2 focus-visible:ring-[#e8eaef] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1d26] active:scale-95\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2\" data-name=\"play-pause button\" data-reason=\"icon visibility and aria state toggled by script\" id=\"play-button\" title=\"Play\" type=\"button\">\n                        <i class=\"ml-0.5 h-[18px] w-[18px] fill-current\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1\" data-lucide=\"play\" data-name=\"play icon\" data-reason=\"toggled by script\" id=\"play-icon\">\n                        </i>\n                        <i class=\"hidden h-[18px] w-[18px] fill-current\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-2\" data-lucide=\"pause\" data-name=\"pause icon\" data-reason=\"toggled by script\" id=\"pause-icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Skip forward 1 second\" class=\"flex h-10 w-10 items-center justify-center rounded-lg text-[#8b93a7] outline-none transition-colors hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:ring-2 focus-visible:ring-[#2dd4bf]\" data-kid=\"1-1-2-2-1-3\" data-name=\"skip forward button\" title=\"Skip forward 1 second\" type=\"button\">\n                        <i class=\"h-[17px] w-[17px]\" data-kid=\"1-1-2-2-1-3-1\" data-lucide=\"skip-forward\" data-name=\"skip forward icon\">\n                        </i>\n                    </button>\n                </div>\n                <div aria-label=\"Current time 0 minutes 1 point 9 seconds of 0 minutes 39 point 2 seconds\" class=\"flex shrink-0 items-baseline gap-2 whitespace-nowrap font-mono text-[13px] tabular-nums tracking-[-0.02em]\" data-kid=\"1-1-2-2-2\" data-name=\"time display area\">\n                    <span class=\"font-semibold text-[#e8eaef]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-2-1\" data-name=\"current time text\" data-reason=\"text updated by script during playback\" id=\"current-time\">\n                        0:01.9\n                    </span>\n                    <span class=\"text-[#8b93a7]\" data-kid=\"1-1-2-2-2-2\" data-name=\"time separator\">\n                        /\n                    </span>\n                    <span class=\"text-[#8b93a7]\" data-kid=\"1-1-2-2-2-3\" data-name=\"total duration text\">\n                        0:39.2\n                    </span>\n                </div>\n                <div aria-label=\"Player utilities\" class=\"flex min-w-0 flex-1 items-center justify-end gap-1\" data-kid=\"1-1-2-2-3\" data-name=\"player utilities group\">\n                    <button aria-label=\"Loop off\" aria-pressed=\"false\" class=\"flex h-10 w-10 items-center justify-center rounded-lg text-[#8b93a7] outline-none transition-colors hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:ring-2 focus-visible:ring-[#2dd4bf]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-1\" data-name=\"loop toggle button\" data-reason=\"color and aria state toggled by script\" id=\"loop-button\" title=\"Loop off\" type=\"button\">\n                        <i class=\"h-[17px] w-[17px]\" data-kid=\"1-1-2-2-3-1-1\" data-lucide=\"repeat-2\" data-name=\"loop icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Audio on\" aria-pressed=\"false\" class=\"flex h-10 w-10 items-center justify-center rounded-lg text-[#8b93a7] outline-none transition-colors hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:ring-2 focus-visible:ring-[#2dd4bf]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2\" data-name=\"audio toggle button\" data-reason=\"color and icon visibility and aria state toggled by script\" id=\"audio-button\" title=\"Mute audio\" type=\"button\">\n                        <i class=\"h-[17px] w-[17px]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-1\" data-lucide=\"volume-2\" data-name=\"audio on icon\" data-reason=\"toggled by script\" id=\"audio-on-icon\">\n                        </i>\n                        <i class=\"hidden h-[17px] w-[17px]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-2-2\" data-lucide=\"volume-x\" data-name=\"audio off icon\" data-reason=\"toggled by script\" id=\"audio-off-icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Fit preview\" class=\"flex h-10 w-10 items-center justify-center rounded-lg text-[#8b93a7] outline-none transition-colors hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:ring-2 focus-visible:ring-[#2dd4bf]\" data-kid=\"1-1-2-2-3-3\" data-name=\"fit preview button\" title=\"Fit preview\" type=\"button\">\n                        <i class=\"h-[17px] w-[17px]\" data-kid=\"1-1-2-2-3-3-1\" data-lucide=\"scan\" data-name=\"fit preview icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"More player options\" class=\"flex h-10 w-10 items-center justify-center rounded-lg text-[#8b93a7] outline-none transition-colors hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:ring-2 focus-visible:ring-[#2dd4bf]\" data-kid=\"1-1-2-2-3-4\" data-name=\"more options button\" title=\"More player options\" type=\"button\">\n                        <i class=\"h-[17px] w-[17px]\" data-kid=\"1-1-2-2-3-4-1\" data-lucide=\"more-horizontal\" data-name=\"more options icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n<script>\n    lucide.createIcons();\n\n  const marks = document.getElementById('scrubber-marks');\n  const scrubber = document.getElementById('scrubber');\n  const playButton = document.getElementById('play-button');\n  const playIcon = document.getElementById('play-icon');\n  const pauseIcon = document.getElementById('pause-icon');\n  const loopButton = document.getElementById('loop-button');\n  const audioButton = document.getElementById('audio-button');\n  const audioOnIcon = document.getElementById('audio-on-icon');\n  const audioOffIcon = document.getElementById('audio-off-icon');\n  const currentTime = document.getElementById('current-time');\n  const totalMarks = 64;\n  let progress = 0.05;\n  let playing = false;\n  let loop = false;\n  let muted = false;\n\n  for (let index = 0; index < totalMarks; index += 1) {\n    const mark = document.createElement('span');\n    mark.className = 'h-[7px] min-w-0 flex-1 rounded-[2px] bg-[#2e3444] transition-colors group-hover:bg-[#3b4356]';\n    mark.dataset.index = String(index);\n    marks.appendChild(mark);\n  }\n\n  function renderProgress(next) {\n    progress = Math.max(0, Math.min(1, next));\n    const activeCount = Math.max(1, Math.round(progress * totalMarks));\n    [...marks.children].forEach((mark, index) => {\n      mark.classList.toggle('bg-[#2dd4bf]', index < activeCount);\n      mark.classList.toggle('bg-[#2e3444]', index >= activeCount);\n    });\n    scrubber.setAttribute('aria-valuenow', String((progress * 39.2).toFixed(1)));\n    currentTime.textContent = progress <= 0.05 ? '0:01.9' : '0:02.0';\n  }\n\n  function seekFromPointer(event) {\n    const rect = scrubber.getBoundingClientRect();\n    renderProgress((event.clientX - rect.left) / rect.width);\n  }\n\n  scrubber.addEventListener('pointerdown', (event) => {\n    seekFromPointer(event);\n    scrubber.setPointerCapture(event.pointerId);\n  });\n  scrubber.addEventListener('pointermove', (event) => {\n    if (event.buttons === 1) seekFromPointer(event);\n  });\n  scrubber.addEventListener('keydown', (event) => {\n    if (event.key === 'ArrowRight') renderProgress(progress + 0.01);\n    if (event.key === 'ArrowLeft') renderProgress(progress - 0.01);\n  });\n\n  playButton.addEventListener('click', () => {\n    playing = !playing;\n    playIcon.classList.toggle('hidden', playing);\n    pauseIcon.classList.toggle('hidden', !playing);\n    playButton.setAttribute('aria-label', playing ? 'Pause' : 'Play');\n    playButton.setAttribute('title', playing ? 'Pause' : 'Play');\n    playButton.setAttribute('aria-pressed', String(playing));\n  });\n\n  loopButton.addEventListener('click', () => {\n    loop = !loop;\n    loopButton.classList.toggle('text-[#2dd4bf]', loop);\n    loopButton.setAttribute('aria-label', loop ? 'Loop on' : 'Loop off');\n    loopButton.setAttribute('title', loop ? 'Loop on' : 'Loop off');\n    loopButton.setAttribute('aria-pressed', String(loop));\n  });\n\n  audioButton.addEventListener('click', () => {\n    muted = !muted;\n    audioOnIcon.classList.toggle('hidden', muted);\n    audioOffIcon.classList.toggle('hidden', !muted);\n    audioButton.classList.toggle('text-[#2dd4bf]', muted);\n    audioButton.setAttribute('aria-label', muted ? 'Audio muted' : 'Audio on');\n    audioButton.setAttribute('title', muted ? 'Unmute audio' : 'Mute audio');\n    audioButton.setAttribute('aria-pressed', String(muted));\n  });\n\n  renderProgress(progress);\n</script>\n",
      "comments": [],
      "created": "2026-08-13T16:36:47.642335+00:00",
      "modified": "2026-08-13T16:37:09.117009+00:00",
      "id": "var_e2a3282b5ba5"
    }
  },
