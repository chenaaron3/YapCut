      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');\n  .player-shell { font-family: 'Inter', 'IBM Plex Sans', sans-serif; }\n  .timecode { font-variant-numeric: tabular-nums; }\n  .control-button { transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease; }\n  .control-button:active { transform: scale(0.96); }\n  .scrub-track { transition: height 160ms ease, top 160ms ease; }\n  .scrub-track:hover { height: 7px; top: -2px; }\n  .scrub-track:hover .scrub-knob { opacity: 1; transform: translateY(-50%) scale(1); }\n</style>\n<section aria-label=\"Video preview player\" class=\"player-shell flex w-full flex-col overflow-hidden bg-[#0b0c10] text-[#e8eaef]\" data-kid=\"1\">\n    <div class=\"relative w-full overflow-hidden bg-black\" data-kid=\"1-1\" style=\"height: 838px;\">\n        <img alt=\"Talking-head video preview with white caption pills reading Three Basic Japanese Greetings\" class=\"absolute left-0 top-0 block w-full max-w-none\" data-kid=\"1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/player-reference.png\"/>\n        <div class=\"pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/15 to-transparent\" data-kid=\"1-1-2\">\n        </div>\n        <div class=\"absolute left-4 top-4 flex items-center gap-2 rounded-md border border-white/12 bg-[#12141a]/72 px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/70 shadow-sm backdrop-blur-sm\" data-kid=\"1-1-3\">\n            <span class=\"h-1.5 w-1.5 rounded-full bg-[#5b8cff] shadow-[0_0_0_3px_rgba(91,140,255,0.14)]\" data-kid=\"1-1-3-1\">\n            </span>\n            Preview\n        </div>\n        <div class=\"absolute bottom-4 right-4 rounded-md border border-white/12 bg-[#12141a]/72 px-2.5 py-1.5 font-mono text-[10px] tabular-nums text-white/65 shadow-sm backdrop-blur-sm\" data-kid=\"1-1-4\">\n            9:16\n        </div>\n    </div>\n    <div class=\"relative border-t border-[#2e3444] bg-[#1a1d26] px-4 pb-3 pt-3 shadow-[0_-12px_28px_rgba(0,0,0,0.16)]\" data-kid=\"1-2\">\n        <div aria-label=\"Playback progress\" class=\"absolute inset-x-0 top-0 h-1 bg-[#222632]\" data-kid=\"1-2-1\">\n            <div class=\"absolute left-0 top-0 h-full w-[5%] bg-[#5b8cff]\" data-dynamic=\"true\" data-kid=\"1-2-1-1\" data-name=\"video progress bar indicator\" data-reason=\"width updated by scrubbing interaction\">\n            </div>\n            <div class=\"absolute left-[5%] top-1/2 h-3.5 w-px -translate-y-1/2 bg-[#e8eaef] shadow-[0_0_0_2px_rgba(91,140,255,0.28)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"playback scrub head handle\" data-reason=\"left position updated by scrubbing interaction\">\n                <div class=\"absolute -left-[3px] -top-1 h-1.5 w-1.5 rotate-45 bg-[#e8eaef]\" data-kid=\"1-2-1-2-1\">\n                </div>\n                <div class=\"scrub-knob absolute -left-[5px] top-1/2 h-2.5 w-2.5 -translate-y-1/2 scale-75 rounded-full border-2 border-[#e8eaef] bg-[#5b8cff] opacity-70 shadow-[0_0_0_3px_rgba(91,140,255,0.18)] transition duration-160\" data-kid=\"1-2-1-2-2\">\n                </div>\n            </div>\n            <button aria-label=\"Seek through video\" class=\"absolute inset-x-0 -top-3 h-7 w-full cursor-ew-resize opacity-0\" data-kid=\"1-2-1-3\" title=\"Seek through video\">\n            </button>\n        </div>\n        <div class=\"flex min-h-[76px] items-center gap-3 pt-1\" data-kid=\"1-2-2\">\n            <div class=\"flex shrink-0 items-center gap-0.5 rounded-xl border border-[#2e3444] bg-[#222632]/70 p-1\" data-kid=\"1-2-2-1\">\n                <button aria-label=\"Skip back one second\" class=\"control-button flex h-11 w-11 items-center justify-center rounded-lg text-[#8b93a7] hover:bg-[#2e3444] hover:text-[#e8eaef] focus-visible:outline-2 focus-visible:outline-[#5b8cff] focus-visible:outline-offset-2\" data-kid=\"1-2-2-1-1\" title=\"Skip back 1 second\" type=\"button\">\n                    <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-1-1-1\" data-lucide=\"rotate-ccw\">\n                    </i>\n                </button>\n                <button aria-label=\"Play\" class=\"control-button flex h-11 w-11 items-center justify-center rounded-lg bg-[#5b8cff] text-[#0b0c10] shadow-[0_3px_10px_rgba(91,140,255,0.25)] hover:bg-[#78a1ff] focus-visible:outline-2 focus-visible:outline-[#e8eaef] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"play/pause control button\" data-reason=\"icon and accessibility labels replaced by script on click\" id=\"play-toggle\" title=\"Play (Space)\" type=\"button\">\n                    <i class=\"h-[18px] w-[18px]\" data-kid=\"1-2-2-1-2-1\" data-lucide=\"play\" fill=\"currentColor\">\n                    </i>\n                </button>\n                <button aria-label=\"Skip forward one second\" class=\"control-button flex h-11 w-11 items-center justify-center rounded-lg text-[#8b93a7] hover:bg-[#2e3444] hover:text-[#e8eaef] focus-visible:outline-2 focus-visible:outline-[#5b8cff] focus-visible:outline-offset-2\" data-kid=\"1-2-2-1-3\" title=\"Skip forward 1 second\" type=\"button\">\n                    <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-1-3-1\" data-lucide=\"rotate-cw\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"h-9 w-px shrink-0 bg-[#2e3444]\" data-kid=\"1-2-2-2\">\n            </div>\n            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-3\">\n                <div class=\"flex items-baseline gap-2 whitespace-nowrap font-mono text-[17px] font-medium leading-none timecode\" data-kid=\"1-2-2-3-1\">\n                    <span class=\"text-[#e8eaef]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-1\" data-name=\"current time display\" data-reason=\"text content replaced by scrubbing interaction\" id=\"current-time\">\n                        0:01.9\n                    </span>\n                    <span class=\"text-[#8b93a7]/65\" data-kid=\"1-2-2-3-1-2\">\n                        /\n                    </span>\n                    <span class=\"text-[14px] text-[#8b93a7]\" data-kid=\"1-2-2-3-1-3\">\n                        0:39.2\n                    </span>\n                </div>\n                <div class=\"mt-2 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#8b93a7]\" data-kid=\"1-2-2-3-2\">\n                    <span class=\"rounded bg-[#222632] px-1.5 py-0.5 text-[#e8eaef]/80\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-1\" data-name=\"playback state status text\" data-reason=\"text content replaced by script on play/pause\" id=\"play-state\">\n                        Paused\n                    </span>\n                    <span class=\"text-[#2e3444]\" data-kid=\"1-2-2-3-2-2\">\n                        •\n                    </span>\n                    <span data-kid=\"1-2-2-3-2-3\">\n                        24 fps\n                    </span>\n                    <span class=\"text-[#2e3444]\" data-kid=\"1-2-2-3-2-4\">\n                        •\n                    </span>\n                    <span data-kid=\"1-2-2-3-2-5\">\n                        Space to play\n                    </span>\n                </div>\n            </div>\n            <div class=\"h-9 w-px shrink-0 bg-[#2e3444]\" data-kid=\"1-2-2-4\">\n            </div>\n            <div class=\"flex shrink-0 items-center gap-0.5\" data-kid=\"1-2-2-5\">\n                <button aria-label=\"Loop playback off\" aria-pressed=\"false\" class=\"control-button flex h-11 w-11 items-center justify-center rounded-lg text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:outline-2 focus-visible:outline-[#5b8cff] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-2-2-5-1\" data-name=\"loop playback toggle button\" data-reason=\"aria state and classes toggled by script\" id=\"loop-toggle\" title=\"Loop playback\" type=\"button\">\n                    <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-5-1-1\" data-lucide=\"repeat\">\n                    </i>\n                </button>\n                <button aria-label=\"Mute audio\" aria-pressed=\"false\" class=\"control-button flex h-11 w-11 items-center justify-center rounded-lg text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:outline-2 focus-visible:outline-[#5b8cff] focus-visible:outline-offset-2\" data-dynamic=\"true\" data-kid=\"1-2-2-5-2\" data-name=\"mute audio toggle button\" data-reason=\"icon and accessibility attributes replaced by script\" id=\"mute-toggle\" title=\"Mute audio\" type=\"button\">\n                    <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-5-2-1\" data-lucide=\"volume-2\">\n                    </i>\n                </button>\n                <button aria-label=\"Fit preview to panel\" class=\"control-button flex h-11 w-11 items-center justify-center rounded-lg text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:outline-2 focus-visible:outline-[#5b8cff] focus-visible:outline-offset-2\" data-kid=\"1-2-2-5-3\" title=\"Fit preview to panel\" type=\"button\">\n                    <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-5-3-1\" data-lucide=\"maximize-2\">\n                    </i>\n                </button>\n                <button aria-label=\"More player options\" class=\"control-button flex h-11 w-11 items-center justify-center rounded-lg text-[#8b93a7] hover:bg-[#222632] hover:text-[#e8eaef] focus-visible:outline-2 focus-visible:outline-[#5b8cff] focus-visible:outline-offset-2\" data-kid=\"1-2-2-5-4\" title=\"More player options\" type=\"button\">\n                    <i class=\"h-[17px] w-[17px]\" data-kid=\"1-2-2-5-4-1\" data-lucide=\"more-horizontal\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </div>\n</section>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    const currentTime = document.getElementById('current-time');\n  const playToggle = document.getElementById('play-toggle');\n  const playState = document.getElementById('play-state');\n  const loopToggle = document.getElementById('loop-toggle');\n  const muteToggle = document.getElementById('mute-toggle');\n  let playing = false;\n  let looping = false;\n  let muted = false;\n  let time = 1.9;\n\n  function refreshIcons() {\n    if (window.lucide) window.lucide.createIcons({ attrs: { 'stroke-width': 2 } });\n  }\n\n  function setPlayState(next) {\n    playing = next;\n    playToggle.setAttribute('aria-label', playing ? 'Pause' : 'Play');\n    playToggle.setAttribute('title', playing ? 'Pause (Space)' : 'Play (Space)');\n    playToggle.innerHTML = '<i data-lucide=\"' + (playing ? 'pause' : 'play') + '\" class=\"h-[18px] w-[18px]\" fill=\"currentColor\"></i>';\n    playState.textContent = playing ? 'Playing' : 'Paused';\n    refreshIcons();\n  }\n\n  playToggle.addEventListener('click', () => setPlayState(!playing));\n  loopToggle.addEventListener('click', () => {\n    looping = !looping;\n    loopToggle.setAttribute('aria-pressed', String(looping));\n    loopToggle.setAttribute('aria-label', looping ? 'Loop playback on' : 'Loop playback off');\n    loopToggle.classList.toggle('bg-[#5b8cff]/15', looping);\n    loopToggle.classList.toggle('text-[#5b8cff]', looping);\n  });\n  muteToggle.addEventListener('click', () => {\n    muted = !muted;\n    muteToggle.setAttribute('aria-pressed', String(muted));\n    muteToggle.setAttribute('aria-label', muted ? 'Unmute audio' : 'Mute audio');\n    muteToggle.setAttribute('title', muted ? 'Unmute audio' : 'Mute audio');\n    muteToggle.innerHTML = '<i data-lucide=\"' + (muted ? 'volume-x' : 'volume-2') + '\" class=\"h-[17px] w-[17px]\"></i>';\n    muteToggle.classList.toggle('text-[#5b8cff]', muted);\n    refreshIcons();\n  });\n\n  document.querySelector('[aria-label=\"Seek through video\"]').addEventListener('click', (event) => {\n    const rect = event.currentTarget.getBoundingClientRect();\n    const pct = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));\n    time = pct * 39.2;\n    const minutes = Math.floor(time / 60);\n    const seconds = (time % 60).toFixed(1).padStart(4, '0');\n    currentTime.textContent = minutes + ':' + seconds;\n  });\n\n  document.addEventListener('keydown', (event) => {\n    if (event.code === 'Space' && event.target === document.body) {\n      event.preventDefault();\n      setPlayState(!playing);\n    }\n  });\n\n  refreshIcons();\n</script>\n",
