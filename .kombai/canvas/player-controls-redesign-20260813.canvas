      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Inter:wght@500;600;700&display=swap');\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"min-h-screen w-full bg-[#12141a] p-5 text-[#e8eaef]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: 'IBM Plex Sans', sans-serif;\">\n    <section aria-label=\"Video preview player\" class=\"mx-auto flex w-full max-w-[720px] flex-col overflow-hidden rounded-[16px] border border-[#2e3444] bg-[#0b0c10] shadow-[0_24px_70px_rgba(0,0,0,0.42)]\" data-kid=\"1-1\" data-name=\"video preview player section\">\n        <div class=\"relative flex h-[700px] items-start justify-center overflow-hidden bg-[#0b0c10]\" data-kid=\"1-1-1\" data-name=\"video viewport container\">\n            <div class=\"relative h-[610px] w-[560px] max-w-full overflow-hidden bg-black shadow-[0_10px_30px_rgba(0,0,0,0.3)]\" data-kid=\"1-1-1-1\" data-name=\"video image container\">\n                <img alt=\"Vertical talking-head video preview with a white caption reading Three Basic Japanese Greetings\" class=\"block h-auto w-full max-w-none\" data-kid=\"1-1-1-1-1\" data-name=\"talking-head video preview image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/player-reference.png\"/>\n            </div>\n            <div class=\"pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#0b0c10] via-[#0b0c10]/80 to-transparent\" data-kid=\"1-1-1-2\" data-name=\"bottom gradient overlay\">\n            </div>\n        </div>\n        <div aria-label=\"Playback controls\" class=\"relative border-t border-[#2e3444] bg-[#1a1d26] px-4 pb-4 pt-2.5\" data-kid=\"1-1-2\" data-name=\"playback controls container\">\n            <div aria-label=\"Video progress\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"5\" class=\"relative h-3\" data-kid=\"1-1-2-1\" data-name=\"video progress bar slider\" role=\"slider\" tabindex=\"0\">\n                <div class=\"absolute inset-x-0 top-[5px] h-[3px] rounded-full bg-[#2e3444]\" data-kid=\"1-1-2-1-1\" data-name=\"inactive track background\">\n                </div>\n                <div class=\"absolute left-0 top-[5px] h-[3px] w-[5%] rounded-full bg-[#5b8cff]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"active progress fill bar\" data-reason=\"width updated dynamically by playback progress\">\n                </div>\n                <div class=\"absolute left-[5%] top-[2px] h-[9px] w-[2px] -translate-x-1/2 rounded-full bg-[#5b8cff] shadow-[0_0_0_3px_rgba(91,140,255,0.16)]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-3\" data-name=\"progress slider handle\" data-reason=\"position updated dynamically by playback progress\">\n                </div>\n                <div aria-hidden=\"true\" class=\"absolute inset-x-0 top-[4px] flex justify-between px-px opacity-60\" data-kid=\"1-1-2-1-4\" data-name=\"progress tick marks container\">\n                    <span class=\"h-[5px] w-px bg-[#8b93a7]\" data-kid=\"1-1-2-1-4-1\" data-name=\"progress tick mark 1\">\n                    </span>\n                    <span class=\"h-[5px] w-px bg-[#8b93a7]\" data-kid=\"1-1-2-1-4-2\" data-name=\"progress tick mark 2\">\n                    </span>\n                    <span class=\"h-[5px] w-px bg-[#8b93a7]\" data-kid=\"1-1-2-1-4-3\" data-name=\"progress tick mark 3\">\n                    </span>\n                    <span class=\"h-[5px] w-px bg-[#8b93a7]\" data-kid=\"1-1-2-1-4-4\" data-name=\"progress tick mark 4\">\n                    </span>\n                    <span class=\"h-[5px] w-px bg-[#8b93a7]\" data-kid=\"1-1-2-1-4-5\" data-name=\"progress tick mark 5\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 rounded-[14px] border border-[#2e3444] bg-[#222632]/90 px-2.5 py-2 shadow-[inset_0_1px_0_rgba(255,255,255,0.03),0_10px_22px_rgba(0,0,0,0.16)]\" data-kid=\"1-1-2-2\" data-name=\"player control tools wrapper\">\n                <div aria-label=\"Transport controls\" class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2-2-1\" data-name=\"transport buttons group\">\n                    <button aria-label=\"Skip back 1 second\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] text-[#8b93a7] outline-none ring-[#5b8cff] hover:bg-[#2e3444]/70 hover:text-[#e8eaef] focus-visible:ring-2\" data-kid=\"1-1-2-2-1-1\" data-name=\"skip back button\" title=\"Skip back 1 second\" type=\"button\">\n                        <i class=\"h-[16px] w-[16px]\" data-kid=\"1-1-2-2-1-1-1\" data-lucide=\"rotate-ccw\" data-name=\"rotate counter-clockwise icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Play\" class=\"flex h-10 w-10 items-center justify-center rounded-[12px] bg-[#5b8cff] text-[#0b0c10] shadow-[0_5px_16px_rgba(91,140,255,0.28)] outline-none ring-[#e8eaef] hover:bg-[#79a1ff] focus-visible:ring-2\" data-kid=\"1-1-2-2-1-2\" data-name=\"play/pause button\" title=\"Play\" type=\"button\">\n                        <i class=\"h-[17px] w-[17px] fill-current\" data-kid=\"1-1-2-2-1-2-1\" data-lucide=\"play\" data-name=\"play icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Skip forward 1 second\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] text-[#8b93a7] outline-none ring-[#5b8cff] hover:bg-[#2e3444]/70 hover:text-[#e8eaef] focus-visible:ring-2\" data-kid=\"1-1-2-2-1-3\" data-name=\"skip forward button\" title=\"Skip forward 1 second\" type=\"button\">\n                        <i class=\"h-[16px] w-[16px]\" data-kid=\"1-1-2-2-1-3-1\" data-lucide=\"rotate-cw\" data-name=\"rotate clockwise icon\">\n                        </i>\n                    </button>\n                </div>\n                <div aria-hidden=\"true\" class=\"h-7 w-px shrink-0 bg-[#2e3444]\" data-kid=\"1-1-2-2-2\" data-name=\"vertical divider\">\n                </div>\n                <div class=\"flex min-w-0 flex-1 items-baseline gap-2 whitespace-nowrap\" data-kid=\"1-1-2-2-3\" data-name=\"playback time display group\" style=\"font-family: 'Inter', sans-serif; font-variant-numeric: tabular-nums;\">\n                    <span class=\"text-[14px] font-semibold tracking-[-0.01em] text-[#e8eaef]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-1\" data-name=\"current playback time text\" data-reason=\"text updated dynamically by playback progress\">\n                        0:01.9\n                    </span>\n                    <span class=\"text-[12px] text-[#8b93a7]\" data-kid=\"1-1-2-2-3-2\" data-name=\"total video duration text\">\n                        / 0:39.2\n                    </span>\n                    <span class=\"hidden rounded-full border border-[#2e3444] px-2 py-0.5 text-[9px] font-semibold uppercase tracking-[0.16em] text-[#8b93a7] sm:inline-flex\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-3\" data-name=\"playback status label\" data-reason=\"text toggled between playing and paused by playback state\">\n                        Paused\n                    </span>\n                </div>\n                <div aria-label=\"View and audio controls\" class=\"flex shrink-0 items-center gap-0.5\" data-kid=\"1-1-2-2-4\" data-name=\"view and audio controls group\">\n                    <button aria-label=\"Mute audio\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] text-[#8b93a7] outline-none ring-[#5b8cff] hover:bg-[#2e3444]/70 hover:text-[#e8eaef] focus-visible:ring-2\" data-kid=\"1-1-2-2-4-1\" data-name=\"mute audio button\" title=\"Mute audio\" type=\"button\">\n                        <i class=\"h-[16px] w-[16px]\" data-kid=\"1-1-2-2-4-1-1\" data-lucide=\"volume-2\" data-name=\"volume icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Loop playback off\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] text-[#8b93a7] outline-none ring-[#5b8cff] hover:bg-[#2e3444]/70 hover:text-[#e8eaef] focus-visible:ring-2\" data-kid=\"1-1-2-2-4-2\" data-name=\"loop playback button\" title=\"Loop playback off\" type=\"button\">\n                        <i class=\"h-[16px] w-[16px]\" data-kid=\"1-1-2-2-4-2-1\" data-lucide=\"repeat\" data-name=\"repeat icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Fit preview\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] text-[#8b93a7] outline-none ring-[#5b8cff] hover:bg-[#2e3444]/70 hover:text-[#e8eaef] focus-visible:ring-2\" data-kid=\"1-1-2-2-4-3\" data-name=\"fit preview button\" title=\"Fit preview\" type=\"button\">\n                        <i class=\"h-[16px] w-[16px]\" data-kid=\"1-1-2-2-4-3-1\" data-lucide=\"scan\" data-name=\"scan icon\">\n                        </i>\n                    </button>\n                    <button aria-label=\"More player options\" class=\"flex h-9 w-9 items-center justify-center rounded-[10px] text-[#8b93a7] outline-none ring-[#5b8cff] hover:bg-[#2e3444]/70 hover:text-[#e8eaef] focus-visible:ring-2\" data-kid=\"1-1-2-2-4-4\" data-name=\"more options button\" title=\"More player options\" type=\"button\">\n                        <i class=\"h-[16px] w-[16px]\" data-kid=\"1-1-2-2-4-4-1\" data-lucide=\"more-horizontal\" data-name=\"more horizontal icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-2 flex items-center justify-between px-1 text-[10px] font-medium uppercase tracking-[0.14em] text-[#8b93a7]\" data-kid=\"1-1-2-3\" data-name=\"video metadata info bar\">\n                <span data-kid=\"1-1-2-3-1\" data-name=\"preview label text\">\n                    Preview\n                </span>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"format and framerate text\">\n                    9:16 · 24 fps\n                </span>\n            </div>\n        </div>\n    </section>\n</div>\n<script>\n    lucide.createIcons({ attrs: { 'stroke-width': 1.8 } });\n</script>\n",
      "comments": [],
      "created": "2026-08-13T16:36:45.980765+00:00",
