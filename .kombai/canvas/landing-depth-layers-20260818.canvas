    "var_bef56b3e56c2": {
      "type": "variant",
      "label": "Landing depth — Quiet Orbit",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n\n  .quiet-orbit {\n    --cream: #f5f9ce;\n    --ink: #450e16;\n    --purple: #432e6f;\n    --orange: #ffa102;\n    --tomato: #dd5533;\n    --crimson: #bc2d29;\n    --teal: #2dd4bf;\n    --muted: rgba(69, 14, 22, 0.5);\n    background: var(--cream);\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .quiet-display {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-weight: 700;\n    letter-spacing: -0.065em;\n  }\n\n  .quiet-mono {\n    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  .quiet-grain {\n    background-image: radial-gradient(rgba(245, 249, 206, 0.16) 0.65px, transparent 0.65px);\n    background-size: 8px 8px;\n  }\n\n  .quiet-plane-back,\n  .quiet-plane-front,\n  .quiet-seam-ornament,\n  .quiet-spotlight {\n    will-change: transform;\n  }\n\n  .quiet-plane-back {\n    transform: translate3d(0, var(--back-y, 0px), 0) rotate(-19deg);\n  }\n\n  .quiet-plane-front {\n    transform: translate3d(0, var(--front-y, 0px), 0) rotate(30deg);\n  }\n\n  .quiet-preview {\n    transform: perspective(1100px) rotateX(var(--tilt-y, 0deg)) rotateY(var(--tilt-x, 0deg));\n    transform-style: preserve-3d;\n    will-change: transform;\n  }\n\n  .quiet-phone-backplate {\n    transform: translate3d(15px, 14px, -40px) rotate(3deg);\n  }\n\n  .quiet-line-shimmer {\n    background-image: linear-gradient(90deg, transparent 0%, rgba(255,161,2,.1) 46%, rgba(245,249,206,.2) 50%, rgba(255,161,2,.1) 54%, transparent 100%);\n    background-size: 220% 100%;\n    animation: quiet-line-shimmer 16s ease-in-out infinite;\n  }\n\n  @keyframes quiet-line-shimmer {\n    0%, 8% { background-position: 140% 0; }\n    18% { background-position: -40% 0; }\n    18.01%, 100% { background-position: 140% 0; }\n  }\n\n  .quiet-float {\n    animation: quiet-float 8s ease-in-out infinite alternate;\n  }\n\n  @keyframes quiet-float {\n    from { transform: translate3d(0, 0, 0) rotate(-1deg); }\n    to { transform: translate3d(0, -8px, 0) rotate(1deg); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .quiet-line-shimmer,\n    .quiet-float { animation: none; }\n  }\n</style>\n<div class=\"quiet-orbit relative min-h-[100dvh] overflow-x-clip selection:bg-[#FFA102] selection:text-[#450E16]\" data-kid=\"1\" data-name=\"main page container\" data-quiet-orbit=\"\">\n    <div aria-hidden=\"\" class=\"quiet-grain pointer-events-none fixed inset-0 z-[3] opacity-30\" data-kid=\"1-1\" data-name=\"grain texture overlay\">\n    </div>\n    <main class=\"relative z-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section class=\"relative min-h-[100dvh] overflow-hidden bg-[#450E16] text-[#F5F9CE]\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"quiet-hero\">\n            <div aria-hidden=\"\" class=\"quiet-plane-back pointer-events-none absolute -top-56 left-[31%] z-0 h-[820px] w-[420px] bg-[linear-gradient(124deg,rgba(255,161,2,.5)_0%,rgba(221,85,51,.26)_44%,rgba(67,46,111,.45)_100%)] opacity-25 [clip-path:polygon(21%_0,100%_0,77%_100%,0_100%)]\" data-dynamic=\"true\" data-kid=\"1-2-1-1\" data-name=\"decorative back plane\" data-reason=\"position reinitialized by scroll progress\">\n            </div>\n            <div aria-hidden=\"\" class=\"quiet-plane-front pointer-events-none absolute top-[16%] right-[-160px] z-0 h-[560px] w-[360px] bg-[linear-gradient(124deg,rgba(255,161,2,.32)_0%,rgba(67,46,111,.52)_100%)] opacity-25 [clip-path:polygon(25%_0,100%_18%,78%_100%,0_76%)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"decorative front plane\" data-reason=\"position reinitialized by scroll progress\">\n            </div>\n            <div aria-hidden=\"\" class=\"pointer-events-none absolute top-[-100px] left-[47%] z-0 h-[620px] w-14 rotate-[-42deg] bg-[linear-gradient(124deg,rgba(255,161,2,.92)_0%,rgba(221,85,51,.7)_42%,rgba(67,46,111,.92)_100%)] opacity-20\" data-kid=\"1-2-1-3\" data-name=\"decorative diagonal beam\">\n            </div>\n            <div aria-hidden=\"\" class=\"quiet-spotlight pointer-events-none absolute top-[56%] left-[54%] z-[1] h-[460px] w-[460px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(255,161,2,.14)_0%,rgba(255,161,2,.06)_34%,transparent_68%)] opacity-80\" data-dynamic=\"true\" data-kid=\"1-2-1-4\" data-name=\"spotlight circle\" data-reason=\"position reinitialized by mouse tracking\" id=\"quiet-spotlight\">\n            </div>\n            <header class=\"absolute inset-x-0 top-0 z-40 border-b border-[#F5F9CE]/20 bg-[#BC2D29]/90 text-[#F5F9CE] backdrop-blur-[2px]\" data-kid=\"1-2-1-5\" data-name=\"site header\">\n                <nav class=\"mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-14 py-5\" data-kid=\"1-2-1-5-1\" data-name=\"site navigation\">\n                    <a aria-label=\"YapCut home\" class=\"flex items-center gap-2.5 no-underline text-[#F5F9CE]\" data-kid=\"1-2-1-5-1-1\" data-name=\"logo and brand name\" href=\"#product\">\n                        <span class=\"grid size-8 place-items-center rounded-[9px] border-2 border-[#450E16] bg-[#FFA102] text-sm font-bold text-[#450E16] shadow-[2px_2px_0_#450E16]\" data-kid=\"1-2-1-5-1-1-1\" data-name=\"logo letter Y\">\n                            Y\n                        </span>\n                        <span class=\"text-xl font-bold tracking-[-.04em]\" data-kid=\"1-2-1-5-1-1-2\" data-name=\"brand name text\">\n                            YapCut\n                        </span>\n                    </a>\n                    <div class=\"flex items-center gap-2 text-sm font-semibold\" data-kid=\"1-2-1-5-1-2\" data-name=\"navigation menu links\">\n                        <a class=\"hidden rounded-[8px] px-4 py-2 text-[#F5F9CE]/75 no-underline hover:text-[#F5F9CE] md:inline-flex\" data-kid=\"1-2-1-5-1-2-1\" data-name=\"product navigation link\" href=\"#features\">\n                            Product\n                        </a>\n                        <a class=\"hidden rounded-[8px] px-4 py-2 text-[#F5F9CE]/75 no-underline hover:text-[#F5F9CE] md:inline-flex\" data-kid=\"1-2-1-5-1-2-2\" data-name=\"how it works navigation link\" href=\"#how-it-works\">\n                            How it works\n                        </a>\n                        <button class=\"quiet-mono rounded-[10px] border-2 border-[#450E16] bg-[#FFA102] px-4 py-2 text-[10px] font-bold tracking-[.13em] text-[#450E16] uppercase shadow-[3px_3px_0_#450E16]\" data-kid=\"1-2-1-5-1-2-3\" data-name=\"sign in button\" type=\"button\">\n                            Sign in\n                        </button>\n                    </div>\n                </nav>\n            </header>\n            <div class=\"relative z-10 mx-auto grid min-h-[100dvh] max-w-[1280px] grid-cols-[minmax(0,1fr)_460px] items-center gap-16 px-14 pt-28 pb-14\" data-kid=\"1-2-1-6\" data-name=\"hero content layout\" id=\"product\">\n                <div class=\"max-w-[650px]\" data-kid=\"1-2-1-6-1\" data-name=\"hero text content\">\n                    <div class=\"quiet-mono inline-flex items-center gap-2 rounded-[9px] border border-[#FFA102] px-3 py-2 text-[10px] font-semibold tracking-[.18em] text-[#FFA102] uppercase\" data-kid=\"1-2-1-6-1-1\" data-name=\"AI powered badge\">\n                        <span class=\"size-1.5 rounded-full bg-[#FFA102]\" data-kid=\"1-2-1-6-1-1-1\" data-name=\"badge indicator dot\">\n                        </span>\n                        AI-Powered\n                    </div>\n                    <h1 class=\"quiet-display m-0 mt-7 max-w-[720px] text-[clamp(5rem,8vw,7.5rem)] leading-[.78]\" data-kid=\"1-2-1-6-1-2\" data-name=\"hero headline\">\n                        Edit talking\n                        <br data-kid=\"1-2-1-6-1-2-1\" data-name=\"headline line break 1\"/>\n                        head shorts\n                        <br data-kid=\"1-2-1-6-1-2-2\" data-name=\"headline line break 2\"/>\n                        <span class=\"text-[#FFA102]\" data-kid=\"1-2-1-6-1-2-3\" data-name=\"speed emphasis span\">\n                            <span class=\"mr-7 inline-block scale-[1.2] origin-left\" data-kid=\"1-2-1-6-1-2-3-1\" data-name=\"10x speed text\">\n                                10x\n                            </span>\n                            faster\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[34rem] text-[1.18rem] leading-[1.38] text-[#F5F9CE]/70\" data-kid=\"1-2-1-6-1-3\" data-name=\"hero subheadline description\">\n                        From raw talking head video to a post-ready Short in 1 click. Cut, caption, SFX, and more — so you can focus on building your personal brand.\n                    </p>\n                    <div class=\"mt-9 flex w-fit cursor-pointer items-center gap-3 rounded-[20px] border-2 border-dashed border-[#F5F9CE]/40 bg-[#F5F9CE]/5 px-5 py-4 text-[#F5F9CE] shadow-[4px_4px_0_#1d080c]\" data-kid=\"1-2-1-6-1-4\" data-name=\"upload call to action\">\n                        <span class=\"grid size-11 shrink-0 place-items-center rounded-full bg-[#FFA102] text-[#450E16]\" data-kid=\"1-2-1-6-1-4-1\" data-name=\"upload icon wrapper\">\n                            <svg aria-hidden=\"true\" class=\"size-5\" data-kid=\"1-2-1-6-1-4-1-1\" data-name=\"upload icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewbox=\"0 0 24 24\">\n                                <path d=\"M12 16V4\">\n                                </path>\n                                <path d=\"m7 9 5-5 5 5\">\n                                </path>\n                                <path d=\"M5 20h14\">\n                                </path>\n                            </svg>\n                        </span>\n 