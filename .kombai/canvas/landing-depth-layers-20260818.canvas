ame=\"cta decorative circle top\">\n            </div>\n            <div aria-hidden=\"\" class=\"absolute bottom-[-150px] left-[-4%] size-[330px] rounded-full border border-[#450E16]/15\" data-kid=\"1-2-4-2\" data-name=\"cta decorative circle bottom\">\n            </div>\n            <div class=\"relative mx-auto max-w-[1180px] text-center\" data-kid=\"1-2-4-3\" data-name=\"cta content wrapper\">\n                <p class=\"quiet-mono text-[10px] font-semibold tracking-[.2em] uppercase\" data-kid=\"1-2-4-3-1\" data-name=\"cta intro text\">\n                    Make the words do more\n                </p>\n                <h2 class=\"quiet-display mx-auto mt-6 max-w-[900px] text-[clamp(4.5rem,8vw,8.5rem)] leading-[.78]\" data-kid=\"1-2-4-3-2\" data-name=\"cta main headline\">\n                    Your next Short is already in the transcript.\n                </h2>\n                <div class=\"mx-auto mt-12 flex w-fit cursor-pointer items-center gap-3 rounded-[20px] border-2 border-[#450E16]/55 bg-[#F5F9CE]/20 px-5 py-4 text-[#450E16] shadow-[4px_4px_0_#450E16]\" data-kid=\"1-2-4-3-3\" data-name=\"cta button\">\n                    <span class=\"grid size-11 place-items-center rounded-full bg-[#FFA102] text-[#450E16]\" data-kid=\"1-2-4-3-3-1\" data-name=\"cta icon wrapper\">\n                        <svg aria-hidden=\"true\" class=\"size-5\" data-kid=\"1-2-4-3-3-1-1\" data-name=\"cta upload icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewbox=\"0 0 24 24\">\n                            <path d=\"M12 16V4\">\n                            </path>\n                            <path d=\"m7 9 5-5 5 5\">\n                            </path>\n                            <path d=\"M5 20h14\">\n                            </path>\n                        </svg>\n                    </span>\n                    <span class=\"text-left\" data-kid=\"1-2-4-3-3-2\" data-name=\"cta text group\">\n                        <span class=\"block text-lg font-semibold leading-none\" data-kid=\"1-2-4-3-3-2-1\" data-name=\"cta primary text\">\n                            Upload and Try It For Free\n                        </span>\n                        <span class=\"quiet-mono mt-2 block text-[10px] tracking-[.12em] text-[#450E16]/55 uppercase\" data-kid=\"1-2-4-3-3-2-2\" data-name=\"cta secondary text\">\n                            No login required\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-7 text-lg text-[#450E16]/65\" data-kid=\"1-2-4-3-4\" data-name=\"cta footer text\">\n                    Designed for Vertical talking-head Shorts.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t-2 border-[#F5F9CE]/20 bg-[#450E16] px-14 py-8 text-[#F5F9CE]\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center justify-between gap-6\" data-kid=\"1-3-1\" data-name=\"footer content\">\n            <span class=\"text-lg font-semibold\" data-kid=\"1-3-1-1\" data-name=\"footer logo name\">\n                YapCut\n            </span>\n            <span class=\"quiet-mono text-[9px] tracking-[.14em] text-[#F5F9CE]/50 uppercase\" data-kid=\"1-3-1-2\" data-name=\"footer tagline\">\n                Edit less. Say more.\n            </span>\n            <span class=\"quiet-mono text-[9px] tracking-[.14em] text-[#F5F9CE]/50 uppercase\" data-kid=\"1-3-1-3\" data-name=\"footer copyright\">\n                © 2026 YapCut\n            </span>\n        </div>\n    </footer>\n</div>\n<script type=\"module\">\n    import { animate, scroll } from 'https://cdn.jsdelivr.net/npm/motion@12/+esm';\n\n  const hero = document.querySelector('#quiet-hero');\n  const back = document.querySelector('.quiet-plane-back');\n  const front = document.querySelector('.quiet-plane-front');\n  const preview = document.querySelector('.quiet-preview');\n  const spotlight = document.querySelector('#quiet-spotlight');\n  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n  const updateDepth = () => {\n    if (!hero || reduce.matches) return;\n    const rect = hero.getBoundingClientRect();\n    const progress = Math.max(0, Math.min(1, -rect.top / Math.max(rect.height, 1)));\n    back?.style.setProperty('--back-y', `${progress * 18}px`);\n    front?.style.setProperty('--front-y', `${progress * -9}px`);\n  };\n\n  updateDepth();\n  const stopScroll = scroll(updateDepth);\n\n  hero?.addEventListener('pointermove', (event) => {\n    if (reduce.matches || !preview || !spotlight) return;\n    const rect = hero.getBoundingClientRect();\n    const nx = (event.clientX - rect.left) / rect.width - 0.5;\n    const ny = (event.clientY - rect.top) / rect.height - 0.5;\n    animate(preview, { '--tilt-x': `${nx * 2}deg`, '--tilt-y': `${ny * -2}deg` }, { duration: 0.45, ease: 'easeOut' });\n    animate(spotlight, { '--spot-x': `${nx * 56}px`, '--spot-y': `${ny * 42}px` }, { duration: 0.5, ease: 'easeOut' });\n  });\n\n  hero?.addEventListener('pointerleave', () => {\n    if (reduce.matches || !preview || !spotlight) return;\n    animate(preview, { '--tilt-x': '0deg', '--tilt-y': '0deg' }, { duration: 0.65, ease: 'easeOut' });\n    animate(spotlight, { '--spot-x': '0px', '--spot-y': '0px' }, { duration: 0.75, ease: 'easeOut' });\n  });\n\n  window.addEventListener('pagehide', () => stopScroll?.());\n</script>\n",
