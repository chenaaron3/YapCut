dline group\">\n                    <p class=\"quiet-mono mb-4 text-[10px] font-semibold tracking-[.2em] text-[#DD5533] uppercase\" data-kid=\"1-2-3-2-1-1\" data-name=\"how it works intro text\">\n                        From first click to ready post\n                    </p>\n                    <h2 class=\"quiet-display m-0 text-[clamp(4.4rem,8.5vw,9rem)] leading-[.78]\" data-kid=\"1-2-3-2-1-2\" data-name=\"how it works main headline\">\n                        Four steps.\n                        <br data-kid=\"1-2-3-2-1-2-1\" data-name=\"line break 1\"/>\n                        <span class=\"text-[#432E6F]\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"highlighted headline text\">\n                            That’s it.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"relative mt-12 min-h-[1150px]\" data-kid=\"1-2-3-2-2\" data-name=\"how it works interactive guide\">\n                    <div class=\"sticky top-0 grid min-h-[680px] grid-cols-[180px_minmax(0,1fr)] items-center gap-12 py-12\" data-kid=\"1-2-3-2-2-1\" data-name=\"interactive steps layout\">\n                        <aside aria-label=\"How it works steps\" class=\"flex flex-col justify-center gap-7\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"steps sidebar\">\n                            <div class=\"flex items-center gap-3 text-[#450E16]\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"step 1 button\">\n                                <span class=\"grid size-8 place-items-center rounded-full border-[1.5px] border-[#FFA102] bg-[#FFA102] quiet-mono text-[10px] font-bold\" data-kid=\"1-2-3-2-2-1-1-1-1\" data-name=\"step 1 number\">\n                                    01\n                                </span>\n                                <span class=\"text-lg font-semibold\" data-kid=\"1-2-3-2-2-1-1-1-2\" data-name=\"step 1 title\">\n                                    Drop it in\n                                </span>\n                        