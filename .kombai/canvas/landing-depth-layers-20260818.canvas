      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n\n  .phone-planes-page {\n    --cream: #F5F9CE;\n    --ink: #450E16;\n    --purple: #432E6F;\n    --orange: #FFA102;\n    --tomato: #DD5533;\n    --crimson: #BC2D29;\n    --muted: #75677F;\n    min-height: 100vh;\n    overflow: hidden;\n    background: var(--cream);\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .phone-planes-page .ember-display {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-weight: 700;\n    letter-spacing: -0.068em;\n  }\n\n  .phone-planes-page .ember-mono {\n    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  .phone-planes-page .grain {\n    background-image: radial-gradient(rgba(245, 249, 206, 0.16) 0.65px, transparent 0.65px);\n    background-size: 8px 8px;\n  }\n\n  .phone-planes-page .section-seam {\n    pointer-events: none;\n    position: absolute;\n    z-index: 3;\n    height: 78px;\n    width: 220px;\n    opacity: 0.6;\n    background: linear-gradient(125deg, transparent 0 39%, var(--orange) 40% 42%, var(--purple) 43% 45%, transparent 46%);\n    transform: translate3d(0, var(--seam-y, 0px), 0) rotate(-4deg);\n    will-change: transform;\n  }\n\n  .phone-planes-page .hero-shell {\n    isolation: isolate;\n    position: relative;\n    min-height: 720px;\n    background: var(--ink);\n    color: var(--cream);\n  }\n\n  .phone-planes-page .ember-field-back,\n  .phone-planes-page .ember-field-front {\n    pointer-events: none;\n    position: absolute;\n    border-radius: 999px;\n    filter: blur(0.2px);\n    transform-origin: center;\n    will-change: transform;\n  }\n\n  .phone-planes-page .ember-field-back {\n    top: -18%;\n    left: 32%;\n    height: 620px;\n    width: 360px;\n    opacity: 0.22;\n    background: linear-gradient(125deg, var(--orange), var(--tomato) 42%, var(--purple));\n    transform: translate3d(0, var(--scroll-y, 0px), 0) rotate(-32deg);\n  }\n\n  .phone-planes-page .ember-field-front {\n    right: 1%;\n    bottom: -15%;\n    height: 370px;\n    width: 250px;\n    opacity: 0.16;\n    background: linear-gradient(135deg, var(--purple), var(--tomato), var(--orange));\n    transform: translate3d(0, var(--scroll-y, 0px), 0) rotate(28deg);\n  }\n\n  .phone-planes-page .hero-noise {\n    pointer-events: none;\n    position: absolute;\n    inset: 0;\n    z-index: 1;\n    opacity: 0.3;\n  }\n\n  .phone-planes-page .hero-content {\n    position: relative;\n    z-index: 4;\n    margin: 0 auto;\n    display: grid;\n    min-height: 720px;\n    max-width: 1280px;\n    grid-template-columns: minmax(0, 1fr) 470px;\n    align-items: center;\n    gap: 72px;\n    padding: 112px 56px 64px;\n  }\n\n  .phone-planes-page .hero-copy {\n    max-width: 640px;\n  }\n\n  .phone-planes-page .hero-title {\n    margin: 24px 0 0;\n    max-width: 700px;\n    font-size: clamp(4.4rem, 7.2vw, 7.6rem);\n    line-height: 0.79;\n  }\n\n  .phone-planes-page .hero-interaction {\n    position: relative;\n    display: grid;\n    min-height: 520px;\n    place-items: center;\n    isolation: isolate;\n  }\n\n  .phone-planes-page .hero-interaction::before {\n    pointer-events: none;\n    position: absolute;\n    inset: 12% -12% 6% -18%;\n    z-index: -1;\n    border-radius: 50%;\n    content: '';\n    background: radial-gradient(circle at var(--spot-x, 50%) var(--spot-y, 48%), rgba(255,161,2,0.23), rgba(255,161,2,0.06) 29%, transparent 64%);\n    opacity: 0.88;\n    transition: opacity 420ms cubic-bezier(0,0,.2,1);\n  }\n\n  .phone-planes-page .phone-stage {\n    position: relative;\n    height: 472px;\n    width: 410px;\n    transform: perspective(1200px) rotateX(var(--tilt-y, 0deg)) rotateY(var(--tilt-x, 0deg));\n    transform-style: preserve-3d;\n    transition: transform 420ms cubic-bezier(0,0,.2,1);\n    will-change: transform;\n  }\n\n  .phone-planes-page .back-plate {\n    position: absolute;\n    top: 38px;\n    left: 41px;\n    height: 356px;\n    width: 302px;\n    border: 2px solid var(--orange);\n    border-radius: 32px;\n    background: linear-gradient(145deg, rgba(245,249,206,0.2), rgba(67,46,111,0.76) 47%, rgba(188,45,41,0.9));\n    box-shadow: 16px 19px 0 rgba(69,14,22,0.86), 0 30px 56px rgba(69,14,22,0.26);\n    clip-path: polygon(7% 0, 100% 0, 91% 100%, 0 91%);\n    transform: translateZ(-35px) rotate(-6deg);\n  }\n\n  .phone-planes-page .back-plate::after {\n    position: absolute;\n    right: 26px;\n    bottom: 28px;\n    height: 92px;\n    width: 92px;\n    border: 1px solid rgba(245,249,206,0.3);\n    border-radius: 50%;\n    content: '';\n  }\n\n  .phone-planes-page .back-plate-label {\n    position: absolute;\n    top: 30px;\n    left: 30px;\n    color: rgba(245,249,206,0.66);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 8px;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n  }\n\n  .phone-planes-page .phone-card {\n    position: absolute;\n    width: 190px;\n    border: 2px solid var(--ink);\n    border-radius: 25px;\n    padding: 6px;\n    box-shadow: 8px 10px 0 rgba(69,14,22,0.92), 0 22px 34px rgba(69,14,22,0.2);\n    transform-style: preserve-3d;\n  }\n\n  .phone-planes-page .phone-card-before {\n    top: 76px;\n    left: 16px;\n    z-index: 20;\n    background: var(--crimson);\n    transform: translateZ(18px) rotate(-7deg);\n  }\n\n  .phone-planes-page .phone-card-after {\n    top: 20px;\n    right: 10px;\n    z-index: 30;\n    background: var(--cream);\n    color: var(--ink);\n    transform: translateZ(42px) rotate(4deg);\n  }\n\n  .phone-planes-page .phone-media {\n    position: relative;\n    display: flex;\n    aspect-ratio: 9 / 16;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    border: 2px solid var(--ink);\n    border-radius: 18px;\n    background: linear-gradient(155deg, var(--purple), var(--crimson) 55%, var(--tomato));\n  }\n\n  .phone-card-after .phone-media {\n    background: linear-gradient(155deg, var(--tomato), var(--orange) 52%, var(--purple));\n  }\n\n  .phone-planes-page .phone-media::before {\n    position: absolute;\n    inset: 0;\n    content: '';\n    opacity: 0.28;\n    background: linear-gradient(105deg, transparent 24%, rgba(245,249,206,0.65) 25% 27%, transparent 28% 60%, rgba(255,161,2,0.8) 61% 64%, transparent 65%);\n    transform: translateX(-18%);\n  }\n\n  .phone-planes-page .media-placeholder {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    color: var(--cream);\n    text-align: center;\n  }\n\n  .phone-planes-page .media-placeholder .play-ring {\n    display: grid;\n    height: 46px;\n    width: 46px;\n    place-items: center;\n    border: 2px solid var(--orange);\n    border-radius: 50%;\n    background: rgba(69,14,22,0.3);\n  }\n\n  .phone-planes-page .media-placeholder small {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 8px;\n    letter-spacing: 0.13em;\n    text-transform: uppercase;\n  }\n\n  .phone-planes-page .media-label {\n    position: absolute;\n    top: 8px;\n    left: 8px;\n    z-index: 2;\n    border-radius: 999px;\n    background: var(--orange);\n    padding: 5px 8px;\n    color: var(--ink);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: 0.09em;\n    text-transform: uppercase;\n  }\n\n  .phone-planes-page .phone-action {\n    position: absolute;\n    right: 24px;\n    bottom: 0;\n    z-index: 50;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 2px solid var(--ink);\n    border-radius: 16px;\n    background: var(--orange);\n    padding: 12px 16px;\n    box-shadow: 5px 6px 0 var(--ink);\n    color: var(--ink);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.11em;\n    text-transform: uppercase;\n    transform: translateZ(64px) rotate(-2deg);\n  }\n\n  .phone-planes-page .phone-action::before {\n    position: absolute;\n    top: -9px;\n    left: 23px;\n    height: 9px;\n    width: 45px;\n    border-left: 2px solid var(--ink);\n    border-right: 2px solid var(--ink);\n    content: '';\n  }\n\n  .phone-planes-page .feature-card {\n    border: 2px solid var(--ink);\n    border-radius: 22px;\n    background: var(--ink);\n    color: var(--cream);\n    box-shadow: 5px 6px 0 rgba(69,14,22,0.9);\n    overflow: hidden;\n  }\n\n  .phone-planes-page .feature-card .mock {\n    display: grid;\n    height: 146px;\n    place-items: center;\n    padding: 18px;\n    color: var(--cream);\n  }\n\n  .phone-planes-page .feature-card .copy {\n    min-height: 164px;\n    border-top: 2px solid var(--ink);\n    background: var(--cream);\n    padding: 14px;\n    color: var(--ink);\n  }\n\n  .phone-planes-page .story-panel {\n    border: 2px solid var(--orange);\n    border-radius: 22px;\n    background: var(--ink);\n    box-shadow: 7px 8px 0 rgba(69,14,22,0.9);\n  }\n\n  .phone-planes-page .story-transcript {\n    border: 2px solid var(--ink);\n    border-radius: 16px;\n    background: var(--cream);\n    padding: 22px;\n    box-shadow: 6px 7px 0 rgba(0,0,0,0.18);\n    color: var(--ink);\n  }\n\n  .phone-planes-page .story-word {\n    display: inline-block;\n    border-radius: 7px;\n    padding: 1px 4px;\n  }\n\n  .phone-planes-page .story-word.is-marked {\n    background: rgba(255,161,2,0.22);\n    box-shadow: inset 0 0 0 1px var(--orange);\n    color: var(--purple);\n  }\n\n  .phone-planes-page .cta-shell {\n    position: relative;\n    overflow: hidden;\n    background: var(--tomato);\n    color: var(--ink);\n  }\n\n  .phone-planes-page .cta-shell::before {\n    position: absolute;\n    top: -140px;\n    right: -60px;\n    height: 360px;\n    width: 360px;\n    border: 26px solid rgba(245,249,206,0.2);\n    border-radius: 50%;\n    content: '';\n  }\n\n  .phone-planes-page .cta-shell::after {\n    pointer-events: none;\n    position: absolute;\n    inset: 0;\n    content: '';\n    background: radial-gradient(circle at 48% 55%, rgba(255,161,2,0.2), transparent 42%);\n  }\n\n  @keyframes field-back {\n    from { transform: translate3d(0,0,0) rotate(-32deg); }\n    to { transform: translate3d(-16px, 12px, 0) rotate(-29deg); }\n  }\n\n  @keyframes field-front {\n    from { transform: translate3d(0,0,0) rotate(28deg); }\n    to { transform: translate3d(10px, -12px, 0) rotate(25deg); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .phone-planes-page .ember-field-back,\n    .phone-planes-page .ember-field-front,\n    .phone-planes-page .phone-stage { animation: none; transition: none; }\n  }\n</style>\n<div class=\"phone-planes-page\" data-kid=\"1\" data-name=\"phone planes page container\">\n    <div class=\"grain pointer-events-none fixed inset-0 z-[500] opacity-30\" data-kid=\"1-1\" data-name=\"grain overlay\">\n    </div>\n    <header class=\"absolute inset-x-0 top-0 z-[100] border-b border-[#F5F9CE]/20 bg-[#BC2D29] text-[#F5F9CE]\" data-kid=\"1-2\" data-name=\"site header bar\">\n        <nav class=\"mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-14 py-5\" data-kid=\"1-2-1\" data-name=\"navigation container\">\n            <a aria-label=\"YapCut home\" class=\"flex items-center gap-3 text-[#F5F9CE] no-underline\" data-kid=\"1-2-1-1\" data-name=\"home link\" href=\"#product\">\n                <span class=\"grid h-8 w-8 place-items-center rounded-[10px] border-2 border-[#F5F9CE] bg-[#FFA102] text-[#450E16]\" data-kid=\"1-2-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-1-1\" data-lucide=\"scissors\" data-name=\"scissors icon\">\n                    </i>\n                </span>\n                <span class=\"ember-display text-3xl leading-none\" data-kid=\"1-2-1-1-2\" data-name=\"brand name\">\n                    YapCut\n                </span>\n            </a>\n            <div class=\"flex items-center gap-4 text-sm font-semibold\" data-kid=\"1-2-1-2\" data-name=\"navigation links group\">\n                <a class=\"hidden text-[#F5F9CE]/75 no-underline hover:text-[#F5F9CE] md:inline-flex\" data-kid=\"1-2-1-2-1\" data-name=\"product link\" href=\"#features\">\n                    Product\n                </a>\n                <a class=\"hidden text-[#F5F9CE]/75 no-underline hover:text-[#F5F9CE] md:inline-flex\" data-kid=\"1-2-1-2-2\" data-name=\"how it works link\" href=\"#how-it-works\">\n                    How it works\n                </a>\n                <button class=\"rounded-[14px] border-2 border-[#450E16] bg-[#FFA102] px-4 py-2.5 text-[#450E16] shadow-[3px_3px_0_#450E16]\" data-kid=\"1-2-1-2-3\" data-name=\"sign in button\">\n                    Sign in\n                </button>\n            </div>\n        </nav>\n    </header>\n    <main class=\"relative z-10\" data-kid=\"1-3\" data-name=\"main page content\">\n        <section class=\"hero-shell\" data-kid=\"1-3-1\" data-name=\"hero section\" id=\"product\">\n            <div class=\"ember-field-back\" data-dynamic=\"true\" data-kid=\"1-3-1-1\" data-name=\"animated background field back\" data-reason=\"style and position updated by scroll-driven script\">\n            </div>\n            <div class=\"ember-field-front\" data-dynamic=\"true\" data-kid=\"1-3-1-2\" data-name=\"animated background field front\" data-reason=\"style and position updated by scroll-driven script\">\n            </div>\n            <div class=\"hero-noise grain\" data-kid=\"1-3-1-3\" data-name=\"hero grain overlay\">\n            </div>\n            <div class=\"section-seam -bottom-7 left-[10%]\" data-dynamic=\"true\" data-kid=\"1-3-1-4\" data-name=\"decorative section seam\" data-reason=\"vertical position updated by scroll-driven script\">\n            </div>\n            <div class=\"hero-content\" data-kid=\"1-3-1-5\" data-name=\"hero content layout\">\n                <div class=\"hero-copy\" data-kid=\"1-3-1-5-1\" data-name=\"hero copy block\">\n                    <div class=\"inline-flex items-center gap-2 rounded-[8px] border border-[#FFA102] px-3 py-2 text-[#FFA102]\" data-kid=\"1-3-1-5-1-1\" data-name=\"badge container\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#FFA102]\" data-kid=\"1-3-1-5-1-1-1\" data-name=\"badge indicator dot\">\n                        </span>\n                        <span class=\"ember-mono text-[10px] font-semibold tracking-[.18em] uppercase\" data-kid=\"1-3-1-5-1-1-2\" data-name=\"badge text\">\n                            AI-Powered\n                        </span>\n                    </div>\n                    <h1 class=\"hero-title ember-display\" data-kid=\"1-3-1-5-1-2\" data-name=\"hero headline\">\n                        Edit talking\n                        <br data-kid=\"1-3-1-5-1-2-1\" data-name=\"line break\"/>\n                        head shorts\n                        <br data-kid=\"1-3-1-5-1-2-2\" data-name=\"line break\"/>\n                        <span class=\"text-[#FFA102]\" data-kid=\"1-3-1-5-1-2-3\" data-name=\"highlighted text span\">\n                            <span class=\"mr-8 inline-block scale-[1.2]\" data-kid=\"1-3-1-5-1-2-3-1\" data-name=\"speed multiplier text\">\n                                10x\n                            </span>\n                            faster\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[34rem] text-[19px] leading-[1.35] text-[#F5F9CE]/70\" data-kid=\"1-3-1-5-1-3\" data-name=\"hero description text\">\n                        From raw talking head video to a post-ready Short in 1 click. Cut, caption, SFX, and more — so you can focus on building your personal brand.\n                    </p>\n                    <div class=\"mt-9 inline-flex cursor-pointer items-center gap-3 rounded-[20px] border-2 border-dashed border-[#F5F9CE]/40 bg-[#F5F9CE]/5 px-5 py-4 text-[#F5F9CE] shadow-[4px_4px_0_#450E16]\" data-kid=\"1-3-1-5-1-4\" data-name=\"hero upload button\">\n                        <span class=\"grid h-11 w-11 place-items-center rounded-full bg-[#FFA102] text-[#450E16]\" data-kid=\"1-3-1-5-1-4-1\" data-name=\"upload icon container\">\n                            <i class=\"h-5 w-5\" data-kid=\"1-3-1-5-1-4-1-1\" data-lucide=\"upload\" data-name=\"upload icon\">\n                            </i>\n                        </span>\n                        <span class=\"text-left\" data-kid=\"1-3-1-5-1-4-2\" data-name=\"button labels group\">\n                            <strong class=\"block text-[17px] leading-none\" data-kid=\"1-3-1-5-1-4-2-1\" data-name=\"button primary text\">\n                                Upload and Try It For Free\n                            </strong>\n                            <span class=\"ember-mono mt-1 block text-[10px] tracking-[.12em] text-[#F5F9CE]/60 uppercase\" data-kid=\"1-3-1-5-1-4-2-2\" data-name=\"button subtitle text\">\n                                No login required\n                            </span>\n                        </span>\n                    </div>\n                </div>\n                <div class=\"hero-interaction\" data-dynamic=\"true\" data-kid=\"1-3-1-5-2\" data-name=\"hero interaction area\" data-reason=\"interactive properties updated by cursor move event\" id=\"preview-interaction\">\n                    <div class=\"absolute right-0 top-8 z-10 rounded-full border border-[#F5F9CE]/30 px-3 py-2 text-[#F5F9CE]/55\" data-kid=\"1-3-1-5-2-1\" data-name=\"instruction label container\">\n                        <span class=\"ember-mono text-[9px] tracking-[.16em] uppercase\" data-kid=\"1-3-1-5-2-1-1\" data-name=\"instruction text\">\n                            drag the edit forward\n                        </span>\n                    </div>\n                    <div class=\"phone-stage\" data-dynamic=\"true\" data-kid=\"1-3-1-5-2-2\" data-name=\"phone stage container\" data-reason=\"3D rotation transform updated by cursor move event\" id=\"phone-stage\">\n                        <div class=\"back-plate\" data-kid=\"1-3-1-5-2-2-1\" data-name=\"phone back plate\">\n                            <span class=\"back-plate-label\" data-kid=\"1-3-1-5-2-2-1-1\" data-name=\"back plate label\">\n                                yapcut / depth layer 01\n                            </span>\n                        </div>\n                        <div class=\"phone-card phone-card-before\" data-kid=\"1-3-1-5-2-2-2\" data-name=\"before phone card\">\n                            <div class=\"phone-media\" data-kid=\"1-3-1-5-2-2-2-1\" data-name=\"before media container\">\n                                <span class=\"media-label\" data-kid=\"1-3-1-5-2-2-2-1-1\" data-name=\"before media label\">\n                                    Before\n                                </span>\n                                <div class=\"media-placeholder\" data-kid=\"1-3-1-5-2-2-2-1-2\" data-name=\"before media placeholder\">\n                                    <span class=\"play-ring\" data-kid=\"1-3-1-5-2-2-2-1-2-1\" data-name=\"before play button container\">\n                                        <i class=\"ml-0.5 h-5 w-5 fill-current\" data-kid=\"1-3-1-5-2-2-2-1-2-1-1\" data-lucide=\"play\" data-name=\"play icon\">\n                                        </i>\n                                    </span>\n                                    <small data-kid=\"1-3-1-5-2-2-2-1-2-2\" data-name=\"before video label\">\n                                        raw clip / 9:16\n                                    </small>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"phone-card phone-card-after\" data-kid=\"1-3-1-5-2-2-3\" data-name=\"after phone card\">\n                            <div class=\"phone-media\" data-kid=\"1-3-1-5-2-2-3-1\" data-name=\"after media container\">\n                                <span class=\"media-label\" data-kid=\"1-3-1-5-2-2-3-1-1\" data-name=\"after media label\">\n                                    After\n                                </span>\n                                <div class=\"media-placeholder\" data-kid=\"1-3-1-5-2-2-3-1-2\" data-name=\"after media placeholder\">\n                                    <span class=\"play-ring\" data-kid=\"1-3-1-5-2-2-3-1-2-1\" data-name=\"after play button container\">\n                                        <i class=\"ml-0.5 h-5 w-5 fill-current\" data-kid=\"1-3-1-5-2-2-3-1-2-1-1\" data-lucide=\"play\" data-name=\"play icon\">\n                                        </i>\n                                    </span>\n                                    <small data-kid=\"1-3-1-5-2-2-3-1-2-2\" data-name=\"after video label\">\n                                        ready short / 00:28\n                                    </small>\n                                </div>\n                                <span class=\"absolute bottom-3 right-3 grid h-8 w-8 place-items-center rounded-full border-2 border-[#450E16] bg-[#FFA102] text-[#450E16]\" data-kid=\"1-3-1-5-2-2-3-1-3\" data-name=\"pause button container\">\n                                    <i class=\"h-3.5 w-3.5 fill-current\" data-kid=\"1-3-1-5-2-2-3-1-3-1\" data-lucide=\"pause\" data-name=\"pause icon\">\n                                    </i>\n                                </span>\n                            </div>\n                        </div>\n                        <button class=\"phone-action\" data-kid=\"1-3-1-5-2-2-4\" data-name=\"one-click action button\">\n                            <i class=\"h-4 w-4\" data-kid=\"1-3-1-5-2-2-4-1\" data-lucide=\"wand-sparkles\" data-name=\"wand icon\">\n                            </i>\n                            <span data-kid=\"1-3-1-5-2-2-4-2\" data-name=\"action button text\">\n                                One AI click\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative bg-[#F5F9CE] px-14 pb-28 pt-20\" data-kid=\"1-3-2\" data-name=\"features section\" id=\"features\">\n            <div class=\"section-seam -top-7 right-[12%]\" data-dynamic=\"true\" data-kid=\"1-3-2-1\" data-name=\"decorative section seam\" data-reason=\"vertical position updated by scroll-driven script\">\n            </div>\n            <div class=\"mx-auto max-w-[1280px]\" data-kid=\"1-3-2-2\" data-name=\"features content container\">\n                <div class=\"border-t-2 border-[#450E16]/20 pt-14\" data-kid=\"1-3-2-2-1\" data-name=\"section header container\">\n                    <p class=\"ember-mono mb-3 text-[10px] font-semibold tracking-[.2em] text-[#432E6F] uppercase\" data-kid=\"1-3-2-2-1-1\" data-name=\"section label\">\n                        The new way to edit talking-head Shorts\n                    </p>\n                    <h2 class=\"ember-display max-w-[940px] text-[clamp(4rem,6.6vw,6.6rem)] leading-[.8]\" data-kid=\"1-3-2-2-1-2\" data-name=\"section title\">\n                        Remove the slow, skippable parts —\n                        <span class=\"text-[#DD5533]\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"highlighted title text\">\n                            so you can shape the brand.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"mt-12 grid grid-cols-4 gap-3\" data-kid=\"1-3-2-2-2\" data-name=\"feature cards grid\">\n                    <article class=\"feature-card -rotate-[1deg]\" data-kid=\"1-3-2-2-2-1\" data-name=\"first feature card\">\n                        <div class=\"mock\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"feature mock container\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"icon group\">\n                                <span class=\"grid h-20 w-14 place-items-center rounded-[8px] border-2 border-[#FFA102] bg-[#BC2D29]\" data-kid=\"1-3-2-2-2-1-1-1-1\" data-name=\"video icon container\">\n                                    <i class=\"h-6 w-6 text-[#F5F9CE]\" data-kid=\"1-3-2-2-2-1-1-1-1-1\" data-lucide=\"video\" data-name=\"video icon\">\n                                    </i>\n                                </span>\n                                <i class=\"h-5 w-5 text-[#FFA102]\" data-kid=\"1-3-2-2-2-1-1-1-2\" data-lucide=\"arrow-right\" data-name=\"arrow icon\">\n                                </i>\n                                <span class=\"grid h-24 w-28 place-items-center rounded-[8px] border-2 border-[#450E16] bg-[#F5F9CE] text-[#DD5533]\" data-kid=\"1-3-2-2-2-1-1-1-3\" data-name=\"align icon container\">\n                                    <i class=\"h-7 w-7\" data-kid=\"1-3-2-2-2-1-1-1-3-1\" data-lucide=\"align-left\" data-name=\"align icon\">\n                                    </i>\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"copy\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"feature text content\">\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-3-2-2-2-1-2-1\" data-name=\"header container\">\n                                <span class=\"ember-mono text-[10px] font-semibold text-[#DD5533]\" data-kid=\"1-3-2-2-2-1-2-1-1\" data-name=\"feature index\">\n                                    01\n                                </span>\n                                <h3 class=\"ember-display text-2xl leading-tight\" data-kid=\"1-3-2-2-2-1-2-1-2\" data-name=\"feature title\">\n                                    Cut by deleting words\n                                </h3>\n                            </div>\n                            <p class=\"mt-2 text-sm leading-snug text-[#432E6F]\" data-kid=\"1-3-2-2-2-1-2-2\" data-name=\"feature body text\">\n                                <strong class=\"text-[#450E16]\" data-kid=\"1-3-2-2-2-1-2-2-1\" data-name=\"strong feature text\">\n                                    Save hours of tedious timeline cutting.\n                                </strong>\n                                AI automatically cuts the gaps and retakes.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"feature-card rotate-[1deg]\" data-kid=\"1-3-2-2-2-2\" data-name=\"second feature card\">\n                        <div class=\"mock\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"feature mock container\">\n                            <div class=\"w-44 space-y-4\" data-kid=\"1-3-2-2-2-2-1-1\" data-name=\"feature mock layout\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-2-1-1-1\" data-name=\"mock bar group\">\n                                    <span class=\"h-1.5 w-32 rounded-full bg-[#F5F9CE]/80\" data-kid=\"1-3-2-2-2-2-1-1-1-1\" data-name=\"bar\">\n                                    </span>\n                                    <span class=\"grid h-7 w-7 place-items-center rounded-[5px] bg-[#DD5533]\" data-kid=\"1-3-2-2-2-2-1-1-1-2\" data-name=\"icon container\">\n                                        <i class=\"h-3.5 w-3.5 text-[#450E16]\" data-kid=\"1-3-2-2-2-2-1-1-1-2-1\" data-lucide=\"type\" data-name=\"type icon\">\n                                        </i>\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-2-1-1-2\" data-name=\"mock bar group\">\n                                    <span class=\"h-1.5 w-40 rounded-full bg-[#F5F9CE]/55\" data-kid=\"1-3-2-2-2-2-1-1-2-1\" data-name=\"bar\">\n                                    </span>\n                                    <span class=\"grid h-7 w-7 place-items-center rounded-[5px] bg-[#2DD4BF]\" data-kid=\"1-3-2-2-2-2-1-1-2-2\" data-name=\"icon container\">\n                                        <i class=\"h-3.5 w-3.5 text-[#450E16]\" data-kid=\"1-3-2-2-2-2-1-1-2-2-1\" data-lucide=\"volume-2\" data-name=\"volume icon\">\n                                        </i>\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3\" data-kid=\"1-3-2-2-2-2-1-1-3\" data-name=\"mock bar group\">\n                                    <span class=\"h-1.5 w-24 rounded-full bg-[#FFA102]\" data-kid=\"1-3-2-2-2-2-1-1-3-1\" data-name=\"bar\">\n                                    </span>\n                                    <span class=\"grid h-7 w-7 place-items-center rounded-[5px] bg-[#3B82F6]\" data-kid=\"1-3-2-2-2-2-1-1-3-2\" data-name=\"icon container\">\n                                        <i class=\"h-3.5 w-3.5 text-[#450E16]\" data-kid=\"1-3-2-2-2-2-1-1-3-2-1\" data-lucide=\"zoom-in\" data-name=\"zoom icon\">\n                                        </i>\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"copy\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"feature text content\">\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"header container\">\n                                <span class=\"ember-mono text-[10px] font-semibold text-[#DD5533]\" data-kid=\"1-3-2-2-2-2-2-1-1\" data-name=\"feature index\">\n                                    02\n                                </span>\n                                <h3 class=\"ember-display text-2xl leading-tight\" data-kid=\"1-3-2-2-2-2-2-1-2\" data-name=\"feature title\">\n                                    Looks directed on arrival\n                                </h3>\n                            </div>\n                            <p class=\"mt-2 text-sm leading-snug text-[#432E6F]\" data-kid=\"1-3-2-2-2-2-2-2\" data-name=\"feature body text\">\n                                <strong class=\"text-[#450E16]\" data-kid=\"1-3-2-2-2-2-2-2-1\" data-name=\"strong feature text\">\n                                    Boost retention with a Short that already looks finished.\n                                </strong>\n                                Zooms, SFX, and overlays land on the words that matter.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"feature-card rotate-[1deg]\" data-kid=\"1-3-2-2-2-3\" data-name=\"third feature card\">\n                        <div class=\"mock\" data-kid=\"1-3-2-2-2-3-1\" data-name=\"feature mock container\">\n                            <p class=\"ember-display flex max-w-[220px] flex-wrap justify-center gap-x-2 text-4xl leading-none\" data-kid=\"1-3-2-2-2-3-1-1\" data-name=\"feature mock text\">\n                                <span data-kid=\"1-3-2-2-2-3-1-1-1\" data-name=\"text segment\">\n                                    the\n                                </span>\n                                <span class=\"rounded-[4px] bg-[#FFA102] px-1 text-[#450E16]\" data-kid=\"1-3-2-2-2-3-1-1-2\" data-name=\"text highlight segment\">\n                                    three\n                                </span>\n                                <span class=\"text-[#FFA102]\" data-kid=\"1-3-2-2-2-3-1-1-3\" data-name=\"text accent segment\">\n                                    tricks\n                                </span>\n                            </p>\n                        </div>\n                        <div class=\"copy\" data-kid=\"1-3-2-2-2-3-2\" data-name=\"feature text content\">\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-3-2-2-2-3-2-1\" data-name=\"header container\">\n                                <span class=\"ember-mono text-[10px] font-semibold text-[#DD5533]\" data-kid=\"1-3-2-2-2-3-2-1-1\" data-name=\"feature index\">\n                                    03\n                                </span>\n                                <h3 class=\"ember-display text-2xl leading-tight\" data-kid=\"1-3-2-2-2-3-2-1-2\" data-name=\"feature title\">\n                                    Tap a word, place the edit\n                                </h3>\n                            </div>\n                            <p class=\"mt-2 text-sm leading-snug text-[#432E6F]\" data-kid=\"1-3-2-2-2-3-2-2\" data-name=\"feature body text\">\n                                <strong class=\"text-[#450E16]\" data-kid=\"1-3-2-2-2-3-2-2-1\" data-name=\"strong feature text\">\n                                    Keep every edit tied to the timing of the words.\n                                </strong>\n                                The timeline’s still there; you just don’t have to live in it.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"feature-card -rotate-[1deg]\" data-kid=\"1-3-2-2-2-4\" data-name=\"fourth feature card\">\n                        <div class=\"mock\" data-kid=\"1-3-2-2-2-4-1\" data-name=\"feature mock container\">\n                            <p class=\"ember-display text-5xl leading-none text-[#F5F9CE]/50\" data-kid=\"1-3-2-2-2-4-1-1\" data-name=\"feature mock text\">\n                                the\n                                <span class=\"relative text-[#F5F9CE]\" data-kid=\"1-3-2-2-2-4-1-1-1\" data-name=\"highlighted text container\">\n                                    <span class=\"absolute -top-12 left-1/2 grid -translate-x-1/2 grid-cols-3 gap-1 rounded-[10px] border-2 border-[#450E16] bg-[#222632] p-1 text-[#F5F9CE]/60\" data-kid=\"1-3-2-2-2-4-1-1-1-1\" data-name=\"icon group\">\n                                        <i class=\"h-5 w-5\" data-kid=\"1-3-2-2-2-4-1-1-1-1-1\" data-lucide=\"type\" data-name=\"type icon\">\n                                        </i>\n                                        <i class=\"h-5 w-5\" data-kid=\"1-3-2-2-2-4-1-1-1-1-2\" data-lucide=\"volume-2\" data-name=\"volume icon\">\n                                        </i>\n                                        <i class=\"h-5 w-5 text-[#FFA102]\" data-kid=\"1-3-2-2-2-4-1-1-1-1-3\" data-lucide=\"zoom-in\" data-name=\"zoom icon\">\n                                        </i>\n                                    </span>\n                                    three\n                                </span>\n                                tricks\n                            </p>\n                        </div>\n                        <div class=\"copy\" data-kid=\"1-3-2-2-2-4-2\" data-name=\"feature text content\">\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-3-2-2-2-4-2-1\" data-name=\"header container\">\n                                <span class=\"ember-mono text-[10px] font-semibold text-[#DD5533]\" data-kid=\"1-3-2-2-2-4-2-1-1\" data-name=\"feature index\">\n                                    04\n                                </span>\n                                <h3 class=\"ember-display text-2xl leading-tight\" data-kid=\"1-3-2-2-2-4-2-1-2\" data-name=\"feature title\">\n                                    Your brand stays yours\n                                </h3>\n                            </div>\n                            <p class=\"mt-2 text-sm leading-snug text-[#432E6F]\" data-kid=\"1-3-2-2-2-4-2-2\" data-name=\"feature body text\">\n                                <strong class=\"text-[#450E16]\" data-kid=\"1-3-2-2-2-4-2-2-1\" data-name=\"strong feature text\">\n                                    The first pass is automatic.\n                                </strong>\n                                Nudge, swap, or undo anything until the look matches the brand you want.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative border-y-2 border-[#450E16]/20 bg-[#F5F9CE] px-14 py-20\" data-kid=\"1-3-3\" data-name=\"how-it-works section\" id=\"how-it-works\">\n            <div class=\"section-seam -top-8 left-[20%]\" data-dynamic=\"true\" data-kid=\"1-3-3-1\" data-name=\"decorative section seam\" data-reason=\"vertical position updated by scroll-driven script\">\n            </div>\n            <div class=\"mx-auto max-w-[1280px]\" data-kid=\"1-3-3-2\" data-name=\"section content\">\n                <div class=\"max-w-[940px]\" data-kid=\"1-3-3-2-1\" data-name=\"section header container\">\n                    <p class=\"ember-mono mb-4 text-[10px] font-semibold tracking-[.2em] text-[#DD5533] uppercase\" data-kid=\"1-3-3-2-1-1\" data-name=\"section label\">\n                        From first click to ready post\n                    </p>\n                    <h2 class=\"ember-display text-[clamp(5rem,8.5vw,9rem)] leading-[.78]\" data-kid=\"1-3-3-2-1-2\" data-name=\"section title\">\n                        Four steps.\n                        <br data-kid=\"1-3-3-2-1-2-1\" data-name=\"line break\"/>\n                        <span class=\"text-[#432E6F]\" data-kid=\"1-3-3-2-1-2-2\" data-name=\"highlighted title text\">\n                            That’s it.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"mt-12 grid grid-cols-[170px_minmax(0,1fr)] items-center gap-12\" data-kid=\"1-3-3-2-2\" data-name=\"steps grid container\">\n                    <aside class=\"flex flex-col justify-center gap-7\" data-kid=\"1-3-3-2-2-1\" data-name=\"steps navigation list\">\n                        <button class=\"flex items-center gap-3 text-left text-[#450E16]\" data-kid=\"1-3-3-2-2-1-1\" data-name=\"first step button\">\n                            <span class=\"grid h-8 w-8 place-items-center rounded-full border-[1.5px] border-[#FFA102] bg-[#FFA102] font-mono text-[10px] font-semibold\" data-kid=\"1-3-3-2-2-1-1-1\" data-name=\"step index\">\n                                01\n                            </span>\n                            <span class=\"text-base font-semibold\" data-kid=\"1-3-3-2-2-1-1-2\" data-name=\"step label\">\n                                Drop it in\n                            </span>\n                        </button>\n                        <button class=\"flex items-center gap-3 text-left text-[#450E16]\" data-kid=\"1-3-3-2-2-1-2\" data-name=\"second step button\">\n                            <span class=\"grid h-8 w-8 place-items-center rounded-full border-[1.5px] border-[#FFA102] bg-[#FFA102] font-mono text-[10px] font-semibold\" data-kid=\"1-3-3-2-2-1-2-1\" data-name=\"step index\">\n                                02\n                            </span>\n                            <span class=\"text-base font-semibold\" data-kid=\"1-3-3-2-2-1-2-2\" data-name=\"step label\">\n                                Watch it in action\n                            </span>\n                        </button>\n                        <button class=\"flex items-center gap-3 text-left text-[#450E16]/45\" data-kid=\"1-3-3-2-2-1-3\" data-name=\"third step button\">\n                            <span class=\"grid h-8 w-8 place-items-center rounded-full border-[1.5px] border-[#450E16]/30 font-mono text-[10px] font-semibold\" data-kid=\"1-3-3-2-2-1-3-1\" data-name=\"step index\">\n                                03\n                            </span>\n                            <span class=\"text-base font-semibold\" data-kid=\"1-3-3-2-2-1-3-2\" data-name=\"step label\">\n                                Tweak it\n                            </span>\n                        </button>\n                        <button class=\"flex items-center gap-3 text-left text-[#450E16]/45\" data-kid=\"1-3-3-2-2-1-4\" data-name=\"fourth step button\">\n                            <span class=\"grid h-8 w-8 place-items-center rounded-full border-[1.5px] border-[#450E16]/30 font-mono text-[10px] font-semibold\" data-kid=\"1-3-3-2-2-1-4-1\" data-name=\"step index\">\n                                04\n                            </span>\n                            <span class=\"text-base font-semibold\" data-kid=\"1-3-3-2-2-1-4-2\" data-name=\"step label\">\n                                Share it\n                            </span>\n                        </button>\n                    </aside>\n                    <div class=\"story-panel h-[400px] p-5 text-[#F5F9CE]\" data-kid=\"1-3-3-2-2-2\" data-name=\"interactive story panel\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"panel header\">\n                            <span class=\"ember-mono text-[10px] tracking-[.18em] text-[#2DD4BF] uppercase\" data-kid=\"1-3-3-2-2-2-1-1\" data-name=\"panel label\">\n                                02 / watch it in action\n                            </span>\n                            <span class=\"ember-mono rounded-full border border-[#2DD4BF]/55 px-3 py-2 text-[9px] tracking-[.12em] text-[#9DEEE1] uppercase\" data-kid=\"1-3-3-2-2-2-1-2\" data-name=\"panel badge\">\n                                AI Edits\n                            </span>\n                        </div>\n                        <div class=\"flex h-[285px] items-center\" data-kid=\"1-3-3-2-2-2-2\" data-name=\"transcript view container\">\n                            <div class=\"story-transcript w-full\" data-kid=\"1-3-3-2-2-2-2-1\" data-name=\"transcript box\">\n                                <div class=\"ember-mono mb-5 flex items-center justify-between text-[8px] tracking-[.14em] text-[#DD5533] uppercase\" data-kid=\"1-3-3-2-2-2-2-1-1\" data-name=\"header\">\n                                    <span data-kid=\"1-3-3-2-2-2-2-1-1-1\" data-name=\"header label\">\n                                        transcript\n                                    </span>\n                                    <span class=\"text-[#450E16]/40\" data-kid=\"1-3-3-2-2-2-2-1-1-2\" data-name=\"timestamp\">\n                                        00:08\n                                    </span>\n                                </div>\n                                <p class=\"m-0 flex flex-wrap gap-x-2 gap-y-2 text-[30px] leading-[1.15]\" data-kid=\"1-3-3-2-2-2-2-1-2\" data-name=\"transcript text block\">\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-1\" data-name=\"word element\">\n                                        The\n                                    </span>\n                                    <span class=\"story-word is-marked\" data-kid=\"1-3-3-2-2-2-2-1-2-2\" data-name=\"marked word\">\n                                        idea\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-3\" data-name=\"word element\">\n                                        is\n                                    </span>\n                                    <span class=\"story-word is-marked\" data-kid=\"1-3-3-2-2-2-2-1-2-4\" data-name=\"marked word\">\n                                        already\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-5\" data-name=\"word element\">\n                                        there.\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-6\" data-name=\"word element\">\n                                        You\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-7\" data-name=\"word element\">\n                                        just\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-8\" data-name=\"word element\">\n                                        have\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-9\" data-name=\"word element\">\n                                        to\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-10\" data-name=\"word element\">\n                                        make\n                                    </span>\n                                    <span class=\"story-word\" data-kid=\"1-3-3-2-2-2-2-1-2-11\" data-name=\"word element\">\n                                        it\n                                    </span>\n                                    <span class=\"story-word is-marked\" data-kid=\"1-3-3-2-2-2-2-1-2-12\" data-name=\"marked word\">\n                                        land.\n                                    </span>\n                                </p>\n                                <div class=\"mt-6 flex gap-2\" data-kid=\"1-3-3-2-2-2-2-1-3\" data-name=\"tag group\">\n                                    <span class=\"ember-mono rounded-[6px] border border-[#3B82F6]/60 bg-[#3B82F6]/10 px-2 py-1 text-[8px] tracking-[.1em] text-[#2563EB] uppercase\" data-kid=\"1-3-3-2-2-2-2-1-3-1\" data-name=\"tag element\">\n                                        zoom\n                                    </span>\n                                    <span class=\"ember-mono rounded-[6px] border border-[#2DD4BF]/60 bg-[#2DD4BF]/10 px-2 py-1 text-[8px] tracking-[.1em] text-[#087F77] uppercase\" data-kid=\"1-3-3-2-2-2-2-1-3-2\" data-name=\"tag element\">\n                                        sfx\n                                    </span>\n                                    <span class=\"ember-mono rounded-[6px] border border-[#DD5533]/60 bg-[#DD5533]/10 px-2 py-1 text-[8px] tracking-[.1em] text-[#BC2D29] uppercase\" data-kid=\"1-3-3-2-2-2-2-1-3-3\" data-name=\"tag element\">\n                                        emphasis\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <p class=\"ember-mono m-0 text-center text-[9px] tracking-[.16em] text-[#F5F9CE]/45 uppercase\" data-kid=\"1-3-3-2-2-2-3\" data-name=\"footer text\">\n                            speech becomes a surface you can edit\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"cta-shell relative px-14 py-36 text-center\" data-kid=\"1-3-4\" data-name=\"call-to-action section\" id=\"cta\">\n            <div class=\"section-seam -top-8 right-[18%]\" data-dynamic=\"true\" data-kid=\"1-3-4-1\" data-name=\"decorative section seam\" data-reason=\"vertical position updated by scroll-driven script\">\n            </div>\n            <div class=\"relative z-10 mx-auto max-w-[1180px]\" data-kid=\"1-3-4-2\" data-name=\"cta content container\">\n                <p class=\"ember-mono text-[10px] font-semibold tracking-[.2em] uppercase\" data-kid=\"1-3-4-2-1\" data-name=\"section header\">\n                    Make the words do more\n                </p>\n                <h2 class=\"ember-display mx-auto mt-5 max-w-[900px] text-[clamp(4.6rem,8vw,8.4rem)] leading-[.78]\" data-kid=\"1-3-4-2-2\" data-name=\"section title\">\n                    Your next Short is already in the transcript.\n                </h2>\n                <div class=\"mx-auto mt-12 inline-flex cursor-pointer items-center gap-3 rounded-[20px] border-2 border-[#450E16]/45 bg-[#F5F9CE]/20 px-5 py-4 text-left shadow-[4px_4px_0_#450E16]\" data-kid=\"1-3-4-2-3\" data-name=\"cta button\">\n                    <span class=\"grid h-11 w-11 place-items-center rounded-full bg-[#FFA102] text-[#450E16]\" data-kid=\"1-3-4-2-3-1\" data-name=\"upload icon container\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-3-4-2-3-1-1\" data-lucide=\"upload\" data-name=\"upload icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-3-4-2-3-2\" data-name=\"button labels group\">\n                        <strong class=\"block text-[17px] leading-none\" data-kid=\"1-3-4-2-3-2-1\" data-name=\"primary button text\">\n                            Upload and Try It For Free\n                        </strong>\n                        <span class=\"ember-mono mt-1 block text-[10px] tracking-[.12em] text-[#450E16]/55 uppercase\" data-kid=\"1-3-4-2-3-2-2\" data-name=\"secondary button text\">\n                            No login required\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-6 text-lg text-[#450E16]/65\" data-kid=\"1-3-4-2-4\" data-name=\"disclaimer text\">\n                    Designed for Vertical talking-head Shorts.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t-2 border-[#F5F9CE]/20 bg-[#450E16] px-14 py-7 text-[#F5F9CE]\" data-kid=\"1-4\" data-name=\"page footer\">\n        <div class=\"mx-auto flex max-w-[1280px] items-center justify-between gap-4 text-sm\" data-kid=\"1-4-1\" data-name=\"footer grid container\">\n            <span class=\"font-semibold\" data-kid=\"1-4-1-1\" data-name=\"brand name\">\n                YapCut\n            </span>\n            <span class=\"ember-mono text-[9px] tracking-[.14em] text-[#F5F9CE]/50 uppercase\" data-kid=\"1-4-1-2\" data-name=\"slogan text\">\n                Edit less. Say more.\n            </span>\n            <span class=\"ember-mono text-[9px] tracking-[.14em] text-[#F5F9CE]/50 uppercase\" data-kid=\"1-4-1-3\" data-name=\"copyright notice\">\n                © 2026 YapCut\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    if (window.lucide) window.lucide.createIcons();\n  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');\n  const hero = document.querySelector('.hero-shell');\n  const back = document.querySelector('.ember-field-back');\n  const front = document.querySelector('.ember-field-front');\n  const seams = [...document.querySelectorAll('.section-seam')];\n  const updateScrollDepth = () => {\n    if (reduce.matches) return;\n    const heroRect = hero?.getBoundingClientRect();\n    if (heroRect) {\n      const heroProgress = Math.max(0, Math.min(1, -heroRect.top / Math.max(heroRect.height, 1)));\n      back?.style.setProperty('--scroll-y', `${(heroProgress * 64).toFixed(1)}px`);\n      front?.style.setProperty('--scroll-y', `${(-heroProgress * 34).toFixed(1)}px`);\n    }\n    seams.forEach((seam) => {\n      const section = seam.parentElement;\n      const rect = section?.getBoundingClientRect();\n      if (!rect) return;\n      const progress = Math.max(0, Math.min(1, (window.innerHeight - rect.top) / Math.max(window.innerHeight + rect.height, 1)));\n      seam.style.setProperty('--seam-y', `${((0.5 - progress) * 26).toFixed(1)}px`);\n    });\n  };\n  updateScrollDepth();\n  window.addEventListener('scroll', updateScrollDepth, { passive: true });\n  window.addEventListener('resize', updateScrollDepth);\n  const preview = document.getElementById('preview-interaction');\n  const stage = document.getElementById('phone-stage');\n  if (preview && stage) {\n    preview.addEventListener('pointermove', (event) => {\n      const rect = preview.getBoundingClientRect();\n      const x = (event.clientX - rect.left) / rect.width - 0.5;\n      const y = (event.clientY - rect.top) / rect.height - 0.5;\n      stage.style.setProperty('--tilt-x', `${(x * 3.2).toFixed(2)}deg`);\n      stage.style.setProperty('--tilt-y', `${(-y * 3.2).toFixed(2)}deg`);\n      preview.style.setProperty('--spot-x', `${((x + 0.5) * 100).toFixed(1)}%`);\n      preview.style.setProperty('--spot-y', `${((y + 0.5) * 100).toFixed(1)}%`);\n    });\n    preview.addEventListener('pointerleave', () => {\n      stage.style.setProperty('--tilt-x', '0deg');\n      stage.style.setProperty('--tilt-y', '0deg');\n      preview.style.setProperty('--spot-x', '50%');\n      preview.style.setProperty('--spot-y', '48%');\n    });\n  }\n</script>\n",
      "comments": [],
      "created": "2026-08-18T15:35:06.021224+00:00",
      "modified": "2026-08-18T16:10:17.185885+00:00",
      "id": "var_60a53bb7acaa",
      "viewportScrollY": 0
    },
    "var_0aea0d68187d": {
      "type": "variant",
      "label": "Landing depth — Editorial Drift",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n\n  :root {\n    --cream: #f5f9ce;\n    --ink: #450e16;\n    --purple: #432e6f;\n    --orange: #ffa102;\n    --tomato: #dd5533;\n    --crimson: #bc2d29;\n    --teal: #2dd4bf;\n  }\n\n  .editorial-page {\n    min-height: 100vh;\n    overflow: hidden;\n    background: var(--cream);\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .editorial-page h1,\n  .editorial-page h2,\n  .editorial-page h3,\n  .editorial-page p {\n    margin: 0;\n  }\n\n  .mono {\n    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  .display {\n    font-weight: 700;\n    letter-spacing: -0.075em;\n  }\n\n  .nav {\n    position: absolute;\n    inset: 0 0 auto;\n    z-index: 40;\n    border-bottom: 1px solid rgba(245, 249, 206, .22);\n    background: rgba(188, 45, 41, .97);\n    color: var(--cream);\n  }\n\n  .nav-inner {\n    display: flex;\n    max-width: 1280px;\n    height: 78px;\n    margin: 0 auto;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    padding: 0 56px;\n  }\n\n  .brand {\n    display: inline-flex;\n    align-items: center;\n    gap: 11px;\n    color: var(--cream);\n    font-size: 27px;\n    font-weight: 700;\n    letter-spacing: -.07em;\n    text-decoration: none;\n  }\n\n  .brand-mark {\n    position: relative;\n    display: grid;\n    width: 29px;\n    height: 29px;\n    place-items: center;\n    border: 2px solid var(--orange);\n    border-radius: 50%;\n  }\n\n  .brand-mark::before,\n  .brand-mark::after {\n    position: absolute;\n    display: block;\n    width: 8px;\n    height: 8px;\n    border-radius: 2px;\n    background: var(--orange);\n    content: '';\n  }\n\n  .brand-mark::before { transform: translate(-5px, -4px) rotate(45deg); }\n  .brand-mark::after { transform: translate(5px, 4px) rotate(45deg); background: var(--cream); }\n\n  .nav-actions {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .nav-link {\n    padding: 12px 14px;\n    color: rgba(245, 249, 206, .72);\n    font-size: 16px;\n    font-weight: 600;\n    text-decoration: none;\n  }\n\n  .nav-link:hover { color: var(--cream); }\n\n  .sign-in {\n    border: 2px solid var(--ink);\n    border-radius: 13px;\n    background: var(--orange);\n    box-shadow: 4px 4px 0 var(--ink);\n    color: var(--ink);\n    cursor: pointer;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    padding: 12px 16px;\n    text-transform: uppercase;\n  }\n\n  .sign-in:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--ink); }\n\n  .hero {\n    position: relative;\n    min-height: 760px;\n    overflow: hidden;\n    background: var(--ink);\n    color: var(--cream);\n  }\n\n  .grain {\n    position: absolute;\n    inset: 0;\n    z-index: 3;\n    pointer-events: none;\n    background-image: radial-gradient(rgba(245, 249, 206, .17) .65px, transparent .65px);\n    background-size: 8px 8px;\n    opacity: .22;\n    mix-blend-mode: screen;\n  }\n\n  .hero-field {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    pointer-events: none;\n  }\n\n  .field-plane {\n    position: absolute;\n    display: block;\n    pointer-events: none;\n    transform-origin: center;\n  }\n\n  .field-plane.back {\n    top: -170px;\n    left: 34%;\n    width: 650px;\n    height: 920px;\n    border: 1px solid rgba(255, 161, 2, .22);\n    background: linear-gradient(124deg, rgba(255, 161, 2, .14), rgba(67, 46, 111, .22));\n    clip-path: polygon(31% 0, 74% 0, 100% 100%, 0 100%);\n    animation: editorial-back 18s ease-in-out infinite alternate;\n  }\n\n  .field-plane.front {\n    top: 110px;\n    right: -90px;\n    width: 500px;\n    height: 520px;\n    border: 1px solid rgba(245, 249, 206, .12);\n    background: linear-gradient(130deg, rgba(221, 85, 51, .13), rgba(67, 46, 111, .16));\n    clip-path: polygon(20% 0, 100% 22%, 74% 100%, 0 78%);\n    animation: editorial-front 15s ease-in-out infinite alternate;\n  }\n\n  .hero-structure {\n    position: absolute;\n    top: 135px;\n    right: 5.5%;\n    width: 250px;\n    height: 250px;\n    border: 1px solid rgba(255, 161, 2, .28);\n    border-radius: 50%;\n    opacity: .55;\n  }\n\n  .hero-structure::before,\n  .hero-structure::after {\n    position: absolute;\n    inset: 50% -34px auto;\n    height: 1px;\n    background: rgba(255, 161, 2, .35);\n    content: '';\n    transform: rotate(-37deg);\n  }\n\n  .hero-structure::after { transform: rotate(53deg); background: rgba(245, 249, 206, .15); }\n\n  .hero-spotlight {\n    position: absolute;\n    z-index: 1;\n    top: 52%;\n    left: 34%;\n    width: 500px;\n    height: 300px;\n    pointer-events: none;\n    background: radial-gradient(ellipse, rgba(255, 161, 2, .14), rgba(255, 161, 2, 0) 70%);\n    transform: translate(-50%, -50%);\n  }\n\n  .hero-inner {\n    position: relative;\n    z-index: 10;\n    display: grid;\n    max-width: 1280px;\n    min-height: 760px;\n    margin: 0 auto;\n    align-items: center;\n    grid-template-columns: minmax(0, 1fr) 430px;\n    gap: 74px;\n    padding: 132px 56px 96px;\n  }\n\n  .hero-copy { max-width: 650px; }\n\n  .eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    border: 1px solid var(--orange);\n    border-radius: 8px;\n    color: var(--orange);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .18em;\n    padding: 10px 13px;\n    text-transform: uppercase;\n  }\n\n  .eyebrow i { width: 7px; height: 7px; fill: var(--orange); stroke: none; }\n\n  .hero-title {\n    max-width: 690px;\n    margin-top: 22px !important;\n    font-size: clamp(76px, 8.2vw, 122px);\n    line-height: .77;\n  }\n\n  .hero-title .orange { color: var(--orange); }\n  .hero-title .ten { display: inline-block; margin-right: 23px; transform: scale(1.16); transform-origin: left center; }\n\n  .hero-description {\n    max-width: 500px;\n    margin-top: 28px !important;\n    color: rgba(245, 249, 206, .72);\n    font-size: 21px;\n    line-height: 1.32;\n  }\n\n  .upload-zone {\n    position: relative;\n    display: inline-flex;\n    width: 362px;\n    margin-top: 32px;\n    align-items: center;\n    gap: 15px;\n    border: 2px dashed rgba(245, 249, 206, .44);\n    border-radius: 20px;\n    background: rgba(245, 249, 206, .05);\n    box-shadow: 5px 6px 0 rgba(0, 0, 0, .38);\n    cursor: pointer;\n    padding: 15px 18px;\n  }\n\n  .upload-zone:hover { border-color: var(--orange); background: rgba(255, 161, 2, .09); }\n\n  .upload-icon {\n    display: grid;\n    width: 48px;\n    height: 48px;\n    flex: 0 0 auto;\n    place-items: center;\n    border-radius: 50%;\n    background: var(--orange);\n    color: var(--ink);\n  }\n\n  .upload-icon i { width: 22px; height: 22px; stroke-width: 2.5; }\n\n  .upload-title { font-size: 21px; font-weight: 700; line-height: 1; }\n  .upload-meta { margin-top: 7px !important; color: rgba(245, 249, 206, .58); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }\n\n  .hero-stage {\n    position: relative;\n    width: 430px;\n    height: 500px;\n    perspective: 1300px;\n  }\n\n  .stage-construction {\n    position: absolute;\n    top: 17px;\n    right: 8px;\n    width: 260px;\n    height: 380px;\n    border: 1px solid rgba(255, 161, 2, .3);\n    clip-path: polygon(22% 0, 100% 14%, 75% 100%, 0 84%);\n    transform: rotate(4deg);\n  }\n\n  .stage-construction::after {\n    position: absolute;\n    top: 11%;\n    right: 13%;\n    bottom: 11%;\n    left: 13%;\n    border: 1px solid rgba(245, 249, 206, .14);\n    content: '';\n    clip-path: inherit;\n  }\n\n  .phone-plate {\n    position: absolute;\n    top: 40px;\n    left: 67px;\n    width: 300px;\n    height: 390px;\n    border: 1px solid rgba(255, 161, 2, .32);\n    background: rgba(67, 46, 111, .16);\n    clip-path: polygon(17% 0, 100% 12%, 82% 100%, 0 87%);\n    transform: rotate(-8deg) translateZ(-38px);\n  }\n\n  .phone {\n    position: absolute;\n    width: 202px;\n    border: 2px solid var(--ink);\n    border-radius: 25px;\n    background: var(--cream);\n    box-shadow: 8px 9px 0 rgba(0, 0, 0, .42), 0 20px 48px rgba(69, 14, 22, .2);\n    padding: 7px;\n    transform-style: preserve-3d;\n  }\n\n  .phone.before { top: 74px; left: 0; z-index: 10; transform: rotateY(8deg) rotateZ(-7deg) translateZ(12px); }\n  .phone.after { top: 26px; right: 7px; z-index: 20; transform: rotateY(-5deg) rotateZ(3deg) translateZ(30px); }\n\n  .phone-screen {\n    position: relative;\n    aspect-ratio: 9 / 16;\n    overflow: hidden;\n    border: 2px solid var(--ink);\n    border-radius: 18px;\n    background: #2d2151;\n  }\n\n  .phone-screen::before {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(156deg, rgba(255, 161, 2, .32), transparent 42%), linear-gradient(20deg, rgba(221, 85, 51, .44), transparent 58%);\n    content: '';\n  }\n\n  .portrait {\n    position: absolute;\n    top: 16%;\n    left: 23%;\n    width: 54%;\n    height: 42%;\n    border: 2px solid rgba(245, 249, 206, .68);\n    border-radius: 47% 47% 43% 43%;\n    background: linear-gradient(160deg, rgba(245, 249, 206, .42), rgba(221, 85, 51, .15));\n    box-shadow: 0 0 0 12px rgba(245, 249, 206, .05);\n  }\n\n  .portrait::before,\n  .portrait::after {\n    position: absolute;\n    top: 35%;\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--cream);\n    content: '';\n  }\n\n  .portrait::before { left: 30%; }\n  .portrait::after { right: 30%; }\n\n  .phone-lines { position: absolute; right: 13%; bottom: 21%; left: 13%; display: grid; gap: 7px; }\n  .phone-lines span { display: block; height: 5px; border-radius: 99px; background: rgba(245, 249, 206, .72); }\n  .phone-lines span:nth-child(2) { width: 75%; background: var(--orange); }\n  .phone-lines span:nth-child(3) { width: 88%; background: rgba(245, 249, 206, .38); }\n\n  .phone-tag {\n    position: absolute;\n    top: 10px;\n    left: 10px;\n    z-index: 2;\n    border-radius: 99px;\n    background: var(--orange);\n    color: var(--ink);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    padding: 5px 8px;\n    text-transform: uppercase;\n  }\n\n  .phone.after .phone-screen { background: #f5f9ce; }\n  .phone.after .phone-screen::before { background: linear-gradient(152deg, rgba(255, 161, 2, .4), transparent 43%), linear-gradient(20deg, rgba(67, 46, 111, .48), transparent 62%); }\n  .phone.after .portrait { border-color: var(--ink); background: linear-gradient(160deg, rgba(67, 46, 111, .37), rgba(221, 85, 51, .12)); box-shadow: 0 0 0 12px rgba(67, 46, 111, .06); }\n  .phone.after .portrait::before, .phone.after .portrait::after { background: var(--ink); }\n  .phone.after .phone-lines span { background: rgba(69, 14, 22, .72); }\n  .phone.after .phone-lines span:nth-child(2) { background: var(--tomato); }\n  .phone.after .phone-lines span:nth-child(3) { background: rgba(69, 14, 22, .34); }\n\n  .preview-switch {\n    position: absolute;\n    bottom: 16px;\n    left: 50%;\n    z-index: 30;\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    border: 2px solid var(--ink);\n    border-radius: 14px;\n    background: var(--orange);\n    box-shadow: 4px 4px 0 var(--ink);\n    color: var(--ink);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    padding: 11px 14px;\n    text-transform: uppercase;\n    transform: translateX(-50%);\n  }\n\n  .preview-switch i { width: 14px; height: 14px; }\n\n  .seam {\n    position: absolute;\n    z-index: 15;\n    pointer-events: none;\n  }\n\n  .seam.hero-to-features {\n    right: -2%;\n    bottom: -2px;\n    width: 72%;\n    height: 136px;\n    border-top: 1px solid rgba(255, 161, 2, .72);\n    background: var(--cream);\n    clip-path: polygon(30% 100%, 100% 0, 100% 100%);\n    animation: seam-drift 16s ease-in-out infinite alternate;\n  }\n\n  .seam.hero-to-features::before {\n    position: absolute;\n    top: 22%;\n    right: 0;\n    left: 39%;\n    height: 1px;\n    background: var(--purple);\n    content: '';\n    transform: rotate(-13deg);\n    transform-origin: right center;\n  }\n\n  .features {\n    position: relative;\n    overflow: hidden;\n    background: var(--cream);\n    padding: 88px 56px 118px;\n  }\n\n  .features::before {\n    position: absolute;\n    top: 26px;\n    left: 6%;\n    width: 280px;\n    height: 1px;\n    background: rgba(67, 46, 111, .35);\n    content: '';\n    transform: rotate(-2deg);\n  }\n\n  .section-inner { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; }\n\n  .section-kicker {\n    color: var(--purple);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .section-title {\n    max-width: 940px;\n    margin-top: 18px !important;\n    font-size: clamp(62px, 6.6vw, 96px);\n    line-height: .8;\n  }\n\n  .section-title .tomato { color: var(--tomato); }\n\n  .feature-grid {\n    display: grid;\n    margin-top: 56px;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 14px;\n  }\n\n  .feature-card {\n    display: flex;\n    min-height: 340px;\n    flex-direction: column;\n    overflow: hidden;\n    border: 2px solid var(--ink);\n    border-radius: 21px;\n    background: var(--ink);\n    box-shadow: 6px 7px 0 rgba(69, 14, 22, .9);\n    color: var(--cream);\n  }\n\n  .feature-card:nth-child(1) { transform: rotate(-1deg); }\n  .feature-card:nth-child(2) { transform: rotate(.7deg); }\n  .feature-card:nth-child(3) { transform: rotate(1deg); }\n  .feature-card:nth-child(4) { transform: rotate(-.8deg); }\n\n  .mock-stage {\n    position: relative;\n    display: grid;\n    height: 166px;\n    place-items: center;\n    overflow: hidden;\n  }\n\n  .mock-stage::after { position: absolute; inset: 0; background-image: radial-gradient(rgba(245,249,206,.13) .6px, transparent .6px); background-size: 8px 8px; opacity: .55; content: ''; }\n\n  .mock-transcript { display: flex; align-items: center; gap: 13px; }\n  .mock-video { position: relative; display: grid; width: 57px; height: 80px; place-items: center; border: 2px solid var(--orange); border-radius: 8px; background: var(--crimson); }\n  .mock-video i { width: 24px; height: 24px; color: var(--cream); }\n  .mock-video small { position: absolute; right: 6px; bottom: 5px; color: var(--orange); font-family: 'JetBrains Mono', monospace; font-size: 7px; }\n  .mock-arrow { width: 19px; color: var(--orange); }\n  .mock-paper { width: 122px; height: 86px; border: 2px solid var(--ink); border-radius: 8px; background: var(--cream); padding: 10px; }\n  .mock-paper-head { display: flex; justify-content: space-between; color: var(--tomato); font-family: 'JetBrains Mono', monospace; font-size: 7px; letter-spacing: .1em; text-transform: uppercase; }\n  .mock-lines { display: grid; gap: 8px; margin-top: 14px; }\n  .mock-lines span { height: 5px; border-radius: 999px; background: rgba(69,14,22,.67); }\n  .mock-lines span:nth-child(2) { width: 82%; background: rgba(69,14,22,.38); }\n  .mock-lines span:nth-child(3) { width: 63%; background: var(--tomato); }\n  .mock-lines span:nth-child(4) { width: 91%; background: rgba(69,14,22,.5); }\n\n  .mock-edits { display: grid; width: 215px; gap: 16px; }\n  .mock-edit-row { display: flex; align-items: center; gap: 10px; }\n  .mock-edit-row .line { display: block; height: 6px; border-radius: 999px; background: rgba(245,249,206,.8); }\n  .mock-edit-row:nth-child(1) .line { width: 143px; }\n  .mock-edit-row:nth-child(2) .line { width: 177px; background: rgba(245,249,206,.5); }\n  .mock-edit-row:nth-child(3) .line { width: 112px; background: var(--orange); }\n  .mock-edit-row i { width: 24px; height: 24px; border-radius: 6px; padding: 5px; }\n  .mock-edit-row:nth-child(1) i { background: var(--tomato); }\n  .mock-edit-row:nth-child(2) i { background: var(--teal); }\n  .mock-edit-row:nth-child(3) i { background: #3b82f6; }\n  .mock-edit-row i { color: var(--ink); }\n\n  .mock-words { max-width: 235px; color: var(--cream); font-size: 39px; line-height: .92; text-align: center; }\n  .mock-words .mark { border-radius: 5px; background: var(--orange); color: var(--ink); padding: 0 5px; }\n  .mock-dot { position: absolute; width: 7px; height: 7px; border-radius: 50%; background: var(--tomato); }\n  .mock-dot.left { left: 17%; bottom: 22%; background: var(--teal); }\n  .mock-dot.right { right: 18%; top: 22%; }\n\n  .mock-control { position: relative; padding-top: 43px; color: var(--cream); font-size: 37px; }\n  .mock-control .control-bar { position: absolute; top: 22px; left: 50%; display: flex; gap: 3px; border: 2px solid var(--ink); border-radius: 9px; background: #222632; padding: 4px; transform: translateX(-50%); }\n  .mock-control .control-bar i { width: 23px; height: 23px; padding: 5px; color: rgba(245,249,206,.55); }\n  .mock-control .control-bar i.active { border-radius: 5px; background: #3b82f6; color: var(--ink); }\n  .mock-control .selected { color: var(--cream); text-decoration: underline; text-decoration-color: #3b82f6; text-decoration-thickness: 4px; text-underline-offset: 7px; }\n  .mock-control .muted { color: rgba(245,249,206,.45); }\n\n  .feature-copy { margin-top: auto; border-top: 2px solid var(--ink); background: var(--cream); color: var(--ink); padding: 15px 16px 17px; }\n  .feature-heading { display: flex; align-items: baseline; gap: 9px; }\n  .feature-number { color: var(--tomato); font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700; }\n  .feature-title { font-size: 26px; line-height: .95; }\n  .feature-description { margin-top: 11px !important; color: var(--purple); font-size: 15px; line-height: 1.22; }\n  .feature-description strong { color: var(--ink); }\n  .feature-icon { float: right; width: 17px; margin-top: 3px; color: var(--ink); }\n\n  .seam.features-to-story {\n    right: 7%;\n    bottom: -22px;\n    width: 250px;\n    height: 116px;\n    border-right: 1px solid rgba(255,161,2,.9);\n    border-left: 1px solid rgba(67,46,111,.45);\n    background: var(--purple);\n    clip-path: polygon(0 0, 100% 18%, 77% 100%, 19% 84%);\n    opacity: .94;\n    animation: seam-drift 14s ease-in-out infinite alternate-reverse;\n  }\n\n  .seam.features-to-story::after { position: absolute; top: 21px; right: 12px; left: 30px; height: 1px; background: var(--orange); content: ''; transform: rotate(12deg); }\n\n  .story {\n    position: relative;\n    overflow: hidden;\n    border-top: 2px solid rgba(69,14,22,.2);\n    border-bottom: 2px solid rgba(69,14,22,.2);\n    background: var(--cream);\n    padding: 92px 56px 118px;\n  }\n\n  .story-heading { max-width: 940px; }\n  .story-heading .section-kicker { color: var(--tomato); }\n  .story-heading .section-title { font-size: clamp(70px, 8.4vw, 125px); }\n  .story-heading .second-line { color: var(--purple); }\n\n  .story-layout { display: grid; margin-top: 52px; grid-template-columns: 170px minmax(0, 1fr); gap: 44px; align-items: center; }\n  .story-steps { display: grid; gap: 28px; }\n  .story-step { display: flex; align-items: center; gap: 12px; color: rgba(69,14,22,.42); font-size: 17px; font-weight: 600; line-height: 1.05; }\n  .story-step.active { color: var(--ink); }\n  .step-dot { display: grid; width: 35px; height: 35px; flex: 0 0 auto; place-items: center; border: 1.5px solid rgba(69,14,22,.32); border-radius: 50%; font-family: 'JetBrains Mono', monospace; font-size: 9px; }\n  .story-step.active .step-dot { border-color: var(--orange); background: var(--orange); box-shadow: 0 0 0 6px rgba(255,161,2,.18); }\n\n  .story-panel {\n    position: relative;\n    min-height: 420px;\n    overflow: hidden;\n    border: 2px solid var(--orange);\n    border-radius: 21px;\n    background: var(--ink);\n    box-shadow: 7px 8px 0 rgba(69,14,22,.9);\n    color: var(--cream);\n    padding: 21px;\n  }\n\n  .story-panel::before { position: absolute; top: -30px; right: 13%; width: 190px; height: 540px; border: 1px solid rgba(255,161,2,.2); clip-path: polygon(28% 0, 100% 14%, 73% 100%, 0 85%); content: ''; transform: rotate(3deg); }\n  .story-panel::after { position: absolute; right: 31px; bottom: 27px; width: 240px; height: 1px; background: rgba(245,249,206,.18); content: ''; transform: rotate(-8deg); }\n  .story-panel-inner { position: relative; z-index: 2; display: flex; height: 100%; min-height: 376px; flex-direction: column; gap: 24px; }\n  .panel-header { display: flex; justify-content: space-between; align-items: center; }\n  .panel-label { color: var(--teal); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }\n  .panel-badge { border: 1px solid rgba(45,212,191,.55); border-radius: 99px; color: #9deee1; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .12em; padding: 8px 12px; text-transform: uppercase; }\n  .transcript-card { max-width: 710px; margin: auto; border: 2px solid var(--ink); border-radius: 15px; background: var(--cream); box-shadow: 7px 8px 0 rgba(0,0,0,.22); color: var(--ink); padding: 24px; }\n  .transcript-top { display: flex; justify-content: space-between; color: var(--tomato); font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: .14em; text-transform: uppercase; }\n  .transcript-copy { margin-top: 25px !important; font-size: 34px; line-height: 1.07; }\n  .transcript-copy span { display: inline-block; border-radius: 7px; padding: 1px 5px; }\n  .transcript-copy .zoom { background: rgba(59,130,246,.18); color: #2563eb; box-shadow: inset 0 0 0 1px #3b82f6; }\n  .transcript-copy .emphasis { background: rgba(221,85,51,.2); color: var(--crimson); box-shadow: inset 0 0 0 1px var(--tomato); }\n  .transcript-copy .sfx { background: rgba(45,212,191,.2); color: #087f77; box-shadow: inset 0 0 0 1px var(--teal); }\n  .mark-row { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 23px; }\n  .mark { border: 1px solid; border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: .1em; padding: 7px 9px; text-transform: uppercase; }\n  .mark.zoom { border-color: rgba(59,130,246,.7); color: #2563eb; background: rgba(59,130,246,.08); }\n  .mark.sfx { border-color: rgba(45,212,191,.7); color: #087f77; background: rgba(45,212,191,.08); }\n  .mark.emphasis { border-color: rgba(221,85,51,.7); color: var(--crimson); background: rgba(221,85,51,.08); }\n  .panel-footer { margin-top: auto; color: rgba(245,249,206,.45); font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .16em; text-align: center; text-transform: uppercase; }\n\n  .seam.story-to-cta {\n    left: -2%;\n    bottom: -1px;\n    width: 67%;\n    height: 128px;\n    background: var(--tomato);\n    clip-path: polygon(0 34%, 58% 0, 100% 100%, 0 100%);\n    animation: seam-drift 17s ease-in-out infinite alternate;\n  }\n\n  .seam.story-to-cta::after { position: absolute; top: 32px; right: 8%; left: 4%; height: 1px; background: var(--cream); content: ''; transform: rotate(9deg); transform-origin: left center; opacity: .58; }\n\n  .cta {\n    position: relative;\n    overflow: hidden;\n    min-height: 588px;\n    background: var(--tomato);\n    color: var(--ink);\n    padding: 112px 56px 116px;\n  }\n\n  .cta::before { position: absolute; top: 38px; right: 8%; width: 300px; height: 300px; border: 1px solid rgba(245,249,206,.3); border-radius: 50%; content: ''; }\n  .cta::after { position: absolute; top: 83px; right: 11.5%; width: 220px; height: 220px; border: 1px solid rgba(69,14,22,.22); border-radius: 50%; content: ''; }\n  .cta-field { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 62%, rgba(255,161,2,.26), transparent 38%); }\n  .cta-inner { position: relative; z-index: 2; max-width: 1180px; margin: 0 auto; text-align: center; }\n  .cta-kicker { font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }\n  .cta-title { max-width: 920px; margin: 22px auto 0 !important; font-size: clamp(68px, 8.2vw, 122px); line-height: .77; }\n  .cta .upload-zone { justify-content: flex-start; margin-top: 45px; border-color: rgba(69,14,22,.48); background: rgba(245,249,206,.17); box-shadow: 5px 6px 0 var(--ink); color: var(--ink); text-align: left; }\n  .cta .upload-zone:hover { border-color: var(--ink); background: rgba(255,161,2,.25); }\n  .cta .upload-meta { color: rgba(69,14,22,.55); }\n  .cta-note { margin-top: 22px !important; color: rgba(69,14,22,.65); font-size: 19px; }\n\n  .footer { border-top: 2px solid rgba(245,249,206,.2); background: var(--ink); color: var(--cream); padding: 26px 56px; }\n  .footer-inner { display: flex; max-width: 1280px; margin: 0 auto; align-items: center; justify-content: space-between; gap: 20px; }\n  .footer-brand { font-size: 24px; font-weight: 700; letter-spacing: -.07em; }\n  .footer-meta { color: rgba(245,249,206,.5); font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }\n\n  @keyframes editorial-back { from { transform: translate3d(0, 0, 0) rotate(-4deg); } to { transform: translate3d(-10px, 12px, 0) rotate(-2deg); } }\n  @keyframes editorial-front { from { transform: translate3d(0, 0, 0) rotate(4deg); } to { transform: translate3d(10px, -8px, 0) rotate(7deg); } }\n  @keyframes seam-drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(12px, -5px, 0); } }\n\n  @media (max-width: 900px) {\n    .nav-inner, .hero-inner, .features, .story, .cta, .footer { padding-left: 28px; padding-right: 28px; }\n    .hero-inner { grid-template-columns: 1fr; gap: 25px; padding-top: 132px; }\n    .hero-stage { width: min(430px, 100%); margin: 0 auto; transform: scale(.82); transform-origin: top center; }\n    .feature-grid { grid-template-columns: repeat(2, 1fr); }\n    .story-layout { grid-template-columns: 1fr; }\n    .story-steps { display: flex; justify-content: space-between; gap: 10px; }\n    .story-step { flex-direction: column; gap: 7px; text-align: center; }\n  }\n\n  @media (max-width: 580px) {\n    .nav-link { display: none; }\n    .nav-inner { height: 68px; padding: 0 18px; }\n    .hero-inner, .features, .story, .cta, .footer { padding-left: 18px; padding-right: 18px; }\n    .hero { min-height: 900px; }\n    .hero-inner { min-height: 900px; padding-top: 112px; }\n    .hero-title { font-size: 68px; }\n    .hero-description { font-size: 18px; }\n    .upload-zone { width: 100%; }\n    .hero-stage { margin-top: 10px; transform: scale(.72); }\n    .feature-grid { grid-template-columns: 1fr; }\n    .story-heading .section-title { font-size: 70px; }\n    .story-layout { margin-top: 36px; }\n    .story-steps { align-items: flex-start; }\n    .story-step { font-size: 12px; }\n    .step-dot { width: 30px; height: 30px; }\n    .story-panel { min-height: 410px; padding: 15px; }\n    .transcript-card { padding: 16px; }\n    .transcript-copy { font-size: 26px; }\n    .footer-inner { flex-wrap: wrap; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .field-plane, .seam { animation: none; }\n    .sign-in:hover { transform: none; }\n  }\n</style>\n<div class=\"editorial-page\" data-kid=\"1\" data-name=\"editorial page container\">\n    <header class=\"nav\" data-kid=\"1-1\" data-name=\"navigation header\">\n        <nav aria-label=\"Primary navigation\" class=\"nav-inner\" data-kid=\"1-1-1\" data-name=\"navigation bar\">\n            <a aria-label=\"YapCut home\" class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#product\">\n                <span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand mark icon\">\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    YapCut\n                </span>\n            </a>\n            <div class=\"nav-actions\" data-kid=\"1-1-1-2\" data-name=\"navigation action items\">\n                <a class=\"nav-link\" data-kid=\"1-1-1-2-1\" data-name=\"product link\" href=\"#features\">\n                    Product\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-1-2-2\" data-name=\"how it works link\" href=\"#how-it-works\">\n                    How it works\n                </a>\n                <button class=\"sign-in\" data-kid=\"1-1-1-2-3\" data-name=\"sign in button\" type=\"button\">\n                    Sign in\n                </button>\n            </div>\n        </nav>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"hero-title\" class=\"hero\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"product\">\n            <div aria-hidden=\"true\" class=\"hero-field\" data-kid=\"1-2-1-1\" data-name=\"hero field background container\">\n                <div class=\"field-plane back\" data-kid=\"1-2-1-1-1\" data-name=\"hero background plane\">\n                </div>\n                <div class=\"field-plane front\" data-kid=\"1-2-1-1-2\" data-name=\"hero background plane\">\n                </div>\n                <div class=\"hero-structure\" data-kid=\"1-2-1-1-3\" data-name=\"hero decorative structure\">\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"hero-spotlight\" data-kid=\"1-2-1-2\" data-name=\"hero spotlight effect\">\n            </div>\n            <div aria-hidden=\"true\" class=\"grain\" data-kid=\"1-2-1-3\" data-name=\"hero noise texture\">\n            </div>\n            <div class=\"hero-inner\" data-kid=\"1-2-1-4\" data-name=\"hero layout container\">\n                <div class=\"hero-copy\" data-kid=\"1-2-1-4-1\" data-name=\"hero copy content\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-1-4-1-1\" data-name=\"hero eyebrow\">\n                        <i data-kid=\"1-2-1-4-1-1-1\" data-lucide=\"sparkles\" data-name=\"hero eyebrow icon\">\n                        </i>\n                        <span data-kid=\"1-2-1-4-1-1-2\" data-name=\"hero eyebrow text\">\n                            AI-Powered\n                        </span>\n                    </div>\n                    <h1 class=\"display hero-title\" data-kid=\"1-2-1-4-1-2\" data-name=\"hero headline\" id=\"hero-title\">\n                        Edit talking\n                        <br data-kid=\"1-2-1-4-1-2-1\" data-name=\"headline line break\"/>\n                        head shorts\n                        <br data-kid=\"1-2-1-4-1-2-2\" data-name=\"headline line break\"/>\n                        <span class=\"orange\" data-kid=\"1-2-1-4-1-2-3\" data-name=\"headline accent text\">\n                            <span class=\"ten\" data-kid=\"1-2-1-4-1-2-3-1\" data-name=\"headline 10x multiplier\">\n                                10x\n                            </span>\n                            faster\n                        </span>\n                    </h1>\n                    <p class=\"hero-description\" data-kid=\"1-2-1-4-1-3\" data-name=\"hero description\">\n                        From raw talking head video to a post-ready Short in 1 click. Cut, caption, SFX, and more — so you can focus on building your personal brand.\n                    </p>\n                    <div aria-label=\"Upload and Try It For Free\" class=\"upload-zone\" data-kid=\"1-2-1-4-1-4\" data-name=\"hero upload area\" role=\"button\" tabindex=\"0\">\n                        <span class=\"upload-icon\" data-kid=\"1-2-1-4-1-4-1\" data-name=\"upload icon wrapper\">\n                            <i data-kid=\"1-2-1-4-1-4-1-1\" data-lucide=\"upload\" data-name=\"upload icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-1-4-1-4-2\" data-name=\"upload text container\">\n                            <span class=\"upload-title\" data-kid=\"1-2-1-4-1-4-2-1\" data-name=\"upload title\">\n                                Upload and Try It For Free\n                            </span>\n                            <span class=\"mono upload-meta\" data-kid=\"1-2-1-4-1-4-2-2\" data-name=\"upload meta text\">\n                                No login required\n                            </span>\n                        </span>\n                    </div>\n                </div>\n                <div aria-label=\"Before and after preview\" class=\"hero-stage\" data-kid=\"1-2-1-4-2\" data-name=\"before and after preview stage\">\n                    <div aria-hidden=\"true\" class=\"stage-construction\" data-kid=\"1-2-1-4-2-1\" data-name=\"preview stage construction\">\n                    </div>\n                    <div aria-hidden=\"true\" class=\"phone-plate\" data-kid=\"1-2-1-4-2-2\" data-name=\"phone display plate\">\n                    </div>\n                    <div class=\"phone before\" data-kid=\"1-2-1-4-2-3\" data-name=\"before phone preview\">\n                        <div class=\"phone-screen\" data-kid=\"1-2-1-4-2-3-1\" data-name=\"before phone screen\">\n                            <span class=\"phone-tag\" data-kid=\"1-2-1-4-2-3-1-1\" data-name=\"before tag\">\n                                Before\n                            </span>\n                            <span aria-hidden=\"true\" class=\"portrait\" data-kid=\"1-2-1-4-2-3-1-2\" data-name=\"before portrait graphic\">\n                            </span>\n                            <span aria-hidden=\"true\" class=\"phone-lines\" data-kid=\"1-2-1-4-2-3-1-3\" data-name=\"before phone lines\">\n                                <span data-kid=\"1-2-1-4-2-3-1-3-1\" data-name=\"before phone line\">\n                                </span>\n                                <span data-kid=\"1-2-1-4-2-3-1-3-2\" data-name=\"before phone line\">\n                                </span>\n                                <span data-kid=\"1-2-1-4-2-3-1-3-3\" data-name=\"before phone line\">\n                                </span>\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"phone after\" data-kid=\"1-2-1-4-2-4\" data-name=\"after phone preview\">\n                        <div class=\"phone-screen\" data-kid=\"1-2-1-4-2-4-1\" data-name=\"after phone screen\">\n                            <span class=\"phone-tag\" data-kid=\"1-2-1-4-2-4-1-1\" data-name=\"after tag\">\n                                After\n                            </span>\n                            <span aria-hidden=\"true\" class=\"portrait\" data-kid=\"1-2-1-4-2-4-1-2\" data-name=\"after portrait graphic\">\n                            </span>\n                            <span aria-hidden=\"true\" class=\"phone-lines\" data-kid=\"1-2-1-4-2-4-1-3\" data-name=\"after phone lines\">\n                                <span data-kid=\"1-2-1-4-2-4-1-3-1\" data-name=\"after phone line\">\n                                </span>\n                                <span data-kid=\"1-2-1-4-2-4-1-3-2\" data-name=\"after phone line\">\n                                </span>\n                                <span data-kid=\"1-2-1-4-2-4-1-3-3\" data-name=\"after phone line\">\n                                </span>\n                            </span>\n                        </div>\n                    </div>\n                    <button class=\"preview-switch\" data-kid=\"1-2-1-4-2-5\" data-name=\"ai preview toggle button\" type=\"button\">\n                        <i data-kid=\"1-2-1-4-2-5-1\" data-lucide=\"wand-2\" data-name=\"ai preview toggle icon\">\n                        </i>\n                        <span data-kid=\"1-2-1-4-2-5-2\" data-name=\"ai preview toggle text\">\n                            One AI click\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"seam hero-to-features\" data-kid=\"1-2-1-5\" data-name=\"hero to features section seam\">\n            </div>\n        </section>\n        <section aria-labelledby=\"features-title\" class=\"features\" data-kid=\"1-2-2\" data-name=\"features section\" id=\"features\">\n            <div class=\"section-inner\" data-kid=\"1-2-2-1\" data-name=\"features layout container\">\n                <p class=\"section-kicker\" data-kid=\"1-2-2-1-1\" data-name=\"section kicker\">\n                    The new way to edit talking-head Shorts\n                </p>\n                <h2 class=\"display section-title\" data-kid=\"1-2-2-1-2\" data-name=\"section title\" id=\"features-title\">\n                    Remove the slow, skippable parts —\n                    <span class=\"tomato\" data-kid=\"1-2-2-1-2-1\" data-name=\"section title accent text\">\n                        so you can shape the brand.\n                    </span>\n                </h2>\n                <div class=\"feature-grid\" data-kid=\"1-2-2-1-3\" data-name=\"feature cards grid\">\n                    <article class=\"feature-card\" data-kid=\"1-2-2-1-3-1\" data-name=\"feature card 1\">\n                        <div class=\"mock-stage\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"feature card mock stage\">\n                            <div class=\"mock-transcript\" data-kid=\"1-2-2-1-3-1-1-1\" data-name=\"mock transcript\">\n                                <div class=\"mock-video\" data-kid=\"1-2-2-1-3-1-1-1-1\" data-name=\"mock video preview\">\n                                    <i data-kid=\"1-2-2-1-3-1-1-1-1-1\" data-lucide=\"video\" data-name=\"mock video icon\">\n                                    </i>\n                                    <small data-kid=\"1-2-2-1-3-1-1-1-1-2\" data-name=\"mock duration text\">\n                                        9:16\n                                    </small>\n                                </div>\n                                <i class=\"mock-arrow\" data-kid=\"1-2-2-1-3-1-1-1-2\" data-lucide=\"arrow-right\" data-name=\"mock arrow icon\">\n                                </i>\n                                <div class=\"mock-paper\" data-kid=\"1-2-2-1-3-1-1-1-3\" data-name=\"mock transcript document\">\n                                    <div class=\"mock-paper-head\" data-kid=\"1-2-2-1-3-1-1-1-3-1\" data-name=\"mock doc header\">\n                                        <span data-kid=\"1-2-2-1-3-1-1-1-3-1-1\" data-name=\"mock doc label\">\n                                            transcript\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-3-1-1-1-3-1-2\" data-name=\"mock doc status\" style=\"color:rgba(69,14,22,.45)\">\n                                            ready\n                                        </span>\n                                    </div>\n                                    <div class=\"mock-lines\" data-kid=\"1-2-2-1-3-1-1-1-3-2\" data-name=\"mock doc content lines\">\n                                        <span data-kid=\"1-2-2-1-3-1-1-1-3-2-1\" data-name=\"mock line\">\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-3-1-1-1-3-2-2\" data-name=\"mock line\">\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-3-1-1-1-3-2-3\" data-name=\"mock line\">\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-3-1-1-1-3-2-4\" data-name=\"mock line\">\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"feature-copy\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"feature copy\">\n                            <div class=\"feature-heading\" data-kid=\"1-2-2-1-3-1-2-1\" data-name=\"feature heading\">\n                                <span class=\"feature-number\" data-kid=\"1-2-2-1-3-1-2-1-1\" data-name=\"feature number\">\n                                    01\n                                </span>\n                                <h3 class=\"feature-title\" data-kid=\"1-2-2-1-3-1-2-1-2\" data-name=\"feature title\">\n                                    Cut by deleting words\n                                </h3>\n                            </div>\n                            <p class=\"feature-description\" data-kid=\"1-2-2-1-3-1-2-2\" data-name=\"feature description\">\n                                <strong data-kid=\"1-2-2-1-3-1-2-2-1\" data-name=\"feature description bold text\">\n                                    Save hours of tedious timeline cutting.\n                                </strong>\n                                AI automatically cuts the gaps and retakes. Change the words, the video follows.\n                            </p>\n                            <i class=\"feature-icon\" data-kid=\"1-2-2-1-3-1-2-3\" data-lucide=\"align-left\" data-name=\"feature icon\">\n                            </i>\n                        </div>\n                    </article>\n                    <article class=\"feature-card\" data-kid=\"1-2-2-1-3-2\" data-name=\"feature card 2\">\n                        <div class=\"mock-stage\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"feature card mock stage\">\n                            <div class=\"mock-edits\" data-kid=\"1-2-2-1-3-2-1-1\" data-name=\"mock edits list\">\n                                <div class=\"mock-edit-row\" data-kid=\"1-2-2-1-3-2-1-1-1\" data-name=\"mock edit row\">\n                                    <span class=\"line\" data-kid=\"1-2-2-1-3-2-1-1-1-1\" data-name=\"mock edit line\">\n                                    </span>\n                                    <i data-kid=\"1-2-2-1-3-2-1-1-1-2\" data-lucide=\"type\" data-name=\"mock edit icon\">\n                                    </i>\n                                </div>\n                                <div class=\"mock-edit-row\" data-kid=\"1-2-2-1-3-2-1-1-2\" data-name=\"mock edit row\">\n                                    <span class=\"line\" data-kid=\"1-2-2-1-3-2-1-1-2-1\" data-name=\"mock edit line\">\n                                    </span>\n                                    <i data-kid=\"1-2-2-1-3-2-1-1-2-2\" data-lucide=\"volume-2\" data-name=\"mock edit icon\">\n                                    </i>\n                                </div>\n                                <div class=\"mock-edit-row\" data-kid=\"1-2-2-1-3-2-1-1-3\" data-name=\"mock edit row\">\n                                    <span class=\"line\" data-kid=\"1-2-2-1-3-2-1-1-3-1\" data-name=\"mock edit line\">\n                                    </span>\n                                    <i data-kid=\"1-2-2-1-3-2-1-1-3-2\" data-lucide=\"zoom-in\" data-name=\"mock edit icon\">\n                                    </i>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"feature-copy\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"feature copy\">\n                            <div class=\"feature-heading\" data-kid=\"1-2-2-1-3-2-2-1\" data-name=\"feature heading\">\n                                <span class=\"feature-number\" data-kid=\"1-2-2-1-3-2-2-1-1\" data-name=\"feature number\">\n                                    02\n                                </span>\n                                <h3 class=\"feature-title\" data-kid=\"1-2-2-1-3-2-2-1-2\" data-name=\"feature title\">\n                                    Looks directed on arrival\n                                </h3>\n                            </div>\n                            <p class=\"feature-description\" data-kid=\"1-2-2-1-3-2-2-2\" data-name=\"feature description\">\n                                <strong data-kid=\"1-2-2-1-3-2-2-2-1\" data-name=\"feature description bold text\">\n                                    Boost retention with a Short that already looks finished.\n                                </strong>\n                                Zooms, SFX, and overlays land on the words that matter.\n                            </p>\n                            <i class=\"feature-icon\" data-kid=\"1-2-2-1-3-2-2-3\" data-lucide=\"sparkles\" data-name=\"feature icon\">\n                            </i>\n                        </div>\n                    </article>\n                    <article class=\"feature-card\" data-kid=\"1-2-2-1-3-3\" data-name=\"feature card 3\">\n                        <div class=\"mock-stage\" data-kid=\"1-2-2-1-3-3-1\" data-name=\"feature card mock stage\">\n                            <span class=\"mock-dot left\" data-kid=\"1-2-2-1-3-3-1-1\" data-name=\"mock dot\">\n                            </span>\n                            <span class=\"mock-dot right\" data-kid=\"1-2-2-1-3-3-1-2\" data-name=\"mock dot\">\n                            </span>\n                            <p class=\"mock-words\" data-kid=\"1-2-2-1-3-3-1-3\" data-name=\"mock words\">\n                                Tap a\n                                <span class=\"mark\" data-kid=\"1-2-2-1-3-3-1-3-1\" data-name=\"mock word highlight\">\n                                    word\n                                </span>\n                                , place the edit\n                            </p>\n                        </div>\n                        <div class=\"feature-copy\" data-kid=\"1-2-2-1-3-3-2\" data-name=\"feature copy\">\n                            <div class=\"feature-heading\" data-kid=\"1-2-2-1-3-3-2-1\" data-name=\"feature heading\">\n                                <span class=\"feature-number\" data-kid=\"1-2-2-1-3-3-2-1-1\" data-name=\"feature number\">\n                                    03\n                                </span>\n                                <h3 class=\"feature-title\" data-kid=\"1-2-2-1-3-3-2-1-2\" data-name=\"feature title\">\n                                    Tap a word, place the edit\n                                </h3>\n                            </div>\n                            <p class=\"feature-description\" data-kid=\"1-2-2-1-3-3-2-2\" data-name=\"feature description\">\n                                <strong data-kid=\"1-2-2-1-3-3-2-2-1\" data-name=\"feature description bold text\">\n                                    Keep every edit tied to the timing of the words.\n                                </strong>\n                                The timeline’s still there; you just don’t have to live in it.\n                            </p>\n                            <i class=\"feature-icon\" data-kid=\"1-2-2-1-3-3-2-3\" data-lucide=\"text-cursor-input\" data-name=\"feature icon\">\n                            </i>\n                        </div>\n                    </article>\n                    <article class=\"feature-card\" data-kid=\"1-2-2-1-3-4\" data-name=\"feature card 4\">\n                        <div class=\"mock-stage\" data-kid=\"1-2-2-1-3-4-1\" data-name=\"feature card mock stage\">\n                            <div class=\"mock-control\" data-kid=\"1-2-2-1-3-4-1-1\" data-name=\"mock control bar container\">\n                                <div class=\"control-bar\" data-kid=\"1-2-2-1-3-4-1-1-1\" data-name=\"mock control bar\">\n                                    <i data-kid=\"1-2-2-1-3-4-1-1-1-1\" data-lucide=\"type\" data-name=\"mock control icon\">\n                                    </i>\n                                    <i data-kid=\"1-2-2-1-3-4-1-1-1-2\" data-lucide=\"volume-2\" data-name=\"mock control icon\">\n                                    </i>\n                                    <i class=\"active\" data-kid=\"1-2-2-1-3-4-1-1-1-3\" data-lucide=\"zoom-in\" data-name=\"mock control icon active\">\n                                    </i>\n                                    <i data-kid=\"1-2-2-1-3-4-1-1-1-4\" data-lucide=\"link-2\" data-name=\"mock control icon\">\n                                    </i>\n                                </div>\n                                <span class=\"muted\" data-kid=\"1-2-2-1-3-4-1-1-2\" data-name=\"mock text\">\n                                    the\n                                </span>\n                                <span class=\"selected\" data-kid=\"1-2-2-1-3-4-1-1-3\" data-name=\"mock selected text\">\n                                    three\n                                </span>\n                                <span class=\"muted\" data-kid=\"1-2-2-1-3-4-1-1-4\" data-name=\"mock text\">\n                                    tricks\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"feature-copy\" data-kid=\"1-2-2-1-3-4-2\" data-name=\"feature copy\">\n                            <div class=\"feature-heading\" data-kid=\"1-2-2-1-3-4-2-1\" data-name=\"feature heading\">\n                                <span class=\"feature-number\" data-kid=\"1-2-2-1-3-4-2-1-1\" data-name=\"feature number\">\n                                    04\n                                </span>\n                                <h3 class=\"feature-title\" data-kid=\"1-2-2-1-3-4-2-1-2\" data-name=\"feature title\">\n                                    Your brand stays yours\n                                </h3>\n                            </div>\n                            <p class=\"feature-description\" data-kid=\"1-2-2-1-3-4-2-2\" data-name=\"feature description\">\n                                <strong data-kid=\"1-2-2-1-3-4-2-2-1\" data-name=\"feature description bold text\">\n                                    The first pass is automatic.\n                                </strong>\n                                Nudge, swap, or undo anything until the look matches the brand you want.\n                            </p>\n                            <i class=\"feature-icon\" data-kid=\"1-2-2-1-3-4-2-3\" data-lucide=\"mouse-pointer-2\" data-name=\"feature icon\">\n                            </i>\n                        </div>\n                    </article>\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"seam features-to-story\" data-kid=\"1-2-2-2\" data-name=\"features to story section seam\">\n            </div>\n        </section>\n        <section aria-labelledby=\"how-title\" class=\"story\" data-kid=\"1-2-3\" data-name=\"story section\" id=\"how-it-works\">\n            <div class=\"section-inner\" data-kid=\"1-2-3-1\" data-name=\"story inner layout\">\n                <div class=\"story-heading\" data-kid=\"1-2-3-1-1\" data-name=\"story heading\">\n                    <p class=\"section-kicker\" data-kid=\"1-2-3-1-1-1\" data-name=\"section kicker\">\n                        From first click to ready post\n                    </p>\n                    <h2 class=\"display section-title\" data-kid=\"1-2-3-1-1-2\" data-name=\"section title\" id=\"how-title\">\n                        Four steps.\n                        <br data-kid=\"1-2-3-1-1-2-1\" data-name=\"title line break\"/>\n                        <span class=\"second-line\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"second title line\">\n                            That’s it.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"story-layout\" data-kid=\"1-2-3-1-2\" data-name=\"story layout grid\">\n                    <aside aria-label=\"How it works steps\" class=\"story-steps\" data-kid=\"1-2-3-1-2-1\" data-name=\"story steps\">\n                        <div class=\"story-step\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"story step 1\">\n                            <span class=\"step-dot\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"step dot\">\n                                01\n                            </span>\n                            <span data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"step text\">\n                                Drop it in\n                            </span>\n                        </div>\n                        <div class=\"story-step active\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"story step 2 active\">\n                            <span class=\"step-dot\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"step dot\">\n                                02\n                            </span>\n                            <span data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"step text\">\n                                Watch it in action\n                            </span>\n                        </div>\n                        <div class=\"story-step\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"story step 3\">\n                            <span class=\"step-dot\" data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"step dot\">\n                                03\n                            </span>\n                            <span data-kid=\"1-2-3-1-2-1-3-2\" data-name=\"step text\">\n                                Tweak it\n                            </span>\n                        </div>\n                        <div class=\"story-step\" data-kid=\"1-2-3-1-2-1-4\" data-name=\"story step 4\">\n                            <span class=\"step-dot\" data-kid=\"1-2-3-1-2-1-4-1\" data-name=\"step dot\">\n                                04\n                            </span>\n                            <span data-kid=\"1-2-3-1-2-1-4-2\" data-name=\"step text\">\n                                Share it\n                            </span>\n                        </div>\n                    </aside>\n                    <div class=\"story-panel\" data-kid=\"1-2-3-1-2-2\" data-name=\"story panel\">\n                        <div class=\"story-panel-inner\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"story panel inner container\">\n                            <div class=\"panel-header\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"panel header\">\n                                <span class=\"panel-label\" data-kid=\"1-2-3-1-2-2-1-1-1\" data-name=\"panel label\">\n                                    02 / watch it in action\n                                </span>\n                                <span class=\"panel-badge\" data-kid=\"1-2-3-1-2-2-1-1-2\" data-name=\"panel badge\">\n                                    AI Edits\n                                </span>\n                            </div>\n                            <div class=\"transcript-card\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"transcript card\">\n                                <div class=\"transcript-top\" data-kid=\"1-2-3-1-2-2-1-2-1\" data-name=\"transcript top\">\n                                    <span data-kid=\"1-2-3-1-2-2-1-2-1-1\" data-name=\"transcript label\">\n                                        transcript\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-1-2-1-2\" data-name=\"transcript time\" style=\"color:rgba(69,14,22,.4)\">\n                                        00:08\n                                    </span>\n                                </div>\n                                <p class=\"transcript-copy\" data-kid=\"1-2-3-1-2-2-1-2-2\" data-name=\"transcript copy\">\n                                    <span data-kid=\"1-2-3-1-2-2-1-2-2-1\" data-name=\"transcript word\">\n                                        The\n                                    </span>\n                                    <span class=\"zoom\" data-kid=\"1-2-3-1-2-2-1-2-2-2\" data-name=\"transcript word highlighted\">\n                                        idea\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-1-2-2-3\" data-name=\"transcript word\">\n                                        is\n                                    </span>\n                                    <span class=\"zoom\" data-kid=\"1-2-3-1-2-2-1-2-2-4\" data-name=\"transcript word highlighted\">\n                                        already\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-1-2-2-5\" data-name=\"transcript word\">\n                                        there.\n                                    </span>\n                                    <span data-kid=\"1-2-3-1-2-2-1-2-2-6\" data-name=\"transcript word\">\n                                        You just have to make\n                                    </span>\n                                    <span class=\"sfx\" data-kid=\"1-2-3-1-2-2-1-2-2-7\" data-name=\"transcript word highlighted\">\n                                        it land.\n                                    </span>\n                                </p>\n                                <div class=\"mark-row\" data-kid=\"1-2-3-1-2-2-1-2-3\" data-name=\"transcript marks\">\n                                    <span class=\"mark zoom\" data-kid=\"1-2-3-1-2-2-1-2-3-1\" data-name=\"mark zoom\">\n                                        zoom\n                                    </span>\n                                    <span class=\"mark sfx\" data-kid=\"1-2-3-1-2-2-1-2-3-2\" data-name=\"mark sfx\">\n                                        sfx\n                                    </span>\n                                    <span class=\"mark emphasis\" data-kid=\"1-2-3-1-2-2-1-2-3-3\" data-name=\"mark emphasis\">\n                                        emphasis\n                                    </span>\n                                </div>\n                            </div>\n                            <p class=\"panel-footer\" data-kid=\"1-2-3-1-2-2-1-3\" data-name=\"panel footer\">\n                                speech becomes a surface you can edit\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"seam story-to-cta\" data-kid=\"1-2-3-2\" data-name=\"story to cta section seam\">\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-title\" class=\"cta\" data-kid=\"1-2-4\" data-name=\"cta section\" id=\"cta\">\n            <div aria-hidden=\"true\" class=\"cta-field\" data-kid=\"1-2-4-1\" data-name=\"cta background field\">\n            </div>\n            <div class=\"cta-inner\" data-kid=\"1-2-4-2\" data-name=\"cta content inner\">\n                <p class=\"cta-kicker\" data-kid=\"1-2-4-2-1\" data-name=\"cta kicker\">\n                    Make the words do more\n                </p>\n                <h2 class=\"display cta-title\" data-kid=\"1-2-4-2-2\" data-name=\"cta title\" id=\"cta-title\">\n                    Your next Short is already in the transcript.\n                </h2>\n                <div aria-label=\"Upload and Try It For Free\" class=\"upload-zone\" data-kid=\"1-2-4-2-3\" data-name=\"cta upload area\" role=\"button\" tabindex=\"0\">\n                    <span class=\"upload-icon\" data-kid=\"1-2-4-2-3-1\" data-name=\"cta upload icon wrapper\">\n                        <i data-kid=\"1-2-4-2-3-1-1\" data-lucide=\"upload\" data-name=\"cta upload icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-4-2-3-2\" data-name=\"cta upload text container\">\n                        <span class=\"upload-title\" data-kid=\"1-2-4-2-3-2-1\" data-name=\"cta upload title\">\n                            Upload and Try It For Free\n                        </span>\n                        <span class=\"mono upload-meta\" data-kid=\"1-2-4-2-3-2-2\" data-name=\"cta upload meta\">\n                            No login required\n                        </span>\n                    </span>\n                </div>\n                <p class=\"cta-note\" data-kid=\"1-2-4-2-4\" data-name=\"cta note\">\n                    Designed for Vertical talking-head Shorts.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"footer-inner\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n            <span class=\"footer-brand\" data-kid=\"1-3-1-1\" data-name=\"footer brand name\">\n                YapCut\n            </span>\n            <span class=\"footer-meta\" data-kid=\"1-3-1-2\" data-name=\"footer tagline\">\n                Edit less. Say more.\n            </span>\n            <span class=\"footer-meta\" data-kid=\"1-3-1-3\" data-name=\"copyright notice\">\n                © 2026 YapCut\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
