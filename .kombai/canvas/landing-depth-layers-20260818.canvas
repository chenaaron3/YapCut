ta-name=\"text segment 2\">\n                                    three\n                                </span>\n                                <span class=\"rounded-[4px] bg-[#FFA102] px-1 text-[#450E16]\" data-kid=\"1-2-2-2-2-3-1-2-3\" data-name=\"text segment highlight\">\n                                    tricks\n                                </span>\n                                <span data-kid=\"1-2-2-2-2-3-1-2-4\" data-name=\"text segment 3\">\n                                    that\n                                </span>\n                                <span class=\"text-[#DD5533]\" data-kid=\"1-2-2-2-2-3-1-2-5\" data-name=\"text segment 4\">\n                                    land.\n                                </span>\n                            </p>\n                            <span class=\"absolute right-[18%] bottom-[28%] size-1.5 rounded-full bg-[#DD5533]\" data-kid=\"1-2-2-2-2-3-1-3\" data-name=\"feature 3 dot indicator 2\">\n                            </span>\n                        </div>\n                        <div class=\"border-t-2 border-[#450E16] bg-[#F5F9CE] px-4 py-4 text-[#450E16]\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"feature 3 bottom content\">\n                            <div class=\"flex items-baseline gap-2\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"feature 3 title group\">\n                                <span class=\"quiet-mono text-[10px] font-bold text-[#DD5533]\" data-kid=\"1-2-2-2-2-3-2-1-1\" data-name=\"feature 3 index\">\n                                    03\n                                </span>\n                                <h3 class=\"quiet-display m-0 text-2xl leading-tight\" data-kid=\"1-2-2-2-2-3-2-1-2\" data-name=\"feature 3 headline\">\n                                    Tap a word, place the edit\n                                </h3>\n                            </div>\n                            <p class=\"m-0 mt-2 text-base leading-snug text-[#432E6F]\" data-kid=\"1-2-2-2-2-3-2-2\" 