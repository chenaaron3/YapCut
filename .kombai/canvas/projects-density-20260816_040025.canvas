      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  .projects-page {\n    --cream: #f5f9ce;\n    --ink: #450e16;\n    --purple: #432e6f;\n    --orange: #ffa102;\n    --tomato: #dd5533;\n    --crimson: #bc2d29;\n    --soft-cream: #ecefc0;\n    min-height: 100vh;\n    background: var(--cream);\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .projects-page .mono {\n    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  .projects-page .display {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-weight: 700;\n    letter-spacing: -0.065em;\n  }\n\n  .projects-page .grain {\n    background-image: radial-gradient(rgba(69, 14, 22, 0.08) 0.65px, transparent 0.65px);\n    background-size: 8px 8px;\n  }\n</style>\n<div class=\"projects-page relative overflow-x-hidden selection:bg-[#FFA102] selection:text-[#450E16]\" data-kid=\"1\" data-name=\"projects page layout\">\n    <div aria-hidden=\"true\" class=\"grain pointer-events-none fixed inset-0 z-0 opacity-25\" data-kid=\"1-1\" data-name=\"background noise texture\">\n    </div>\n    <header class=\"relative z-20 border-b border-[#F5F9CE]/20 bg-[#BC2D29] text-[#F5F9CE]\" data-kid=\"1-2\" data-name=\"header section\">\n        <nav aria-label=\"Primary navigation\" class=\"mx-auto flex h-[92px] max-w-[1280px] items-center justify-between gap-6 px-6 sm:px-8 lg:px-10\" data-kid=\"1-2-1\" data-name=\"navigation bar\">\n            <a aria-label=\"YapCut projects\" class=\"group inline-flex items-center gap-3 rounded-[12px] outline-none focus-visible:ring-3 focus-visible:ring-[#FFA102] focus-visible:ring-offset-3 focus-visible:ring-offset-[#BC2D29]\" data-kid=\"1-2-1-1\" data-name=\"app logo and name link\" href=\"#projects\">\n                <span class=\"grid size-11 -rotate-6 place-items-center rounded-[10px