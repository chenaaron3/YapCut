      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n  .font-ember-display { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; letter-spacing: -0.055em; }\n  .font-ember-body { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .font-ember-mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }\n</style>\n<div class=\"relative min-h-screen overflow-x-hidden bg-[#F5F9CE] text-[#450E16] selection:bg-[#FFA102] selection:text-[#450E16]\" data-kid=\"1\" data-name=\"page background container\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 opacity-30 [background-image:radial-gradient(rgba(69,14,22,.16)_0.65px,transparent_0.65px)] [background-size:8px_8px]\" data-kid=\"1-1\" data-name=\"background pattern overlay\">\n    </div>\n    <header class=\"relative z-10 border-b border-[#F5F9CE]/20 bg-[#BC2D29] text-[#F5F9CE]\" data-kid=\"1-2\" data-name=\"header navigation container\">\n        <nav aria-label=\"Primary navigation\" class=\"mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-6 py-5 sm:px-10 lg:px-14\" data-kid=\"1-2-1\" data-name=\"navigation bar\">\n            <a aria-label=\"YapCut home\" class=\"group inline-flex items-center gap-3 rounded-[10px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#BC2D29]\" data-kid=\"1-2-1-1\" data-name=\"home link\" href=\"#projects\">\n                <span class=\"grid h-10 w-10 -rotate-6 place-items-center rounded-[10px] border-2 border-[#450E16] bg-[#FFA102] text-[15px] font-bold text-[#450E16] shadow-[4px_4px_0_#450E16] transition-[transform,box-shadow] duration-200 group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:shadow-[2px_2px_0_#450E16]\" data-kid=\"1-2-1-1-1\" data-name=\"logo acronym icon\">\n                    YC\n                </span>\n                <span class=\"font-ember-display text-[26px] leading-none tracking-[-0.04em]\" data-kid=\"1-2-1-1-2\" data-name=\"logo text\">\n                    YapCut\n                </span>\n            </a>\n            <button aria-label=\"Open account menu\" class=\"group relative size-11 overflow-hidden rounded-full border-2 border-[#450E16] bg-[#FFA102] text-sm font-bold text-[#450E16] shadow-[3px_3px_0_#450E16] outline-none transition-[transform,box-shadow] duration-200 hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[1px_1px_0_#450E16] focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#BC2D29]\" data-kid=\"1-2-1-2\" data-name=\"account menu button\" type=\"button\">\n                <img alt=\"Account avatar\" class=\"size-full object-cover\" data-kid=\"1-2-1-2-1\" data-name=\"account avatar image\" decoding=\"async\" height=\"88\" loading=\"lazy\" src=\"https://i.pravatar.cc/88?img=12\" width=\"88\"/>\n            </button>\n        </nav>\n    </header>\n    <main class=\"relative z-10 mx-auto max-w-[1280px] px-6 pb-20 sm:px-10 lg:px-14\" data-kid=\"1-3\" data-name=\"projects main section\" id=\"projects\">\n        <section aria-labelledby=\"projects-title\" class=\"pt-9 sm:pt-11 lg:pt-12\" data-kid=\"1-3-1\" data-name=\"projects header section\">\n            <div class=\"flex flex-col gap-7 border-b border-[#450E16]/20 pb-7 sm:flex-row sm:items-end sm:justify-between sm:gap-8\" data-kid=\"1-3-1-1\" data-name=\"projects info and actions container\">\n                <div class=\"min-w-0\" data-kid=\"1-3-1-1-1\" data-name=\"projects summary container\">\n                    <p class=\"font-ember-mono mb-2 text-[10px] font-semibold tracking-[.22em] text-[#DD5533] uppercase\" data-kid=\"1-3-1-1-1-1\" data-name=\"section library label\">\n                        Library\n                    </p>\n                    <h1 class=\"font-ember-display m-0 text-[clamp(3.8rem,7vw,6.8rem)] leading-[.78]\" data-kid=\"1-3-1-1-1-2\" data-name=\"projects page title\" id=\"projects-title\">\n                        Projects\n                    </h1>\n                    <p class=\"font-ember-body mt-3 text-[17px] leading-none text-[#432E6F]\" data-kid=\"1-3-1-1-1-3\" data-name=\"projects count and description\">\n                        12 projects\n                        <span class=\"mx-2 text-[#DD5533]\" data-kid=\"1-3-1-1-1-3-1\" data-name=\"count separator dot\">\n                            ·\n                        </span>\n                        your recent edits, in one place\n                    </p>\n                </div>\n                <div class=\"flex shrink-0 flex-wrap items-center gap-3\" data-kid=\"1-3-1-1-2\" data-name=\"header action buttons container\">\n                    <div aria-label=\"Project view\" class=\"flex items-center rounded-[14px] border border-[#450E16]/35 bg-[#F5F9CE]/70 p-1 shadow-[0_6px_18px_rgba(69,14,22,.07)]\" data-kid=\"1-3-1-1-2-1\" data-name=\"view toggle group\" role=\"group\">\n                        <button aria-label=\"Grid view\" aria-pressed=\"true\" class=\"grid size-9 place-items-center rounded-[10px] bg-[#450E16] text-[#F5F9CE] outline-none focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"grid view button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-1-1-2-1-1-1\" data-lucide=\"grid-2x2\" data-name=\"grid view icon\">\n                            </i>\n                        </button>\n                        <button aria-label=\"List view\" aria-pressed=\"false\" class=\"grid size-9 place-items-center rounded-[10px] text-[#432E6F] outline-none hover:bg-[#FFA102]/20 focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"list view button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-1-1-2-1-2-1\" data-lucide=\"list\" data-name=\"list view icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <button class=\"inline-flex h-12 items-center gap-2 rounded-[16px] border-2 border-[#450E16] bg-[#FFA102] px-5 font-ember-body text-[18px] font-semibold text-[#450E16] shadow-[0_10px_22px_rgba(69,14,22,.18)] outline-none transition-[transform,box-shadow,background-color] duration-200 hover:-translate-y-0.5 hover:bg-[#ffad1f] hover:shadow-[0_14px_28px_rgba(69,14,22,.22)] focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-1-2-2\" data-name=\"new project button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"size-5\" data-kid=\"1-3-1-1-2-2-1\" data-lucide=\"plus\" data-name=\"plus icon\">\n                        </i>\n                        New project\n                    </button>\n                </div>\n            </div>\n            <div aria-label=\"Project filters\" class=\"flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-[#450E16]/20 py-4\" data-kid=\"1-3-1-2\" data-name=\"project filter bar\">\n                <div class=\"flex flex-wrap items-center gap-5 font-ember-mono text-[11px] font-semibold tracking-[.08em] uppercase\" data-kid=\"1-3-1-2-1\" data-name=\"filter tabs group\">\n                    <button aria-pressed=\"true\" class=\"relative pb-1 text-[#450E16] outline-none after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:bg-[#FFA102] focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-2-1-1\" data-name=\"recent filter tab\" type=\"button\">\n                        Recent\n                    </button>\n                    <button aria-pressed=\"false\" class=\"pb-1 text-[#432E6F]/65 outline-none hover:text-[#450E16] focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-2-1-2\" data-name=\"published filter tab\" type=\"button\">\n                        Published\n                    </button>\n                    <button aria-pressed=\"false\" class=\"pb-1 text-[#432E6F]/65 outline-none hover:text-[#450E16] focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-2-1-3\" data-name=\"in progress filter tab\" type=\"button\">\n                        In progress\n                    </button>\n                </div>\n                <div class=\"ml-auto flex flex-wrap items-center gap-3 font-ember-mono text-[10px] font-semibold tracking-[.06em] uppercase\" data-kid=\"1-3-1-2-2\" data-name=\"sort and search container\">\n                    <button aria-label=\"Search projects\" class=\"inline-flex items-center gap-2 rounded-full border border-[#450E16]/30 bg-[#F5F9CE]/60 px-3 py-2 text-[#432E6F] outline-none hover:border-[#450E16] hover:text-[#450E16] focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-2-2-1\" data-name=\"search button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"size-3.5\" data-kid=\"1-3-1-2-2-1-1\" data-lucide=\"search\" data-name=\"search icon\">\n                        </i>\n                        Search\n                    </button>\n                    <button class=\"inline-flex items-center gap-2 rounded-full border border-[#450E16]/30 bg-[#F5F9CE]/60 px-3 py-2 text-[#432E6F] outline-none hover:border-[#450E16] hover:text-[#450E16] focus-visible:ring-2 focus-visible:ring-[#FFA102] focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F9CE]\" data-kid=\"1-3-1-2-2-2\" data-name=\"sort button\" type=\"button\">\n                        Sort: Updated\n                        <span aria-hidden=\"true\" class=\"text-[#DD5533]\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"sort arrow icon\">\n                            ↕\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"recent-title\" class=\"pt-8\" data-kid=\"1-3-2\" data-name=\"recent work section\">\n            <div class=\"mb-4 flex items-end justify-between gap-4\" data-kid=\"1-3-2-1\" data-name=\"recent work title container\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"recent work section label\">\n                    <p class=\"font-ember-mono mb-1 text-[10px] font-semibold tracking-[.18em] text-[#DD5533] uppercase\" data-kid=\"1-3-2-1-1-1\" data-name=\"recent work eyebrow label\">\n                        Your edit desk\n                    </p>\n                    <h2 class=\"font-ember-display m-0 text-4xl leading-none sm:text-5xl\" data-kid=\"1-3-2-1-1-2\" data-name=\"recent work heading\" id=\"recent-title\">\n                        Recent work\n                    </h2>\n                </div>\n                <div aria-hidden=\"true\" class=\"hidden items-center gap-1.5 pb-1 sm:flex\" data-kid=\"1-3-2-1-2\" data-name=\"decorative line elements container\">\n                    <span class=\"h-1.5 w-8 -rotate-3 rounded-full bg-[#FFA102]\" data-kid=\"1-3-2-1-2-1\" data-name=\"decorative line\">\n                    </span>\n                    <span class=\"h-1.5 w-4 rotate-3 rounded-full bg-[#DD5533]\" data-kid=\"1-3-2-1-2-2\" data-name=\"decorative line\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-1 gap-4 md:grid-cols-12 lg:gap-5\" data-kid=\"1-3-2-2\" data-name=\"recent project cards grid\">\n                <article class=\"group overflow-hidden rounded-[24px] border-2 border-[#450E16] bg-[#F5F9CE] shadow-[0_14px_34px_rgba(69,14,22,.13)] transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(69,14,22,.18)] md:col-span-6\" data-kid=\"1-3-2-2-1\" data-name=\"primary project card\">\n                    <div class=\"relative h-[230px] overflow-hidden sm:h-[255px]\" data-kid=\"1-3-2-2-1-1\" data-name=\"project card media container\">\n                        <img alt=\"Top Three Video Editing Tricks video thumbnail, Benjamin Dominguez on Pexels\" class=\"size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"project card thumbnail image\" decoding=\"async\" height=\"800\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14772071/pexels-photo-14772071.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\" width=\"1200\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#450E16]/70 via-transparent to-[#450E16]/10\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"card image gradient overlay\">\n                        </div>\n                        <div class=\"absolute inset-x-5 top-5 flex items-center justify-between gap-3\" data-kid=\"1-3-2-2-1-1-3\" data-name=\"project card header tags\">\n                            <span class=\"font-ember-mono rounded-full border border-[#F5F9CE]/70 bg-[#F5F9CE] px-3 py-1 text-[10px] font-semibold tracking-[.08em] text-[#450E16] uppercase\" data-kid=\"1-3-2-2-1-1-3-1\" data-name=\"project card status tag\">\n                                Ready\n                            </span>\n                            <span class=\"font-ember-mono text-[10px] font-semibold tracking-[.14em] text-[#F5F9CE]/80 uppercase\" data-kid=\"1-3-2-2-1-1-3-2\" data-name=\"project card series tag\">\n                                Featured 01\n                            </span>\n                        </div>\n                        <div class=\"absolute inset-x-5 bottom-5 flex items-end justify-between