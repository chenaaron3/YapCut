      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  .projects-page {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    background: #F5F9CE;\n    color: #450E16;\n  }\n  .projects-page .mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace; }\n  .projects-page .display { font-weight: 700; letter-spacing: -0.065em; }\n  .projects-page .grain {\n    background-image: radial-gradient(rgba(69,14,22,.12) .6px, transparent .6px);\n    background-size: 8px 8px;\n  }\n  .projects-page .soft-shadow { box-shadow: 0 8px 24px rgba(69,14,22,.12); }\n  .projects-page .lift-shadow { box-shadow: 0 16px 36px rgba(69,14,22,.16); }\n  .projects-page .focus-ring:focus-visible { outline: 3px solid #FFA102; outline-offset: 3px; }\n  .projects-page .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }\n  .projects-page .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n</style>\n<div class=\"projects-page min-h-[100dvh] overflow-x-hidden\" data-kid=\"1\" data-name=\"projects page container\">\n    <div aria-hidden=\"true\" class=\"grain pointer-events-none fixed inset-0 z-0 opacity-30\" data-kid=\"1-1\" data-name=\"background noise texture overlay\">\n    </div>\n    <header class=\"relative z-20 border-b border-[#F5F9CE]/20 bg-[#BC2D29] text-[#F5F9CE]\" data-kid=\"1-2\" data-name=\"header container\">\n        <nav aria-label=\"Primary navigation\" class=\"mx-auto flex max-w-[1280px] items-center justify-between px-6 py-4 sm:px-10 lg:px-14\" data-kid=\"1-2-1\" data-name=\"navigation bar\">\n            <a aria-label=\"YapCut projects\" class=\"focus-ring flex items-center gap-3 no-underline\" data-kid=\"1-2-1-1\" data-name=\"logo and brand link\" href=\"#projects\">\n                <span class=\"grid size-10 -rotate-6 place-items-center rounded-[10px] border-2 border-[#450E16] bg-[#FFA102] text-base font-bold text-[#450E16] shadow-[3px_4px_0_#450E16]\" data-kid=\"1-2-1-1-1\" data-name=\"brand initials icon\">\n                    YC\n                </span>\n                <span class=\"text-[23px] font-semibold leading-none tracking-[-.03em]\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text\">\n                    YapCut\n                </span>\n            </a>\n            <div class=\"flex items-center gap-4 sm:gap-6\" data-kid=\"1-2-1-2\" data-name=\"account management section\">\n                <span class=\"mono hidden text-[10px] font-medium tracking-[.16em] text-[#F5F9CE]/70 uppercase sm:inline\" data-kid=\"1-2-1-2-1\" data-name=\"workspace status label\">\n                    Creator workspace\n                </span>\n                <button aria-label=\"Open account menu\" class=\"focus-ring grid size-10 place-items-center overflow-hidden rounded-full border-2 border-[#450E16] bg-[#FFA102] text-xs font-semibold text-[#450E16] shadow-[3px_3px_0_#450E16] transition-transform hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none\" data-kid=\"1-2-1-2-2\" data-name=\"account menu trigger button\" type=\"button\">\n                    <span aria-hidden=\"true\" data-kid=\"1-2-1-2-2-1\" data-name=\"user initials label\">\n                        AM\n                    </span>\n                </button>\n            </div>\n        </nav>\n    </header>\n    <main class=\"relative z-10 mx-auto max-w-[1280px] px-6 pb-16 pt-8 sm:px-10 sm:pt-10 lg:px-14 lg:pt-12\" data-kid=\"1-3\" data-name=\"projects content area\" id=\"projects\">\n        <section aria-labelledby=\"projects-title\" data-kid=\"1-3-1\" data-name=\"page intro section\">\n            <div class=\"flex flex-col gap-5 border-b border-[#450E16]/15 pb-7 sm:flex-row sm:items-end sm:justify-between sm:gap-8\" data-kid=\"1-3-1-1\" data-name=\"intro content wrapper\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"intro text container\">\n                    <div class=\"mb-2 flex items-center gap-3\" data-kid=\"1-3-1-1-1-1\" data-name=\"meta info container\">\n                        <span class=\"mono text-[10px] font-semibold tracking-[.2em] text-[#DD5533] uppercase\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"page category label\">\n                            Library\n                        </span>\n                        <span aria-hidden=\"true\" class=\"h-px w-10 bg-[#DD5533]/45\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"horizontal spacer\">\n                        </span>\n                        <span class=\"mono text-[10px] tracking-[.12em] text-[#432E6F]/75 uppercase\" data-kid=\"1-3-1-1-1-1-3\" data-name=\"project count label\">\n                            12 projects\n                        </span>\n                    </div>\n                    <h1 class=\"display m-0 text-[clamp(3.5rem,7vw,6.6rem)] leading-[.78]\" data-kid=\"1-3-1-1-1-2\" data-name=\"page title\" id=\"projects-title\">\n                        Projects\n                    </h1>\n                    <p class=\"mt-3 max-w-[42ch] text-[17px] leading-tight text-[#432E6F]\" data-kid=\"1-3-1-1-1-3\" data-name=\"page description text\">\n                        The edits you are shaping, publishing, and ready to pick back up.\n                    </p>\n                </div>\n                <button aria-label=\"Create a new project\" class=\"focus-ring mono inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-[16px] border-2 border-[#450E16] bg-[#FFA102] px-5 text-[11px] font-semibold tracking-[.04em] text-[#450E16] shadow-[0_5px_0_#450E16] transition-transform hover:translate-y-0.5 hover:shadow-[0_3px_0_#450E16] active:translate-y-1 active:shadow-none sm:mb-1\" data-kid=\"1-3-1-1-2\" data-name=\"create new project button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-1-1-2-1\" data-lucide=\"plus\" data-name=\"plus icon\">\n                    </i>\n                    New project\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"Continue editing and workflow summary\" class=\"mt-7 grid gap-5 lg:grid-cols-12\" data-kid=\"1-3-2\" data-name=\"workflow summary section\">\n            <article class=\"group relative overflow-hidden rounded-[24px] border-2 border-[#450E16] bg-[#450E16] text-[#F5F9CE] lift-shadow lg:col-span-8\" data-kid=\"1-3-2-1\" data-name=\"featured project card\">\n                <div class=\"grid min-h-[285px] grid-cols-1 md:grid-cols-[1.22fr_.78fr]\" data-kid=\"1-3-2-1-1\" data-name=\"featured project layout container\">\n                    <div class=\"relative min-h-[230px] overflow-hidden md:min-h-0\" data-kid=\"1-3-2-1-1-1\" data-name=\"featured image area\">\n                        <img alt=\"Creator speaking into a microphone at a home studio, photographed by Benjamin Dominguez on Pexels\" class=\"absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"featured project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14772072/pexels-photo-14772072.jpeg?auto=compress&cs=tinysrgb&w=1400&q=80\"/>\n                        <div class=\"absolute inset-0 bg-[linear-gradient(120deg,rgba(69,14,22,.78),rgba(69,14,22,.16)_60%,rgba(255,161,2,.18))]\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"image gradient overlay\">\n                        </div>\n                        <div class=\"absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#450E16] to-transparent\" data-kid=\"1-3-2-1-1-1-3\" data-name=\"bottom fade gradient\">\n                        </div>\n                        <div class=\"absolute top-4 left-4 flex items-center gap-2\" data-kid=\"1-3-2-1-1-1-4\" data-name=\"image badge container\">\n                            <span class=\"mono rounded-full border border-[#450E16] bg-[#F5F9CE] px-2.5 py-1 text-[10px] font-semibold tracking-[.12em] text-[#450E16] uppercase\" data-kid=\"1-3-2-1-1-1-4-1\" data-name=\"status badge\">\n                                Ready\n                            </span>\n                            <span class=\"mono rounded-full border border-[#F5F9CE]/50 bg-[#450E16]/40 px-2.5 py-1 text-[10px] tracking-[.1em] text-[#F5F9CE] uppercase\" data-kid=\"1-3-2-1-1-1-4-2\" data-name=\"aspect ratio label\">\n                                9:16\n                            </span>\n                        </div>\n                        <div class=\"absolute bottom-4 left-4 right-4 flex items-end justify-between gap-3\" data-kid=\"1-3-2-1-1-1-5\" data-name=\"image bottom controls\">\n                            <div data-kid=\"1-3-2-1-1-1-5-1\" data-name=\"project metadata container\">\n                                <p class=\"mono mb-2 text-[10px] tracking-[.18em] text-[#FFA102] uppercase\" data-kid=\"1-3-2-1-1-1-5-1-1\" data-name=\"sub-header label\">\n                                    Continue editing\n                                </p>\n                                <h2 class=\"display m-0 max-w-[13ch] text-[clamp(2rem,3.6vw,3.4rem)] leading-[.84]\" data-kid=\"1-3-2-1-1-1-5-1-2\" data-name=\"featured project title\">\n                                    Top Three Video Editing Tricks\n                                </h2>\n                            </div>\n                            <button aria-label=\"Play Top Three Video Editing Tricks\" class=\"focus-ring grid size-12 shrink-0 place-items-center rounded-full border-2 border-[#450E16] bg-[#FFA102] text-[#450E16] shadow-[0_4px_0_#450E16] transition-transform hover:scale-105\" data-kid=\"1-3-2-1-1-1-5-2\" data-name=\"play project button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ml-0.5 size-5 fill-current\" data-kid=\"1-3-2-1-1-1-5-2-1\" data-lucide=\"play\" data-name=\"play icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col justify-between bg-[#F5F9CE] p-5 text-[#450E16] md:p-6\" data-kid=\"1-3-2-1-1-2\" data-name=\"project status info container\">\n                        <div data-kid=\"1-3-2-1-1-2-1\" data-name=\"activity info wrapper\">\n                            <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-3-2-1-1-2-1-1\" data-name=\"last opened label container\">\n                                <span class=\"mono text-[10px] tracking-[.14em] text-[#432E6F]/75 uppercase\" data-kid=\"1-3-2-1-1-2-1-1-1\" data-name=\"last opened label\">\n                                    Last opened\n                                </span>\n                                <span class=\"mono text-[10px] font-semibold tracking-[.14em] text-[#DD5533] uppercase\" data-kid=\"1-3-2-1-1-2-1-1-2\" data-name=\"last opened time\">\n                                    3h ago\n                                </span>\n                            </div>\n                            <p class=\"m-0 max-w-[28ch] text-[18px] leading-tight text-[#432E6F]\" data-kid=\"1-3-2-1-1-2-1-2\" data-name=\"project progress description\">\n                                Your latest cut is ready for one more pass before you send it out.\n                            </p>\n                        </div>\n                        <div class=\"mt-8 border-t border-[#450E16]/15 pt-4\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"progress footer container\">\n                            <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-3-2-1-1-2-2-1\" data-name=\"footer info row\">\n                                <div class=\"flex items-center gap-2 text-[#432E6F]\" data-kid=\"1-3-2-1-1-2-2-1-1\" data-name=\"project duration indicator\">\n                                    <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-2-1-1-2-2-1-1-1\" data-lucide=\"clock\" data-name=\"clock icon\">\n                                    </i>\n                                    <span class=\"mono text-[10px] tracking-[.1em] uppercase\" data-kid=\"1-3-2-1-1-2-2-1-1-2\" data-name=\"duration text\">\n                                        7 min project\n                                    </span>\n                                </div>\n                                <span class=\"mono text-[10px] font-semibold tracking-[.1em] text-[#432E6F] uppercase\" data-kid=\"1-3-2-1-1-2-2-1-2\" data-name=\"open edit label\">\n                                    Open edit\n                                </span>\n                            </div>\n                            <div class=\"mt-3 h-1.5 overflow-hidden rounded-full bg-[#450E16]/10\" data-kid=\"1-3-2-1-1-2-2-2\" data-name=\"progress bar track\">\n                                <div class=\"h-full w-[72%] rounded-full bg-[#FFA102]\" data-kid=\"1-3-2-1-1-2-2-2-1\" data-name=\"progress bar fill\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </article>\n            <aside aria-labelledby=\"workflow-title\" class=\"rounded-[24px] border border-[#450E16] bg-[#F5F9CE] p-5 text-[#450E16] soft-shadow lg:col-span-4 lg:p-6\" data-kid=\"1-3-2-2\" data-name=\"workflow stats sidebar\">\n                <div class=\"flex items-start justify-between gap-3 border-b border-[#450E16]/15 pb-4\" data-kid=\"1-3-2-2-1\" data-name=\"sidebar header container\">\n                    <div data-kid=\"1-3-2-2-1-1\" data-name=\"sidebar title area\">\n                        <p class=\"mono mb-2 text-[10px] font-semibold tracking-[.18em] text-[#DD5533] uppercase\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"sidebar sub-header label\">\n                            At a glance\n                        </p>\n                        <h2 class=\"display m-0 text-3xl leading-none\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"sidebar main title\" id=\"workflow-title\">\n                            Your workflow\n                        </h2>\n                    </div>\n                    <i aria-hidden=\"true\" class=\"mt-1 size-5 text-[#FFA102]\" data-kid=\"1-3-2-2-1-2\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                    </i>\n                </div>\n                <div class=\"divide-y divide-[#450E16]/15\" data-kid=\"1-3-2-2-2\" data-name=\"stats list container\">\n                    <div class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"1-3-2-2-2-1\" data-name=\"stat item\">\n                        <div data-kid=\"1-3-2-2-2-1-1\" data-name=\"stat label container\">\n                            <p class=\"m-0 text-lg leading-none\" data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"stat title\">\n                                3 projects\n                            </p>\n                            <p class=\"mono mt-1.5 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-2-2-2-1-1-2\" data-name=\"stat description\">\n                                edited this week\n                            </p>\n                        </div>\n                        <span class=\"mono text-xl font-semibold text-[#432E6F]\" data-kid=\"1-3-2-2-2-1-2\" data-name=\"stat value\">\n                            +3\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"1-3-2-2-2-2\" data-name=\"stat item\">\n                        <div data-kid=\"1-3-2-2-2-2-1\" data-name=\"stat label container\">\n                            <p class=\"m-0 text-lg leading-none\" data-kid=\"1-3-2-2-2-2-1-1\" data-name=\"stat title\">\n                                Last opened\n                            </p>\n                            <p class=\"mono mt-1.5 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-2-2-2-2-1-2\" data-name=\"stat description\">\n                                Top Three Tricks\n                            </p>\n                        </div>\n                        <span class=\"mono text-[11px] font-semibold text-[#DD5533] uppercase\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"stat value\">\n                            3h ago\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-4 py-4\" data-kid=\"1-3-2-2-2-3\" data-name=\"stat item\">\n                        <div data-kid=\"1-3-2-2-2-3-1\" data-name=\"stat label container\">\n                            <p class=\"m-0 text-lg leading-none\" data-kid=\"1-3-2-2-2-3-1-1\" data-name=\"stat title\">\n                                Ready to publish\n                            </p>\n                            <p class=\"mono mt-1.5 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-2-2-2-3-1-2\" data-name=\"stat description\">\n                                finished edits\n                            </p>\n                        </div>\n                        <span class=\"mono text-xl font-semibold text-[#432E6F]\" data-kid=\"1-3-2-2-2-3-2\" data-name=\"stat value\">\n                            4\n                        </span>\n                    </div>\n                </div>\n                <a class=\"focus-ring mono mt-1 inline-flex items-center gap-2 text-[10px] font-semibold tracking-[.1em] text-[#432E6F] uppercase no-underline hover:text-[#DD5533]\" data-kid=\"1-3-2-2-3\" data-name=\"view all link\" href=\"#all-projects\">\n                    View all projects\n                    <i aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-3-2-2-3-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow icon\">\n                    </i>\n                </a>\n            </aside>\n        </section>\n        <section aria-labelledby=\"all-projects-title\" class=\"mt-8\" data-kid=\"1-3-3\" data-name=\"all projects section\" id=\"all-projects\">\n            <div class=\"flex flex-col gap-4 border-b border-[#450E16]/15 pb-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3-3-1\" data-name=\"all projects header container\">\n                <div class=\"flex items-baseline gap-3\" data-kid=\"1-3-3-1-1\" data-name=\"all projects title wrapper\">\n                    <h2 class=\"display m-0 text-4xl leading-none\" data-kid=\"1-3-3-1-1-1\" data-name=\"all projects title\" id=\"all-projects-title\">\n                        All projects\n                    </h2>\n                    <span class=\"mono text-[10px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-1-1-2\" data-name=\"all projects total count\">\n                        12 total\n                    </span>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-3-3-1-2\" data-name=\"view mode toggle container\">\n                    <button aria-pressed=\"true\" class=\"focus-ring mono inline-flex h-8 items-center gap-1.5 rounded-full border border-[#450E16] bg-[#450E16] px-3 text-[10px] font-semibold tracking-[.08em] text-[#F5F9CE] uppercase\" data-kid=\"1-3-3-1-2-1\" data-name=\"grid view button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"size-3.5\" data-kid=\"1-3-3-1-2-1-1\" data-lucide=\"grid-2x2\" data-name=\"grid icon\">\n                        </i>\n                        Grid\n                    </button>\n                    <button aria-pressed=\"false\" class=\"focus-ring mono inline-flex h-8 items-center gap-1.5 rounded-full border border-[#450E16]/25 bg-transparent px-3 text-[10px] tracking-[.08em] text-[#432E6F] uppercase hover:border-[#450E16]\" data-kid=\"1-3-3-1-2-2\" data-name=\"list view button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"size-3.5\" data-kid=\"1-3-3-1-2-2-1\" data-lucide=\"list\" data-name=\"list icon\">\n                        </i>\n                        List\n                    </button>\n                    <button class=\"focus-ring mono h-8 rounded-full border border-[#450E16]/25 bg-transparent px-3 text-[10px] tracking-[.08em] text-[#432E6F] uppercase hover:border-[#450E16]\" data-kid=\"1-3-3-1-2-3\" data-name=\"sort order button\" type=\"button\">\n                        Recent\n                    </button>\n                </div>\n            </div>\n            <div class=\"mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\" data-kid=\"1-3-3-2\" data-name=\"projects grid container\">\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-1\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#BC2D29]\" data-kid=\"1-3-3-2-1-1\" data-name=\"card image area\">\n                        <img alt=\"Creator recording beside a camera in a home studio, photographed by Alena Darmel on Pexels\" class=\"size-full object-cover transition-transform duration-500 group-hover:scale-105\" data-kid=\"1-3-3-2-1-1-1\" data-name=\"project card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9040531/pexels-photo-9040531.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#450E16]/65 to-transparent\" data-kid=\"1-3-3-2-1-1-2\" data-name=\"card image overlay\">\n                        </div>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#432E6F] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#F5F9CE] uppercase\" data-kid=\"1-3-3-2-1-1-3\" data-name=\"project status badge\">\n                            Published\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-1-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"project card title\">\n                            Tasting Expensive Japanese Food\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-1-2-2\" data-name=\"last updated label\">\n                            6h ago\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-2\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#DD5533]\" data-kid=\"1-3-3-2-2-1\" data-name=\"card image area\">\n                        <img alt=\"Video editor working at a dual-monitor desk, photographed by Ron Lach on Pexels\" class=\"size-full object-cover transition-transform duration-500 group-hover:scale-105\" data-kid=\"1-3-3-2-2-1-1\" data-name=\"project card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8100050/pexels-photo-8100050.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#450E16]/65 to-transparent\" data-kid=\"1-3-3-2-2-1-2\" data-name=\"card image overlay\">\n                        </div>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#FFA102] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#450E16] uppercase\" data-kid=\"1-3-3-2-2-1-3\" data-name=\"project status badge\">\n                            Ready\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-2-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"project card title\">\n                            Japanese Politeness Basics Explained\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-2-2-2\" data-name=\"last updated label\">\n                            1d ago\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-3\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#BC2D29]\" data-kid=\"1-3-3-2-3-1\" data-name=\"card image area\">\n                        <img alt=\"Creator filming a cooking video in a bright kitchen, photographed by Anna Shvets on Pexels\" class=\"size-full object-cover transition-transform duration-500 group-hover:scale-105\" data-kid=\"1-3-3-2-3-1-1\" data-name=\"project card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/12674044/pexels-photo-12674044.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#450E16]/65 to-transparent\" data-kid=\"1-3-3-2-3-1-2\" data-name=\"card image overlay\">\n                        </div>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#F5F9CE] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#450E16] uppercase\" data-kid=\"1-3-3-2-3-1-3\" data-name=\"project status badge\">\n                            Ready\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-3-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-3-2-1\" data-name=\"project card title\">\n                            Creator Q&A: Editing Faster\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-3-2-2\" data-name=\"last updated label\">\n                            2d ago\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-4\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#432E6F]\" data-kid=\"1-3-3-2-4-1\" data-name=\"card image area\">\n                        <img alt=\"Creator speaking into a microphone at a home studio, photographed by Benjamin Dominguez on Pexels\" class=\"size-full object-cover transition-transform duration-500 group-hover:scale-105\" data-kid=\"1-3-3-2-4-1-1\" data-name=\"project card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/14772072/pexels-photo-14772072.jpeg?auto=compress&cs=tinysrgb&w=1400&q=80\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[#450E16]/70 to-transparent\" data-kid=\"1-3-3-2-4-1-2\" data-name=\"card image overlay\">\n                        </div>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#432E6F] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#F5F9CE] uppercase\" data-kid=\"1-3-3-2-4-1-3\" data-name=\"project status badge\">\n                            Published\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-4-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-4-2-1\" data-name=\"project card title\">\n                            Five Cuts That Hold Attention\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-4-2-2\" data-name=\"last updated label\">\n                            4d ago\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-5\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#DD5533]\" data-kid=\"1-3-3-2-5-1\" data-name=\"card graphic area\">\n                        <div class=\"absolute inset-0 bg-[linear-gradient(135deg,#DD5533,#BC2D29_52%,#450E16)]\" data-kid=\"1-3-3-2-5-1-1\" data-name=\"card background gradient\">\n                        </div>\n                        <div class=\"absolute inset-0 bg-[repeating-linear-gradient(-12deg,transparent_0_18px,#F5F9CE12_18px_19px)]\" data-kid=\"1-3-3-2-5-1-2\" data-name=\"background pattern\">\n                        </div>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#FFA102] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#450E16] uppercase\" data-kid=\"1-3-3-2-5-1-3\" data-name=\"project status badge\">\n                            Ready\n                        </span>\n                        <span class=\"display absolute inset-0 grid place-items-center px-5 text-center text-3xl leading-[.8] text-[#F5F9CE]\" data-kid=\"1-3-3-2-5-1-4\" data-name=\"card graphic text\">\n                            Notes from a Talking Head\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-5-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-5-2-1\" data-name=\"project card title\">\n                            Notes from a Talking Head\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-5-2-2\" data-name=\"last updated label\">\n                            5d ago\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-6\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#BC2D29]\" data-kid=\"1-3-3-2-6-1\" data-name=\"card graphic area\">\n                        <div class=\"absolute inset-0 bg-[linear-gradient(135deg,#FFA102,#DD5533_45%,#432E6F)]\" data-kid=\"1-3-3-2-6-1-1\" data-name=\"card background gradient\">\n                        </div>\n                        <span class=\"display absolute inset-0 grid place-items-center px-5 text-center text-3xl leading-[.8] text-[#450E16]\" data-kid=\"1-3-3-2-6-1-2\" data-name=\"card graphic text\">\n                            A Better Hook in 30 Seconds\n                        </span>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#F5F9CE] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#450E16] uppercase\" data-kid=\"1-3-3-2-6-1-3\" data-name=\"project status badge\">\n                            Draft\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-6-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-6-2-1\" data-name=\"project card title\">\n                            A Better Hook in 30 Seconds\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-6-2-2\" data-name=\"last updated label\">\n                            6d ago\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-7\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#432E6F]\" data-kid=\"1-3-3-2-7-1\" data-name=\"card graphic area\">\n                        <div class=\"absolute inset-0 bg-[linear-gradient(135deg,#432E6F,#450E16)]\" data-kid=\"1-3-3-2-7-1-1\" data-name=\"card background gradient\">\n                        </div>\n                        <span class=\"display absolute inset-0 grid place-items-center px-5 text-center text-3xl leading-[.8] text-[#F5F9CE]\" data-kid=\"1-3-3-2-7-1-2\" data-name=\"card graphic text\">\n                            The Simple Edit\n                        </span>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#BC2D29] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#F5F9CE] uppercase\" data-kid=\"1-3-3-2-7-1-3\" data-name=\"project status badge\">\n                            Publishing\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-7-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-7-2-1\" data-name=\"project card title\">\n                            The Simple Edit\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-7-2-2\" data-name=\"last updated label\">\n                            1w ago\n                        </p>\n                    </div>\n                </article>\n                <article class=\"group overflow-hidden rounded-[20px] border border-[#450E16] bg-[#F5F9CE] soft-shadow transition-transform hover:-translate-y-1\" data-kid=\"1-3-3-2-8\" data-name=\"project card\">\n                    <div class=\"relative h-36 overflow-hidden bg-[#BC2D29]\" data-kid=\"1-3-3-2-8-1\" data-name=\"card graphic area\">\n                        <div class=\"absolute inset-0 bg-[linear-gradient(135deg,#BC2D29,#450E16)]\" data-kid=\"1-3-3-2-8-1-1\" data-name=\"card background gradient\">\n                        </div>\n                        <span class=\"display absolute inset-0 grid place-items-center px-5 text-center text-3xl leading-[.8] text-[#FFA102]\" data-kid=\"1-3-3-2-8-1-2\" data-name=\"card graphic text\">\n                            Talk Less, Land More\n                        </span>\n                        <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#F5F9CE] px-2 py-1 text-[9px] font-semibold tracking-[.1em] text-[#450E16] uppercase\" data-kid=\"1-3-3-2-8-1-3\" data-name=\"project status badge\">\n                            Ready\n                        </span>\n                    </div>\n                    <div class=\"p-4\" data-kid=\"1-3-3-2-8-2\" data-name=\"card content area\">\n                        <h3 class=\"display line-clamp-1 m-0 text-2xl leading-none\" data-kid=\"1-3-3-2-8-2-1\" data-name=\"project card title\">\n                            Talk Less, Land More\n                        </h3>\n                        <p class=\"mono mt-2 text-[9px] tracking-[.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-3-2-8-2-2\" data-name=\"last updated label\">\n                            1w ago\n                        </p>\n                    </div>\n                </article>\n            </div>\n        </section>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
