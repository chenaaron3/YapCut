tion-transform duration-500 group-hover:scale-105\" data-kid=\"1-3-1-4-6-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8100060/pexels-photo-8100060.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\"/>\n                                <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(69,14,22,0.06),rgba(69,14,22,0.8))]\" data-kid=\"1-3-1-4-6-1-1-1-2\">\n                                </div>\n                                <p class=\"display absolute inset-x-4 bottom-3 m-0 max-w-[12ch] text-[29px] leading-[0.84] text-[#F5F9CE]\" data-kid=\"1-3-1-4-6-1-1-1-3\">\n                                    AI captions — March\n                                </p>\n                                <span class=\"mono absolute top-3 right-3 rounded-full border border-[#450E16] bg-[#432E6F] px-2 py-1 text-[9px] font-semibold tracking-[0.08em] text-[#F5F9CE] uppercase\" data-kid=\"1-3-1-4-6-1-1-1-4\">\n                                    Scheduled\n                                </span>\n                            </div>\n                            <div class=\"flex min-h-[78px] flex-col justify-center px-4 py-3\" data-kid=\"1-3-1-4-6-1-1-2\">\n                                <h2 class=\"display m-0 truncate text-[22px] leading-none\" data-kid=\"1-3-1-4-6-1-1-2-1\">\n                                    AI Captions — March\n                                </h2>\n                                <p class=\"mono mt-2 m-0 text-[9px] tracking-[0.12em] text-[#432E6F]/70 uppercase\" data-kid=\"1-3-1-4-6-1-1-2-2\">\n                                    5d ago\n                                </p>\n                            </div>\n                        </article>\n                    </a>\n                </li>\n            </ul>\n        </section>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
