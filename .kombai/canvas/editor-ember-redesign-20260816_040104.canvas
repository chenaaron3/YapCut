    "var_d3686d18cbe4": {
      "type": "variant",
      "label": "04 — Restrained Ember / Existing Editor",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --canvas: #12141a;\n    --panel: #1a1d26;\n    --panel-raised: #222632;\n    --panel-warm: #241b22;\n    --border: #2e3444;\n    --border-warm: #453239;\n    --ink: #e8eaef;\n    --muted: #8b93a7;\n    --muted-2: #667083;\n    --cream: #f5f9ce;\n    --orange: #ffa102;\n    --orange-soft: #8b6521;\n    --crimson: #450e16;\n    --amethyst: #432e6f;\n    --tomato: #9c4c42;\n    --yellow-muted: #9d8940;\n    --teal-muted: #3f8580;\n    --blue-muted: #536b9f;\n    --pink-muted: #95606d;\n    --purple-muted: #786599;\n    --sans: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;\n    --serif: 'Cormorant Garamond', Georgia, serif;\n    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\n  }\n\n  body {\n    margin: 0;\n    background: var(--canvas);\n    color: var(--ink);\n    font-family: var(--sans);\n  }\n\n  .editor-shell,\n  .editor-shell button,\n  .editor-shell input,\n  .editor-shell span,\n  .editor-shell i,\n  .editor-shell strong,\n  .editor-shell small,\n  .editor-shell div,\n  .editor-shell main,\n  .editor-shell aside,\n  .editor-shell section,\n  .editor-shell header,\n  .editor-shell nav,\n  .editor-shell p { box-sizing: border-box; }\n\n  button, input { font: inherit; }\n\n  .editor-shell {\n    position: relative;\n    display: grid;\n    grid-template-rows: 44px minmax(0, 1fr) 320px;\n    min-width: 1040px;\n    min-height: 100dvh;\n    overflow: hidden;\n    background: var(--canvas);\n    color: var(--ink);\n    font-size: 12px;\n  }\n\n  .editor-shell::before {\n    position: absolute;\n    z-index: 10;\n    top: 0;\n    right: 0;\n    left: 0;\n    height: 1px;\n    background: var(--orange);\n    content: '';\n    opacity: .82;\n    pointer-events: none;\n  }\n\n  .topbar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    min-width: 0;\n    padding: 0 12px 0 16px;\n    border-bottom: 1px solid var(--border-warm);\n    background: var(--panel-warm);\n  }\n\n  .topbar-left,\n  .topbar-actions,\n  .topbar-brand,\n  .topbar-status,\n  .panel-actions,\n  .panel-button,\n  .time-controls,\n  .tool-card,\n  .edit-chip,\n  .track-legend,\n  .timeline-head,\n  .ruler-labels {\n    display: flex;\n    align-items: center;\n  }\n\n  .topbar-left { min-width: 0; gap: 10px; }\n  .topbar-actions { gap: 8px; }\n  .topbar-brand { gap: 7px; padding-left: 7px; border-left: 1px solid var(--border-warm); }\n  .topbar-brand strong { font-family: var(--serif); font-size: 17px; font-weight: 700; letter-spacing: -.03em; }\n\n  .brand-mark {\n    display: grid;\n    width: 22px;\n    height: 22px;\n    place-items: center;\n    border: 1px solid var(--orange-soft);\n    border-radius: 6px;\n    color: var(--cream);\n    font-family: var(--serif);\n    font-size: 15px;\n    font-weight: 700;\n  }\n\n  .back-link,\n  .icon-button,\n  .compact-button,\n  .tab-button,\n  .tool-card,\n  .panel-button,\n  .export-button,\n  .play-button {\n    border: 0;\n    cursor: pointer;\n  }\n\n  .back-link {\n    padding: 4px 0;\n    color: var(--muted);\n    background: transparent;\n    font-size: 12px;\n  }\n\n  .back-link:hover,\n  .back-link:focus-visible { color: var(--cream); outline: none; }\n\n  .topbar-meta {\n    position: absolute;\n    left: 50%;\n    transform: translateX(-50%);\n    color: var(--muted-2);\n    font-family: var(--mono);\n    font-size: 9px;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .topbar-status {\n    gap: 6px;\n    height: 28px;\n    padding: 0 10px;\n    border: 1px solid var(--border);\n    border-radius: 999px;\n    color: var(--muted);\n    font-size: 11px;\n  }\n\n  .status-dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--teal-muted);\n  }\n\n  .compact-button,\n  .export-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n    height: 29px;\n    padding: 0 11px;\n    border: 1px solid var(--border);\n    border-radius: 6px;\n    color: var(--ink);\n    background: var(--panel-raised);\n    font-size: 11px;\n    font-weight: 500;\n  }\n\n  .compact-button:hover,\n  .compact-button:focus-visible {\n    border-color: var(--orange-soft);\n    background: #272b37;\n    outline: none;\n  }\n\n  .export-button {\n    border-color: #a06b11;\n    background: var(--orange);\n    color: #21180c;\n    box-shadow: 3px 3px 0 var(--crimson);\n    font-weight: 600;\n  }\n\n  .export-button:hover,\n  .export-button:focus-visible { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--crimson); outline: none; }\n\n  .workspace {\n    display: grid;\n    grid-template-columns: 200px minmax(0, 1fr) 280px;\n    min-height: 0;\n    min-width: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .asset-rail {\n    display: flex;\n    min-height: 0;\n    flex-direction: column;\n    border-right: 1px solid var(--border);\n    background: var(--panel);\n  }\n\n  .rail-head,\n  .panel-head,\n  .preview-head {\n    display: flex;\n    min-height: 43px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    padding: 0 12px;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .eyebrow,\n  .rail-head span,\n  .preview-head span,\n  .transcript-meta,\n  .timeline-label,\n  .track-label,\n  .ruler-label,\n  .rail-note,\n  .mini-label,\n  .panel-kicker {\n    font-family: var(--mono);\n    font-size: 9px;\n    letter-spacing: .11em;\n    text-transform: uppercase;\n  }\n\n  .rail-head span { color: var(--muted); }\n  .rail-head i { color: var(--muted-2); }\n\n  .tabs {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 3px;\n    padding: 10px 10px 8px;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .tab-button {\n    min-width: 0;\n    padding: 7px 2px 6px;\n    border: 1px solid transparent;\n    border-radius: 5px;\n    color: var(--muted);\n    background: transparent;\n    font-family: var(--mono);\n    font-size: 8px;\n    letter-spacing: -.02em;\n  }\n\n  .tab-button:hover { color: var(--ink); background: var(--panel-raised); }\n  .tab-button.active {\n    border-color: var(--orange-soft);\n    background: #2a2028;\n    color: var(--cream);\n    box-shadow: inset 0 -2px 0 var(--orange);\n  }\n\n  .tool-list { display: grid; gap: 7px; padding: 12px 10px; }\n\n  .tool-card {\n    position: relative;\n    justify-content: flex-start;\n    gap: 10px;\n    min-height: 55px;\n    padding: 8px 9px;\n    border: 1px solid var(--border);\n    border-radius: 7px;\n    color: var(--muted);\n    background: var(--panel-raised);\n    text-align: left;\n  }\n\n  .tool-card:hover,\n  .tool-card:focus-visible { border-color: var(--orange-soft); color: var(--ink); outline: none; }\n\n  .tool-card.active {\n    border-color: var(--orange-soft);\n    background: #27212a;\n    color: var(--cream);\n    box-shadow: 3px 3px 0 rgba(69,14,22,.72);\n  }\n\n  .tool-icon {\n    display: grid;\n    width: 26px;\n    height: 26px;\n    flex: 0 0 26px;\n    place-items: center;\n    border: 1px solid var(--border-warm);\n    border-radius: 5px;\n    color: var(--muted);\n    background: #20232c;\n  }\n\n  .tool-card.active .tool-icon { border-color: var(--orange-soft); color: var(--orange); }\n  .tool-card strong { display: block; font-family: var(--serif); font-size: 16px; font-weight: 600; line-height: 1; }\n  .tool-card small { display: block; margin-top: 4px; color: var(--muted-2); font-family: var(--mono); font-size: 8px; }\n\n  .rail-footer {\n    margin-top: auto;\n    padding: 12px 10px 14px;\n    border-top: 1px solid var(--border);\n  }\n\n  .rail-note { color: var(--muted-2); line-height: 1.5; }\n  .rail-note b { color: var(--orange-soft); font-weight: 500; }\n\n  .transcript-panel {\n    display: flex;\n    min-width: 0;\n    min-height: 0;\n    flex-direction: column;\n    background: var(--panel);\n  }\n\n  .panel-head { background: #1d2029; }\n  .panel-title { min-width: 0; }\n  .project-title {\n    display: block;\n    width: 270px;\n    padding: 0;\n    overflow: hidden;\n    border: 0;\n    color: var(--ink);\n    background: transparent;\n    font-family: var(--serif);\n    font-size: 17px;\n    font-weight: 700;\n    letter-spacing: -.02em;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .project-title:focus { outline: 1px solid var(--orange-soft); outline-offset: 3px; }\n  .panel-actions { gap: 4px; }\n\n  .panel-button {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    height: 28px;\n    padding: 0 9px;\n    border: 1px solid transparent;\n    border-radius: 5px;\n    color: var(--muted);\n    background: transparent;\n    font-size: 11px;\n  }\n\n  .panel-button:hover,\n  .panel-button:focus-visible { color: var(--ink); background: var(--panel-raised); outline: none; }\n  .panel-button.active { border-color: rgba(67,46,111,.8); background: rgba(67,46,111,.24); color: var(--cream); }\n\n  .transcript-body {\n    position: relative;\n    min-height: 0;\n    flex: 1;\n    overflow: hidden;\n    padding: 26px 34px 18px;\n  }\n\n  .transcript-meta {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    color: var(--muted-2);\n  }\n\n  .transcript-meta strong { color: var(--muted); font-weight: 500; }\n  .transcript-meta .time { color: var(--orange-soft); }\n\n  .transcript-copy {\n    max-width: 760px;\n    margin: 24px 0 0;\n    color: var(--ink);\n    font-family: var(--serif);\n    font-size: clamp(21px, 2.1vw, 31px);\n    font-weight: 500;\n    letter-spacing: -.025em;\n    line-height: 1.6;\n  }\n\n  .line { display: block; white-space: nowrap; }\n  .word { position: relative; display: inline-block; padding: 0 2px; }\n  .word:hover { background: rgba(255,161,2,.08); }\n  .word.selected { background: rgba(255,161,2,.2); color: var(--cream); box-shadow: 2px 2px 0 var(--orange); }\n  .word.orange { text-decoration: underline; text-decoration-color: var(--orange-soft); text-decoration-thickness: 2px; text-underline-offset: 4px; }\n  .word.tomato { color: #c18478; text-decoration: underline; text-decoration-color: var(--tomato); text-decoration-thickness: 2px; text-underline-offset: 4px; }\n  .word.teal { color: #82beba; }\n  .word.blue { color: #98add7; }\n\n  .edit-chip {\n    gap: 4px;\n    min-height: 18px;\n    margin: 0 4px;\n    padding: 0 5px;\n    border: 1px solid var(--border);\n    border-radius: 4px;\n    color: var(--muted);\n    background: var(--panel-raised);\n    font-family: var(--mono);\n    font-size: 8px;\n    letter-spacing: .02em;\n    vertical-align: middle;\n  }\n  .edit-chip i { width: 10px; height: 10px; }\n  .edit-chip.orange { border-color: #6e5524; color: var(--orange); }\n  .edit-chip.teal { border-color: #2e5f5d; color: #7fb7b0; }\n  .edit-chip.blue { border-color: #3b4d73; color: #9aacd1; }\n  .edit-chip.tomato { border-color: #64403d; color: #c18478; }\n\n  .transcript-footer {\n    position: absolute;\n    right: 30px;\n    bottom: 16px;\n    left: 34px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding-top: 10px;\n    border-top: 1px solid var(--border);\n    color: var(--muted-2);\n    font-family: var(--mono);\n    font-size: 9px;\n  }\n\n  .transcript-footer span { display: inline-flex; align-items: center; gap: 6px; }\n  .footer-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--orange); }\n\n  .preview-panel {\n    display: flex;\n    min-height: 0;\n    flex-direction: column;\n    border-left: 1px solid var(--border);\n    background: #111319;\n  }\n\n  .preview-head { background: var(--panel-warm); }\n  .preview-head span { color: var(--muted); }\n  .preview-head strong { font-family: var(--serif); font-size: 16px; font-weight: 600; }\n  .preview-well {\n    position: relative;\n    display: flex;\n    min-height: 0;\n    flex: 1;\n    align-items: center;\n    justify-content: center;\n    background: #0d0f13;\n  }\n\n  .preview-frame {\n    position: relative;\n    height: min(310px, 80%);\n    aspect-ratio: 9 / 16;\n    border: 1px solid #7b7865;\n    background: var(--cream);\n    box-shadow: 3px 3px 0 rgba(69,14,22,.68);\n  }\n\n  .preview-frame::before {\n    position: absolute;\n    top: 10px;\n    left: 10px;\n    padding: 3px 5px;\n    border: 1px solid rgba(69,14,22,.52);\n    color: var(--crimson);\n    content: 'TALKING HEAD';\n    font-family: var(--mono);\n    font-size: 7px;\n    letter-spacing: .08em;\n  }\n\n  .preview-frame::after {\n    position: absolute;\n    right: 10px;\n    bottom: 10px;\n    left: 10px;\n    height: 1px;\n    background: rgba(69,14,22,.32);\n    content: '';\n  }\n\n  .preview-copy {\n    position: absolute;\n    right: 12px;\n    bottom: 33px;\n    left: 12px;\n    color: var(--crimson);\n    font-family: var(--serif);\n    font-size: 21px;\n    font-weight: 700;\n    line-height: .95;\n    text-align: center;\n  }\n\n  .preview-copy em { color: #876a4f; font-style: normal; }\n  .preview-label { position: absolute; top: 12px; right: 10px; color: rgba(69,14,22,.56); font-family: var(--mono); font-size: 7px; }\n\n  .player-controls {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    align-items: center;\n    gap: 10px;\n    min-height: 48px;\n    padding: 0 11px;\n    border-top: 1px solid var(--border);\n    background: #0b0d11;\n  }\n\n  .timecode { color: var(--orange); font-family: var(--mono); font-size: 10px; }\n  .timecode span { color: var(--muted-2); }\n  .time-controls { justify-content: center; gap: 6px; }\n  .play-button {\n    display: grid;\n    width: 27px;\n    height: 27px;\n    place-items: center;\n    border: 1px solid #a06b11;\n    border-radius: 6px;\n    color: #22180c;\n    background: var(--orange);\n  }\n  .play-button:hover, .play-button:focus-visible { box-shadow: 2px 2px 0 var(--crimson); outline: none; }\n  .icon-button {\n    display: grid;\n    width: 25px;\n    height: 25px;\n    place-items: center;\n    border-radius: 5px;\n    color: var(--muted);\n    background: transparent;\n  }\n  .icon-button:hover, .icon-button:focus-visible { color: var(--cream); background: var(--panel-raised); outline: none; }\n\n  .timeline {\n    position: relative;\n    min-height: 0;\n    overflow: hidden;\n    background: var(--panel);\n  }\n\n  .timeline-head {\n    justify-content: space-between;\n    height: 32px;\n    padding: 0 12px;\n    border-bottom: 1px solid var(--border);\n    color: var(--muted);\n  }\n  .timeline-head strong { color: var(--ink); font-family: var(--mono); font-size: 9px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }\n  .timeline-head span { color: var(--muted-2); font-family: var(--mono); font-size: 9px; }\n\n  .timeline-scroll { position: relative; height: calc(100% - 32px); overflow: hidden; padding: 0 12px 10px 0; }\n  .ruler {\n    position: relative;\n    height: 38px;\n    margin-left: 72px;\n    border-bottom: 1px solid var(--border);\n    background-image: linear-gradient(to right, rgba(139,147,167,.16) 1px, transparent 1px);\n    background-size: 48px 100%;\n  }\n  .ruler::after {\n    position: absolute;\n    right: 0;\n    bottom: 8px;\n    left: 0;\n    height: 1px;\n    background: rgba(139,147,167,.28);\n    content: '';\n  }\n  .ruler-labels { height: 100%; justify-content: space-between; padding: 4px 3px 0; }\n  .ruler-label { color: var(--muted); font-size: 8px; letter-spacing: 0; text-transform: none; }\n\n  .track-stack { position: relative; padding-top: 7px; }\n  .track-row {\n    display: grid;\n    grid-template-columns: 72px minmax(0, 1fr);\n    align-items: center;\n    height: 36px;\n  }\n  .track-label { padding-left: 11px; color: var(--muted); font-size: 9px; letter-spacing: .08em; }\n  .track-lane {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: 3px;\n    height: 27px;\n    overflow: hidden;\n    padding: 4px 6px;\n    border: 1px solid var(--border);\n    border-radius: 5px;\n    background-color: #171a22;\n    background-image: linear-gradient(to right, rgba(139,147,167,.09) 1px, transparent 1px);\n    background-size: 48px 100%;\n  }\n  .block {\n    position: relative;\n    height: 17px;\n    min-width: 12px;\n    overflow: hidden;\n    padding: 2px 7px;\n    border: 1px solid transparent;\n    border-radius: 3px;\n    color: #d9dde5;\n    font-family: var(--mono);\n    font-size: 8px;\n    line-height: 11px;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .block.video { background: #47442d; border-color: #756735; color: #d5c47c; }\n  .block.cut { background: #3e292c; border-color: #614041; color: #b37d7c; }\n  .block.caption { background: #303747; border-color: #48526b; color: #a4afc9; }\n  .block.sfx { background: #253c3d; border-color: #356968; color: #8cc0ba; }\n  .block.zoom { background: #30374c; border-color: #4c608a; color: #a2b4dc; }\n  .block.vfx { background: #453038; border-color: #704752; color: #c3909b; }\n  .block.selected { border-color: var(--orange); box-shadow: 2px 2px 0 rgba(255,161,2,.46); color: var(--cream); }\n  .block.handle-left::before, .block.handle-right::after { position: absolute; top: 3px; bottom: 3px; width: 2px; background: currentColor; content: ''; opacity: .65; }\n  .block.handle-left::before { left: 2px; }\n  .block.handle-right::after { right: 2px; }\n\n  .playhead {\n    position: absolute;\n    z-index: 4;\n    top: 0;\n    bottom: 8px;\n    left: 188px;\n    width: 1px;\n    background: var(--orange);\n    box-shadow: 0 0 0 1px rgba(255,161,2,.16);\n    pointer-events: none;\n  }\n  .playhead::before {\n    position: absolute;\n    top: 0;\n    left: -4px;\n    width: 9px;\n    height: 9px;\n    background: var(--orange);\n    clip-path: polygon(0 0, 100% 0, 50% 100%);\n    content: '';\n  }\n  .playhead::after { position: absolute; top: 10px; left: 5px; color: var(--orange); content: '0:02.4'; font-family: var(--mono); font-size: 8px; white-space: nowrap; }\n\n  .track-legend { gap: 13px; height: 22px; margin-left: 84px; color: var(--muted-2); font-family: var(--mono); font-size: 8px; }\n  .legend-item { display: inline-flex; align-items: center; gap: 4px; }\n  .legend-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); }\n  .legend-dot.video { background: var(--yellow-muted); }\n  .legend-dot.sfx { background: var(--teal-muted); }\n  .legend-dot.zoom { background: var(--blue-muted); }\n  .legend-dot.vfx { background: var(--pink-muted); }\n\n  @media (max-width: 1100px) {\n    .editor-shell { min-width: 0; grid-template-columns: 1fr; grid-template-rows: auto auto auto; overflow: auto; }\n    .topbar { min-height: 46px; }\n    .topbar-meta { display: none; }\n    .workspace { grid-template-columns: 180px minmax(0, 1fr); min-height: 510px; }\n    .preview-panel { grid-column: 1 / -1; min-height: 360px; border-top: 1px solid var(--border); border-left: 0; }\n    .preview-well { min-height: 280px; }\n    .timeline { min-height: 300px; }\n  }\n\n  @media (max-width: 720px) {\n    .workspace { grid-template-columns: 1fr; }\n    .asset-rail { min-height: 285px; border-right: 0; border-bottom: 1px solid var(--border); }\n    .tool-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n    .rail-footer { display: none; }\n    .transcript-body { min-height: 350px; padding: 22px 18px 18px; }\n    .transcript-copy { font-size: 25px; white-space: normal; }\n    .line { white-space: normal; }\n    .transcript-footer { right: 18px; left: 18px; }\n  }\n</style>\n<div aria-label=\"Restrained Ember video editor\" class=\"editor-shell\" data-kid=\"1\" data-name=\"editor shell container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"topbar header section\">\n        <div class=\"topbar-left\" data-kid=\"1-1-1\" data-name=\"topbar left section\">\n            <button aria-label=\"Back to projects\" class=\"back-link\" data-kid=\"1-1-1-1\" data-name=\"back to projects button\" title=\"Back to projects\" type=\"button\">\n                ← Projects\n            </button>\n            <div aria-label=\"YapCut\" class=\"topbar-brand\" data-kid=\"1-1-1-2\" data-name=\"brand identity container\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-2-1\" data-name=\"brand initial mark\">\n                    Y\n                </span>\n                <strong data-kid=\"1-1-1-2-2\" data-name=\"brand name text\">\n                    YapCut\n                </strong>\n            </div>\n        </div>\n        <div class=\"topbar-meta\" data-kid=\"1-1-2\" data-name=\"project meta status text\">\n            EDIT / 01  ·  WORD-FIRST\n        </div>\n        <div class=\"topbar-actions\" data-kid=\"1-1-3\" data-name=\"topbar actions container\">\n            <span class=\"topbar-status\" data-dynamic=\"true\" data-kid=\"1-1-3-1\" data-name=\"project save status indicator\" data-reason=\"status updated by background sync\" title=\"Project saved\">\n                <span class=\"status-dot\" data-kid=\"1-1-3-1-1\" data-name=\"save status dot\">\n                </span>\n                Saved\n            </span>\n            <button aria-label=\"Generate edits\" class=\"compact-button\" data-kid=\"1-1-3-2\" data-name=\"generate edits button\" title=\"Generate edits\" type=\"button\">\n                <i data-kid=\"1-1-3-2-1\" data-lucide=\"sparkles\">\n                </i>\n                Generate edits\n            </button>\n            <button aria-label=\"Export video\" class=\"export-button\" data-kid=\"1-1-3-3\" data-name=\"export video button\" title=\"Export video\" type=\"button\">\n                <i data-kid=\"1-1-3-3-1\" data-lucide=\"cloud-upload\">\n                </i>\n                Export video\n                <i data-kid=\"1-1-3-3-2\" data-lucide=\"chevron-down\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"workspace\" data-kid=\"1-2\" data-name=\"main workspace container\">\n        <aside aria-label=\"Edit tools\" class=\"asset-rail\" data-kid=\"1-2-1\" data-name=\"asset rail sidebar\">\n            <div class=\"rail-head\" data-kid=\"1-2-1-1\" data-name=\"rail header\">\n                <span data-kid=\"1-2-1-1-1\">\n                    Edit tools\n                </span>\n                <i data-kid=\"1-2-1-1-2\" data-lucide=\"panel-left\">\n                </i>\n            </div>\n            <nav aria-label=\"Asset tabs\" class=\"tabs\" data-kid=\"1-2-1-2\" data-name=\"asset navigation tabs\">\n                <button aria-current=\"page\" class=\"tab-button active\" data-kid=\"1-2-1-2-1\" data-name=\"active A-roll tab\" type=\"button\">\n                    A-roll\n                </button>\n                <button class=\"tab-button\" data-kid=\"1-2-1-2-2\" data-name=\"B-roll tab\" type=\"button\">\n                    B-roll\n                </button>\n                <button class=\"tab-button\" data-kid=\"1-2-1-2-3\" data-name=\"VFX tab\" type=\"button\">\n                    VFX\n                </button>\n                <button class=\"tab-button\" data-kid=\"1-2-1-2-4\" data-name=\"transitions tab\" type=\"button\">\n                    Trans.\n                </button>\n            </nav>\n            <div class=\"tool-list\" data-kid=\"1-2-1-3\" data-name=\"tool list container\">\n                <button aria-label=\"Quote treatment\" class=\"tool-card active\" data-kid=\"1-2-1-3-1\" data-name=\"active quote treatment tool card\" title=\"Quote treatment\" type=\"button\">\n                    <span class=\"tool-icon\" data-kid=\"1-2-1-3-1-1\">\n                        <i data-kid=\"1-2-1-3-1-1-1\" data-lucide=\"quote\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-3-1-2\">\n                        <strong data-kid=\"1-2-1-3-1-2-1\">\n                            Quote\n                        </strong>\n                        <small data-kid=\"1-2-1-3-1-2-2\">\n                            VFX / 04\n                        </small>\n                    </span>\n                </button>\n                <button aria-label=\"Text treatment\" class=\"tool-card\" data-kid=\"1-2-1-3-2\" data-name=\"text treatment tool card\" title=\"Text treatment\" type=\"button\">\n                    <span class=\"tool-icon\" data-kid=\"1-2-1-3-2-1\">\n                        <i data-kid=\"1-2-1-3-2-1-1\" data-lucide=\"type\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-3-2-2\">\n                        <strong data-kid=\"1-2-1-3-2-2-1\">\n                            Text\n                        </strong>\n                        <small data-kid=\"1-2-1-3-2-2-2\">\n                            VFX / 06\n                        </small>\n                    </span>\n                </button>\n                <button aria-label=\"Listicle treatment\" class=\"tool-card\" data-kid=\"1-2-1-3-3\" data-name=\"listicle treatment tool card\" title=\"Listicle treatment\" type=\"button\">\n                    <span class=\"tool-icon\" data-kid=\"1-2-1-3-3-1\">\n                        <i data-kid=\"1-2-1-3-3-1-1\" data-lucide=\"list-ordered\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-3-3-2\">\n                        <strong data-kid=\"1-2-1-3-3-2-1\">\n                            Listicle\n                        </strong>\n                        <small data-kid=\"1-2-1-3-3-2-2\">\n                            VFX / 03\n                        </small>\n                    </span>\n                </button>\n                <button aria-label=\"Shake treatment\" class=\"tool-card\" data-kid=\"1-2-1-3-4\" data-name=\"shake treatment tool card\" title=\"Shake treatment\" type=\"button\">\n                    <span class=\"tool-icon\" data-kid=\"1-2-1-3-4-1\">\n                        <i data-kid=\"1-2-1-3-4-1-1\" data-lucide=\"move-diagonal\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-3-4-2\">\n                        <strong data-kid=\"1-2-1-3-4-2-1\">\n                            Shake\n                        </strong>\n                        <small data-kid=\"1-2-1-3-4-2-2\">\n                            VFX / 02\n                        </small>\n                    </span>\n                </button>\n            </div>\n            <div class=\"rail-footer\" data-kid=\"1-2-1-4\" data-name=\"rail footer area\">\n                <div class=\"rail-note\" data-kid=\"1-2-1-4-1\" data-name=\"instructional rail note\">\n                    <b data-kid=\"1-2-1-4-1-1\">\n                        Drag to a word\n                    </b>\n                    <br data-kid=\"1-2-1-4-1-2\"/>\n                    treatment follows the transcript\n                </div>\n            </div>\n        </aside>\n        <section aria-label=\"Transcript editor\" class=\"transcript-panel\" data-kid=\"1-2-2\" data-name=\"transcript editor panel\">\n            <div class=\"panel-head\" data-kid=\"1-2-2-1\" data-name=\"transcript panel head\">\n                <div class=\"panel-title\" data-kid=\"1-2-2-1-1\" data-name=\"project title input wrapper\">\n                    <input aria-label=\"Project title\" class=\"project-title\" data-kid=\"1-2-2-1-1-1\" data-name=\"project title editable input\" value=\"Top Three Video Editing Tricks\"/>\n                </div>\n                <div class=\"panel-actions\" data-kid=\"1-2-2-1-2\" data-name=\"panel utility actions\">\n                    <button aria-label=\"Edit visibility\" class=\"panel-button active\" data-kid=\"1-2-2-1-2-1\" data-name=\"edit visibility button\" title=\"Edit visibility\" type=\"button\">\n                        <i data-kid=\"1-2-2-1-2-1-1\" data-lucide=\"layers-3\">\n                        </i>\n                        22 edits\n                        <i data-kid=\"1-2-2-1-2-1-2\" data-lucide=\"chevron-down\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Caption settings\" class=\"panel-button\" data-kid=\"1-2-2-1-2-2\" data-name=\"caption settings button\" title=\"Caption settings\" type=\"button\">\n                        <i data-kid=\"1-2-2-1-2-2-1\" data-lucide=\"captions\">\n                        </i>\n                        Captions\n                    </button>\n                    <button aria-label=\"Project settings\" class=\"panel-button\" data-kid=\"1-2-2-1-2-3\" data-name=\"project settings button\" title=\"Project settings\" type=\"button\">\n                        <i data-kid=\"1-2-2-1-2-3-1\" data-lucide=\"sliders-horizontal\">\n                        </i>\n                        Settings\n                    </button>\n                </div>\n            </div>\n            <div class=\"transcript-body\" data-kid=\"1-2-2-2\" data-name=\"transcript body content\">\n                <div class=\"transcript-meta\" data-kid=\"1-2-2-2-1\" data-name=\"transcript meta info bar\">\n                    <strong data-kid=\"1-2-2-2-1-1\">\n                        Transcript\n                    </strong>\n                    <span class=\"time\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2\" data-name=\"transcript timestamp text\" data-reason=\"updated during video playback\">\n                        00:00 / 00:22\n                    </span>\n                    <span data-kid=\"1-2-2-2-1-3\">\n                        word editing / selected pass\n                    </span>\n                </div>\n                <p class=\"transcript-copy\" data-kid=\"1-2-2-2-2\" data-name=\"transcript text block\">\n                    <span class=\"line\" data-kid=\"1-2-2-2-2-1\">\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-1-1\">\n                            Top\n                        </span>\n                        <span class=\"word selected\" data-kid=\"1-2-2-2-2-1-2\">\n                            three\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-1-3\">\n                            tricks\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-1-4\">\n                            for\n                        </span>\n                        <span class=\"word tomato\" data-kid=\"1-2-2-2-2-1-5\">\n                            editing\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-1-6\">\n                            videos.\n                        </span>\n                        <span class=\"edit-chip orange\" data-kid=\"1-2-2-2-2-1-7\">\n                            <i data-kid=\"1-2-2-2-2-1-7-1\" data-lucide=\"type\">\n                            </i>\n                            T\n                        </span>\n                    </span>\n                    <span class=\"line\" data-kid=\"1-2-2-2-2-2\">\n                        <span class=\"edit-chip\" data-kid=\"1-2-2-2-2-2-1\">\n                            <i data-kid=\"1-2-2-2-2-2-1-1\" data-lucide=\"list-ordered\">\n                            </i>\n                            list\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-2-2\">\n                            Number\n                        </span>\n                        <span class=\"word orange\" data-kid=\"1-2-2-2-2-2-3\">\n                            one\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-2-4\">\n                            is\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-2-5\">\n                            to\n                        </span>\n                        <span class=\"word teal\" data-kid=\"1-2-2-2-2-2-6\">\n                            use\n                        </span>\n                        <span class=\"word teal\" data-kid=\"1-2-2-2-2-2-7\">\n                            overlay\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-2-8\">\n                            text.\n                        </span>\n                    </span>\n                    <span class=\"line\" data-kid=\"1-2-2-2-2-3\">\n                        <span class=\"edit-chip teal\" data-kid=\"1-2-2-2-2-3-1\">\n                            <i data-kid=\"1-2-2-2-2-3-1-1\" data-lucide=\"volume-2\">\n                            </i>\n                            sfx\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-3-2\">\n                            Text over here will help add,\n                        </span>\n                        <span class=\"word tomato\" data-kid=\"1-2-2-2-2-3-3\">\n                            impact\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-3-4\">\n                            your videos and make things pop.\n                        </span>\n                    </span>\n                    <span class=\"line\" data-kid=\"1-2-2-2-2-4\">\n                        <span class=\"edit-chip\" data-kid=\"1-2-2-2-2-4-1\">\n                            <i data-kid=\"1-2-2-2-2-4-1-1\" data-lucide=\"list-ordered\">\n                            </i>\n                            list\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-4-2\">\n                            Tip number two is\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-4-3\">\n                            to use\n                        </span>\n                        <span class=\"word blue\" data-kid=\"1-2-2-2-2-4-4\">\n                            zooms.\n                        </span>\n                    </span>\n                    <span class=\"line\" data-kid=\"1-2-2-2-2-5\">\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-5-1\">\n                            For specific words that you want to\n                        </span>\n                        <span class=\"word tomato\" data-kid=\"1-2-2-2-2-5-2\">\n                            emphasize\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-5-3\">\n                            , try to\n                        </span>\n                        <span class=\"edit-chip blue\" data-kid=\"1-2-2-2-2-5-4\">\n                            <i data-kid=\"1-2-2-2-2-5-4-1\" data-lucide=\"zoom-in\">\n                            </i>\n                            zoom\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-5-5\">\n                            in to those words.\n                        </span>\n                    </span>\n                    <span class=\"line\" data-kid=\"1-2-2-2-2-6\">\n                        <span class=\"edit-chip\" data-kid=\"1-2-2-2-2-6-1\">\n                            <i data-kid=\"1-2-2-2-2-6-1-1\" data-lucide=\"link-2\">\n                            </i>\n                            link\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-6-2\">\n                            And\n                        </span>\n                        <span class=\"edit-chip\" data-kid=\"1-2-2-2-2-6-3\">\n                            <i data-kid=\"1-2-2-2-2-6-3-1\" data-lucide=\"list-ordered\">\n                            </i>\n                            list\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-6-4\">\n                            tip number three is to\n                        </span>\n                        <span class=\"edit-chip teal\" data-kid=\"1-2-2-2-2-6-5\">\n                            <i data-kid=\"1-2-2-2-2-6-5-1\" data-lucide=\"volume-2\">\n                            </i>\n                            sfx\n                        </span>\n                        <span class=\"word teal\" data-kid=\"1-2-2-2-2-6-6\">\n                            add sound\n                        </span>\n                        <span class=\"word\" data-kid=\"1-2-2-2-2-6-7\">\n                            effects.\n                        </span>\n                    </span>\n                </p>\n                <div class=\"transcript-footer\" data-kid=\"1-2-2-2-3\" data-name=\"transcript footer bar\">\n                    <span data-kid=\"1-2-2-2-3-1\">\n                        <b class=\"footer-dot\" data-kid=\"1-2-2-2-3-1-1\">\n                        </b>\n                        Click a word to place an edit\n                    </span>\n                    <span data-kid=\"1-2-2-2-3-2\">\n                        ⌘ Z to undo\n                    </span>\n                </div>\n            </div>\n        </section>\n        <aside aria-label=\"Video preview\" class=\"preview-panel\" data-kid=\"1-2-3\" data-name=\"video preview sidebar\">\n            <div class=\"preview-head\" data-kid=\"1-2-3-1\" data-name=\"preview header\">\n                <span data-kid=\"1-2-3-1-1\">\n                    Preview\n                </span>\n                <strong data-kid=\"1-2-3-1-2\">\n                    Vertical cut\n                </strong>\n                <button aria-label=\"Preview options\" class=\"icon-button\" data-kid=\"1-2-3-1-3\" title=\"Preview options\" type=\"button\">\n                    <i data-kid=\"1-2-3-1-3-1\" data-lucide=\"more-horizontal\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"preview-well\" data-kid=\"1-2-3-2\" data-name=\"preview well container\">\n                <div aria-label=\"Vertical video preview\" class=\"preview-frame\" data-kid=\"1-2-3-2-1\" data-name=\"vertical video preview frame\">\n                    <span class=\"preview-label\" data-kid=\"1-2-3-2-1-1\">\n                        9:16\n                    </span>\n                    <div class=\"preview-copy\" data-kid=\"1-2-3-2-1-2\" data-name=\"preview copy overlay\">\n                        Top three\n                        <br data-kid=\"1-2-3-2-1-2-1\"/>\n                        <em data-kid=\"1-2-3-2-1-2-2\">\n                            tricks for\n                        </em>\n                        <br data-kid=\"1-2-3-2-1-2-3\"/>\n                        editing.\n                    </div>\n                </div>\n            </div>\n            <div class=\"player-controls\" data-kid=\"1-2-3-3\" data-name=\"player controls bar\">\n                <div class=\"timecode\" data-dynamic=\"true\" data-kid=\"1-2-3-3-1\" data-name=\"timecode display\" data-reason=\"updated during video playback\">\n                    0:00:00\n                    <span data-kid=\"1-2-3-3-1-1\">\n                        / 0:22:10\n                    </span>\n                </div>\n                <div class=\"time-controls\" data-kid=\"1-2-3-3-2\">\n                    <button aria-label=\"Previous frame\" class=\"icon-button\" data-kid=\"1-2-3-3-2-1\" title=\"Previous frame\" type=\"button\">\n                        <i data-kid=\"1-2-3-3-2-1-1\" data-lucide=\"skip-back\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Play preview\" class=\"play-button\" data-kid=\"1-2-3-3-2-2\" title=\"Play preview\" type=\"button\">\n                        <i data-kid=\"1-2-3-3-2-2-1\" data-lucide=\"play\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Next frame\" class=\"icon-button\" data-kid=\"1-2-3-3-2-3\" title=\"Next frame\" type=\"button\">\n                        <i data-kid=\"1-2-3-3-2-3-1\" data-lucide=\"skip-forward\">\n                        </i>\n                    </button>\n                </div>\n                <button aria-label=\"Fullscreen preview\" class=\"icon-button\" data-kid=\"1-2-3-3-3\" title=\"Fullscreen preview\" type=\"button\">\n                    <i data-kid=\"1-2-3-3-3-1\" data-lucide=\"maximize-2\">\n                    </i>\n                </button>\n            </div>\n        </aside>\n    </main>\n    <section aria-label=\"Timeline\" class=\"timeline\" data-kid=\"1-3\" data-name=\"timeline section\">\n        <div class=\"timeline-head\" data-kid=\"1-3-1\" data-name=\"timeline head section\">\n            <strong data-kid=\"1-3-1-1\">\n                Timeline\n            </strong>\n            <span data-kid=\"1-3-1-2\">\n                drag to refine  ·  snap on\n            </span>\n        </div>\n        <div class=\"timeline-scroll\" data-kid=\"1-3-2\" data-name=\"timeline scrollable area\">\n            <div class=\"ruler\" data-kid=\"1-3-2-1\" data-name=\"ruler container\">\n                <div class=\"ruler-labels\" data-kid=\"1-3-2-1-1\">\n                    <span class=\"ruler-label\" data-kid=\"1-3-2-1-1-1\">\n                        0:00\n                    </span>\n                    <span class=\"ruler-label\" data-kid=\"1-3-2-1-1-2\">\n                        0:05\n                    </span>\n                    <span class=\"ruler-label\" data-kid=\"1-3-2-1-1-3\">\n                        0:10\n                    </span>\n                    <span class=\"ruler-label\" data-kid=\"1-3-2-1-1-4\">\n                        0:15\n                    </span>\n                    <span class=\"ruler-label\" data-kid=\"1-3-2-1-1-5\">\n                        0:20\n                    </span>\n                    <span class=\"ruler-label\" data-kid=\"1-3-2-1-1-6\">\n                        0:25\n                    </span>\n                    <span class=\"ruler-label\" data-kid=\"1-3-2-1-1-7\">\n                        0:30\n                    </span>\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"playhead\" data-dynamic=\"true\" data-kid=\"1-3-2-2\" data-name=\"playhead indicator\" data-reason=\"positioned by playback script\">\n            </div>\n            <div class=\"track-stack\" data-kid=\"1-3-2-3\" data-name=\"track stack container\">\n                <div class=\"track-row\" data-kid=\"1-3-2-3-1\" data-name=\"video track row\">\n                    <div class=\"track-label\" data-kid=\"1-3-2-3-1-1\">\n                        Video\n                    </div>\n                    <div class=\"track-lane\" data-kid=\"1-3-2-3-1-2\">\n                        <span class=\"block video handle-left\" data-kid=\"1-3-2-3-1-2-1\" style=\"width:17%\">\n                            KEEP / 1.9s\n                        </span>\n                        <span class=\"block cut\" data-kid=\"1-3-2-3-1-2-2\" style=\"width:9%\">\n                            CUT\n                        </span>\n                        <span class=\"block video\" data-kid=\"1-3-2-3-1-2-3\" style=\"width:16%\">\n                            KEEP / 2.6s\n                        </span>\n                        <span class=\"block cut\" data-kid=\"1-3-2-3-1-2-4\" style=\"width:11%\">\n                            CUT\n                        </span>\n                        <span class=\"block video selected handle-right\" data-kid=\"1-3-2-3-1-2-5\" style=\"width:19%\">\n                            KEEP / 3.0s\n                        </span>\n                        <span class=\"block video\" data-kid=\"1-3-2-3-1-2-6\" style=\"width:14%\">\n                            KEEP / 3.1s\n                        </span>\n                        <span class=\"block cut\" data-kid=\"1-3-2-3-1-2-7\" style=\"width:8%\">\n                            CUT\n                        </span>\n                    </div>\n                </div>\n                <div class=\"track-row\" data-kid=\"1-3-2-3-2\" data-name=\"captions track row\">\n                    <div class=\"track-label\" data-kid=\"1-3-2-3-2-1\">\n                        Captions\n                    </div>\n                    <div class=\"track-lane\" data-kid=\"1-3-2-3-2-2\">\n                        <span class=\"block caption\" data-kid=\"1-3-2-3-2-2-1\" style=\"width:11%\">\n                            Top three tricks\n                        </span>\n                        <span class=\"block caption\" data-kid=\"1-3-2-3-2-2-2\" style=\"width:15%\">\n                            overlay text\n                        </span>\n                        <span class=\"block caption\" data-kid=\"1-3-2-3-2-2-3\" style=\"width:13%\">\n                            Tip number two\n                        </span>\n                        <span class=\"block caption\" data-kid=\"1-3-2-3-2-2-4\" style=\"width:17%\">\n                            sound effects\n                        </span>\n                        <span class=\"block caption\" data-kid=\"1-3-2-3-2-2-5\" style=\"width:10%\">\n                            bold words\n                        </span>\n                    </div>\n                </div>\n                <div class=\"track-row\" data-kid=\"1-3-2-3-3\" data-name=\"SFX track row\">\n                    <div class=\"track-label\" data-kid=\"1-3-2-3-3-1\">\n                        SFX\n                    </div>\n                    <div class=\"track-lane\" data-kid=\"1-3-2-3-3-2\">\n                        <span class=\"block sfx\" data-kid=\"1-3-2-3-3-2-1\" style=\"width:5%\">\n                            Cream\n                        </span>\n                        <span class=\"block sfx\" data-kid=\"1-3-2-3-3-2-2\" style=\"width:5%\">\n                            click\n                        </span>\n                        <span class=\"block sfx\" data-kid=\"1-3-2-3-3-2-3\" style=\"width:5%\">\n                            pop\n                        </span>\n                        <span class=\"block sfx\" data-kid=\"1-3-2-3-3-2-4\" style=\"width:7%\">\n                            Magic\n                        </span>\n                    </div>\n                </div>\n                <div class=\"track-row\" data-kid=\"1-3-2-3-4\" data-name=\"zoom track row\">\n                    <div class=\"track-label\" data-kid=\"1-3-2-3-4-1\">\n                        Zoom\n                    </div>\n                    <div class=\"track-lane\" data-kid=\"1-3-2-3-4-2\">\n                        <span class=\"block zoom\" data-kid=\"1-3-2-3-4-2-1\" style=\"width:8%\">\n                            1.10x\n                        </span>\n                        <span class=\"block zoom\" data-kid=\"1-3-2-3-4-2-2\" style=\"width:8%\">\n                            1.10x\n                        </span>\n                        <span class=\"block zoom selected\" data-kid=\"1-3-2-3-4-2-3\" style=\"width:6%\">\n                            1.15x\n                        </span>\n                        <span class=\"block zoom\" data-kid=\"1-3-2-3-4-2-4\" style=\"width:8%\">\n                            1.10x\n                        </span>\n                    </div>\n                </div>\n                <div class=\"track-row\" data-kid=\"1-3-2-3-5\" data-name=\"VFX track row\">\n                    <div class=\"track-label\" data-kid=\"1-3-2-3-5-1\">\n                        VFX\n                    </div>\n                    <div class=\"track-lane\" data-kid=\"1-3-2-3-5-2\">\n                        <span class=\"block vfx\" data-kid=\"1-3-2-3-5-2-1\" style=\"width:12%\">\n                            Top Three Video\n                        </span>\n                        <span class=\"block vfx selected\" data-kid=\"1-3-2-3-5-2-2\" style=\"width:15%\">\n                            Number One · Overlay\n                        </span>\n                        <span class=\"block vfx\" data-kid=\"1-3-2-3-5-2-3\" style=\"width:10%\">\n                            Bold words\n                        </span>\n                        <span class=\"block vfx\" data-kid=\"1-3-2-3-5-2-4\" style=\"width:13%\">\n                            Tip Two\n                        </span>\n                        <span class=\"block vfx\" data-kid=\"1-3-2-3-5-2-5\" style=\"width:11%\">\n                            Bold White\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"track-legend\" data-kid=\"1-3-2-4\" data-name=\"track legend section\">\n                <span class=\"legend-item\" data-kid=\"1-3-2-4-1\">\n                    <i class=\"legend-dot video\" data-kid=\"1-3-2-4-1-1\">\n                    </i>\n                    Video\n                </span>\n                <span class=\"legend-item\" data-kid=\"1-3-2-4-2\">\n                    <i class=\"legend-dot sfx\" data-kid=\"1-3-2-4-2-1\">\n                    </i>\n                    SFX\n                </span>\n                <span class=\"legend-item\" data-kid=\"1-3-2-4-3\">\n                    <i class=\"legend-dot zoom\" data-kid=\"1-3-2-4-3-1\">\n                    </i>\n                    Zoom\n                </span>\n                <span class=\"legend-item\" data-kid=\"1-3-2-4-4\">\n                    <i class=\"legend-dot vfx\" data-kid=\"1-3-2-4-4-1\">\n                    </i>\n                    VFX\n                </span>\n            </div>\n        </div>\n    </section>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons({ attrs: { 'stroke-width': 1.8 } });\n</script>\n",
      "comments": [],
      "created": "2026-08-16T04:19:33.466555+00:00",
      "modified": "2026-08-16T04:20:28.397414+00:00",
      "id": "var_d3686d18cbe4",
