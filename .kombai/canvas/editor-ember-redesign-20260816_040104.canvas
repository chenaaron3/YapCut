-1\">\n                    </span>\n                </div>\n                <div class=\"mono flex w-full justify-between pr-5 text-[9px] tracking-[.1em] text-[#F5F9CE]/55\" data-kid=\"1-3-1-1-2\">\n                    <span class=\"text-[#FFA102]\" data-kid=\"1-3-1-1-2-1\" data-name=\"timeline current time marker\">\n                        0:00\n                    </span>\n                    <span data-kid=\"1-3-1-1-2-2\" data-name=\"timeline timestamp\">\n                        0:05\n                    </span>\n                    <span data-kid=\"1-3-1-1-2-3\" data-name=\"timeline timestamp\">\n                        0:10\n                    </span>\n                    <span data-kid=\"1-3-1-1-2-4\" data-name=\"timeline timestamp\">\n                        0:15\n                    </span>\n                    <span data-kid=\"1-3-1-1-2-5\" data-name=\"timeline timestamp\">\n                        0:20\n                    </span>\n                    <span data-kid=\"1-3-1-1-2-6\" data-name=\"timeline timestamp\">\n                        0:25\n                    </span>\n                    <span data-kid=\"1-3-1-1-2-7\" data-name=\"timeline timestamp\">\n                        0:30\n                    </span>\n                </div>\n            </div>\n            <div class=\"px-5 py-3\" data-kid=\"1-3-1-2\">\n                <div class=\"timeline-track relative flex h-[40px] items-center border-b border-[#F5F9CE]/10\" data-kid=\"1-3-1-2-1\">\n                    <div class=\"track-label mono w-[72px] shrink-0 text-[10px] font-semibold tracking-[.12em] text-[#F5F9CE]/55\" data-kid=\"1-3-1-2-1-1\">\n                        VIDEO\n                    </div>\n                    <div class=\"relative h-7 flex-1 rounded-[7px] border border-[#F5F9CE]/10 bg-[#1D151A]\" data-kid=\"1-3-1-2-1-2\">\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[2%] w-[14%] rounded-[5px] border border-[#FFA102] bg-[#C9A227] px-2 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"video timeline block\" style=\"transition:transform 180ms\">\n                            KEEP / 1.9s\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[17%] w-[9%] rounded-[5px] bg-[#BC2D29] px-2 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"video timeline block\" style=\"transition:transform 180ms\">\n                            CUT\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[27%] w-[16%] rounded-[5px] bg-[#C9A227] px-2 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-1-2-3\" data-name=\"video timeline block\" style=\"transition:transform 180ms\">\n                            KEEP / 2.6s\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[46%] w-[17%] rounded-[5px] bg-[#C9A227] px-2 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-1-2-4\" data-name=\"video timeline block\" style=\"transition:transform 180ms\">\n                            KEEP / 3.0s\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[66%] w-[18%] rounded-[5px] bg-[#BC2D29] px-2 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-1-2-5\" data-name=\"video timeline block\" style=\"transition:transform 180ms\">\n                            KEEP / 3.1s\n                        </span>\n                    </div>\n                </div>\n                <div class=\"timeline-track relative flex h-[40px] items-center border-b border-[#F5F9CE]/10\" data-kid=\"1-3-1-2-2\">\n                    <div class=\"track-label mono w-[72px] shrink-0 text-[10px] font-semibold tracking-[.12em] text-[#F5F9CE]/55\" data-kid=\"1-3-1-2-2-1\">\n                        CAPTIONS\n                    </div>\n                    <div class=\"relative h-7 flex-1 rounded-[7px] border border-[#F5F9CE]/10 bg-[#1D151A]\" data-kid=\"1-3-1-2-2-2\">\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[3%] w-[4%] rounded-[4px] bg-[#432E6F]\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"caption timeline block\" style=\"transition:transform 180ms\">\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[8%] w-[15%] rounded-[4px] bg-[#432E6F] px-1 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"caption timeline block\" style=\"transition:transform 180ms\">\n                            Top three tricks\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[26%] w-[11%] rounded-[4px] bg-[#432E6F] px-1 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-2-2-3\" data-name=\"caption timeline block\" style=\"transition:transform 180ms\">\n                            overlay text\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[42%] w-[13%] rounded-[4px] bg-[#432E6F] px-1 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-2-2-4\" data-name=\"caption timeline block\" style=\"transition:transform 180ms\">\n                            Tip number two\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[61%] w-[18%] rounded-[4px] bg-[#432E6F] px-1 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-2-2-5\" data-name=\"caption timeline block\" style=\"transition:transform 180ms\">\n                            sound effects\n                        </span>\n                    </div>\n                </div>\n                <div class=\"timeline-track relative flex h-[40px] items-center border-b border-[#F5F9CE]/10\" data-kid=\"1-3-1-2-3\">\n                    <div class=\"track-label mono w-[72px] shrink-0 text-[10px] font-semibold tracking-[.12em] text-[#F5F9CE]/55\" data-kid=\"1-3-1-2-3-1\">\n                        SFX\n                    </div>\n                    <div class=\"relative h-7 flex-1 rounded-[7px] border border-[#F5F9CE]/10 bg-[#1D151A]\" data-kid=\"1-3-1-2-3-2\">\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[4%] w-[4%] rounded-[4px] border border-[#2DD4BF]/70 bg-[#2DD4BF]/70\" data-kid=\"1-3-1-2-3-2-1\" data-name=\"sfx timeline block\" style=\"transition:transform 180ms\">\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[33%] w-[5%] rounded-[4px] border border-[#2DD4BF]/70 bg-[#2DD4BF]/70 px-1 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-3-2-2\" data-name=\"sfx timeline block\" style=\"transition:transform 180ms\">\n                            click\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[71%] w-[5%] rounded-[4px] border border-[#2DD4BF]/70 bg-[#2DD4BF]/70 px-1 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-3-2-3\" data-name=\"sfx timeline block\" style=\"transition:transform 180ms\">\n                            pop\n                        </span>\n                    </div>\n                </div>\n                <div class=\"timeline-track relative flex h-[40px] items-center border-b border-[#F5F9CE]/10\" data-kid=\"1-3-1-2-4\">\n                    <div class=\"track-label mono w-[72px] shrink-0 text-[10px] font-semibold tracking-[.12em] text-[#F5F9CE]/55\" data-kid=\"1-3-1-2-4-1\">\n                        ZOOM\n                    </div>\n                    <div class=\"relative h-7 flex-1 rounded-[7px] border border-[#F5F9CE]/10 bg-[#1D151A]\" data-kid=\"1-3-1-2-4-2\">\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[19%] w-[7%] rounded-[4px] border border-[#3B82F6]/80 bg-[#3B82F6]/70 px-1 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-4-2-1\" data-name=\"zoom timeline block\" style=\"transition:transform 180ms\">\n                            1.10×\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[55%] w-[7%] rounded-[4px] border border-[#3B82F6]/80 bg-[#3B82F6]/70 px-1 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-4-2-2\" data-name=\"zoom timeline block\" style=\"transition:transform 180ms\">\n                            1.10×\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[82%] w-[6%] rounded-[4px] border border-[#3B82F6]/80 bg-[#3B82F6]/70 px-1 text-[8px] leading-5 text-[#F5F9CE]\" data-kid=\"1-3-1-2-4-2-3\" data-name=\"zoom timeline block\" style=\"transition:transform 180ms\">\n                            1.15×\n                        </span>\n                    </div>\n                </div>\n                <div class=\"timeline-track relative flex h-[40px] items-center\" data-kid=\"1-3-1-2-5\">\n                    <div class=\"track-label mono w-[72px] shrink-0 text-[10px] font-semibold tracking-[.12em] text-[#F5F9CE]/55\" data-kid=\"1-3-1-2-5-1\">\n                        VFX\n                    </div>\n                    <div class=\"relative h-7 flex-1 rounded-[7px] border border-[#F5F9CE]/10 bg-[#1D151A]\" data-kid=\"1-3-1-2-5-2\">\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[3%] w-[10%] rounded-[4px] border border-[#DD5533] bg-[#DD5533]/80 px-1 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-5-2-1\" data-name=\"vfx timeline block\" style=\"transition:transform 180ms\">\n                            Title frame\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[25%] w-[15%] rounded-[4px] border border-[#DD5533] bg-[#DD5533]/80 px-1 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-5-2-2\" data-name=\"vfx timeline block\" style=\"transition:transform 180ms\">\n                            Quote / emphasis\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[57%] w-[12%] rounded-[4px] border border-[#DD5533] bg-[#DD5533]/80 px-1 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-5-2-3\" data-name=\"vfx timeline block\" style=\"transition:transform 180ms\">\n                            Listicle 01\n                        </span>\n                        <span class=\"timeline-block absolute top-1 bottom-1 left-[78%] w-[14%] rounded-[4px] border border-[#DD5533] bg-[#DD5533]/80 px-1 text-[8px] leading-5 text-[#450E16]\" data-kid=\"1-3-1-2-5-2-4\" data-name=\"vfx timeline block\" style=\"transition:transform 180ms\">\n                            Bold white\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4 border-t border-[#F5F9CE]/10 px-5 py-2.5\" data-kid=\"1-3-1-3\">\n                <span class=\"mono text-[8px] tracking-[.16em] text-[#F5F9CE]/45 uppercase\" data-kid=\"1-3-1-3-1\">\n                    Edit types\n                </span>\n                <span class=\"mono inline-flex items-center gap-1.5 text-[9px] text-[#C9A227]\" data-kid=\"1-3-1-3-2\">\n                    <i class=\"icon-sm\" data-kid=\"1-3-1-3-2-1\" data-lucide=\"video\" style=\"color:#C9A227\">\n                    </i>\n                    Video\n                </span>\n                <span class=\"mono inline-flex items-center gap-1.5 text-[9px] text-[#432E6F]\" data-kid=\"1-3-1-3-3\">\n                    <i class=\"icon-sm\" data-kid=\"1-3-1-3-3-1\" data-lucide=\"captions\" style=\"color:#A78BFA\">\n                    </i>\n                    Captions\n                </span>\n                <span class=\"mono inline-flex items-center gap-1.5 text-[9px] text-[#2DD4BF]\" data-kid=\"1-3-1-3-4\">\n                    <i class=\"icon-sm\" data-kid=\"1-3-1-3-4-1\" data-lucide=\"volume-2\" style=\"color:#2DD4BF\">\n                    </i>\n                    SFX\n                </span>\n                <span class=\"mono inline-flex items-center gap-1.5 text-[9px] text-[#3B82F6]\" data-kid=\"1-3-1-3-5\">\n                    <i class=\"icon-sm\" data-kid=\"1-3-1-3-5-1\" data-lucide=\"zoom-in\" style=\"color:#3B82F6\">\n                    </i>\n                    Zoom\n                </span>\n                <span class=\"mono inline-flex items-center gap-1.5 text-[9px] text-[#DD5533]\" data-kid=\"1-3-1-3-6\">\n                    <i class=\"icon-sm\" data-kid=\"1-3-1-3-6-1\" data-lucide=\"sparkles\" style=\"color:#DD5533\">\n                    </i>\n                    VFX\n                </span>\n            </div>\n        </div>\n    </section>\n</div>\n<script>\n    lucide.createIcons();\n</script>\n",
      "comments": [],
      "created": "2026-08-16T04:03:08.916610+00:00",
      "modified": "2026-08-16T04:03:52.837208+00:00",
      "id": "var_f986814f7554"
    },
    "var_24ef7a635f91": {
      "type": "variant",
      "label": "02 — Ember Workbench / Crimson Console",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  :root {\n    --ink: #450e16;\n    --ink-deep: #2a1117;\n    --crimson: #bc2d29;\n    --cream: #f5f9ce;\n    --orange: #ffa102;\n    --purple: #432e6f;\n    --tomato: #dd5533;\n    --teal: #2dd4bf;\n    --blue: #3b82f6;\n    --lilac: #a78bfa;\n    --muted-ink: #75677f;\n    --hairline: rgba(69, 14, 22, .2);\n    --dark-line: rgba(245, 249, 206, .16);\n    --serif: 'Cormorant Garamond', Georgia, serif;\n    --sans: 'IBM Plex Sans', Arial, sans-serif;\n    --mono: 'JetBrains Mono', monospace;\n  }\n  * { box-sizing: border-box; }\n  .ember-editor, .ember-editor button, .ember-editor input { font-family: var(--sans); }\n  .ember-editor {\n    min-height: 100vh;\n    width: 100%;\n    overflow: hidden;\n    position: relative;\n    display: grid;\n    grid-template-rows: 64px minmax(0, 1fr) 304px;\n    color: var(--cream);\n    background: var(--ink);\n    isolation: isolate;\n  }\n  .ember-editor::before {\n    content: '';\n    position: absolute;\n    z-index: -2;\n    inset: -22% 40% 42% -12%;\n    background: linear-gradient(128deg, rgba(255,161,2,.34), rgba(221,85,51,.18) 46%, rgba(67,46,111,.48));\n    clip-path: polygon(0 15%, 77% 0, 100% 68%, 35% 100%);\n    opacity: .75;\n  }\n  .ember-editor::after {\n    content: '';\n    position: absolute;\n    z-index: -1;\n    inset: 0;\n    pointer-events: none;\n    opacity: .1;\n    background-image: radial-gradient(rgba(245,249,206,.7) .6px, transparent .7px);\n    background-size: 8px 8px;\n    mix-blend-mode: screen;\n  }\n  .topbar {\n    position: relative;\n    z-index: 5;\n    display: grid;\n    grid-template-columns: 1fr auto 1fr;\n    align-items: center;\n    gap: 18px;\n    padding: 0 18px;\n    border-bottom: 1px solid rgba(245,249,206,.18);\n    background: rgba(188,45,41,.96);\n    box-shadow: 0 4px 0 rgba(42,17,23,.34);\n  }\n  .top-left, .top-right, .brand-lockup, .top-actions, .toolbar-actions, .toolbar-left, .player-controls, .time-readout { display: flex; align-items: center; }\n  .top-left { min-width: 0; gap: 16px; }\n  .top-right { justify-content: flex-end; gap: 8px; }\n  .brand-lockup { gap: 8px; color: var(--cream); text-decoration: none; }\n  .brand-mark {\n    display: grid;\n    width: 27px;\n    height: 27px;\n    place-items: center;\n    border: 1px solid var(--cream);\n    border-radius: 8px;\n    color: var(--orange);\n    font: 600 15px/1 var(--serif);\n    box-shadow: 2px 2px 0 var(--ink);\n  }\n  .brand-name { font: 600 16px/1 var(--serif); letter-spacing: -.02em; }\n  .projects-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    color: rgba(245,249,206,.72);\n    font: 500 11px/1 var(--mono);\n    text-decoration: none;\n    letter-spacing: .03em;\n  }\n  .projects-link:hover, .projects-link:focus-visible { color: var(--cream); }\n  .project-title {\n    min-width: 250px;\n    border: 1px solid transparent;\n    border-radius: 7px;\n    background: transparent;\n    color: var(--cream);\n    text-align: center;\n    font: 700 20px/1 var(--serif);\n    letter-spacing: -.015em;\n    outline: none;\n  }\n  .project-title:hover, .project-title:focus-visible { border-color: rgba(245,249,206,.32); background: rgba(69,14,22,.22); }\n  .save-pill, .edit-count, .status-tag {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    border: 1px solid rgba(245,249,206,.22);\n    border-radius: 999px;\n    color: rgba(245,249,206,.84);\n    font: 500 10px/1 var(--mono);\n    white-space: nowrap;\n  }\n  .save-pill { padding: 7px 10px; background: rgba(69,14,22,.22); }\n  .save-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 3px rgba(45,212,191,.16); }\n  .chrome-btn, .icon-button, .rail-tab, .edit-tile, .style-option {\n    cursor: pointer;\n    color: inherit;\n    border: 0;\n    outline: none;\n  }\n  .chrome-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-height: 35px;\n    padding: 0 13px;\n    border-radius: 9px;\n    font: 600 11px/1 var(--sans);\n    letter-spacing: .01em;\n  }\n  .chrome-btn:focus-visible, .icon-button:focus-visible, .rail-tab:focus-visible, .edit-tile:focus-visible, .style-option:focus-visible { box-shadow: 0 0 0 3px rgba(255,161,2,.42); }\n  .chrome-btn.ghost { border: 1px solid rgba(245,249,206,.42); background: transparent; color: var(--cream); }\n  .chrome-btn.ghost:hover { border-color: var(--orange); color: var(--orange); background: rgba(255,161,2,.07); }\n  .export-group { display: inline-flex; overflow: hidden; border: 2px solid var(--ink); border-radius: 10px; box-shadow: 3px 3px 0 var(--ink); }\n  .chrome-btn.export, .chrome-btn.export-menu { min-height: 33px; border-radius: 0; background: var(--orange); color: var(--ink); }\n  .chrome-btn.export { padding: 0 14px; }\n  .chrome-btn.export-menu { width: 32px; padding: 0; border-left: 1px solid rgba(69,14,22,.42); }\n  .chrome-btn.export:hover, .chrome-btn.export-menu:hover { background: #ffb62d; }\n  .workbench {\n    min-height: 0;\n    display: grid;\n    grid-template-columns: 230px minmax(0, 1fr) 360px;\n    gap: 0;\n    border-bottom: 1px solid rgba(245,249,206,.18);\n  }\n  .asset-rail {\n    min-width: 0;\n    position: relative;\n    overflow: hidden;\n    border-right: 1px solid rgba(245,249,206,.18);\n    background: var(--crimson);\n  }\n  .asset-rail::after {\n    content: '';\n    position: absolute;\n    right: -28px;\n    bottom: -48px;\n    width: 108px;\n    height: 160px;\n    background: linear-gradient(135deg, rgba(255,161,2,.9), rgba(67,46,111,.85));\n    clip-path: polygon(50% 0, 100% 32%, 66% 100%, 0 67%);\n    opacity: .35;\n    transform: rotate(14deg);\n  }\n  .rail-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 15px 12px; border-bottom: 1px solid rgba(245,249,206,.2); }\n  .section-kicker { color: rgba(245,249,206,.64); font: 500 9px/1 var(--mono); letter-spacing: .16em; text-transform: uppercase; }\n  .rail-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 11px 11px 13px; border-bottom: 1px solid rgba(245,249,206,.18); }\n  .rail-tab { min-height: 48px; padding: 7px 3px; border-radius: 7px; background: transparent; color: rgba(245,249,206,.62); font: 500 9px/1.1 var(--mono); text-transform: uppercase; letter-spacing: .03em; }\n  .rail-tab:hover, .rail-tab.active { background: var(--cream); color: var(--ink); box-shadow: 3px 3px 0 var(--ink); }\n  .rail-tab i { display: block; margin: 0 auto 6px; }\n  .tile-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; padding: 14px 12px; }\n  .edit-tile { position: relative; min-height: 80px; padding: 11px 10px; overflow: hidden; border: 1px solid rgba(245,249,206,.22); border-radius: 10px; background: rgba(69,14,22,.25); color: var(--cream); text-align: left; transition: transform .18s ease, border-color .18s ease, background .18s ease; }\n  .edit-tile::before { content: ''; position: absolute; top: -19px; right: -15px; width: 40px; height: 40px; background: var(--orange); opacity: .2; clip-path: polygon(50% 0, 100% 55%, 50% 100%, 0 55%); }\n  .edit-tile:hover, .edit-tile.selected { transform: translate(-2px,-2px); border-color: var(--orange); background: var(--ink); box-shadow: 4px 4px 0 var(--orange); }\n  .tile-icon { display: grid; width: 27px; height: 27px; place-items: center; margin-bottom: 9px; border-radius: 7px; color: var(--ink); }\n  .tile-icon.orange { background: var(--orange); }\n  .tile-icon.tomato { background: var(--tomato); }\n  .tile-icon.teal { background: var(--teal); }\n  .tile-icon.lilac { background: var(--lilac); }\n  .tile-label { display: block; font: 600 13px/1 var(--serif); }\n  .tile-meta { display: block; margin-top: 5px; color: rgba(245,249,206,.54); font: 9px/1 var(--mono); text-transform: uppercase; }\n  .transcript-panel { min-width: 0; min-height: 0; display: flex; flex-direction: column; background: var(--cream); color: var(--ink); }\n  .transcript-toolbar { display: flex; align-items: center; justify-content: space-between; min-height: 58px; padding: 0 20px; border-bottom: 1px solid var(--hairline); background: rgba(245,249,206,.9); }\n  .toolbar-left { gap: 11px; }\n  .toolbar-title { font: 700 18px/1 var(--serif); letter-spacing: -.015em; }\n  .edit-count { padding: 7px 10px; border-color: rgba(69,14,22,.22); background: rgba(188,45,41,.08); color: var(--purple); }\n  .edit-count b { color: var(--tomato); font-weight: 600; }\n  .toolbar-actions { gap: 4px; }\n  .paper-btn { display: inline-flex; align-items: center; gap: 7px; min-height: 31px; padding: 0 10px; border: 1px solid transparent; border-radius: 7px; background: transparent; color: var(--purple); font: 600 10px/1 var(--sans); }\n  .paper-btn:hover, .paper-btn.active { border-color: var(--hairline); background: rgba(67,46,111,.08); color: var(--ink); }\n  .transcript-scroll { min-height: 0; flex: 1; overflow: hidden; position: relative; display: grid; grid-template-columns: minmax(0,1fr) 190px; }\n  .word-canvas { min-width: 0; padding: 30px 30px 20px 28px; overflow: hidden; }\n  .transcript-note { display: flex; align-items: center; gap: 8px; margin-bottom: 22px; color: var(--muted-ink); font: 10px/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; }\n  .transcript-note::before { content: ''; width: 22px; height: 2px; background: var(--orange); }\n  .sentence { margin: 0 0 18px; font: 600 clamp(24px, 2.25vw, 34px)/1.08 var(--serif); letter-spacing: -.02em; }\n  .sentence.secondary { color: rgba(69,14,22,.66); }\n  .sentence strong { color: var(--ink); font-weight: 700; }\n  .word { display: inline; padding: 0 2px; border-radius: 3px; }\n  .word.hot { background: rgba(255,161,2,.46); box-shadow: inset 0 -3px 0 var(--orange); }\n  .word.tomato { background: rgba(221,85,51,.2); box-shadow: inset 0 -3px 0 var(--tomato); }\n  .word.teal { background: rgba(45,212,191,.2); box-shadow: inset 0 -3px 0 var(--teal); }\n  .word.blue { background: rgba(59,130,246,.14); box-shadow: inset 0 -3px 0 var(--blue); }\n  .inline-chip { display: inline-flex; vertical-align: 10%; align-items: center; gap: 4px; min-height: 22px; margin: 0 3px; padding: 0 6px; border: 1px solid rgba(69,14,22,.32); border-radius: 6px; color: var(--ink); font: 600 9px/1 var(--mono); letter-spacing: .01em; }\n  .inline-chip.orange { background: var(--orange); }\n  .inline-chip.teal { background: var(--teal); }\n  .inline-chip.tomato { background: var(--tomato); }\n  .inline-chip.blue { background: var(--blue); color: var(--cream); }\n  .selection-underline { border-bottom: 2px dashed var(--tomato); }\n  .paper-footer { display: flex; align-items: center; gap: 10px; margin-top: 28px; padding-top: 15px; border-top: 1px solid var(--hairline); color: var(--muted-ink); font: 10px/1 var(--mono); }\n  .paper-footer .spark { color: var(--orange); }\n  .mini-inspector { min-width: 0; border-left: 1px solid var(--hairline); background: rgba(255,255,255,.22); }\n  .mini-inspector-head { display: flex; align-items: center; justify-content: space-between; padding: 17px 14px 13px; border-bottom: 1px solid var(--hairline); }\n  .mini-inspector h3 { margin: 0; font: 700 17px/1 var(--serif); }\n  .mini-inspector-body { padding: 14px; }\n  .inspector-label { color: var(--muted-ink); font: 600 9px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; }\n  .style-option { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 38px; margin-top: 8px; padding: 0 9px; border: 1px solid rgba(69,14,22,.22); border-radius: 7px; background: rgba(245,249,206,.45); color: var(--ink); text-align: left; font: 600 11px/1 var(--sans); }\n  .style-option:hover { border-color: var(--orange); background: rgba(255,161,2,.13); }\n  .style-option.active { border-color: var(--ink); background: var(--purple); color: var(--cream); box-shadow: 3px 3px 0 var(--orange); }\n  .style-option i { opacity: .62; }\n  .style-option.active i { opacity: 1; color: var(--orange); }\n  .preview-column { min-width: 0; min-height: 0; display: flex; flex-direction: column; border-left: 1px solid rgba(245,249,206,.18); background: var(--ink-deep); }\n  .preview-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 14px 11px; border-bottom: 1px solid var(--dark-line); }\n  .preview-head strong { font: 700 18px/1 var(--serif); }\n  .status-tag { padding: 6px 8px; border-color: rgba(45,212,191,.42); color: var(--teal); background: rgba(45,212,191,.08); }\n  .stage-wrap { min-height: 0; flex: 1; display: flex; align-items: center; justify-content: center; padding: 15px 12px 11px; background: #211317; }\n  .video-stage { position: relative; width: min(196px, 72%); aspect-ratio: 9 / 16; overflow: hidden; border: 2px solid var(--cream); background: linear-gradient(155deg, #eadab7 0%, #f5f9ce 50%, #d9b47c 100%); box-shadow: 6px 6px 0 rgba(255,161,2,.58); }\n  .video-stage::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, transparent 45%, rgba(69,14,22,.12) 46% 58%, transparent 59%), radial-gradient(circle at 65% 28%, rgba(255,255,255,.55), transparent 22%); }\n  .stage-topline { position: absolute; top: 12px; left: 11px; right: 11px; display: flex; justify-content: space-between; color: rgba(69,14,22,.68); font: 8px/1 var(--mono); letter-spacing: .09em; text-transform: uppercase; }\n  .stage-copy { position: absolute; right: 12px; bottom: 48px; left: 12px; color: var(--ink); font: 700 25px/.84 var(--serif); letter-spacing: -.04em; }\n  .stage-copy em { color: var(--tomato); font-style: normal; }\n  .stage-chip { position: absolute; right: 12px; bottom: 15px; padding: 5px 7px; border: 1px solid var(--ink); border-radius: 4px; background: var(--orange); color: var(--ink); font: 600 8px/1 var(--mono); }\n  .player-controls { justify-content: space-between; min-height: 38px; padding: 0 13px; border-top: 1px solid rgba(245,249,206,.18); border-bottom: 1px solid rgba(245,249,206,.18); background: rgba(69,14,22,.42); }\n  .time-readout { gap: 7px; color: var(--orange); font: 600 10px/1 var(--mono); }\n  .time-readout span { color: rgba(245,249,206,.4); }\n  .control-icons { display: flex; align-items: center; gap: 4px; }\n  .icon-button { display: grid; width: 27px; height: 27px; place-items: center; border-radius: 6px; background: transparent; color: rgba(245,249,206,.62); }\n  .icon-button:hover { background: rgba(245,249,206,.11); color: var(--cream); }\n  .icon-button.play { border: 1px solid var(--orange); background: var(--orange); color: var(--ink); box-shadow: 2px 2px 0 var(--ink); }\n  .caption-inspector { padding: 12px 13px 13px; background: var(--crimson); }\n  .caption-inspector .section-kicker { color: rgba(245,249,206,.62); }\n  .caption-inspector h3 { margin: 5px 0 10px; color: var(--cream); font: 700 22px/1 var(--serif); }\n  .inspector-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\n  .caption-option { min-height: 49px; padding: 7px 5px; border: 1px solid rgba(245,249,206,.28); border-radius: 6px; background: rgba(69,14,22,.22); color: rgba(245,249,206,.7); text-align: center; font: 600 9px/1.1 var(--sans); }\n  .caption-option:hover, .caption-option.active { border-color: var(--orange); background: var(--cream); color: var(--ink); box-shadow: 3px 3px 0 var(--ink); }\n  .caption-sample { display: block; margin-bottom: 6px; font: 700 14px/.8 var(--serif); }\n  .caption-option:nth-child(2) .caption-sample { color: var(--tomato); }\n  .caption-option:nth-child(3) .caption-sample { color: var(--orange); }\n  .timeline {\n    min-height: 0;\n    position: relative;\n    overflow: hidden;\n    padding: 0 16px 11px;\n    background: var(--ink-deep);\n    color: var(--cream);\n  }\n  .timeline::before { content: ''; position: absolute; top: 0; left: 0; width: 38%; height: 3px; background: linear-gradient(90deg, var(--orange), var(--tomato), var(--purple)); }\n  .timeline-head { display: flex; align-items: center; justify-content: space-between; height: 42px; padding-left: 72px; border-bottom: 1px solid var(--dark-line); }\n  .timeline-head-left { display: flex; align-items: center; gap: 12px; }\n  .timeline-title { color: var(--cream); font: 600 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; }\n  .timeline-sub { color: rgba(245,249,206,.4); font: 9px/1 var(--mono); }\n  .timeline-actions { display: flex; gap: 5px; }\n  .timeline-control { padding: 5px 8px; border: 1px solid rgba(245,249,206,.17); border-radius: 5px; background: rgba(245,249,206,.04); color: rgba(245,249,206,.55); font: 9px/1 var(--mono); }\n  .timeline-control:hover { border-color: var(--orange); color: var(--orange); }\n  .ruler { position: relative; height: 26px; margin-left: 72px; border-bottom: 1px solid rgba(245,249,206,.18); background: repeating-linear-gradient(90deg, transparent 0 28px, rgba(245,249,206,.18) 28px 29px); }\n  .ruler::after { content: ''; position: absolute; inset: auto 0 0; height: 8px; background: repeating-linear-gradient(90deg, rgba(245,249,206,.42) 0 1px, transparent 1px 112px); opacity: .72; }\n  .ruler-labels { position: absolute; inset: 4px 0 auto; display: flex; justify-content: space-between; padding: 0 8px; color: rgba(245,249,206,.58); font: 9px/1 var(--mono); }\n  .timeline-body { position: relative; padding-top: 6px; }\n  .playhead { position: absolute; z-index: 8; top: -1px; bottom: 0; left: 20%; width: 2px; background: var(--orange); box-shadow: 0 0 0 1px rgba(255,161,2,.2); }\n  .playhead::before { content: ''; position: absolute; top: -8px; left: -5px; width: 12px; height: 10px; border-radius: 3px 3px 6px 6px; background: var(--orange); box-shadow: 2px 2px 0 var(--ink); }\n  .playhead::after { content: '00:04.7'; position: absolute; top: -24px; left: -18px; padding: 4px 6px; border-radius: 4px; background: var(--orange); color: var(--ink); font: 600 9px/1 var(--mono); white-space: nowrap; }\n  .track-row { display: grid; grid-template-columns: 72px minmax(0,1fr); min-height: 35px; align-items: center; }\n  .track-label { color: rgba(245,249,206,.58); font: 600 9px/1 var(--mono); letter-spacing: .08em; }\n  .track-lane { position: relative; height: 27px; border: 1px solid rgba(245,249,206,.12); border-radius: 5px; background: rgba(245,249,206,.035); }\n  .clip { position: absolute; top: 4px; bottom: 4px; overflow: hidden; display: flex; align-items: center; padding: 0 7px; border-radius: 4px; border: 1px solid rgba(69,14,22,.6); color: var(--ink); font: 600 9px/1 var(--mono); white-space: nowrap; }\n  .clip.video { background: #d6aa18; }\n  .clip.video.alt { background: #e4c34e; }\n  .clip.caption { background: rgba(245,249,206,.2); border-color: rgba(245,249,206,.3); color: rgba(245,249,206,.76); }\n  .clip.sfx { background: var(--teal); }\n  .clip.zoom { background: var(--lilac); }\n  .clip.vfx { background: #f18a9e; }\n  .clip.selected { outline: 2px solid var(--orange); outline-offset: 2px; box-shadow: 4px 4px 0 var(--orange); }\n  .handle { position: absolute; top: 3px; bottom: 3px; width: 3px; border-radius: 3px; background: rgba(69,14,22,.7); }\n  .handle.left { left: 3px; }\n  .handle.right { right: 3px; }\n  .track-row + .track-row { margin-top: 1px; }\n  .timeline-legend { display: flex; align-items: center; gap: 12px; margin-left: 72px; padding-top: 7px; color: rgba(245,249,206,.45); font: 8px/1 var(--mono); text-transform: uppercase; }\n  .legend-item { display: inline-flex; align-items: center; gap: 4px; }\n  .legend-dot { width: 6px; height: 6px; border-radius: 2px; }\n  @media (max-width: 1080px) {\n    .workbench { grid-template-columns: 190px minmax(0,1fr) 300px; }\n    .topbar { grid-template-columns: auto 1fr auto; }\n    .project-title { min-width: 190px; font-size: 17px; }\n    .transcript-scroll { grid-template-columns: minmax(0,1fr) 160px; }\n    .sentence { font-size: 26px; }\n  }\n  @media (max-width: 820px) {\n    .ember-editor { grid-template-rows: auto minmax(0,1fr) 300px; overflow: auto; }\n    .topbar { grid-template-columns: 1fr auto; min-height: 64px; padding: 10px 14px; }\n    .project-title { grid-column: 1 / -1; grid-row: 2; width: 100%; }\n    .top-right { grid-column: 2; grid-row: 1; }\n    .workbench { grid-template-columns: 1fr; min-height: 0; overflow: auto; }\n    .asset-rail { min-height: 190px; border-right: 0; border-bottom: 1px solid rgba(245,249,206,.18); }\n    .rail-tabs { grid-template-columns: repeat(4, minmax(0,1fr)); }\n    .tile-grid { grid-template-columns: repeat(4, minmax(0,1fr)); }\n    .transcript-panel { min-height: 460px; }\n    .preview-column { min-height: 500px; border-left: 0; border-top: 1px solid rgba(245,249,206,.18); }\n    .timeline { min-height: 300px; }\n  }\n</style>\n<div aria-label=\"YapCut Ember editor workbench\" class=\"ember-editor\" data-kid=\"1\" data-name=\"YapCut Ember editor workbench\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <div class=\"top-left\" data-kid=\"1-1-1\" data-name=\"top navigation left section\">\n            <a aria-label=\"YapCut home\" class=\"brand-lockup\" data-kid=\"1-1-1-1\" data-name=\"brand identity lockup\" href=\"#\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo mark\">\n                    Y\n                </span>\n                <span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    YapCut\n                </span>\n            </a>\n            <a class=\"projects-link\" data-kid=\"1-1-1-2\" data-name=\"projects navigation link\" href=\"#\">\n                <i data-kid=\"1-1-1-2-1\" data-lucide=\"arrow-left\" data-name=\"back arrow icon\" style=\"width:13px;height:13px\">\n                </i>\n                Projects\n            </a>\n        </div>\n        <input aria-label=\"Project title\" class=\"project-title\" data-kid=\"1-1-2\" data-name=\"project title input field\" value=\"Top Three Video Editing Tricks\"/>\n        <div class=\"top-right\" data-kid=\"1-1-3\" data-name=\"top navigation right actions\">\n            <span class=\"save-pill\" data-kid=\"1-1-3-1\" data-name=\"save status indicator\" title=\"All changes saved\">\n                <span class=\"save-dot\" data-kid=\"1-1-3-1-1\" data-name=\"save status dot\">\n                </span>\n                Saved\n            </span>\n            <button aria-label=\"Generate edits\" class=\"chrome-btn ghost\" data-kid=\"1-1-3-2\" data-name=\"generate edits button\" title=\"Generate a new set of edits\" type=\"button\">\n                <i data-kid=\"1-1-3-2-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\" style=\"width:14px;height:14px\">\n                </i>\n                Generate edits\n            </button>\n            <div aria-label=\"Export actions\" class=\"export-group\" data-kid=\"1-1-3-3\" data-name=\"export action group\" role=\"group\">\n                <button class=\"chrome-btn export\" data-kid=\"1-1-3-3-1\" data-name=\"primary export button\" type=\"button\">\n                    <i data-kid=\"1-1-3-3-1-1\" data-lucide=\"cloud-upload\" data-name=\"cloud upload icon\" style=\"width:14px;height:14px\">\n                    </i>\n                    Export video\n                </button>\n                <button aria-label=\"More export actions\" class=\"chrome-btn export-menu\" data-kid=\"1-1-3-3-2\" data-name=\"export menu button\" title=\"Download or schedule\" type=\"button\">\n                    <i data-kid=\"1-1-3-3-2-1\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" style=\"width:14px;height:14px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"workbench\" data-kid=\"1-2\" data-name=\"main editor workbench\">\n        <aside aria-label=\"Edit tools\" class=\"asset-rail\" data-kid=\"1-2-1\" data-name=\"asset editing rail\">\n            <div class=\"rail-head\" data-kid=\"1-2-1-1\" data-name=\"rail header\">\n                <span class=\"section-kicker\" data-kid=\"1-2-1-1-1\" data-name=\"section kicker text\">\n                    Edit kit\n                </span>\n                <button aria-label=\"Collapse edit kit\" class=\"icon-button\" data-kid=\"1-2-1-1-2\" data-name=\"collapse rail button\" title=\"Collapse edit kit\" type=\"button\">\n                    <i data-kid=\"1-2-1-1-2-1\" data-lucide=\"panel-left-close\" data-name=\"panel close icon\" style=\"width:14px;height:14px\">\n                    </i>\n                </button>\n            </div>\n            <nav aria-label=\"Asset tabs\" class=\"rail-tabs\" data-kid=\"1-2-1-2\" data-name=\"asset category tabs\">\n                <button class=\"rail-tab active\" data-kid=\"1-2-1-2-1\" data-name=\"A-roll tab button\" type=\"button\">\n                    <i data-kid=\"1-2-1-2-1-1\" data-lucide=\"video\" data-name=\"video icon\" style=\"width:15px;height:15px\">\n                    </i>\n                    A-roll\n                </button>\n                <button class=\"rail-tab\" data-kid=\"1-2-1-2-2\" data-name=\"B-roll tab button\" type=\"button\">\n                    <i data-kid=\"1-2-1-2-2-1\" data-lucide=\"layers-2\" data-name=\"layers icon\" style=\"width:15px;height:15px\">\n                    </i>\n                    B-roll\n                </button>\n                <button class=\"rail-tab\" data-kid=\"1-2-1-2-3\" data-name=\"VFX tab button\" type=\"button\">\n                    <i data-kid=\"1-2-1-2-3-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\" style=\"width:15px;height:15px\">\n                    </i>\n                    VFX\n                </button>\n                <button class=\"rail-tab\" data-kid=\"1-2-1-2-4\" data-name=\"transitions tab button\" type=\"button\">\n                    <i data-kid=\"1-2-1-2-4-1\" data-lucide=\"arrow-left-right\" data-name=\"arrows icon\" style=\"width:15px;height:15px\">\n                    </i>\n                    Trans.\n                </button>\n            </nav>\n            <div class=\"tile-grid\" data-kid=\"1-2-1-3\" data-name=\"edit effect tile grid\">\n                <button aria-label=\"Add quote effect\" class=\"edit-tile selected\" data-kid=\"1-2-1-3-1\" data-name=\"quote effect tile\" title=\"Quote effect\" type=\"button\">\n                    <span class=\"tile-icon orange\" data-kid=\"1-2-1-3-1-1\" data-name=\"tile icon container\">\n                        <i data-kid=\"1-2-1-3-1-1-1\" data-lucide=\"quote\" data-name=\"quote icon\" style=\"width:15px;height:15px\">\n                        </i>\n                    </span>\n                    <span class=\"tile-label\" data-kid=\"1-2-1-3-1-2\" data-name=\"tile label text\">\n                        Quote\n                    </span>\n                    <span class=\"tile-meta\" data-kid=\"1-2-1-3-1-3\" data-name=\"tile meta text\">\n                        01 / VFX\n                    </span>\n                </button>\n                <button aria-label=\"Add text effect\" class=\"edit-tile\" data-kid=\"1-2-1-3-2\" data-name=\"text effect tile\" title=\"Text overlay\" type=\"button\">\n                    <span class=\"tile-icon tomato\" data-kid=\"1-2-1-3-2-1\" data-name=\"tile icon container\">\n                        <i data-kid=\"1-2-1-3-2-1-1\" data-lucide=\"type\" data-name=\"text icon\" style=\"width:15px;height:15px\">\n                        </i>\n                    </span>\n                    <span class=\"tile-label\" data-kid=\"1-2-1-3-2-2\" data-name=\"tile label text\">\n                        Text\n                    </span>\n                    <span class=\"tile-meta\" data-kid=\"1-2-1-3-2-3\" data-name=\"tile meta text\