    },
    "var_d88714a57c22": {
      "type": "variant",
      "label": "03 — Night Ember / Studio Desk",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --ink: #241118;\n    --rum: #450E16;\n    --crimson: #BC2D29;\n    --cream: #F5F9CE;\n    --orange: #FFA102;\n    --purple: #432E6F;\n    --tomato: #DD5533;\n    --teal: #2DD4BF;\n    --blue: #3B82F6;\n    --yellow: #C9A227;\n    --pink: #FB7185;\n    --lilac: #A78BFA;\n    --line: rgba(245,249,206,.18);\n    --muted: rgba(245,249,206,.58);\n    --mono: 'JetBrains Mono', ui-monospace, monospace;\n    --sans: 'IBM Plex Sans', ui-sans-serif, sans-serif;\n    --serif: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  * { box-sizing: border-box; }\n  body { margin: 0; min-width: 320px; min-height: 100dvh; background: var(--ink); color: var(--cream); font-family: var(--sans); }\n  button, input { font: inherit; }\n  button { cursor: pointer; }\n  button:focus-visible, input:focus-visible, summary:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }\n  .studio { min-height: 780px; height: 100dvh; display: grid; grid-template-rows: 58px minmax(0,1fr) 292px; overflow: hidden; background: var(--ink); border: 1px solid rgba(245,249,206,.24); position: relative; isolation: isolate; }\n  .studio:before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 70% 18%, rgba(221,85,51,.08), transparent 28%), radial-gradient(circle at 16% 82%, rgba(67,46,111,.13), transparent 32%); z-index: -2; }\n  .studio:after { content: ''; position: absolute; left: 52%; top: 58px; width: 11px; height: 230px; opacity: .32; transform: rotate(22deg); transform-origin: top; background: linear-gradient(126deg, var(--orange), var(--tomato) 46%, var(--purple)); clip-path: polygon(35% 0,100% 0,65% 100%,0 100%); pointer-events: none; z-index: 1; }\n\n  .topbar { min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 0 16px; background: var(--crimson); border-bottom: 1px solid rgba(245,249,206,.24); position: relative; z-index: 4; }\n  .top-left, .top-actions, .title-wrap { display: flex; align-items: center; min-width: 0; }\n  .top-left { gap: 14px; width: 30%; }\n  .top-actions { justify-content: flex-end; gap: 8px; width: 35%; }\n  .brand { display: inline-flex; align-items: center; gap: 8px; color: var(--cream); text-decoration: none; white-space: nowrap; }\n  .brand-mark { width: 26px; height: 26px; display: grid; place-items: center; border: 1px solid var(--cream); border-radius: 7px; color: var(--orange); font-family: var(--serif); font-weight: 700; font-size: 17px; line-height: 1; }\n  .brand-name { font-size: 12px; font-weight: 600; letter-spacing: .02em; }\n  .back { display: inline-flex; align-items: center; gap: 6px; border: 0; padding: 5px 7px; background: transparent; color: rgba(245,249,206,.72); font-size: 11px; }\n  .back:hover { color: var(--cream); transform: translateX(-2px); }\n  .title-wrap { justify-content: center; flex: 1; gap: 9px; }\n  .project-title { max-width: 320px; min-width: 160px; border: 1px solid transparent; border-radius: 6px; padding: 5px 7px; background: transparent; color: var(--cream); font-family: var(--serif); font-size: 19px; font-weight: 700; text-align: center; letter-spacing: -.02em; }\n  .project-title:hover, .project-title:focus { border-color: rgba(245,249,206,.32); background: rgba(36,17,24,.16); }\n  .mono { font-family: var(--mono); }\n  .status { display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(245,249,206,.26); border-radius: 999px; padding: 6px 9px; color: rgba(245,249,206,.78); font: 500 10px/1 var(--mono); letter-spacing: .03em; }\n  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 3px rgba(45,212,191,.15); }\n  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 30px; border: 1px solid transparent; border-radius: 7px; padding: 0 11px; color: var(--cream); font-size: 11px; font-weight: 600; white-space: nowrap; transition: transform .24s ease, opacity .24s ease; }\n  .btn:hover { transform: translateY(-1px); }\n  .btn-ghost { border-color: rgba(245,249,206,.35); background: transparent; }\n  .btn-ghost:hover { border-color: var(--orange); color: var(--orange); }\n  .btn-primary { border-color: var(--orange); background: var(--orange); color: var(--rum); box-shadow: 3px 3px 0 var(--rum); }\n  .btn-primary:hover { box-shadow: 1px 1px 0 var(--rum); }\n  .export-group { display: inline-flex; filter: drop-shadow(3px 3px 0 rgba(36,17,24,.8)); }\n  .export-group .btn-primary { border-radius: 7px 0 0 7px; box-shadow: none; }\n  .split { width: 29px; padding: 0; border-left: 1px solid rgba(69,14,22,.42); border-radius: 0 7px 7px 0; }\n\n  .main { min-height: 0; display: grid; grid-template-columns: 200px minmax(0,1fr) 350px; background: var(--ink); position: relative; z-index: 2; }\n  .rail { min-width: 0; overflow: hidden; background: var(--rum); border-right: 1px solid rgba(245,249,206,.2); }\n  .rail-tabs { display: flex; align-items: center; gap: 13px; min-height: 44px; overflow: hidden; padding: 0 13px; border-bottom: 1px solid rgba(245,249,206,.18); white-space: nowrap; }\n  .rail-tab { border: 0; border-bottom: 2px solid transparent; padding: 14px 0 11px; background: transparent; color: rgba(245,249,206,.54); font: 500 10px/1 var(--mono); }\n  .rail-tab:hover, .rail-tab.active { color: var(--cream); }\n  .rail-tab.active { border-bottom-color: var(--orange); }\n  .rail-body { padding: 15px 11px; }\n  .eyebrow { margin: 0 0 11px; color: rgba(245,249,206,.48); font: 500 9px/1 var(--mono); letter-spacing: .16em; text-transform: uppercase; }\n  .asset-grid { display: grid; gap: 8px; }\n  .asset-card { display: flex; align-items: center; gap: 10px; width: 100%; border: 1px solid rgba(245,249,206,.15); border-radius: 9px; padding: 9px 8px; background: rgba(36,17,24,.48); color: var(--cream); text-align: left; transition: transform .24s ease, opacity .24s ease; }\n  .asset-card:hover { transform: translateX(3px); border-color: rgba(255,161,2,.75); }\n  .asset-card.active { border-color: var(--orange); background: rgba(255,161,2,.12); box-shadow: 3px 3px 0 rgba(255,161,2,.55); }\n  .asset-icon { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 7px; flex: none; }\n  .asset-copy { min-width: 0; }\n  .asset-name { display: block; font: 600 13px/1 var(--serif); }\n  .asset-meta { display: block; margin-top: 4px; color: rgba(245,249,206,.46); font: 9px/1 var(--mono); }\n  .asset-footer { margin-top: 18px; border-top: 1px solid rgba(245,249,206,.15); padding-top: 13px; color: rgba(245,249,206,.45); font-size: 10px; line-height: 1.5; }\n  .asset-footer strong { color: var(--orange); font-weight: 500; }\n\n  .transcript { min-width: 0; min-height: 0; display: flex; flex-direction: column; overflow: hidden; background: #2c161b; }\n  .workspace-toolbar { min-height: 50px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 17px; border-bottom: 1px solid rgba(245,249,206,.19); background: rgba(69,14,22,.6); }\n  .toolbar-left, .toolbar-right { display: flex; align-items: center; gap: 8px; min-width: 0; }\n  .toolbar-title { color: rgba(245,249,206,.7); font: 500 10px/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; }\n  .edit-count { display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(245,249,206,.25); border-radius: 7px; padding: 6px 9px; color: var(--cream); font-size: 11px; }\n  .edit-count i { color: var(--orange); }\n  .tool-link { display: inline-flex; align-items: center; gap: 6px; border: 0; border-radius: 6px; padding: 6px 8px; background: transparent; color: rgba(245,249,206,.58); font-size: 11px; }\n  .tool-link:hover { background: rgba(245,249,206,.08); color: var(--cream); }\n  .transcript-scroll { min-height: 0; overflow: auto; padding: 22px 26px 26px; }\n  .reading-label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; color: rgba(245,249,206,.45); font: 500 9px/1 var(--mono); letter-spacing: .13em; text-transform: uppercase; }\n  .reading-label strong { color: var(--orange); font-weight: 500; }\n  .paper { position: relative; max-width: 780px; min-height: 290px; border: 1px solid rgba(69,14,22,.85); border-radius: 16px; padding: 27px 29px 29px; background: var(--cream); color: var(--rum); box-shadow: 6px 7px 0 rgba(36,17,24,.75); }\n  .paper:before { content: ''; position: absolute; left: 17px; top: 17px; bottom: 17px; width: 1px; background: rgba(221,85,51,.3); }\n  .paper-top { display: flex; justify-content: space-between; align-items: center; margin: 0 0 22px 14px; color: rgba(69,14,22,.5); font: 500 9px/1 var(--mono); letter-spacing: .13em; text-transform: uppercase; }\n  .paper-top strong { color: var(--tomato); font-weight: 600; }\n  .line { margin: 0 0 17px 14px; font: 600 clamp(25px,2.5vw,38px)/.98 var(--serif); letter-spacing: -.025em; }\n  .line:last-of-type { margin-bottom: 0; }\n  .word { display: inline-block; position: relative; padding: 0 4px 1px; border-radius: 4px; transition: transform .24s ease, opacity .24s ease; }\n  .word:hover { transform: translateY(-2px); }\n  .word.orange { background: var(--orange); }\n  .word.tomato { background: var(--tomato); color: var(--cream); }\n  .word.teal { background: var(--teal); }\n  .word.blue { background: var(--blue); color: var(--cream); }\n  .word.underline { text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: var(--orange); text-underline-offset: 5px; }\n  .word.selected:before, .word.selected:after { content: ''; position: absolute; top: -7px; bottom: -5px; width: 5px; border-top: 2px solid var(--orange); border-bottom: 2px solid var(--orange); }\n  .word.selected:before { left: -5px; border-left: 2px solid var(--orange); }\n  .word.selected:after { right: -5px; border-right: 2px solid var(--orange); }\n  .paper-foot { display: flex; justify-content: space-between; gap: 12px; margin: 25px 0 0 14px; padding-top: 12px; border-top: 1px solid rgba(69,14,22,.18); color: rgba(69,14,22,.54); font: 10px/1.4 var(--mono); }\n  .paper-foot .active { color: var(--tomato); }\n  .visibility { position: absolute; top: 86px; right: 16px; width: 210px; z-index: 6; }\n  .visibility summary { display: flex; align-items: center; justify-content: space-between; list-style: none; border: 1px solid rgba(245,249,206,.28); border-radius: 7px; padding: 7px 9px; background: rgba(36,17,24,.96); color: var(--cream); font-size: 10px; cursor: pointer; }\n  .visibility summary::-webkit-details-marker { display: none; }\n  .visibility[open] summary { border-color: var(--orange); color: var(--orange); }\n  .menu { margin-top: 5px; border: 1px solid rgba(245,249,206,.24); border-radius: 9px; padding: 6px; background: #241118; box-shadow: 4px 4px 0 rgba(255,161,2,.55); }\n  .menu-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 6px; color: rgba(245,249,206,.78); font-size: 10px; }\n  .menu-row:hover { background: rgba(245,249,206,.08); color: var(--cream); }\n  .menu-label { display: flex; align-items: center; gap: 7px; }\n  .menu-dot { width: 7px; height: 7px; border-radius: 50%; }\n  .menu-count { color: rgba(245,249,206,.42); font: 9px var(--mono); }\n\n  .preview { min-width: 0; min-height: 0; display: flex; flex-direction: column; overflow: hidden; background: var(--rum); border-left: 1px solid rgba(245,249,206,.2); }\n  .preview-head { min-height: 50px; display: flex; align-items: center; justify-content: space-between; padding: 0 14px; border-bottom: 1px solid rgba(245,249,206,.18); }\n  .preview-title { color: var(--cream); font: 600 12px/1 var(--serif); }\n  .preview-tag { border: 1px solid rgba(255,161,2,.55); border-radius: 999px; padding: 5px 7px; color: var(--orange); font: 9px/1 var(--mono); }\n  .player-well { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 12px 12px 3px; background: #170d12; }\n  .ribbon { position: absolute; top: 18px; right: 23px; width: 8px; height: 138px; transform: rotate(21deg); opacity: .68; background: linear-gradient(180deg,var(--orange),var(--tomato),var(--purple)); clip-path: polygon(20% 0,100% 0,77% 100%,0 100%); }\n  .poster { position: relative; height: min(286px,100%); aspect-ratio: 9/16; overflow: hidden; border: 2px solid var(--cream); background: var(--cream); color: var(--rum); box-shadow: 4px 4px 0 rgba(255,161,2,.72); }\n  .poster:before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 72% 24%, rgba(255,161,2,.62), transparent 29%), linear-gradient(145deg, rgba(67,46,111,.92), rgba(69,14,22,.12) 46%, rgba(221,85,51,.78)); mix-blend-mode: multiply; opacity: .8; }\n  .poster-bar { position: absolute; left: 10px; top: 10px; border: 1px solid var(--rum); border-radius: 3px; padding: 4px 5px; background: rgba(245,249,206,.72); font: 8px/1 var(--mono); letter-spacing: .08em; }\n  .poster-person { position: absolute; left: 16%; right: 16%; bottom: 22%; height: 42%; border-radius: 48% 48% 12% 12%; background: rgba(69,14,22,.76); clip-path: polygon(28% 0,72% 0,89% 28%,100% 100%,0 100%,11% 28%); }\n  .poster-copy { position: absolute; left: 13px; right: 13px; bottom: 17px; font: 700 23px/.84 var(--serif); letter-spacing: -.05em; }\n  .poster-copy span { color: var(--orange); }\n  .player-controls { width: 100%; max-width: 250px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 9px; padding: 6px 0 0; color: rgba(245,249,206,.7); }\n  .time { color: var(--orange); font: 10px var(--mono); white-space: nowrap; }\n  .control-line { height: 3px; border-radius: 999px; background: linear-gradient(90deg,var(--orange) 0 19%, rgba(245,249,206,.24) 19% 100%); }\n  .icon-btn { width: 25px; height: 25px; display: inline-grid; place-items: center; border: 1px solid transparent; border-radius: 6px; padding: 0; background: transparent; color: currentColor; transition: transform .24s ease, opacity .24s ease; }\n  .icon-btn:hover { border-color: rgba(255,161,2,.72); color: var(--orange); transform: translateY(-1px); }\n  .ai-note { position: absolute; right: 12px; bottom: 14px; width: 148px; border: 1px solid rgba(45,212,191,.65); border-radius: 9px; padding: 9px; background: rgba(36,17,24,.94); box-shadow: 4px 4px 0 rgba(45,212,191,.36); color: var(--cream); }\n  .ai-head { display: flex; align-items: center; gap: 6px; color: var(--teal); font: 600 9px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }\n  .ai-head i { width: 12px; height: 12px; }\n  .ai-note p { margin: 7px 0 0; color: rgba(245,249,206,.72); font-size: 10px; line-height: 1.35; }\n\n  .timeline { min-width: 0; min-height: 0; overflow: hidden; background: #1b1015; border-top: 1px solid rgba(245,249,206,.22); position: relative; z-index: 3; }\n  .timeline-head { height: 35px; display: grid; grid-template-columns: 82px minmax(0,1fr) 88px; align-items: center; border-bottom: 1px solid rgba(245,249,206,.18); color: rgba(245,249,206,.52); }\n  .timeline-head .label { padding-left: 14px; font: 500 9px var(--mono); letter-spacing: .12em; }\n  .ruler { position: relative; height: 35px; overflow: hidden; background: repeating-linear-gradient(90deg, transparent 0 48px, rgba(245,249,206,.16) 48px 49px); }\n  .ruler:after { content: ''; position: absolute; left: 25%; top: 0; bottom: 0; width: 1px; background: var(--orange); box-shadow: 0 0 0 3px rgba(255,161,2,.14); }\n  .tick-labels { position: absolute; inset: 7px 0 auto; display: flex; justify-content: space-between; padding: 0 14px; color: rgba(245,249,206,.52); font: 9px var(--mono); }\n  .timeline-head .duration { padding-right: 14px; text-align: right; color: var(--orange); font: 10px var(--mono); }\n  .tracks { padding: 8px 0 10px; }\n  .track { height: 39px; display: grid; grid-template-columns: 82px minmax(0,1fr); align-items: center; }\n  .track-label { padding-left: 14px; color: rgba(245,249,206,.52); font: 500 9px var(--mono); letter-spacing: .1em; }\n  .track-canvas { position: relative; height: 28px; margin-right: 12px; overflow: hidden; border: 1px solid rgba(245,249,206,.12); border-radius: 5px; background: rgba(245,249,206,.035); }\n  .track-canvas:after { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(90deg, transparent 0 48px, rgba(245,249,206,.08) 48px 49px); }\n  .clip { position: absolute; top: 4px; bottom: 4px; z-index: 1; display: flex; align-items: center; min-width: 8px; overflow: hidden; border: 1px solid rgba(36,17,24,.58); border-radius: 4px; padding: 0 7px; color: var(--rum); font: 9px var(--mono); white-space: nowrap; }\n  .clip:before, .clip:after { content: ''; position: absolute; top: 5px; bottom: 5px; width: 2px; border-radius: 2px; background: rgba(36,17,24,.55); }\n  .clip:before { left: 3px; } .clip:after { right: 3px; }\n  .clip.yellow { background: var(--yellow); } .clip.pink { background: var(--pink); } .clip.teal { background: var(--teal); } .clip.purple { background: var(--lilac); } .clip.blue { background: var(--blue); color: var(--cream); } .clip.dark { background: rgba(221,85,51,.62); color: var(--cream); }\n  .clip.selected { border-color: var(--orange); box-shadow: 4px 4px 0 var(--orange); transform: translateY(-1px); }\n  .playhead { position: absolute; top: 35px; bottom: 0; left: calc(82px + 25% * (100% - 82px)); z-index: 5; width: 2px; background: var(--orange); box-shadow: 0 0 0 3px rgba(255,161,2,.12); pointer-events: none; }\n  .playhead:before { content: ''; position: absolute; top: -2px; left: -5px; width: 10px; height: 8px; border-radius: 2px 2px 5px 5px; background: var(--orange); }\n  .playhead-label { position: absolute; top: -25px; left: -22px; border-radius: 4px; padding: 3px 4px; background: var(--orange); color: var(--rum); font: 9px var(--mono); }\n\n  @media (max-width: 1020px) {\n    .studio { grid-template-rows: 58px minmax(0,1fr) 270px; }\n    .main { grid-template-columns: 176px minmax(0,1fr) 294px; }\n    .top-left { width: 26%; } .top-actions { width: 39%; }\n    .project-title { max-width: 245px; font-size: 17px; }\n    .paper { padding: 23px 23px 24px; }\n    .line { font-size: clamp(24px,2.7vw,32px); }\n    .ai-note { right: 8px; width: 130px; }\n  }\n  @media (max-width: 767px) {\n    body { background: var(--ink); }\n    .studio { height: auto; min-height: 100dvh; overflow: visible; display: block; }\n    .topbar { min-height: 60px; flex-wrap: wrap; padding: 9px 12px; }\n    .top-left, .top-actions { width: auto; } .top-left { flex: 1; } .title-wrap { order: 3; flex-basis: 100%; }\n    .project-title { width: 100%; max-width: none; }\n    .top-actions { gap: 5px; } .top-actions .btn-ghost { display: none; } .status { display: none; }\n    .main { display: block; }\n    .rail { border-right: 0; border-bottom: 1px solid rgba(245,249,206,.2); }\n    .rail-tabs { overflow-x: auto; } .rail-body { padding: 12px; } .asset-grid { grid-template-columns: repeat(4,minmax(0,1fr)); } .asset-card { justify-content: center; padding: 8px 4px; } .asset-copy { display: none; }\n    .asset-footer { display: none; }\n    .transcript { min-height: 410px; } .workspace-toolbar { padding: 0 12px; } .transcript-scroll { padding: 18px 14px 24px; }\n    .visibility { position: static; width: auto; margin: 10px 14px 0; } .visibility .menu { position: relative; }\n    .preview { min-height: 420px; border-left: 0; border-top: 1px solid rgba(245,249,206,.2); }\n    .player-well { min-height: 350px; } .ai-note { right: 12px; bottom: 12px; }\n    .timeline { min-height: 270px; overflow-x: auto; } .timeline-head, .tracks { min-width: 860px; } .playhead { left: calc(82px + 25% * (860px - 82px)); }\n  }\n</style>\n<div aria-label=\"Night Ember video editor workspace\" class=\"studio\" data-kid=\"1\" data-name=\"Night Ember video editor workspace\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <div class=\"top-left\" data-kid=\"1-1-1\" data-name=\"left top navigation section\">\n            <button aria-label=\"Back to projects\" class=\"back\" data-kid=\"1-1-1-1\" data-name=\"back to projects button\" title=\"Back to projects\">\n                <i data-kid=\"1-1-1-1-1\" data-lucide=\"arrow-left\" data-name=\"arrow left icon\" style=\"width:13px;height:13px\">\n                </i>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"projects button text\">\n                    Projects\n                </span>\n            </button>\n            <a aria-label=\"YapCut home\" class=\"brand\" data-kid=\"1-1-1-2\" data-name=\"YapCut branding link\" href=\"#\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-2-1\" data-name=\"brand mark\">\n                    Y\n                </span>\n                <span class=\"brand-name\" data-kid=\"1-1-1-2-2\" data-name=\"brand name text\">\n                    YapCut\n                </span>\n            </a>\n        </div>\n        <div class=\"title-wrap\" data-kid=\"1-1-2\" data-name=\"center project title section\">\n            <input aria-label=\"Project title\" class=\"project-title\" data-kid=\"1-1-2-1\" data-name=\"project title input\" value=\"Top Three Video Editing Tricks\"/>\n        </div>\n        <div class=\"top-actions\" data-kid=\"1-1-3\" data-name=\"right top actions section\">\n            <span class=\"status\" data-kid=\"1-1-3-1\" data-name=\"save status indicator\" title=\"All changes saved\">\n                <span class=\"status-dot\" data-kid=\"1-1-3-1-1\" data-name=\"status dot\">\n                </span>\n                Saved\n            </span>\n            <button aria-label=\"Generate edits\" class=\"btn btn-ghost\" data-kid=\"1-1-3-2\" data-name=\"generate edits button\">\n                <i data-kid=\"1-1-3-2-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\" style=\"width:13px;height:13px\">\n                </i>\n                Generate edits\n            </button>\n            <div aria-label=\"Export actions\" class=\"export-group\" data-kid=\"1-1-3-3\" data-name=\"export button group\">\n                <button aria-label=\"Export video\" class=\"btn btn-primary\" data-kid=\"1-1-3-3-1\" data-name=\"primary export button\">\n                    <i data-kid=\"1-1-3-3-1-1\" data-lucide=\"cloud-upload\" data-name=\"cloud upload icon\" style=\"width:13px;height:13px\">\n                    </i>\n                    Export video\n                </button>\n                <button aria-label=\"More export actions\" class=\"btn btn-primary split\" data-kid=\"1-1-3-3-2\" data-name=\"more export options button\" title=\"More export actions\">\n                    <i data-kid=\"1-1-3-3-2-1\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" style=\"width:14px;height:14px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"main\" data-kid=\"1-2\" data-name=\"main workspace layout container\">\n        <aside aria-label=\"Edit tools\" class=\"rail\" data-kid=\"1-2-1\" data-name=\"edit tools sidebar\">\n            <nav aria-label=\"Asset categories\" class=\"rail-tabs\" data-kid=\"1-2-1-1\" data-name=\"asset category navigation bar\">\n                <button class=\"rail-tab active\" data-kid=\"1-2-1-1-1\" data-name=\"A-roll tab button\">\n                    A-roll\n                </button>\n                <button class=\"rail-tab\" data-kid=\"1-2-1-1-2\" data-name=\"B-roll tab button\">\n                    B-roll\n                </button>\n                <button class=\"rail-tab\" data-kid=\"1-2-1-1-3\" data-name=\"VFX tab button\">\n                    VFX\n                </button>\n                <button class=\"rail-tab\" data-kid=\"1-2-1-1-4\" data-name=\"Transitions tab button\">\n                    Transitions\n                </button>\n            </nav>\n            <div class=\"rail-body\" data-kid=\"1-2-1-2\" data-name=\"sidebar body container\">\n                <p class=\"eyebrow\" data-kid=\"1-2-1-2-1\" data-name=\"treatments eyebrow label\">\n                    Treatments\n                </p>\n                <div class=\"asset-grid\" data-kid=\"1-2-1-2-2\" data-name=\"asset category grid\">\n                    <button aria-label=\"Add quote effect\" class=\"asset-card active\" data-kid=\"1-2-1-2-2-1\" data-name=\"quote effect card\">\n                        <span class=\"asset-icon\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"quote icon background\" style=\"background:#DD5533;color:#F5F9CE\">\n                            <i data-kid=\"1-2-1-2-2-1-1-1\" data-lucide=\"quote\" data-name=\"quote icon\" style=\"width:16px;height:16px\">\n                            </i>\n                        </span>\n                        <span class=\"asset-copy\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"asset label container\">\n                            <span class=\"asset-name\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"asset name\">\n                                Quote\n                            </span>\n                            <span class=\"asset-meta\" data-kid=\"1-2-1-2-2-1-2-2\" data-name=\"asset meta data\">\n                                7 on canvas\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Add text effect\" class=\"asset-card\" data-kid=\"1-2-1-2-2-2\" data-name=\"text effect card\">\n                        <span class=\"asset-icon\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"text effect icon background\" style=\"background:#432E6F;color:#F5F9CE\">\n                            <i data-kid=\"1-2-1-2-2-2-1-1\" data-lucide=\"type\" data-name=\"text effect icon\" style=\"width:16px;height:16px\">\n                            </i>\n                        </span>\n                        <span class=\"asset-copy\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"text label container\">\n                            <span class=\"asset-name\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"text effect name\">\n                                Text\n                            </span>\n                            <span class=\"asset-meta\" data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"text effect meta data\">\n                                3 on canvas\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Add listicle effect\" class=\"asset-card\" data-kid=\"1-2-1-2-2-3\" data-name=\"listicle effect card\">\n                        <span class=\"asset-icon\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"listicle effect icon background\" style=\"background:#FFA102;color:#450E16\">\n                            <i data-kid=\"1-2-1-2-2-3-1-1\" data-lucide=\"list-ordered\" data-name=\"listicle effect icon\" style=\"width:16px;height:16px\">\n                            </i>\n                        </span>\n                        <span class=\"asset-copy\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"listicle label container\">\n                            <span class=\"asset-name\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"listicle effect name\">\n                                Listicle\n                            </span>\n                            <span class=\"asset-meta\" data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"listicle effect meta data\">\n                                4 on canvas\n                            </span>\n                        </span>\n                    </button>\n                    <button aria-label=\"Add shake effect\" class=\"asset-card\" data-kid=\"1-2-1-2-2-4\" data-name=\"shake effect card\">\n                        <span class=\"asset-icon\" data-kid=\"1-2-1-2-2-4-1\" data-name=\"shake effect icon background\" style=\"background:#2DD4BF;color:#450E16\">\n                            <i data-kid=\"1-2-1-2-2-4-1-1\" data-lucide=\"waves\" data-name=\"shake effect icon\" style=\"width:16px;height:16px\">\n                            </i>\n                        </span>\n                        <span class=\"asset-copy\" data-kid=\"1-2-1-2-2-4-2\" data-name=\"shake label container\">\n                            <span class=\"asset-name\" data-kid=\"1-2-1-2-2-4-2-1\" data-name=\"shake effect name\">\n                                Shake\n                            </span>\n                            <span class=\"asset-meta\" data-kid=\"1-2-1-2-2-4-2-2\" data-name=\"shake effect meta data\">\n                                1 on canvas\n                            </span>\n                        </span>\n                    </button>\n                </div>\n                <div class=\"asset-footer\" data-kid=\"1-2-1-2-3\" data-name=\"drag-and-drop instruction footer\">\n                    <strong data-kid=\"1-2-1-2-3-1\">\n                        Drag to a word\n                    </strong>\n                    <br data-kid=\"1-2-1-2-3-2\"/>\n                    Drop a treatment exactly where the idea lands.\n                </div>\n            </div>\n        </aside>\n        <section aria-label=\"Transcript workspace\" class=\"transcript\" data-kid=\"1-2-2\" data-name=\"transcript workspace container\">\n            <div class=\"workspace-toolbar\" data-kid=\"1-2-2-1\" data-name=\"workspace toolbar\">\n                <div class=\"toolbar-left\" data-kid=\"1-2-2-1-1\" data-name=\"toolbar left group\">\n                    <span class=\"toolbar-title\" data-kid=\"1-2-2-1-1-1\" data-name=\"transcript label\">\n                        Transcript\n                    </span>\n                    <span class=\"edit-count\" data-kid=\"1-2-2-1-1-2\" data-name=\"edit count indicator\">\n                        <i data-kid=\"1-2-2-1-1-2-1\" data-lucide=\"layers\" data-name=\"layers icon\" style=\"width:13px;height:13px\">\n                        </i>\n                        22 edits\n                    </span>\n                </div>\n                <div class=\"toolbar-right\" data-kid=\"1-2-2-1-2\" data-name=\"toolbar right group\">\n                    <button aria-label=\"Caption settings\" class=\"tool-link\" data-kid=\"1-2-2-1-2-1\" data-name=\"caption settings button\">\n                        <i data-kid=\"1-2-2-1-2-1-1\" data-lucide=\"captions\" data-name=\"captions icon\" style=\"width:14px;height:14px\">\n                        </i>\n                        Captions\n                    </button>\n                    <button aria-label=\"Project settings\" class=\"tool-link\" data-kid=\"1-2-2-1-2-2\" data-name=\"project settings button\">\n                        <i data-kid=\"1-2-2-1-2-2-1\" data-lucide=\"sliders-horizontal\" data-name=\"sliders icon\" style=\"width:14px;height:14px\">\n                        </i>\n                        Settings\n                    </button>\n                </div>\n            </div>\n            <div class=\"transcript-scroll\" data-kid=\"1-2-2-2\" data-name=\"transcript scroll area\">\n                <div class=\"reading-label\" data-kid=\"1-2-2-2-1\" data-name=\"transcript reading surface label\">\n                    <span data-kid=\"1-2-2-2-1-1\" data-name=\"label text\">\n                        Word-first edit surface\n                    </span>\n                    <strong data-kid=\"1-2-2-2-1-2\" data-name=\"timestamp range\">\n                        00:00:00 — 00:22:10\n                    </strong>\n                </div>\n                <article aria-label=\"Editable transcript\" class=\"paper\" data-kid=\"1-2-2-2-2\" data-name=\"editable transcript surface\">\n                    <div class=\"paper-top\" data-kid=\"1-2-2-2-2-1\" data-name=\"transcript metadata row\">\n                        <span data-kid=\"1-2-2-2-2-1-1\" data-name=\"speaker name\">\n                            Talking head / Jordan\n                        </span>\n                        <strong data-kid=\"1-2-2-2-2-1-2\" data-name=\"treatment visibility count\">\n                            6 treatments visible\n                        </strong>\n                    </div>\n                    <p class=\"line\" data-kid=\"1-2-2-2-2-2\" data-name=\"transcript line\">\n                        Top\n                        <span class=\"word orange selected\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"orange highlighted word\">\n                            three\n                        </span>\n                        tricks for\n                        <span class=\"word tomato\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"tomato highlighted word\">\n                            editing\n                        </span>\n                        videos.\n                    </p>\n                    <p class=\"line\" data-kid=\"1-2-2-2-2-3\" data-name=\"transcript line\">\n                        <span class=\"word blue\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"blue highlighted word\">\n                            Number one\n                        </span>\n                        is to use\n                        <span class=\"word teal underline\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"teal underlined highlighted word\">\n                            overlay\n                        </span>\n                        text.\n                    </p>\n                    <p class=\"line\" data-kid=\"1-2-2-2-2-4\" data-name=\"transcript line\">\n                        Tip number two is to use\n                        <span class=\"word orange\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"orange highlighted word\">\n                            zooms\n                        </span>\n                        .\n                    </p>\n                    <p class=\"line\" data-kid=\"1-2-2-2-2-5\" data-name=\"transcript line\">\n                        And tip number three is to add\n                        <span class=\"word tomato\" data-kid=\"1-2-2-2-2-5-1\" data-name=\"tomato highlighted word\">\n                            sound effects\n                        </span>\n                        .\n                    </p>\n                    <div class=\"paper-foot\" data-kid=\"1-2-2-2-2-6\" data-name=\"transcript foot\">\n                        <span data-kid=\"1-2-2-2-2-6-1\" data-name=\"selected word status\">\n                            <span class=\"active\" data-kid=\"1-2-2-2-2-6-1-1\" data-name=\"active dot icon\">\n                                ●\n                            </span>\n                            selected word: three\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-6-2\" data-name=\"edit instruction text\">\n                            ⌘ ↵ edit treatment\n                        </span>\n                    </div>\n                </article>\n                <details class=\"visibility\" data-kid=\"1-2-2-2-3\" data-name=\"edit type visibility menu\" open=\"\">\n                    <summary data-kid=\"1-2-2-2-3-1\" data-name=\"menu toggle\">\n                        <span data-kid=\"1-2-2-2-3-1-1\" data-name=\"label container\">\n                            <i data-kid=\"1-2-2-2-3-1-1-1\" data-lucide=\"eye\" data-name=\"eye icon\" style=\"width:13px;height:13px;vertical-align:-2px\">\n                            </i>\n                            Visible edit types\n                        </span>\n                        <i data-kid=\"1-2-2-2-3-1-2\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" style=\"width:13px;height:13px\">\n                        </i>\n                    </summary>\n                    <div aria-label=\"Visible edit types\" class=\"menu\" data-kid=\"1-2-2-2-3-2\" data-name=\"visibility menu dropdown\" role=\"menu\">\n                        <div class=\"menu-row\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"quote row\" role=\"menuitem\">\n                            <span class=\"menu-label\" data-kid=\"1-2-2-2-3-2-1-1\" data-name=\"label container\">\n                                <span class=\"menu-dot\" data-kid=\"1-2-2-2-3-2-1-1-1\" data-name=\"pink dot\" style=\"background:var(--pink)\">\n                                </span>\n                                Quote effects\n                            </span>\n                            <span class=\"menu-count\" data-kid=\"1-2-2-2-3-2-1-2\" data-name=\"count\">\n                                7\n                            </span>\n                        </div>\n                        <div class=\"menu-row\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"listicle row\" role=\"menuitem\">\n                            <span class=\"menu-label\" data-kid=\"1-2-2-2-3-2-2-1\" data-name=\"label container\">\n                                <span class=\"menu-dot\" data-kid=\"1-2-2-2-3-2-2-1-1\" data-name=\"tomato dot\" style=\"background:var(--tomato)\">\n                                </span>\n                                Listicles\n                            </span>\n                            <span class=\"menu-count\" data-kid=\"1-2-2-2-3-2-2-2\" data-name=\"count\">\n                                4\n                            </span>\n                        </div>\n                        <div class=\"menu-row\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"sound effects row\" role=\"menuitem\">\n                            <span class=\"menu-label\" data-kid=\"1-2-2-2-3-2-3-1\" data-name=\"label container\">\n                                <span class=\"menu-dot\" data-kid=\"1-2-2-2-3-2-3-1-1\" data-name=\"teal dot\" style=\"background:var(--teal)\">\n                                </span>\n                                Sound effects\n                            </span>\n                            <span class=\"menu-count\" data-kid=\"1-2-2-2-3-2-3-2\" data-name=\"count\">\n                                14\n                            </span>\n                        </div>\n                        <div class=\"menu-row\" data-kid=\"1-2-2-2-3-2-4\" data-name=\"zooms row\" role=\"menuitem\">\n                            <span class=\"menu-label\" data-kid=\"1-2-2-2-3-2-4-1\" data-name=\"label container\">\n                                <span class=\"menu-dot\" data-kid=\"1-2-2-2-3-2-4-1-1\" data-name=\"blue dot\" style=\"background:var(--blue)\">\n                                </span>\n                                Zooms\n                            </span>\n                            <span class=\"menu-count\" data-kid=\"1-2-2-2-3-2-4-2\" data-name=\"count\">\n                                10\n                            </span>\n                        </div>\n                    </div>\n                </details>\n            </div>\n        </section>\n        <aside aria-label=\"Video preview and caption style\" class=\"preview\" data-kid=\"1-2-3\" data-name=\"preview pane container\">\n            <div class=\"preview-head\" data-kid=\"1-2-3-1\" data-name=\"preview header\">\n                <span class=\"preview-title\" data-kid=\"1-2-3-1-1\" data-name=\"preview title\">\n                    Preview / 9:16\n                </span>\n                <span class=\"preview-tag\" data-kid=\"1-2-3-1-2\" data-name=\"AI status tag\">\n                    AI PASS READY\n                </span>\n            </div>\n            <div class=\"player-well\" data-kid=\"1-2-3-2\" data-name=\"player well\">\n                <span aria-hidden=\"true\" class=\"ribbon\" data-kid=\"1-2-3-2-1\" data-name=\"decorative ribbon\">\n                </span>\n                <div aria-label=\"Vertical video preview\" class=\"poster\" data-kid=\"1-2-3-2-2\" data-name=\"video preview poster\">\n                    <span class=\"poster-bar\" data-kid=\"1-2-3-2-2-1\" data-name=\"poster aspect ratio label\">\n                        TALKING HEAD · 9:16\n                    </span>\n                    <span aria-hidden=\"true\" class=\"poster-person\" data-kid=\"1-2-3-2-2-2\" data-name=\"poster person silhouette\">\n                    </span>\n                    <div class=\"poster-copy\" data-kid=\"1-2-3-2-2-3\" data-name=\"poster text block\">\n                        Make the idea\n                        <br data-kid=\"1-2-3-2-2-3-1\"/>\n                        <span data-kid=\"1-2-3-2-2-3-2\" data-name=\"poster emphasized text\">\n                            impossible to miss.\n                        </span>\n                    </div>\n                </div>\n                <div class=\"ai-note\" data-kid=\"1-2-3-2-3\" data-name=\"AI helper note\">\n                    <div class=\"ai-head\" data-kid=\"1-2-3-2-3-1\" data-name=\"AI note header\">\n                        <i data-kid=\"1-2-3-2-3-1-1\" data-lucide=\"sparkles\" data-name=\"sparkles icon\">\n                        </i>\n                        AI helper\n                    </div>\n                    <p data-kid=\"1-2-3-2-3-2\" data-name=\"AI recommendation text\">\n                        Found 6 emphasis moments and 3 clean cut points.\n                    </p>\n                </div>\n                <div class=\"player-controls\" data-kid=\"1-2-3-2-4\" data-name=\"player controls\">\n                    <span class=\"time\" data-dynamic=\"true\" data-kid=\"1-2-3-2-4-1\" data-name=\"current time display\" data-reason=\"timestamp updated by media playback script\">\n                        0:00:00\n                    </span>\n                    <span aria-hidden=\"true\" class=\"control-line\" data-kid=\"1-2-3-2-4-2\" data-name=\"playback progress bar\">\n                    </span>\n                    <button aria-label=\"Play preview\" class=\"icon-btn\" data-kid=\"1-2-3-2-4-3\" data-name=\"play button\" title=\"Play preview\">\n                        <i data-kid=\"1-2-3-2-4-3-1\" data-lucide=\"play\" data-name=\"play icon\" style=\"width:14px;height:14px;fill:currentColor\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </aside>\n    </main>\n    <section aria-label=\"Timeline\" class=\"timeline\" data-kid=\"1-3\" data-name=\"timeline section\">\n        <div class=\"timeline-head\" data-kid=\"1-3-1\" data-name=\"timeline head\">\n            <span class=\"label\" data-kid=\"1-3-1-1\" data-name=\"edit tracks label\">\n                EDIT TRACKS\n            </span>\n            <div class=\"ruler\" data-kid=\"1-3-1-2\" data-name=\"timeline ruler\">\n                <div class=\"tick-labels\" data-kid=\"1-3-1-2-1\" data-name=\"ruler tick labels\">\n                    <span data-kid=\"1-3-1-2-1-1\">\n                        0:00\n                    </span>\n                    <span data-kid=\"1-3-1-2-1-2\">\n                        0:05\n                    </span>\n                    <span data-kid=\"1-3-1-2-1-3\">\n                        0:10\n                    </span>\n                    <span data-kid=\"1-3-1-2-1-4\">\n                        0:15\n                    </span>\n                    <span data-kid=\"1-3-1-2-1-5\">\n                        0:20\n                    </span>\n                    <span data-kid=\"1-3-1-2-1-6\">\n                        0:25\n                    </span>\n                    <span data-kid=\"1-3-1-2-1-7\">\n                        0:30\n                    </span>\n                </div>\n            </div>\n            <span class=\"duration\" data-kid=\"1-3-1-3\" data-name=\"duration display\">\n                00:22:10\n            </span>\n        </div>\n        <div class=\"tracks\" data-kid=\"1-3-2\" data-name=\"timeline tracks\">\n            <div class=\"track\" data-kid=\"1-3-2-1\" data-name=\"video track container\">\n                <span class=\"track-label\" data-kid=\"1-3-2-1-1\" data-name=\"track label\">\n                    VIDEO\n                </span>\n                <div class=\"track-canvas\" data-kid=\"1-3-2-1-2\" data-name=\"video track canvas\">\n                    <span class=\"clip yellow\" data-kid=\"1-3-2-1-2-1\" style=\"left:2%;width:14%\">\n                        keep · 1.9s\n                    </span>\n                    <span class=\"clip dark\" data-kid=\"1-3-2-1-2-2\" style=\"left:16.5%;width:10%\">\n                        cut\n                    </span>\n                    <span class=\"clip yellow\" data-kid=\"1-3-2-1-2-3\" style=\"left:27%;width:13%\">\n                        keep · 3.0s\n                    </span>\n                    <span class=\"clip dark\" data-kid=\"1-3-2-1-2-4\" style=\"left:40.5%;width:14%\">\n                        cut\n                    </span>\n                    <span class=\"clip yellow\" data-kid=\"1-3-2-1-2-5\" style=\"left:55%;width:19%\">\n                        keep · 4.2s\n                    </span>\n                    <span class=\"clip yellow\" data-kid=\"1-3-2-1-2-6\" style=\"left:75%;width:13%\">\n                        keep\n                    </span>\n                    <span class=\"clip dark\" data-kid=\"1-3-2-1-2-7\" style=\"left:88.5%;width:9%\">\n                        cut\n                    </span>\n                </div>\n            </div>\n            <div class=\"track\" data-kid=\"1-3-2-2\" data-name=\"captions track container\">\n                <span class=\"track-label\" data-kid=\"1-3-2-2-1\" data-name=\"track label\">\n                    CAPTIONS\n                </span>\n                <div class=\"track-canvas\" data-kid=\"1-3-2-2-2\" data-name=\"captions track canvas\">\n                    <span class=\"clip blue\" data-kid=\"1-3-2-2-2-1\" style=\"left:2%;width:9%\">\n                        Top three\n                    </span>\n                    <span class=\"clip blue\" data-kid=\"1-3-2-2-2-2\" style=\"left:13%;width:11%\">\n                        tricks\n                    </span>\n                    <span class=\"clip purple\" data-kid=\"1-3-2-2-2-3\" style=\"left:25%;width:10%\">\n                        editing\n                    </span>\n                    <span class=\"clip blue\" data-kid=\"1-3-2-2-2-4\" style=\"left:38%;width:16%\">\n                        Number one\n                    </span>\n                    <span class=\"clip purple\" data-kid=\"1-3-2-2-2-5\" style=\"left:57%;width:13%\">\n                        overlay text\n                    </span>\n                    <span class=\"clip blue\" data-kid=\"1-3-2-2-2-6\" style=\"left:73%;width:19%\">\n                        sound effects\n                    </span>\n                </div>\n            </div>\n            <div class=\"track\" data-kid=\"1-3-2-3\" data-name=\"SFX track container\">\n                <span class=\"track-label\" data-kid=\"1-3-2-3-1\" data-name=\"track label\">\n                    SFX\n                </span>\n                <div class=\"track-canvas\" data-kid=\"1-3-2-3-2\" data-name=\"SFX track canvas\">\n                    <span class=\"clip teal\" data-kid=\"1-3-2-3-2-1\" style=\"left:5%;width:5%\">\n                        click\n                    </span>\n                    <span class=\"clip teal\" data-kid=\"1-3-2-3-2-2\" style=\"left:28%;width:2%\">\n                    </span>\n                    <span class=\"clip teal\" data-kid=\"1-3-2-3-2-3\" style=\"left:61%;width:3%\">\n                    </span>\n                    <span class=\"clip teal\" data-kid=\"1-3-2-3-2-4\" style=\"left:84%;width:7%\">\n                        magic\n                    </span>\n                </div>\n            </div>\n            <div class=\"track\" data-kid=\"1-3-2-4\" data-name=\"zoom track container\">\n                <span class=\"track-label\" data-kid=\"1-3-2-4-1\" data-name=\"track label\">\n                    ZOOM\n                </span>\n                <div class=\"track-canvas\" data-kid=\"1-3-2-4-2\" data-name=\"zoom track canvas\">\n                    <span class=\"clip purple\" data-kid=\"1-3-2-4-2-1\" style=\"left:18%;width:5%\">\n                        1.10x\n                    </span>\n                    <span class=\"clip purple\" data-kid=\"1-3-2-4-2-2\" style=\"left:56%;width:5%\">\n                        1.10x\n                    </span>\n                    <span class=\"clip purple\" data-kid=\"1-3-2-4-2-3\" style=\"left:76%;width:4%\">\n                        1.15x\n                    </span>\n                </div>\n            </div>\n            <div class=\"track\" data-kid=\"1-3-2-5\" data-name=\"VFX track container\">\n                <span class=\"track-label\" data-kid=\"1-3-2-5-1\" data-name=\"track label\">\n                    VFX\n                </span>\n                <div class=\"track-canvas\" data-kid=\"1-3-2-5-2\" data-name=\"VFX track canvas\">\n                    <span class=\"clip pink\" data-kid=\"1-3-2-5-2-1\" style=\"left:3%;width:15%\">\n                        Top Three Video...\n                    </span>\n                    <span class=\"clip pink selected\" data-kid=\"1-3-2-5-2-2\" style=\"left:23%;width:18%\">\n                        Number One · Overlay\n                    </span>\n                    <span class=\"clip pink\" data-kid=\"1-3-2-5-2-3\" style=\"left:48%;width:8%\">\n                        Bold words\n                    </span>\n                    <span class=\"clip pink\" data-kid=\"1-3-2-5-2-4\" style=\"left:65%;width:14%\">\n                        Tip Two · Zoom\n                    </span>\n                    <span class=\"clip pink\" data-kid=\"1-3-2-5-2-5\" style=\"left:83%;width:12%\">\n                        Bold White\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div aria-hidden=\"true\" class=\"playhead\" data-kid=\"1-3-3\" data-name=\"timeline playhead\">\n            <span class=\"playhead-label\" data-dynamic=\"true\" data-kid=\"1-3-3-1\" data-name=\"playhead time label\" data-reason=\"timestamp updated by media playback script\">\n                0:05.1\n            </span>\n        </div>\n    </section>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
