me\" type=\"button\">\n                        <i data-kid=\"1-2-3-3-2-1-1\" data-lucide=\"skip-back\" data-name=\"skip back icon\" style=\"width:13px;height:13px\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Play preview\" class=\"icon-button play\" data-kid=\"1-2-3-3-2-2\" data-name=\"play button\" title=\"Play preview\" type=\"button\">\n                        <i data-kid=\"1-2-3-3-2-2-1\" data-lucide=\"play\" data-name=\"play icon\" style=\"width:13px;height:13px;fill:currentColor\">\n                        </i>\n                    </button>\n                    <button aria-label=\"Fullscreen preview\" class=\"icon-button\" data-kid=\"1-2-3-3-2-3\" data-name=\"fullscreen button\" title=\"Fullscreen preview\" type=\"button\">\n                        <i data-kid=\"1-2-3-3-2-3-1\" data-lucide=\"maximize-2\" data-name=\"maximize icon\" style=\"width:13px;height:13px\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"caption-inspector\" data-kid=\"1-2-3-4\" data-name=\"caption inspector panel\">\n                <span class=\"section-kicker\" data-kid=\"1-2-3-4-1\" data-name=\"inspector section kicker\">\n                    Selected treatment\n                </span>\n                <h3 data-kid=\"1-2-3-4-2\" data-name=\"inspector section title\">\n                    Caption style\n                </h3>\n                <div class=\"inspector-options\" data-kid=\"1-2-3-4-3\" data-name=\"caption option grid\">\n                    <button class=\"caption-option active\" data-kid=\"1-2-3-4-3-1\" data-name=\"emphasis caption option\" type=\"button\">\n                        <span class=\"caption-sample\" data-kid=\"1-2-3-4-3-1-1\" data-name=\"caption sample text\">\n                            one\n                        </span>\n                        Emphasis\n                    </button>\n                    <button class=\"caption-option\" data-kid=\"1-2-3-4-3-2\" data-name=\"quote caption option\" type=\"button\">\n                        <span class=\"caption-sample\" data-kid=\"1-2-3-4-3-2-1\" data-name=\"caption sample text\">\n                            “ ”\n                        </span>\n                        Quote card\n                    </button>\n                    <button class=\"caption-option\" data-kid=\"1-2-3-4-3-3\" data-name=\"title caption option\" type=\"button\">\n                        <span class=\"caption-sample\" data-kid=\"1-2-3-4-3-3-1\" data-name=\"caption sample text\">\n                            Aa\n                        </span>\n                        Title frame\n                    </button>\n                </div>\n            </div>\n        </aside>\n    </main>\n    <section aria-label=\"Timeline editor\" class=\"timeline\" data-kid=\"1-3\" data-name=\"timeline editor\">\n        <div class=\"timeline-head\" data-kid=\"1-3-1\" data-name=\"timeline header\">\n            <div class=\"timeline-head-left\" data-kid=\"1-3-1-1\" data-name=\"timeline title area\">\n                <span class=\"timeline-title\" data-kid=\"1-3-1-1-1\" data-name=\"timeline section title\">\n                    Timeline\n                </span>\n                <span class=\"timeline-sub\" data-kid=\"1-3-1-1-2\" data-name=\"timeline instructional subtext\">\n                    drag to refine · snap on\n                </span>\n            </div>\n            <div class=\"timeline-actions\" data-kid=\"1-3-1-2\" data-name=\"timeline action buttons\">\n                <button aria-label=\"Zoom out timeline\" class=\"timeline-control\" data-kid=\"1-3-1-2-1\" data-name=\"zoom out button\" type=\"button\">\n                    −\n                </button>\n                <button aria-label=\"Zoom in timeline\" class=\"timeline-control\" data-kid=\"1-3-1-2-2\" data-name=\"zoom in button\" type=\"button\">\n                    +\n                </button>\n                <button class=\"timeline-control\" data-kid=\"1-3-1-2-3\" data-name=\"fit timeline button\" type=\"button\">\n                    FIT\n                </button>\n            </div>\n        </div>\n        <div class=\"ruler\" data-kid=\"1-3-2\" data-name=\"timeline ruler\">\n            <div class=\"ruler-labels\" data-kid=\"1-3-2-1\" data-name=\"ruler time labels\">\n                <span data-kid=\"1-3-2-1-1\">\n                    0:00\n                </span>\n                <span data-kid=\"1-3-2-1-2\">\n                    0:05\n                </span>\n                <span data-kid=\"1-3-2-1-3\">\n                    0:10\n                </span>\n                <span data-kid=\"1-3-2-1-4\">\n                    0:15\n                </span>\n                <span data-kid=\"1-3-2-1-5\">\n                    0:20\n                </span>\n                <span data-kid=\"1-3-2-1-6\">\n                    0:25\n                </span>\n                <span data-kid=\"1-3-2-1-7\">\n                    0:30\n                </span>\n            </div>\n        </div>\n        <div class=\"timeline-body\" data-kid=\"1-3-3\" data-name=\"timeline body\">\n            <div aria-hidden=\"true\" class=\"playhead\" data-dynamic=\"true\" data-kid=\"1-3-3-1\" data-name=\"playhead marker\" data-reason=\"position updated by animation or playback script\">\n            </div>\n            <div class=\"track-row\" data-kid=\"1-3-3-2\" data-name=\"video track row\">\n                <span class=\"track-label\" data-kid=\"1-3-3-2-1\">\n                    VIDEO\n                </span>\n                <div class=\"track-lane\" data-kid=\"1-3-3-2-2\">\n                    <span class=\"clip video\" data-kid=\"1-3-3-2-2-1\" style=\"left:0%;width:8%\">\n                        <span class=\"handle left\" data-kid=\"1-3-3-2-2-1-1\">\n                        </span>\n                        KEEP 1.9s\n                    </span>\n                    <span class=\"clip video alt\" data-kid=\"1-3-3-2-2-2\" style=\"left:8.2%;width:10%\">\n                        KEEP\n                    </span>\n                    <span class=\"clip video\" data-kid=\"1-3-3-2-2-3\" style=\"left:18.5%;width:7%\">\n                        CUT 1.9s\n                    </span>\n                    <span class=\"clip video alt selected\" data-kid=\"1-3-3-2-2-4\" style=\"left:25.8%;width:13%\">\n                        <span class=\"handle left\" data-kid=\"1-3-3-2-2-4-1\">\n                        </span>\n                        KEEP 3.0s\n                        <span class=\"handle right\" data-kid=\"1-3-3-2-2-4-2\">\n                        </span>\n                    </span>\n                    <span class=\"clip video\" data-kid=\"1-3-3-2-2-5\" style=\"left:39.2%;width:13%\">\n                        KEEP\n                    </span>\n                    <span class=\"clip video alt\" data-kid=\"1-3-3-2-2-6\" style=\"left:52.6%;width:10%\">\n                        KEEP\n                    </span>\n                    <span class=\"clip video\" data-kid=\"1-3-3-2-2-7\" style=\"left:63%;width:18%\">\n                        KEEP 3.2s\n                    </span>\n                    <span class=\"clip video alt\" data-kid=\"1-3-3-2-2-8\" style=\"left:81.3%;width:9%\">\n                        KEEP\n                    </span>\n                    <span class=\"clip video\" data-kid=\"1-3-3-2-2-9\" style=\"left:90.7%;width:8%\">\n                        KEEP\n                    </span>\n                </div>\n            </div>\n            <div class=\"track-row\" data-kid=\"1-3-3-3\" data-name=\"captions track row\">\n                <span class=\"track-label\" data-kid=\"1-3-3-3-1\">\n                    CAPTIONS\n                </span>\n                <div class=\"track-lane\" data-kid=\"1-3-3-3-2\">\n                    <span class=\"clip caption\" data-kid=\"1-3-3-3-2-1\" style=\"left:1%;width:10%\">\n                        Top three tricks\n                    </span>\n                    <span class=\"clip caption\" data-kid=\"1-3-3-3-2-2\" style=\"left:18%;width:14%\">\n                        Number one\n                    </span>\n                    <span class=\"clip caption\" data-kid=\"1-3-3-3-2-3\" style=\"left:38%;width:11%\">\n                        overlay text\n                    </span>\n                    <span class=\"clip caption\" data-kid=\"1-3-3-3-2-4\" style=\"left:54%;width:13%\">\n                        Tip two\n                    </span>\n                    <span class=\"clip caption\" data-kid=\"1-3-3-3-2-5\" style=\"left:73%;width:11%\">\n                        sound effects\n                    </span>\n                    <span class=\"clip caption\" data-kid=\"1-3-3-3-2-6\" style=\"left:88%;width:9%\">\n                        pop\n                    </span>\n                </div>\n            </div>\n            <div class=\"track-row\" data-kid=\"1-3-3-4\" data-name=\"sfx track row\">\n                <span class=\"track-label\" data-kid=\"1-3-3-4-1\">\n                    SFX\n                </span>\n                <div class=\"track-lane\" data-kid=\"1-3-3-4-2\">\n                    <span class=\"clip sfx\" data-kid=\"1-3-3-4-2-1\" style=\"left:2%;width:4%\">\n                        Cream\n                    </span>\n                    <span class=\"clip sfx\" data-kid=\"1-3-3-4-2-2\" style=\"left:25%;width:2%\">\n                    </span>\n                    <span class=\"clip sfx\" data-kid=\"1-3-3-4-2-3\" style=\"left:61%;width:2%\">\n                    </span>\n                    <span class=\"clip sfx\" data-kid=\"1-3-3-4-2-4\" style=\"left:83%;width:5%\">\n                        Magic\n                    </span>\n                </div>\n            </div>\n            <div class=\"track-row\" data-kid=\"1-3-3-5\" data-name=\"zoom track row\">\n                <span class=\"track-label\" data-kid=\"1-3-3-5-1\">\n                    ZOOM\n                </span>\n                <div class=\"track-lane\" data-kid=\"1-3-3-5-2\">\n                    <span class=\"clip zoom\" data-kid=\"1-3-3-5-2-1\" style=\"left:17%;width:4%\">\n                        1.10x\n                    </span>\n                    <span class=\"clip zoom\" data-kid=\"1-3-3-5-2-2\" style=\"left:49%;width:4%\">\n                        1.10x\n                    </span>\n                    <span class=\"clip zoom selected\" data-kid=\"1-3-3-5-2-3\" style=\"left:69%;width:3%\">\n                        <span class=\"handle left\" data-kid=\"1-3-3-5-2-3-1\">\n                        </span>\n                        1.2x\n                        <span class=\"handle right\" data-kid=\"1-3-3-5-2-3-2\">\n                        </span>\n                    </span>\n                    <span class=\"clip zoom\" data-kid=\"1-3-3-5-2-4\" style=\"left:79%;width:4%\">\n                        1.10x\n                    </span>\n                </div>\n            </div>\n            <div class=\"track-row\" data-kid=\"1-3-3-6\" data-name=\"vfx track row\">\n                <span class=\"track-label\" data-kid=\"1-3-3-6-1\">\n                    VFX\n                </span>\n                <div class=\"track-lane\" data-kid=\"1-3-3-6-2\">\n                    <span class=\"clip vfx\" data-kid=\"1-3-3-6-2-1\" style=\"left:1%;width:8%\">\n                        Top Three Video\n                    </span>\n                    <span class=\"clip vfx\" data-kid=\"1-3-3-6-2-2\" style=\"left:18%;width:16%\">\n                        Number One · Overlay\n                    </span>\n                    <span class=\"clip vfx\" data-kid=\"1-3-3-6-2-3\" style=\"left:40%;width:6%\">\n                        Bold words\n                    </span>\n                    <span class=\"clip vfx\" data-kid=\"1-3-3-6-2-4\" style=\"left:56%;width:8%\">\n                        Tip Two\n                    </span>\n                    <span class=\"clip vfx\" data-kid=\"1-3-3-6-2-5\" style=\"left:74%;width:12%\">\n                        Tip Three\n                    </span>\n                    <span class=\"clip vfx\" data-kid=\"1-3-3-6-2-6\" style=\"left:90%;width:8%\">\n                        Bold White\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"timeline-legend\" data-kid=\"1-3-4\" data-name=\"timeline legend\">\n            <span class=\"legend-item\" data-kid=\"1-3-4-1\">\n                <span class=\"legend-dot\" data-kid=\"1-3-4-1-1\" style=\"background:#d6aa18\">\n                </span>\n                Video\n            </span>\n            <span class=\"legend-item\" data-kid=\"1-3-4-2\">\n                <span class=\"legend-dot\" data-kid=\"1-3-4-2-1\" style=\"background:var(--teal)\">\n                </span>\n                SFX\n            </span>\n            <span class=\"legend-item\" data-kid=\"1-3-4-3\">\n                <span class=\"legend-dot\" data-kid=\"1-3-4-3-1\" style=\"background:var(--lilac)\">\n                </span>\n                Zoom\n            </span>\n            <span class=\"legend-item\" data-kid=\"1-3-4-4\">\n                <span class=\"legend-dot\" data-kid=\"1-3-4-4-1\" style=\"background:#f18a9e\">\n                </span>\n                VFX\n            </span>\n            <span data-kid=\"1-3-4-5\" style=\"margin-left:auto;color:rgba(245,249,206,.3)\">\n                ⌘ S save\n            </span>\n        </div>\n    </section>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
      "comments": [],
      "created": "2026-08-16T04:04:18.189449+00:00",
      "modified": "2026-08-16T04:05:12.614201+00:00",
