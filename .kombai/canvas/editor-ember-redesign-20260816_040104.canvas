    },
    "var_5b19b69686f1": {
      "type": "variant",
      "label": "New project — Sequence Studio",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  .stage,\n  .stage * { box-sizing: border-box; }\n\n  .stage {\n    --cream: #f5f9ce;\n    --cream-deep: #ecefc0;\n    --ink: #450e16;\n    --purple: #432e6f;\n    --orange: #ffa102;\n    --tomato: #dd5533;\n    --crimson: #bc2d29;\n    --muted: #75677f;\n    min-height: 760px;\n    overflow: hidden;\n    position: relative;\n    display: grid;\n    place-items: center;\n    padding: 48px;\n    background:\n      radial-gradient(circle at 18% 18%, rgba(255,161,2,.16), transparent 27%),\n      linear-gradient(128deg, rgba(67,46,111,.16), transparent 38%),\n      #d9d7b8;\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .library-backdrop {\n    position: absolute;\n    inset: 0;\n    padding: 34px 42px;\n    filter: blur(5px);\n    opacity: .76;\n    transform: scale(1.045);\n    pointer-events: none;\n  }\n\n  .backdrop-top { display:flex; align-items:center; justify-content:space-between; }\n  .backdrop-brand { font-size: 26px; font-weight:700; letter-spacing:-.04em; }\n  .backdrop-nav { display:flex; gap:10px; font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:.12em; text-transform:uppercase; }\n  .backdrop-nav span { padding:8px 13px; border:1px solid rgba(69,14,22,.28); border-radius:999px; }\n  .backdrop-heading { margin:90px auto 22px; max-width:1080px; font-size:64px; line-height:.88; font-weight:700; }\n  .backdrop-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; max-width:1080px; margin:auto; }\n  .backdrop-card { height:190px; border:2px solid rgba(69,14,22,.34); border-radius:22px; background:rgba(245,249,206,.66); box-shadow:5px 6px 0 rgba(69,14,22,.25); padding:18px; }\n  .backdrop-card:nth-child(2) { background:linear-gradient(125deg, rgba(255,161,2,.62), rgba(245,249,206,.75)); }\n  .backdrop-card:nth-child(3) { background:linear-gradient(135deg, rgba(67,46,111,.42), rgba(245,249,206,.72)); }\n  .backdrop-card strong { display:block; margin-top:110px; font-size:20px; }\n\n  .scrim { position:absolute; inset:0; background:rgba(69,14,22,.28); }\n\n  .modal {\n    position:relative;\n    z-index:1;\n    width:min(1080px, 100%);\n    min-height:660px;\n    display:flex;\n    flex-direction:column;\n    overflow:hidden;\n    border:2px solid var(--ink);\n    border-radius:24px;\n    background:var(--cream);\n    box-shadow:8px 9px 0 var(--ink), 0 20px 48px rgba(69,14,22,.25);\n  }\n\n  .modal-header { display:flex; align-items:flex-start; justify-content:space-between; gap:24px; padding:30px 34px 22px; border-bottom:1.5px solid rgba(69,14,22,.28); }\n  .eyebrow { margin:0 0 7px; color:var(--tomato); font:600 10px/1.2 'JetBrains Mono', monospace; letter-spacing:.18em; text-transform:uppercase; }\n  .title { margin:0; font-size:54px; line-height:.82; letter-spacing:-.055em; font-weight:700; }\n  .helper { margin:10px 0 0; color:var(--purple); font-size:17px; line-height:1.2; }\n  .close-button,\n  .icon-button,\n  .play-button,\n  .move-button,\n  .remove-button { display:grid; place-items:center; flex:none; width:44px; height:44px; border:1.5px solid var(--ink); color:var(--ink); background:transparent; border-radius:50%; cursor:pointer; }\n  .close-button:hover, .icon-button:hover, .move-button:hover, .remove-button:hover { background:var(--orange); }\n  .close-button:focus-visible, .icon-button:focus-visible, .play-button:focus-visible, .move-button:focus-visible, .remove-button:focus-visible, .clip-row:focus-visible, .dropzone:focus-visible, .create-button:focus-visible, .cancel-button:focus-visible { outline:3px solid var(--orange); outline-offset:3px; }\n  .icon { font-size:18px; line-height:1; }\n\n  .modal-main { flex:1; min-height:0; display:grid; grid-template-columns: 40% 60%; }\n  .queue-pane { min-width:0; padding:24px 26px 28px 34px; border-right:1.5px solid rgba(69,14,22,.3); }\n  .pane-heading { display:flex; align-items:baseline; justify-content:space-between; gap:14px; margin-bottom:13px; }\n  .pane-title { margin:0; font-size:27px; line-height:1; font-weight:700; }\n  .pane-meta { color:var(--purple); font:500 10px/1.2 'JetBrains Mono', monospace; letter-spacing:.04em; white-space:nowrap; }\n  .dropzone { display:flex; align-items:center; gap:9px; min-height:48px; margin-bottom:14px; padding:10px 12px; border:1.5px dashed var(--ink); border-radius:12px; color:var(--purple); background:rgba(255,161,2,.07); cursor:pointer; text-align:left; }\n  .dropzone:hover, .dropzone.is-dragging { background:rgba(255,161,2,.22); border-color:var(--orange); color:var(--ink); }\n  .dropzone-copy { display:flex; flex-direction:column; gap:1px; }\n  .dropzone-copy strong { font-size:16px; line-height:1; font-weight:600; }\n  .dropzone-copy span { font:500 9px/1.2 'JetBrains Mono', monospace; letter-spacing:.04em; text-transform:uppercase; }\n  .clip-list { display:flex; flex-direction:column; gap:9px; margin:0; padding:0; list-style:none; }\n  .clip-row { position:relative; display:grid; grid-template-columns: 30px 24px minmax(0,1fr) auto; align-items:center; gap:8px; min-height:78px; padding:10px 9px 10px 10px; border:1.5px solid var(--ink); border-radius:16px; background:rgba(245,249,206,.68); cursor:pointer; transition:transform 180ms ease, background-color 180ms ease, box-shadow 180ms ease; }\n  .clip-row:hover { transform:translateX(3px); background:rgba(255,161,2,.12); }\n  .clip-row.is-selected { background:var(--orange); box-shadow:4px 4px 0 var(--ink); transform:translateX(4px); }\n  .order-number { display:grid; place-items:center; width:27px; height:27px; border:1.5px solid currentColor; border-radius:50%; font:600 11px/1 'JetBrains Mono', monospace; }\n  .grip-button { display:grid; place-items:center; width:24px; height:44px; border:0; padding:0; color:var(--muted); background:transparent; cursor:grab; }\n  .clip-row.is-selected .grip-button { color:var(--ink); }\n  .clip-copy { min-width:0; text-align:left; }\n  .clip-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:18px; line-height:1; font-weight:600; }\n  .clip-sub { display:flex; align-items:center; gap:6px; margin-top:6px; color:var(--purple); font:500 9px/1.1 'JetBrains Mono', monospace; letter-spacing:.03em; text-transform:uppercase; }\n  .clip-row.is-selected .clip-sub { color:rgba(69,14,22,.76); }\n  .playing-now { display:inline-flex; align-items:center; gap:4px; margin-top:5px; color:var(--ink); font:600 8px/1 'JetBrains Mono', monospace; letter-spacing:.11em; }\n  .playing-dot { width:5px; height:5px; border-radius:50%; background:var(--ink); box-shadow:0 0 0 3px rgba(69,14,22,.14); }\n  .clip-actions { display:flex; align-items:center; gap:2px; }\n  .move-button, .remove-button { width:36px; height:36px; border-color:rgba(69,14,22,.55); }\n  .remove-button { color:var(--crimson); }\n  .clip-row.is-selected .move-button, .clip-row.is-selected .remove-button { border-color:rgba(69,14,22,.6); color:var(--ink); }\n  .drag-ghost { opacity:.45; }\n  .queue-note { display:flex; align-items:center; gap:8px; margin:16px 0 0; color:var(--purple); font:500 9px/1.3 'JetBrains Mono', monospace; letter-spacing:.02em; }\n  .queue-note .icon { font-size:14px; }\n\n  .preview-pane { min-width:0; display:flex; flex-direction:column; padding:24px 34px 28px 28px; background:linear-gradient(135deg, rgba(255,161,2,.06), rgba(67,46,111,.07)); }\n  .preview-topline { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }\n  .preview-kicker { color:var(--purple); font:600 10px/1.2 'JetBrains Mono', monospace; letter-spacing:.16em; text-transform:uppercase; }\n  .clip-badge { display:inline-flex; align-items:center; min-height:26px; padding:5px 9px; border:1.5px solid var(--ink); border-radius:999px; background:var(--orange); font:600 9px/1 'JetBrains Mono', monospace; letter-spacing:.06em; }\n  .player-shell { position:relative; overflow:hidden; aspect-ratio:16/9; border:2px solid var(--ink); border-radius:18px; background:var(--ink); box-shadow:6px 7px 0 var(--ink); }\n  .player-shell video { display:block; width:100%; height:100%; object-fit:cover; background:#2a1820; }\n  .player-sheen { position:absolute; inset:0; pointer-events:none; background:linear-gradient(125deg, rgba(255,161,2,.2), transparent 44%, rgba(67,46,111,.28)); mix-blend-mode:screen; }\n  .play-button { position:absolute; left:50%; top:50%; width:68px; height:68px; transform:translate(-50%,-50%); border:2px solid var(--cream); color:var(--ink); background:var(--orange); box-shadow:4px 4px 0 var(--ink); }\n  .play-button:hover { transform:translate(-50%,-50%) scale(1.04); }\n  .play-button .icon { font-size:28px; margin-left:3px; }\n  .player-controls { display:flex; align-items:center; gap:11px; margin-top:13px; }\n  .control-play { display:grid; place-items:center; width:40px; height:40px; border:1.5px solid var(--ink); border-radius:50%; color:var(--ink); background:transparent; cursor:pointer; }\n  .control-play:hover { background:var(--orange); }\n  .scrub-wrap { flex:1; display:flex; flex-direction:column; gap:6px; }\n  .scrub { width:100%; height:5px; accent-color:var(--orange); cursor:pointer; }\n  .time-row { display:flex; justify-content:space-between; color:var(--purple); font:500 9px/1 'JetBrains Mono', monospace; }\n  .active-title { margin:25px 0 0; font-size:34px; line-height:.95; letter-spacing:-.035em; font-weight:700; }\n  .active-helper { margin:7px 0 0; color:var(--purple); font-size:15px; line-height:1.2; }\n  .footer-actions { display:flex; align-items:center; justify-content:flex-end; gap:16px; margin-top:auto; padding-top:22px; }\n  .cancel-button { min-height:44px; border:0; padding:9px 7px; color:var(--purple); background:transparent; font:600 15px/1 'Cormorant Garamond', Georgia, serif; cursor:pointer; }\n  .cancel-button:hover { color:var(--ink); text-decoration:underline; text-underline-offset:4px; }\n  .create-button { display:inline-flex; align-items:center; justify-content:center; min-height:48px; border:2px solid var(--ink); border-radius:16px; padding:11px 18px; color:var(--ink); background:var(--orange); box-shadow:4px 4px 0 var(--ink); font:600 17px/1 'Cormorant Garamond', Georgia, serif; cursor:pointer; }\n  .create-button:hover { transform:translate(1px,1px); box-shadow:3px 3px 0 var(--ink); }\n  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }\n  .status-line { min-height:17px; margin:10px 0 0; color:var(--tomato); font:500 9px/1.3 'JetBrains Mono', monospace; }\n\n  @media (max-width: 900px) {\n    .stage { padding:28px; }\n    .modal-header { padding-inline:25px; }\n    .queue-pane { padding-left:25px; }\n    .preview-pane { padding-right:25px; }\n  }\n\n  @media (max-width: 767px) {\n    .stage { min-height:100dvh; padding:14px; place-items:start center; overflow:auto; }\n    .library-backdrop { display:none; }\n    .scrim { background:rgba(69,14,22,.13); }\n    .modal { width:100%; min-height:0; margin:14px 0 24px; }\n    .modal-header { padding:24px 20px 18px; }\n    .title { font-size:43px; }\n    .helper { max-width:250px; font-size:15px; }\n    .modal-main { display:flex; flex-direction:column; }\n    .queue-pane { padding:20px; border-right:0; border-bottom:1.5px solid rgba(69,14,22,.3); }\n    .preview-pane { padding:20px; }\n    .clip-row { grid-template-columns:28px 24px minmax(0,1fr) auto; }\n    .clip-actions { gap:1px; }\n    .move-button, .remove-button { width:40px; height:40px; }\n    .active-title { font-size:30px; }\n    .footer-actions { justify-content:stretch; }\n    .cancel-button { flex:0 0 auto; }\n    .create-button { flex:1; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .clip-row, .play-button, .create-button { transition:none; }\n    .clip-row:hover, .clip-row.is-selected, .play-button:hover, .create-button:hover { transform:none; }\n  }\n</style>\n<div aria-label=\"New project sequence setup\" class=\"stage\" data-kid=\"1\">\n    <div aria-hidden=\"true\" class=\"library-backdrop\" data-kid=\"1-1\">\n        <div class=\"backdrop-top\" data-kid=\"1-1-1\">\n            <div class=\"backdrop-brand\" data-kid=\"1-1-1-1\">\n                YapCut\n            </div>\n            <div class=\"backdrop-nav\" data-kid=\"1-1-1-2\">\n                <span data-kid=\"1-1-1-2-1\">\n                    Library\n                </span>\n                <span data-kid=\"1-1-1-2-2\">\n                    Edits\n                </span>\n                <span data-kid=\"1-1-1-2-3\">\n                    Account\n                </span>\n            </div>\n        </div>\n        <div class=\"backdrop-heading\" data-kid=\"1-1-2\">\n            Your next cut starts here.\n        </div>\n        <div class=\"backdrop-grid\" data-kid=\"1-1-3\">\n            <div class=\"backdrop-card\" data-kid=\"1-1-3-1\">\n                <strong data-kid=\"1-1-3-1-1\">\n                    Studio Walkthrough\n                </strong>\n            </div>\n            <div class=\"backdrop-card\" data-kid=\"1-1-3-2\">\n                <strong data-kid=\"1-1-3-2-1\">\n                    Founder Notes\n                </strong>\n            </div>\n            <div class=\"backdrop-card\" data-kid=\"1-1-3-3\">\n                <strong data-kid=\"1-1-3-3-1\">\n                    Launch Film\n                </strong>\n            </div>\n        </div>\n    </div>\n    <div aria-hidden=\"true\" class=\"scrim\" data-kid=\"1-2\">\n    </div>\n    <section aria-labelledby=\"new-project-title\" aria-modal=\"true\" class=\"modal\" data-kid=\"1-3\" role=\"dialog\">\n        <header class=\"modal-header\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <p class=\"eyebrow\" data-kid=\"1-3-1-1-1\">\n                    Setup / A-roll\n                </p>\n                <h1 class=\"title\" data-kid=\"1-3-1-1-2\" id=\"new-project-title\">\n                    New project\n                </h1>\n                <p class=\"helper\" data-kid=\"1-3-1-1-3\">\n                    Arrange the story before we cut it.\n                </p>\n            </div>\n            <button aria-label=\"Close new project dialog\" class=\"close-button\" data-kid=\"1-3-1-2\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-x icon\" data-kid=\"1-3-1-2-1\">\n                </i>\n            </button>\n        </header>\n        <div class=\"modal-main\" data-kid=\"1-3-2\">\n            <section aria-labelledby=\"sequence-title\" class=\"queue-pane\" data-kid=\"1-3-2-1\">\n                <div class=\"pane-heading\" data-kid=\"1-3-2-1-1\">\n                    <h2 class=\"pane-title\" data-kid=\"1-3-2-1-1-1\" id=\"sequence-title\">\n                        Sequence\n                    </h2>\n                    <span class=\"pane-meta\" data-dynamic=\"true\" data-kid=\"1-3-2-1-1-2\" data-name=\"sequence metadata count\" data-reason=\"text updated when clips are added, removed, or reordered\" id=\"sequence-meta\">\n                        3 clips · 00:42 total\n                    </span>\n                </div>\n                <button aria-label=\"Add more videos\" class=\"dropzone\" data-kid=\"1-3-2-1-2\" id=\"add-more\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus icon\" data-kid=\"1-3-2-1-2-1\">\n                    </i>\n                    <span class=\"dropzone-copy\" data-kid=\"1-3-2-1-2-2\">\n                        <strong data-kid=\"1-3-2-1-2-2-1\">\n                            Add more videos\n                        </strong>\n                        <span data-kid=\"1-3-2-1-2-2-2\">\n                            MP4 / MOV · A-roll only\n                        </span>\n                    </span>\n                </button>\n                <input accept=\"video/mp4,video/quicktime,video/webm,video/x-m4v\" class=\"sr-only\" data-kid=\"1-3-2-1-3\" id=\"file-input\" multiple=\"\" type=\"file\"/>\n                <ul aria-label=\"A-roll sequence\" class=\"clip-list\" data-dynamic=\"true\" data-kid=\"1-3-2-1-4\" data-name=\"clip list container\" data-reason=\"list items dynamically rendered by script\" id=\"clip-list\">\n                </ul>\n                <p class=\"queue-note\" data-kid=\"1-3-2-1-5\">\n                    <i aria-hidden=\"true\" class=\"ti ti-arrows-move icon\" data-kid=\"1-3-2-1-5-1\">\n                    </i>\n                    <span data-kid=\"1-3-2-1-5-2\">\n                        Drag clips to change the cut. Use the arrow controls for precise moves.\n                    </span>\n                </p>\n                <p aria-live=\"polite\" class=\"status-line\" data-dynamic=\"true\" data-kid=\"1-3-2-1-6\" data-name=\"status notification text\" data-reason=\"text updated via aria-live on user actions\" id=\"status-line\">\n                </p>\n            </section>\n            <section aria-labelledby=\"preview-title\" class=\"preview-pane\" data-kid=\"1-3-2-2\">\n                <div class=\"preview-topline\" data-kid=\"1-3-2-2-1\">\n                    <span class=\"preview-kicker\" data-kid=\"1-3-2-2-1-1\" id=\"preview-title\">\n                        Expected order / live preview\n                    </span>\n                    <span class=\"clip-badge\" data-dynamic=\"true\" data-kid=\"1-3-2-2-1-2\" data-name=\"active clip indicator\" data-reason=\"text updated when selected clip changes\" id=\"clip-badge\">\n                        Clip 2 of 3\n                    </span>\n                </div>\n                <div class=\"player-shell\" data-kid=\"1-3-2-2-2\">\n                    <video aria-label=\"Preview of A-roll_Scene2.mov — Wayne Speedy on Pexels\" autoplay=\"\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-1\" data-name=\"preview video player\" data-reason=\"source and poster updated via script when clip selection changes\" id=\"preview-video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/36381056/aerial-landscape-agriculture-cinematic-shot-country-road-36381056.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\">\n                        <source data-kid=\"1-3-2-2-2-1-1\" src=\"https://videos.pexels.com/video-files/36381056/15428529_640_360_30fps.mp4\" type=\"video/mp4\"/>\n                    </video>\n                    <div aria-hidden=\"true\" class=\"player-sheen\" data-kid=\"1-3-2-2-2-2\">\n                    </div>\n                    <button aria-label=\"Play preview\" class=\"play-button\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-3\" data-name=\"hero play toggle button\" data-reason=\"icon and aria-label toggled based on video state\" id=\"hero-play\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-player-play-filled icon\" data-kid=\"1-3-2-2-2-3-1\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"player-controls\" data-kid=\"1-3-2-2-3\">\n                    <button aria-label=\"Pause preview\" class=\"control-play\" data-dynamic=\"true\" data-kid=\"1-3-2-2-3-1\" data-name=\"control play toggle button\" data-reason=\"icon and aria-label toggled based on video state\" id=\"control-play\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-player-pause-filled icon\" data-kid=\"1-3-2-2-3-1-1\">\n                        </i>\n                    </button>\n                    <div class=\"scrub-wrap\" data-kid=\"1-3-2-2-3-2\">\n                        <input aria-label=\"Preview progress\" class=\"scrub\" data-dynamic=\"true\" data-kid=\"1-3-2-2-3-2-1\" data-name=\"video scrub slider\" data-reason=\"value synchronized with video playback position\" id=\"scrub\" max=\"100\" min=\"0\" type=\"range\" value=\"0\"/>\n                        <div class=\"time-row\" data-kid=\"1-3-2-2-3-2-2\">\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-2-3-2-2-1\" data-name=\"current playback time\" data-reason=\"text updated as video plays\" id=\"current-time\">\n                                00:00\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-3-2-2-3-2-2-2\" data-name=\"total duration time\" data-reason=\"text updated to match active video length\" id=\"duration-time\">\n                                00:15\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <h2 class=\"active-title\" data-dynamic=\"true\" data-kid=\"1-3-2-2-4\" data-name=\"active clip title heading\" data-reason=\"text updated when selected clip changes\" id=\"active-title\">\n                    A-roll_Scene2.mov\n                </h2>\n                <p class=\"active-helper\" data-kid=\"1-3-2-2-5\">\n                    Clip 2 is queued after the opening beat. Drag clips to change the cut.\n                </p>\n                <div class=\"footer-actions\" data-kid=\"1-3-2-2-6\">\n                    <button class=\"cancel-button\" data-kid=\"1-3-2-2-6-1\" type=\"button\">\n                        Cancel\n                    </button>\n                    <button class=\"create-button\" data-kid=\"1-3-2-2-6-2\" id=\"create-project\" type=\"button\">\n                        Create project ·\n                        <span data-dynamic=\"true\" data-kid=\"1-3-2-2-6-2-1\" data-name=\"create project clip count\" data-reason=\"text updated when clips are added, removed, or reordered\" id=\"create-count\">\n                            3 clips\n                        </span>\n                    </button>\n                </div>\n            </section>\n        </div>\n    </section>\n</div>\n<script>\n    (() => {\n    const poster = 'https://images.pexels.com/videos/36381056/aerial-landscape-agriculture-cinematic-shot-country-road-36381056.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200';\n    const source = 'https://videos.pexels.com/video-files/36381056/15428529_640_360_30fps.mp4';\n    let clips = [\n      { name: 'A-roll_Scene1.mp4', kind: 'MP4', duration: '00:18', poster, source },\n      { name: 'A-roll_Scene2.mov', kind: 'MOV', duration: '00:15', poster, source },\n      { name: 'A-roll_Closing.mp4', kind: 'MP4', duration: '00:09', poster, source },\n    ];\n    let active = 1;\n    let dragged = null;\n    const list = document.getElementById('clip-list');\n    const video = document.getElementById('preview-video');\n    const activeTitle = document.getElementById('active-title');\n    const clipBadge = document.getElementById('clip-badge');\n    const sequenceMeta = document.getElementById('sequence-meta');\n    const createCount = document.getElementById('create-count');\n    const status = document.getElementById('status-line');\n    const scrub = document.getElementById('scrub');\n    const currentTime = document.getElementById('current-time');\n    const durationTime = document.getElementById('duration-time');\n    const playButton = document.getElementById('hero-play');\n    const controlPlay = document.getElementById('control-play');\n    const fileInput = document.getElementById('file-input');\n\n    const formatTime = (seconds) => {\n      const value = Number.isFinite(seconds) ? Math.max(0, seconds) : 0;\n      return `${String(Math.floor(value / 60)).padStart(2, '0')}:${String(Math.floor(value % 60)).padStart(2, '0')}`;\n    };\n\n    const totalSeconds = () => clips.reduce((sum, clip) => sum + Number(clip.duration.split(':')[1] || 0), 0);\n\n    function render() {\n      list.innerHTML = clips.map((clip, index) => `\n        <li class=\"clip-row ${index === active ? 'is-selected' : ''}\" data-index=\"${index}\" draggable=\"true\" tabindex=\"0\" aria-label=\"${clip.name}, position ${index + 1} of ${clips.length}\" aria-current=\"${index === active ? 'true' : 'false'}\">\n          <span class=\"order-number\" aria-hidden=\"true\">${index + 1}</span>\n          <button class=\"grip-button\" type=\"button\" draggable=\"false\" aria-label=\"Drag to reorder ${clip.name}\"><i class=\"ti ti-grip-vertical icon\" aria-hidden=\"true\"></i></button>\n          <span class=\"clip-copy\">\n            <span class=\"clip-name\">${clip.name}</span>\n            <span class=\"clip-sub\"><span>${clip.kind}</span><span>·</span><span>${clip.duration}</span></span>\n            ${index === active ? '<span class=\"playing-now\"><span class=\"playing-dot\"></span> PLAYING NOW</span>' : ''}\n          </span>\n          <span class=\"clip-actions\">\n            <button class=\"move-button move-up\" type=\"button\" draggable=\"false\" aria-label=\"Move ${clip.name} up\" ${index === 0 ? 'disabled' : ''}><i class=\"ti ti-chevron-up icon\" aria-hidden=\"true\"></i></button>\n            <button class=\"move-button move-down\" type=\"button\" draggable=\"false\" aria-label=\"Move ${clip.name} down\" ${index === clips.length - 1 ? 'disabled' : ''}><i class=\"ti ti-chevron-down icon\" aria-hidden=\"true\"></i></button>\n            <button class=\"remove-button\" type=\"button\" draggable=\"false\" aria-label=\"Remove ${clip.name}\"><i class=\"ti ti-x icon\" aria-hidden=\"true\"></i></button>\n          </span>\n        </li>\n      `).join('');\n\n      const total = totalSeconds();\n      sequenceMeta.textContent = `${clips.length} clips · ${formatTime(total)} total`;\n      createCount.textContent = `${clips.length} clip${clips.length === 1 ? '' : 's'}`;\n      active = Math.min(active, Math.max(0, clips.length - 1));\n      const current = clips[active];\n      if (current) {\n        activeTitle.textContent = current.name;\n        clipBadge.textContent = `Clip ${active + 1} of ${clips.length}`;\n        video.poster = current.poster;\n        video.src = current.source;\n        video.load();\n        video.play().catch(() => {});\n      }\n      bindRows();\n    }\n\n    function bindRows() {\n      list.querySelectorAll('.clip-row').forEach((row) => {\n        const index = Number(row.dataset.index);\n        row.addEventListener('click', (event) => {\n          if (event.target.closest('button')) return;\n          active = index;\n          status.textContent = `${clips[active].name} is now previewing.`;\n          render();\n        });\n        row.addEventListener('keydown', (event) => {\n          if (event.key === 'Enter' || event.key === ' ') {\n            event.preventDefault();\n            active = index;\n            render();\n          }\n        });\n        row.addEventListener('dragstart', (event) => {\n          dragged = index;\n          row.classList.add('drag-ghost');\n          event.dataTransfer.effectAllowed = 'move';\n          event.dataTransfer.setData('text/plain', String(index));\n        });\n        row.addEventListener('dragend', () => {\n          dragged = null;\n          row.classList.remove('drag-ghost');\n        });\n        row.addEventListener('dragover', (event) => {\n          event.preventDefault();\n          event.dataTransfer.dropEffect = 'move';\n        });\n        row.addEventListener('drop', (event) => {\n          event.preventDefault();\n          const target = Number(row.dataset.index);\n          if (dragged === null || dragged === target) return;\n          const [moved] = clips.splice(dragged, 1);\n          clips.splice(target, 0, moved);\n          if (active === dragged) active = target;\n          else if (dragged < active && target >= active) active -= 1;\n          else if (dragged > active && target <= active) active += 1;\n          status.textContent = `Sequence updated — ${clips[active].name} remains selected.`;\n          render();\n        });\n        row.querySelector('.move-up')?.addEventListener('click', () => move(index, -1));\n        row.querySelector('.move-down')?.addEventListener('click', () => move(index, 1));\n        row.querySelector('.remove-button')?.addEventListener('click', () => {\n          const removed = clips[index];\n          clips.splice(index, 1);\n          active = Math.min(active, Math.max(0, clips.length - 1));\n          status.textContent = `${removed.name} removed from the sequence.`;\n          render();\n        });\n      });\n    }\n\n    function move(index, direction) {\n      const next = index + direction;\n      if (next < 0 || next >= clips.length) return;\n      [clips[index], clips[next]] = [clips[next], clips[index]];\n      if (active === index) active = next;\n      else if (active === next) active = index;\n      status.textContent = `Moved ${clips[active].name} to position ${active + 1}.`;\n      render();\n    }\n\n    document.getElementById('add-more').addEventListener('click', () => fileInput.click());\n    document.getElementById('add-more').addEventListener('dragover', (event) => {\n      event.preventDefault();\n      event.currentTarget.classList.add('is-dragging');\n    });\n    document.getElementById('add-more').addEventListener('dragleave', (event) => event.currentTarget.classList.remove('is-dragging'));\n    document.getElementById('add-more').addEventListener('drop', (event) => {\n      event.preventDefault();\n      event.currentTarget.classList.remove('is-dragging');\n      addFiles(event.dataTransfer.files);\n    });\n    fileInput.addEventListener('change', (event) => addFiles(event.target.files));\n\n    function addFiles(fileList) {\n      const files = Array.from(fileList || []).filter((file) => file.type.startsWith('video/') || /\\.(mp4|mov|webm|m4v)$/i.test(file.name));\n      if (!files.length) return;\n      files.forEach((file, offset) => {\n        const objectUrl = URL.createObjectURL(file);\n        clips.push({ name: file.name || `A-roll_Added${offset + 1}.mp4`, kind: file.name?.toLowerCase().endsWith('.mov') ? 'MOV' : 'MP4', duration: '00:12', poster, source: objectUrl });\n      });\n      active = clips.length - files.length;\n      status.textContent = `${files.length} video${files.length === 1 ? '' : 's'} added to the end of the sequence.`;\n      render();\n      fileInput.value = '';\n    }\n\n    function togglePlay() {\n      if (video.paused) video.play().catch(() => {}); else video.pause();\n      updatePlayState();\n    }\n    function updatePlayState() {\n      const paused = video.paused;\n      playButton.innerHTML = `<i class=\"ti ${paused ? 'ti-player-play-filled' : 'ti-player-pause-filled'} icon\" aria-hidden=\"true\"></i>`;\n      playButton.setAttribute('aria-label', paused ? 'Play preview' : 'Pause preview');\n      controlPlay.innerHTML = `<i class=\"ti ${paused ? 'ti-player-play-filled' : 'ti-player-pause-filled'} icon\" aria-hidden=\"true\"></i>`;\n      controlPlay.setAttribute('aria-label', paused ? 'Play preview' : 'Pause preview');\n    }\n    playButton.addEventListener('click', togglePlay);\n    controlPlay.addEventListener('click', togglePlay);\n    video.addEventListener('play', updatePlayState);\n    video.addEventListener('pause', updatePlayState);\n    video.addEventListener('timeupdate', () => {\n      if (video.duration) scrub.value = String((video.currentTime / video.duration) * 100);\n      currentTime.textContent = formatTime(video.currentTime);\n      durationTime.textContent = formatTime(video.duration) || '00:15';\n    });\n    scrub.addEventListener('input', () => {\n      if (video.duration) video.currentTime = (Number(scrub.value) / 100) * video.duration;\n    });\n    document.getElementById('create-project').addEventListener('click', () => {\n      status.textContent = 'Project queued — preparing your sequence…';\n    });\n\n    render();\n    updatePlayState();\n  })();\n</script>\n",
      "comments": [],
      "created": "2026-08-16T04:51:48.455408+00:00",
      "modified": "2026-08-16T04:52:21.565944+00:00",
      "id": "var_5b19b69686f1"
    },
    "var_689c22277afb": {
      "type": "variant",
      "label": "New project — Timeline Cut",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7540,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .timeline-design {\n    --cream: #f5f9ce;\n    --cream-deep: #ecefc0;\n    --ink: #450e16;\n    --purple: #432e6f;\n    --orange: #ffa102;\n    --tomato: #dd5533;\n    --crimson: #bc2d29;\n    --muted: #75677f;\n    min-height: 100dvh;\n    overflow: hidden;\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    background:\n      radial-gradient(circle at 17% 12%, rgb(255 161 2 / 0.16), transparent 22rem),\n      linear-gradient(135deg, #f5f9ce 0%, #e9ecc0 48%, #d8d5b4 100%);\n  }\n\n  .timeline-design *,\n  .timeline-design *::before,\n  .timeline-design *::after { box-sizing: border-box; }\n\n  .stage-backdrop { position: absolute; inset: 0; overflow: hidden; }\n  .ghost-nav {\n    position: absolute; inset: 0 0 auto; height: 72px; display: flex; align-items: center; gap: 20px;\n    padding: 0 58px; color: rgb(69 14 22 / 0.64); background: rgb(245 249 206 / 0.65);\n    border-bottom: 1px solid rgb(69 14 22 / 0.12);\n  }\n  .ghost-brand { font-size: 22px; font-weight: 700; letter-spacing: -0.05em; }\n  .ghost-nav-pill { width: 88px; height: 10px; border-radius: 999px; background: rgb(67 46 111 / 0.16); }\n  .ghost-nav-pill.short { width: 54px; }\n  .ghost-content {\n    position: absolute; inset: 126px 58px 54px; display: grid; grid-template-columns: 0.78fr 1.45fr; gap: 44px;\n    opacity: 0.58; filter: blur(8px); transform: scale(1.03);\n  }\n  .ghost-copy { padding-top: 42px; }\n  .ghost-kicker { width: 118px; height: 9px; border-radius: 999px; background: rgb(221 85 51 / 0.42); }\n  .ghost-title { width: min(440px, 90%); height: 82px; margin-top: 22px; border-radius: 16px; background: rgb(69 14 22 / 0.16); }\n  .ghost-line { width: min(340px, 80%); height: 12px; margin-top: 18px; border-radius: 999px; background: rgb(67 46 111 / 0.19); }\n  .ghost-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; align-content: center; }\n  .ghost-card { min-height: 182px; border: 2px solid rgb(69 14 22 / 0.15); border-radius: 22px; background: rgb(245 249 206 / 0.76); box-shadow: 9px 10px 0 rgb(69 14 22 / 0.15); }\n  .ghost-card:nth-child(2) { transform: translateY(34px); background: rgb(188 45 41 / 0.2); }\n  .ghost-card:nth-child(3) { transform: translateY(-10px); background: rgb(255 161 2 / 0.22); }\n  .scrim { position: absolute; inset: 0; background: rgb(69 14 22 / 0.30); backdrop-filter: blur(4px); }\n\n  .modal-wrap { position: relative; z-index: 2; display: grid; min-height: 100dvh; place-items: center; padding: 34px 24px; }\n  .modal-card {\n    width: min(1100px, calc(100vw - 48px)); min-height: 720px; overflow: hidden; border: 2px solid var(--ink);\n    border-radius: 24px; background: var(--cream); box-shadow: 9px 10px 0 var(--ink), 0 22px 54px rgb(69 14 22 / 0.22);\n  }\n\n  .modal-header {\n    position: relative; min-height: 158px; padding: 28px 38px 26px; color: var(--cream);\n    background: linear-gradient(124deg, var(--orange) 0%, var(--tomato) 42%, var(--purple) 100%);\n    isolation: isolate;\n  }\n  .modal-header::after {\n    position: absolute; inset: 0; z-index: -1; content: ''; opacity: 0.22;\n    background-image: radial-gradient(rgb(245 249 206 / 0.46) 0.7px, transparent 0.7px); background-size: 9px 9px;\n    mix-blend-mode: screen;\n  }\n  .header-orbit { position: absolute; right: 92px; bottom: -48px; width: 176px; height: 176px; border: 1px solid rgb(245 249 206 / 0.34); border-radius: 50%; opacity: 0.7; }\n  .header-orbit::after { position: absolute; inset: 20px; content: ''; border: 1px dashed rgb(245 249 206 / 0.44); border-radius: 50%; }\n  .header-row { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 28px; }\n  .eyebrow { margin: 0; color: rgb(245 249 206 / 0.78); font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }\n  .modal-title { margin: 8px 0 0; font-size: clamp(42px, 5vw, 62px); font-weight: 700; line-height: 0.86; letter-spacing: -0.065em; }\n  .header-helper { max-width: 440px; margin: 14px 0 0; color: rgb(245 249 206 / 0.82); font-size: 16px; line-height: 1.25; }\n  .close-button { display: grid; flex: 0 0 auto; width: 44px; height: 44px; place-items: center; border: 2px solid var(--ink); border-radius: 999px; color: var(--ink); background: var(--cream); cursor: pointer; box-shadow: 3px 3px 0 var(--ink); }\n  .close-button:hover { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--ink); }\n  .close-button:focus-visible, .icon-button:focus-visible, .create-button:focus-visible, .cancel-link:focus-visible, .clip-row:focus-visible, .drop-branch:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }\n  .icon { display: inline-block; width: 1em; height: 1em; line-height: 1; font-size: 20px; }\n\n  .modal-body { display: grid; grid-template-columns: minmax(350px, 0.92fr) minmax(0, 1.18fr); min-height: 562px; }\n  .queue-pane { position: relative; padding: 28px 32px 30px 38px; border-right: 1px solid rgb(69 14 22 / 0.28); background: rgb(245 249 206 / 0.94); }\n  .queue-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; margin-bottom: 20px; }\n  .pane-label { margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }\n  .queue-caption { margin: 4px 0 0; color: var(--purple); font-size: 14px; line-height: 1.1; }\n  .sequence-count { flex: 0 0 auto; color: var(--purple); font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }\n  .timeline { position: relative; display: grid; gap: 12px; padding: 3px 0 0 36px; }\n  .timeline::before { position: absolute; top: 16px; bottom: 56px; left: 13px; width: 2px; content: ''; background: var(--ink); opacity: 0.76; }\n  .clip-row { position: relative; display: grid; grid-template-columns: 28px minmax(0, 1fr) 44px; align-items: center; min-height: 80px; padding: 10px 8px 10px 0; border: 1.5px solid transparent; border-radius: 16px; background: transparent; cursor: pointer; transition: transform 240ms cubic-bezier(0, 0, 0.2, 1), background-color 240ms cubic-bezier(0, 0, 0.2, 1), border-color 240ms cubic-bezier(0, 0, 0.2, 1), box-shadow 240ms cubic-bezier(0, 0, 0.2, 1); }\n  .clip-row:hover { border-color: rgb(69 14 22 / 0.24); background: rgb(255 161 2 / 0.09); }\n  .clip-row.is-active { transform: translateX(7px); border-color: rgb(67 46 111 / 0.32); background: rgb(67 46 111 / 0.10); }\n  .clip-row.is-playing { box-shadow: inset 4px 0 0 var(--orange); }\n  .clip-node { position: absolute; top: 50%; left: -36px; display: grid; width: 28px; height: 28px; place-items: center; border: 2px solid var(--ink); border-radius: 50%; color: var(--cream); background: var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; transform: translateY(-50%); z-index: 1; }\n  .clip-row.is-active .clip-node { width: 36px; height: 36px; left: -40px; border-color: var(--ink); color: var(--ink); background: var(--orange); box-shadow: 0 0 0 6px rgb(255 161 2 / 0.18); }\n  .grip { display: grid; width: 28px; height: 44px; place-items: center; color: var(--muted); cursor: grab; }\n  .grip:active { cursor: grabbing; }\n  .grip .icon { font-size: 18px; }\n  .clip-main { min-width: 0; padding: 0 6px; text-align: left; }\n  .clip-title-line { display: flex; min-width: 0; align-items: center; gap: 7px; }\n  .clip-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 19px; font-weight: 600; line-height: 1.05; }\n  .clip-row.is-active .clip-title { font-weight: 700; }\n  .play-state { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 4px; color: var(--tomato); font-family: 'JetBrains Mono', monospace; font-size: 8px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; }\n  .play-state .icon { font-size: 12px; }\n  .clip-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 6px; color: var(--purple); font-family: 'JetBrains Mono', monospace; font-size: 9px; font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase; }\n  .meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--purple); opacity: 0.64; }\n  .remove-button { display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid transparent; border-radius: 12px; color: var(--muted); background: transparent; cursor: pointer; }\n  .remove-button:hover { border-color: var(--tomato); color: var(--tomato); background: rgb(221 85 51 / 0.12); }\n  .remove-button .icon { font-size: 18px; }\n  .drop-branch { position: relative; display: flex; min-height: 70px; align-items: center; gap: 12px; margin-top: 2px; padding: 13px 16px 13px 20px; border: 1.5px dashed var(--ink); border-radius: 16px; color: var(--purple); background: rgb(255 161 2 / 0.08); cursor: pointer; transition: background-color 240ms cubic-bezier(0, 0, 0.2, 1), transform 240ms cubic-bezier(0, 0, 0.2, 1); }\n  .drop-branch::before { position: absolute; top: 50%; left: -27px; width: 25px; height: 2px; content: ''; background: var(--ink); opacity: 0.76; }\n  .drop-branch:hover, .drop-branch.is-dragging { transform: translateX(4px); background: rgb(255 161 2 / 0.22); }\n  .drop-icon { display: grid; width: 34px; height: 34px; place-items: center; border: 1.5px solid var(--ink); border-radius: 50%; color: var(--ink); background: var(--orange); }\n  .drop-icon .icon { font-size: 16px; }\n  .drop-copy { min-width: 0; }\n  .drop-title { display: block; font-size: 17px; font-weight: 700; line-height: 1; }\n  .drop-hint { display: block; margin-top: 4px; color: var(--muted); font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: 0.06em; text-transform: uppercase; }\n  .queue-note { margin: 20px 0 0; color: var(--muted); font-family: 'JetBrains Mono', monospace; font-size: 9px; line-height: 1.45; }\n\n  .preview-pane { display: flex; min-width: 0; flex-direction: column; justify-content: space-between; padding: 30px 38px 31px; background: var(--cream-deep); }\n  .preview-topline { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }\n  .preview-kicker { margin: 0; color: var(--purple); font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }\n  .preview-status { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; }\n  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px rgb(255 161 2 / 0.18); }\n  .player-shell { position: relative; overflow: hidden; border: 2px solid var(--ink); border-radius: 16px; background: var(--ink); box-shadow: 8px 9px 0 var(--ink); }\n  .player-shell::after { position: absolute; inset: 0; pointer-events: none; content: ''; background: linear-gradient(135deg, rgb(255 161 2 / 0.16), transparent 37%, rgb(67 46 111 / 0.24)); mix-blend-mode: screen; }\n  .player-video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #242329; }\n  .player-badge { position: absolute; top: 14px; left: 14px; z-index: 2; display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1.5px solid var(--ink); border-radius: 999px; color: var(--ink); background: var(--orange); font-family: 'JetBrains Mono', monospace; font-size: 9px; font-weight: 600; letter-spacing: 0.08em; box-shadow: 3px 3px 0 var(--ink); }\n  .player-badge .icon { font-size: 13px; }\n  .player-controls { position: absolute; right: 14px; bottom: 13px; left: 14px; z-index: 2; display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid rgb(245 249 206 / 0.42); border-radius: 12px; background: rgb(69 14 22 / 0.72); backdrop-filter: blur(8px); }\n  .icon-button { display: grid; flex: 0 0 auto; width: 44px; height: 44px; place-items: center; border: 1px solid rgb(245 249 206 / 0.52); border-radius: 50%; color: var(--cream); background: transparent; cursor: pointer; }\n  .icon-button:hover { border-color: var(--orange); color: var(--orange); }\n  .icon-button .icon { font-size: 20px; }\n  .scrub { width: 100%; accent-color: var(--orange); cursor: pointer; }\n  .time-readout { flex: 0 0 auto; color: var(--cream); font-family: 'JetBrains Mono', monospace; font-size: 9px; }\n  .active-caption { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-top: 24px; }\n  .active-caption h2 { min-width: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: clamp(28px, 3vw, 40px); font-weight: 700; line-height: 0.94; letter-spacing: -0.055em; }\n  .active-caption p { flex: 0 0 auto; max-width: 190px; margin: 0; color: var(--purple); font-size: 15px; line-height: 1.05; text-align: right; }\n  .preview-footer { display: flex; align-items: center; justify-content: flex-end; gap: 22px; padding-top: 24px; }\n  .cancel-link { padding: 10px 4px; border: 0; color: var(--purple); font-family: 'Cormorant Garamond', Georgia, serif; font-size: 17px; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; background: transparent; cursor: pointer; }\n  .cancel-link:hover { color: var(--ink); }\n  .create-button { display: inline-flex; min-height: 52px; align-items: center; gap: 10px; padding: 12px 20px; border: 2px solid var(--ink); border-radius: 999px; color: var(--ink); background: var(--orange); box-shadow: 4px 5px 0 var(--ink); font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; cursor: pointer; transition: transform 240ms cubic-bezier(0, 0, 0.2, 1), box-shadow 240ms cubic-bezier(0, 0, 0.2, 1), background-color 240ms cubic-bezier(0, 0, 0.2, 1); }\n  .create-button:hover { transform: translate(2px, 2px); box-shadow: 2px 3px 0 var(--ink); background: #ffab1f; }\n  .create-button .icon { font-size: 18px; }\n  .create-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n\n  @media (max-width: 767px) {\n    .modal-wrap { padding: 14px 12px; }\n    .modal-card { width: min(100%, 620px); min-height: auto; max-height: calc(100dvh - 28px); overflow: auto; }\n    .modal-header { min-height: 148px; padding: 24px 22px; }\n    .modal-title { font-size: 46px; }\n    .header-helper { max-width: 280px; font-size: 15px; }\n    .header-orbit { right: -44px; bottom: -64px; }\n    .modal-body { grid-template-columns: 1fr; }\n    .queue-pane { padding: 24px 22px 26px 34px; border-right: 0; border-bottom: 1px solid rgb(69 14 22 / 0.28); }\n    .preview-pane { padding: 24px 22px 28px; }\n    .preview-footer { justify-content: stretch; }\n    .create-button { flex: 1; justify-content: center; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .clip-row, .drop-branch, .create-button, .close-button { transition: none; }\n    .clip-row.is-active, .drop-branch:hover, .drop-branch.is-dragging, .create-button:hover, .close-button:hover { transform: none; }\n  }\n</style>\n<div class=\"timeline-design\" data-kid=\"1\">\n    <div aria-hidden=\"true\" class=\"stage-backdrop\" data-kid=\"1-1\">\n        <div class=\"ghost-nav\" data-kid=\"1-1-1\">\n            <span class=\"ghost-brand\" data-kid=\"1-1-1-1\">\n                YapCut\n            </span>\n            <span class=\"ghost-nav-pill\" data-kid=\"1-1-1-2\">\n            </span>\n            <span class=\"ghost-nav-pill short\" data-kid=\"1-1-1-3\">\n            </span>\n            <span class=\"ghost-nav-pill\" data-kid=\"1-1-1-4\">\n            </span>\n        </div>\n        <div class=\"ghost-content\" data-kid=\"1-1-2\">\n            <div class=\"ghost-copy\" data-kid=\"1-1-2-1\">\n                <div class=\"ghost-kicker\" data-kid=\"1-1-2-1-1\">\n                </div>\n                <div class=\"ghost-title\" data-kid=\"1-1-2-1-2\">\n                </div>\n                <div class=\"ghost-line\" data-kid=\"1-1-2-1-3\">\n                </div>\n                <div class=\"ghost-line\" data-kid=\"1-1-2-1-4\" style=\"width: 250px; margin-top: 10px;\">\n                </div>\n            </div>\n            <div class=\"ghost-grid\" data-kid=\"1-1-2-2\">\n                <div class=\"ghost-card\" data-kid=\"1-1-2-2-1\">\n                </div>\n                <div class=\"ghost-card\" data-kid=\"1-1-2-2-2\">\n                </div>\n                <div class=\"ghost-card\" data-kid=\"1-1-2-2-3\">\n                </div>\n                <div class=\"ghost-card\" data-kid=\"1-1-2-2-4\">\n                </div>\n            </div>\n        </div>\n        <div class=\"scrim\" data-kid=\"1-1-3\">\n        </div>\n    </div>\n    <div class=\"modal-wrap\" data-kid=\"1-2\">\n        <section aria-labelledby=\"new-project-title\" aria-modal=\"true\" class=\"modal-card\" data-kid=\"1-2-1\" role=\"dialog\">\n            <header class=\"modal-header\" data-kid=\"1-2-1-1\">\n                <div aria-hidden=\"true\" class=\"header-orbit\" data-kid=\"1-2-1-1-1\">\n                </div>\n                <div class=\"header-row\" data-kid=\"1-2-1-1-2\">\n                    <div data-kid=\"1-2-1-1-2-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-2-1-1-2-1-1\">\n                            Setup / A-roll\n                        </p>\n                        <h1 class=\"modal-title\" data-kid=\"1-2-1-1-2-1-2\" id=\"new-project-title\">\n                            New project\n                        </h1>\n                        <p class=\"header-helper\" data-kid=\"1-2-1-1-2-1-3\">\n                            Set the order now. We’ll build the edit around this story beat by beat.\n                        </p>\n                    </div>\n                    <button aria-label=\"Close new project dialog\" class=\"close-button\" data-kid=\"1-2-1-1-2-2\" title=\"Close dialog\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-x icon\" data-kid=\"1-2-1-1-2-2-1\">\n                        </i>\n                    </button>\n                </div>\n            </header>\n            <div class=\"modal-body\" data-kid=\"1-2-1-2\">\n                <section aria-labelledby=\"queue-title\" class=\"queue-pane\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"queue-head\" data-kid=\"1-2-1-2-1-1\">\n                        <div data-kid=\"1-2-1-2-1-1-1\">\n                            <p class=\"pane-label\" data-kid=\"1-2-1-2-1-1-1-1\" id=\"queue-title\">\n                                Story order\n                            </p>\n                            <p class=\"queue-caption\" data-kid=\"1-2-1-2-1-1-1-2\">\n                                Drag to shape the cut.\n                            </p>\n                        </div>\n                        <span class=\"sequence-count\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"sequence count display\" data-reason=\"text content updated based on current clip count by script\" id=\"sequenceCount\">\n                            3 clips\n                        </span>\n                    </div>\n                    <div aria-label=\"A-roll clip sequence\" class=\"timeline\" data-kid=\"1-2-1-2-1-2\" data-name=\"timeline list container\" id=\"timeline\">\n                        <article aria-label=\"Clip 1, scene 01 opening, 14 seconds. Press enter to preview. Use arrow keys to move.\" class=\"clip-row\" data-duration=\"00:14\" data-id=\"clip-1\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"clip row element\" draggable=\"true\" tabindex=\"0\">\n                            <span aria-hidden=\"true\" class=\"clip-node\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"clip index node\" data-reason=\"text content updated to reflect current position by script\">\n                                1\n                            </span>\n                            <span aria-label=\"Drag scene 01 opening to reorder\" class=\"grip\" data-kid=\"1-2-1-2-1-2-1-2\" role=\"button\" tabindex=\"0\" title=\"Drag to reorder\">\n                                <i aria-hidden=\"true\" class=\"ti ti-grip-vertical icon\" data-kid=\"1-2-1-2-1-2-1-2-1\">\n                                </i>\n                            </span>\n                            <button class=\"clip-main\" data-kid=\"1-2-1-2-1-2-1-3\" data-name=\"clip main interaction button\" type=\"button\">\n                                <span class=\"clip-title-line\" data-kid=\"1-2-1-2-1-2-1-3-1\">\n                                    <span class=\"clip-title\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-1-3-1-1\" data-name=\"clip title text\" data-reason=\"text content set by file name when added or during render by script\">\n                                        scene-01-opening.mp4\n                                    </span>\n                                </span>\n                                <span class=\"clip-meta\" data-kid=\"1-2-1-2-1-2-1-3-2\">\n                                    <span data-kid=\"1-2-1-2-1-2-1-3-2-1\">\n                                        00:14\n                                    </span>\n                                    <span class=\"meta-dot\" data-kid=\"1-2-1-2-1-2-1-3-2-2\">\n                                    </span>\n                                    <span data-kid=\"1-2-1-2-1-2-1-3-2-3\">\n                                        MP4 / 1080p\n                                    </span>\n                                </span>\n                            </button>\n                            <button aria-label=\"Remove scene 01 opening\" class=\"remove-button\" data-kid=\"1-2-1-2-1-2-1-4\" title=\"Remove clip\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-x icon\" data-kid=\"1-2-1-2-1-2-1-4-1\">\n                                </i>\n                            </button>\n                        </article>\n                        <article aria-current=\"true\" aria-label=\"Clip 2, scene 02 explain, 22 seconds, playing now. Press enter to preview. Use arrow keys to move.\" class=\"clip-row is-active is-playing\" data-duration=\"00:22\" data-dynamic=\"true\" data-id=\"clip-2\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"active clip row element\" data-reason=\"classes and attributes toggled by active state logic in script\" draggable=\"true\" tabindex=\"0\">\n                            <span aria-hidden=\"true\" class=\"clip-node\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"active clip index node\" data-reason=\"text content updated to reflect current position by script\">\n                                2\n                            </span>\n                            <span aria-label=\"Drag scene 02 explain to reorder\" class=\"grip\" data-kid=\"1-2-1-2-1-2-2-2\" role=\"button\" tabindex=\"0\" title=\"Drag to reorder\">\n                                <i aria-hidden=\"true\" class=\"ti ti-grip-vertical icon\" data-kid=\"1-2-1-2-1-2-2-2-1\">\n                                </i>\n                            </span>\n                            <button class=\"clip-main\" data-kid=\"1-2-1-2-1-2-2-3\" type=\"button\">\n                                <span class=\"clip-title-line\" data-kid=\"1-2-1-2-1-2-2-3-1\">\n                                    <span class=\"clip-title\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-2-3-1-1\" data-name=\"active clip title text\" data-reason=\"text content set by file name when added or during render by script\">\n                                        scene-02-explain.mov\n                                    </span>\n                                    <span class=\"play-state\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-2-3-1-2\" data-name=\"playing state indicator\" data-reason=\"injected/removed from DOM by script when clip is active/inactive\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-player-play-filled icon\" data-kid=\"1-2-1-2-1-2-2-3-1-2-1\">\n                                        </i>\n                                        playing now\n                                    </span>\n                                </span>\n                                <span class=\"clip-meta\" data-kid=\"1-2-1-2-1-2-2-3-2\">\n                                    <span data-kid=\"1-2-1-2-1-2-2-3-2-1\">\n                                        00:22\n                                    </span>\n                                    <span class=\"meta-dot\" data-kid=\"1-2-1-2-1-2-2-3-2-2\">\n                                    </span>\n                                    <span data-kid=\"1-2-1-2-1-2-2-3-2-3\">\n                                        MOV / 4K\n                                    </span>\n                                </span>\n                            </button>\n                            <button aria-label=\"Remove scene 02 explain\" class=\"remove-button\" data-kid=\"1-2-1-2-1-2-2-4\" title=\"Remove clip\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-x icon\" data-kid=\"1-2-1-2-1-2-2-4-1\">\n                                </i>\n                            </button>\n                        </article>\n                        <article aria-label=\"Clip 3, scene 03 close, 9 seconds. Press enter to preview. Use arrow keys to move.\" class=\"clip-row\" data-duration=\"00:09\" data-id=\"clip-3\" data-kid=\"1-2-1-2-1-2-3\" data-name=\"scene-03-close.mp4\" draggable=\"true\" tabindex=\"0\">\n                            <span aria-hidden=\"true\" class=\"clip-node\" data-kid=\"1-2-1-2-1-2-3-1\">\n                                3\n                            </span>\n                            <span aria-label=\"Drag scene 03 close to reorder\" class=\"grip\" data-kid=\"1-2-1-2-1-2-3-2\" role=\"button\" tabindex=\"0\" title=\"Drag to reorder\">\n                                <i aria-hidden=\"true\" class=\"ti ti-grip-vertical icon\" data-kid=\"1-2-1-2-1-2-3-2-1\">\n                                </i>\n                            </span>\n                            <button class=\"clip-main\" data-kid=\"1-2-1-2-1-2-3-3\" type=\"button\">\n                                <span class=\"clip-title-line\" data-kid=\"1-2-1-2-1-2-3-3-1\">\n                                    <span class=\"clip-title\" data-kid=\"1-2-1-2-1-2-3-3-1-1\">\n                                        scene-03-close.mp4\n                                    </span>\n                                </span>\n                                <span class=\"clip-meta\" data-kid=\"1-2-1-2-1-2-3-3-2\">\n                                    <span data-kid=\"1-2-1-2-1-2-3-3-2-1\">\n                                        00:09\n                                    </span>\n                                    <span class=\"meta-dot\" data-kid=\"1-2-1-2-1-2-3-3-2-2\">\n                                    </span>\n                                    <span data-kid=\"1-2-1-2-1-2-3-3-2-3\">\n                                        MP4 / 1080p\n                                    </span>\n                                </span>\n                            </button>\n                            <button aria-label=\"Remove scene 03 close\" class=\"remove-button\" data-kid=\"1-2-1-2-1-2-3-4\" title=\"Remove clip\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"ti ti-x icon\" data-kid=\"1-2-1-2-1-2-3-4-1\">\n                                </i>\n                            </button>\n                        </article>\n                        <button aria-label=\"Add more videos\" class=\"drop-branch\" data-kid=\"1-2-1-2-1-2-4\" id=\"addMore\" title=\"Add more videos\" type=\"button\">\n                            <span class=\"drop-icon\" data-kid=\"1-2-1-2-1-2-4-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-cloud-upload icon\" data-kid=\"1-2-1-2-1-2-4-1-1\">\n                                </i>\n                            </span>\n                            <span class=\"drop-copy\" data-kid=\"1-2-1-2-1-2-4-2\">\n                                <span class=\"drop-title\" data-kid=\"1-2-1-2-1-2-4-2-1\">\n                                    Drop videos\n                                </span>\n                                <span class=\"drop-hint\" data-kid=\"1-2-1-2-1-2-4-2-2\">\n                                    MP4 · MOV · add to the story\n                                </span>\n                            </span>\n                        </button>\n                        <input accept=\"video/mp4,video/quicktime,video/webm,.mp4,.mov,.webm\" class=\"sr-only\" data-kid=\"1-2-1-2-1-2-5\" id=\"fileInput\" multiple=\"\" type=\"file\"/>\n                    </div>\n                    <p class=\"queue-note\" data-kid=\"1-2-1-2-1-3\">\n                        Tip: select a clip to inspect it. Use ↑ ↓ while focused to move it through the sequence.\n                    </p>\n                </section>\n                <section aria-labelledby=\"preview-title\" class=\"preview-pane\" data-kid=\"1-2-1-2-2\">\n                    <div data-kid=\"1-2-1-2-2-1\">\n                        <div class=\"preview-topline\" data-kid=\"1-2-1-2-2-1-1\">\n                            <p class=\"preview-kicker\" data-kid=\"1-2-1-2-2-1-1-1\" id=\"preview-title\">\n                                Expected order / live preview\n                            </p>\n                            <span class=\"preview-status\" data-kid=\"1-2-1-2-2-1-1-2\">\n                                <span aria-hidden=\"true\" class=\"status-dot\" data-kid=\"1-2-1-2-2-1-1-2-1\">\n                                </span>\n                                <span data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-1-2-2\" data-name=\"preview status text\" data-reason=\"text content updated based on clip existence by script\" id=\"previewStatus\">\n                                    Playing selected clip\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"player-shell\" data-kid=\"1-2-1-2-2-1-2\">\n                            <video aria-describedby=\"posterAttribution\" autoplay=\"\" class=\"player-video\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-2-1\" data-name=\"video element\" data-reason=\"src and playback controlled by video player script\" id=\"previewVideo\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/8865886/pexels-photo-8865886.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/8865886/8865886-hd_1280_720_25fps.mp4\">\n                            </video>\n                            <span class=\"sr-only\" data-kid=\"1-2-1-2-2-1-2-2\" id=\"posterAttribution\">\n                                Preview poster image by Yan Krukau on Pexels.\n                            </span>\n                            <span class=\"player-badge\" data-kid=\"1-2-1-2-2-1-2-3\">\n                                <i aria-hidden=\"true\" class=\"ti ti-player-play-filled icon\" data-kid=\"1-2-1-2-2-1-2-3-1\">\n                                </i>\n                                <span data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-2-3-2\" data-name=\"clip count badge text\" data-reason=\"text content updated to reflect current position and total by script\" id=\"clipBadge\">\n                                    Clip 2 of 3\n                                </span>\n                            </span>\n                            <div class=\"player-controls\" data-kid=\"1-2-1-2-2-1-2-4\">\n                                <button aria-label=\"Pause preview\" class=\"icon-button\" data-kid=\"1-2-1-2-2-1-2-4-1\" id=\"playToggle\" title=\"Pause preview\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-player-pause-filled icon\" data-kid=\"1-2-1-2-2-1-2-4-1-1\" id=\"playIcon\">\n                                    </i>\n                                </button>\n                                <input aria-label=\"Preview position\" class=\"scrub\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-2-4-2\" data-name=\"scrub range input\" data-reason=\"value synchronized with video progress by script\" id=\"scrub\" max=\"100\" min=\"0\" type=\"range\" value=\"0\"/>\n                                <span class=\"time-readout\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-2-4-3\" data-name=\"time readout text\" data-reason=\"text content updated periodically by script based on video progress\" id=\"timeReadout\">\n                                    00:00 / 00:22\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"active-caption\" data-kid=\"1-2-1-2-2-1-3\">\n                            <h2 data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-3-1\" data-name=\"active clip title headline\" data-reason=\"text content updated when active clip changes by script\" id=\"activeName\">\n                                scene-02-explain.mov\n                            </h2>\n                            <p data-kid=\"1-2-1-2-2-1-3-2\">\n                                Reorder clips to set the story.\n                            </p>\n                        </div>\n                    </div>\n                    <footer class=\"preview-footer\" data-kid=\"1-2-1-2-2-2\">\n                        <button class=\"cancel-link\" data-kid=\"1-2-1-2-2-2-1\" type=\"button\">\n                            Cancel\n                        </button>\n                        <button class=\"create-button\" data-kid=\"1-2-1-2-2-2-2\" id=\"createButton\" type=\"button\">\n                            <span data-kid=\"1-2-1-2-2-2-2-1\">\n                                Create project ·\n                                <span data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-2-1-1\" data-name=\"create project count text\" data-reason=\"text content updated when clip count changes by script\" id=\"createCount\">\n                                    3 clips\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right icon\" data-kid=\"1-2-1-2-2-2-2-2\">\n                            </i>\n                        </button>\n                        <span aria-live=\"polite\" class=\"create-status\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"create project status live region\" data-reason=\"text content updated when action is triggered by script\" id=\"createStatus\" role=\"status\">\n                        </span>\n                    </footer>\n                </section>\n            </div>\n        </section>\n    </div>\n</div>\n<script>\n    (() => {\n    const timeline = document.getElementById('timeline');\n    const addMore = document.getElementById('addMore');\n    const fileInput = document.getElementById('fileInput');\n    const previewVideo = document.getElementById('previewVideo');\n    const playToggle = document.getElementById('playToggle');\n    const playIcon = document.getElementById('playIcon');\n    const scrub = document.getElementById('scrub');\n    const timeReadout = document.getElementById('timeReadout');\n    const clipBadge = document.getElementById('clipBadge');\n    const activeName = document.getElementById('activeName');\n    const sequenceCount = document.getElementById('sequenceCount');\n    const createCount = document.getElementById('createCount');\n    const previewStatus = document.getElementById('previewStatus');\n    const createButton = document.getElementById('createButton');\n    const createStatus = document.getElementById('createStatus');\n    const initialPoster = 'https://images.pexels.com/videos/8865886/pexels-photo-8865886.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200';\n    let activeId = 'clip-2';\n    let draggedId = null;\n    let nextId = 4;\n\n    const getRows = () => Array.from(timeline.querySelectorAll('.clip-row'));\n    const durationFor = (row) => row?.dataset.duration || '00:00';\n    const setVideoTime = () => {\n      const duration = Number.isFinite(previewVideo.duration) ? previewVideo.duration : 22;\n      const current = Number.isFinite(previewVideo.currentTime) ? previewVideo.currentTime : 0;\n      scrub.value = String(duration ? (current / duration) * 100 : 0);\n      const clock = (value) => {\n        const safe = Math.max(0, Math.floor(value || 0));\n        return `${String(Math.floor(safe / 60)).padStart(2, '0')}:${String(safe % 60).padStart(2, '0')}`;\n      };\n      timeReadout.textContent = `${clock(current)} / ${clock(duration)}`;\n    };\n\n    const render = () => {\n      const rows = getRows();\n      const activeIndex = Math.max(0, rows.findIndex((row) => row.dataset.id === activeId));\n      const count = rows.length;\n      rows.forEach((row, index) => {\n        const node = row.querySelector('.clip-node');\n        const title = row.querySelector('.clip-title');\n        const remove = row.querySelector('.remove-button');\n        const playState = row.querySelector('.play-state');\n        const isActive = row.dataset.id === activeId;\n        row.classList.toggle('is-active', isActive);\n        row.classList.toggle('is-playing', isActive);\n        row.setAttribute('aria-current', isActive ? 'true' : 'false');\n        row.setAttribute('aria-label', `Clip ${index + 1}, ${row.dataset.name}, ${durationFor(row)}. ${isActive ? 'Playing now. ' : ''}Press Enter to preview. Use arrow keys to move.`);\n        node.textContent = String(index + 1);\n        remove.setAttribute('aria-label', `Remove ${row.dataset.name}`);\n        if (isActive && !playState) {\n          const line = row.querySelector('.clip-title-line');\n          const state = document.createElement('span');\n          state.className = 'play-state';\n          state.innerHTML = '<i class=\"ti ti-player-play-filled icon\" aria-hidden=\"true\"></i> playing now';\n          line.appendChild(state);\n        }\n        if (!isActive && playState) playState.remove();\n        if (title) title.textContent = row.dataset.name;\n      });\n      const activeRow = rows[activeIndex];\n      const name = activeRow?.dataset.name || 'No clips yet';\n      const duration = durationFor(activeRow);\n      activeName.textContent = name;\n      clipBadge.textContent = `Clip ${count ? activeIndex + 1 : 0} of ${count}`;\n      sequenceCount.textContent = `${count} clip${count === 1 ? '' : 's'}`;\n      createCount.textContent = `${count} clip${count === 1 ? '' : 's'}`;\n      timeReadout.textContent = `00:00 / ${duration}`;\n      previewStatus.textContent = count ? 'Playing selected clip' : 'Add a clip to preview';\n    };\n\n    const selectRow = (row) => {\n      if (!row) return;\n      activeId = row.dataset.id;\n      previewVideo.poster = initialPoster;\n      if (previewVideo.paused) previewVideo.play().catch(() => undefined);\n      render();\n    };\n\n    const moveRow = (row, direction) => {\n      const rows = getRows();\n      const index = rows.indexOf(row);\n      const target = rows[index + direction];\n      if (!target) return;\n      if (direction < 0) timeline.insertBefore(row, target);\n      else timeline.insertBefore(row, target.nextElementSibling);\n      selectRow(row);\n      row.focus();\n    };\n\n    timeline.addEventListener('click', (event) => {\n      const remove = event.target.closest('.remove-button');\n      if (remove) {\n        const row = remove.closest('.clip-row');\n        const rows = getRows();\n        const wasActive = row?.dataset.id === activeId;\n        row?.remove();\n        if (wasActive) activeId = getRows()[0]?.dataset.id || '';\n        render();\n        return;\n      }\n      const row = event.target.closest('.clip-row');\n      if (row) selectRow(row);\n    });\n\n    timeline.addEventListener('keydown', (event) => {\n      const row = event.target.closest('.clip-row');\n      if (!row) return;\n      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectRow(row); }\n      if (event.key === 'ArrowUp') { event.preventDefault(); moveRow(row, -1); }\n      if (event.key === 'ArrowDown') { event.preventDefault(); moveRow(row, 1); }\n    });\n\n    timeline.addEventListener('dragstart', (event) => {\n      const row = event.target.closest('.clip-row');\n      if (!row) return;\n      draggedId = row.dataset.id;\n      row.style.opacity = '0.52';\n      event.dataTransfer.effectAllowed = 'move';\n      event.dataTransfer.setData('text/plain', draggedId);\n    });\n\n    timeline.addEventListener('dragover', (event) => {\n      const row = event.target.closest('.clip-row');\n      if (!row || !draggedId) return;\n      event.preventDefault();\n      const dragged = timeline.querySelector(`[data-id=\"${draggedId}\"]`);\n      if (!dragged || dragged === row) return;\n      const rect = row.getBoundingClientRect();\n      const before = event.clientY < rect.top + rect.height / 2;\n      timeline.insertBefore(dragged, before ? row : row.nextElementSibling);\n      render();\n    });\n\n    timeline.addEventListener('dragend', () => {\n      const row = draggedId ? timeline.querySelector(`[data-id=\"${draggedId}\"]`) : null;\n      if (row) row.style.opacity = '';\n      draggedId = null;\n      render();\n    });\n\n    addMore.addEventListener('click', () => fileInput.click());\n    addMore.addEventListener('dragover', (event) => { event.preventDefault(); addMore.classList.add('is-dragging'); });\n    addMore.addEventListener('dragleave', () => addMore.classList.remove('is-dragging'));\n    addMore.addEventListener('drop', (event) => {\n      event.preventDefault(); addMore.classList.remove('is-dragging'); appendFiles(event.dataTransfer.files);\n    });\n\n    const appendFiles = (files) => {\n      Array.from(files || []).filter((file) => file.type.startsWith('video/') || /\\.(mp4|mov|webm|m4v)$/i.test(file.name)).forEach((file) => {\n        const row = document.createElement('article');\n        row.className = 'clip-row'; row.draggable = true; row.tabIndex = 0; row.dataset.id = `clip-${nextId++}`; row.dataset.name = file.name; row.dataset.duration = '00:12';\n        row.innerHTML = `<span class=\"clip-node\" aria-hidden=\"true\"></span><span class=\"grip\" role=\"button\" tabindex=\"0\" title=\"Drag to reorder\" aria-label=\"Drag ${file.name} to reorder\"><i class=\"ti ti-grip-vertical icon\" aria-hidden=\"true\"></i></span><button class=\"clip-main\" type=\"button\"><span class=\"clip-title-line\"><span class=\"clip-title\"></span></span><span class=\"clip-meta\"><span>00:12</span><span class=\"meta-dot\"></span><span>${file.type.includes('quicktime') ? 'MOV' : 'MP4'} / local file</span></span></button><button class=\"remove-button\" type=\"button\" title=\"Remove clip\"><i class=\"ti ti-x icon\" aria-hidden=\"true\"></i></button>`;\n        row.querySelector('.clip-title').textContent = file.name;\n        timeline.insertBefore(row, addMore);\n      });\n      const last = getRows().at(-1); if (last) selectRow(last); else render();\n    };\n\n    fileInput.addEventListener('change', () => { appendFiles(fileInput.files); fileInput.value = ''; });\n    playToggle.addEventListener('click', () => {\n      if (previewVideo.paused) { previewVideo.play().catch(() => undefined); playIcon.className = 'ti ti-player-pause-filled icon'; playToggle.setAttribute('aria-label', 'Pause preview'); playToggle.title = 'Pause preview'; }\n      else { previewVideo.pause(); playIcon.className = 'ti ti-player-play-filled icon'; playToggle.setAttribute('aria-label', 'Play preview'); playToggle.title = 'Play preview'; }\n    });\n    previewVideo.addEventListener('timeupdate', setVideoTime);\n    previewVideo.addEventListener('loadedmetadata', setVideoTime);\n    scrub.addEventListener('input', () => { if (Number.isFinite(previewVideo.duration)) previewVideo.currentTime = (Number(scrub.value) / 100) * previewVideo.duration; });\n    createButton.addEventListener('click', () => { createStatus.textContent = 'Project creation queued with the current clip order.'; createButton.querySelector('span').textContent = 'Project queued'; });\n    render();\n  })();\n</script>\n",
