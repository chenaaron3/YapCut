      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  .editor-root { font-family: 'IBM Plex Sans', sans-serif; background: #F5F9CE; color: #450E16; }\n  .display { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n  .icon { width: 15px; height: 15px; stroke-width: 1.8; }\n  .icon-sm { width: 12px; height: 12px; stroke-width: 1.8; }\n  .editor-button, .asset-card, .toolbar-button, .word, .tab { transition: transform 180ms cubic-bezier(0,0,.2,1), background-color 180ms cubic-bezier(0,0,.2,1), color 180ms cubic-bezier(0,0,.2,1), border-color 180ms cubic-bezier(0,0,.2,1), box-shadow 180ms cubic-bezier(0,0,.2,1); }\n  .editor-button:hover, .asset-card:hover { transform: translate(-1px, -1px); }\n  .editor-button:focus-visible, .asset-card:focus-visible, .toolbar-button:focus-visible, .word:focus-visible, .tab:focus-visible { outline: 2px solid #FFA102; outline-offset: 2px; }\n  .tab:hover { color: #450E16; background: rgba(255,161,2,.12); }\n  .word:hover { background: rgba(255,161,2,.20); }\n  .asset-card:hover { box-shadow: 4px 4px 0 #450E16; }\n  .inspector-option:hover { background: rgba(255,161,2,.14); }\n  .timeline-track:hover .track-label { color: #FFA102; }\n  .timeline-block:hover { filter: brightness(1.08); transform: translateY(-1px); }\n  @media (max-width: 980px) {\n    .editor-workspace { grid-template-columns: 1fr; height: auto; overflow: visible; }\n    .asset-rail, .preview-panel { min-height: 260px; border-right: 0; border-left: 0; border-bottom: 2px solid #450E16; }\n    .preview-panel { order: 3; }\n    .transcript-panel { min-height: 620px; }\n    .inspector { position: relative; right: auto; top: auto; width: min(100%, 320px); margin: 24px auto 0; }\n    .timeline-panel { min-width: 760px; }\n    .timeline-wrap { overflow-x: auto; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"editor-root min-h-[100dvh] overflow-hidden\" data-kid=\"1\">\n    <header aria-label=\"Editor header\" class=\"grid h-[70px] grid-cols-[1fr_auto_1fr] items-center border-b-2 border-[#450E16] bg-[#BC2D29] px-6 text-[#F5F9CE] shadow-[0_4px_0_rgba(69,14,22,.22)] sm:px-8\" data-kid=\"1-1\">\n        <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-1-1\">\n            <a aria-label=\"Back to projects\" class=\"mono inline-flex items-center gap-2 text-[11px] tracking-[.08em] text-[#F5F9CE]/80 uppercase hover:text-[#F5F9CE]\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"text-[16px] leading-none\" data-kid=\"1-1-1-1-1\">\n                    ←\n                </span>\n                <span data-kid=\"1-1-1-1-2\">\n                    Projects\n                </span>\n            </a>\n            <span class=\"hidden h-6 w-px bg-[#F5F9CE]/25 sm:block\" data-kid=\"1-1-1-2\">\n            </span>\n            <div aria-label=\"YapCut mark\" class=\"hidden items-center gap-2 sm:flex\" data-kid=\"1-1-1-3\">\n                <span class=\"grid size-7 place-items-center rounded-[8px] border border-[#F5F9CE]/70 bg-[#450E16] text-[11px] font-semibold tracking-[-.08em] text-[#FFA102]\" data-kid=\"1-1-1-3-1\">\n                    YC\n                </span>\n                <span class=\"display text-[19px] font-semibold leading-none\" data-kid=\"1-1-1-3-2\">\n                    YapCut\n                </span>\n            </div>\n        </div>\n        <div class=\"flex min-w-0 items-center justify-center gap-3\" data-kid=\"1-1-2\">\n            <span class=\"mono hidden text-[9px] tracking-[.2em] text-[#F5F9CE]/55 uppercase lg:inline\" data-kid=\"1-1-2-1\">\n                Edit / 01\n            </span>\n            <span class=\"hidden h-4 w-px bg-[#F5F9CE]/25 lg:inline-block\" data-kid=\"1-1-2-2\">\n            </span>\n            <label class=\"sr-only\" data-kid=\"1-1-2-3\" for=\"project-title\">\n                Project title\n            </label>\n            <input class=\"display w-[min(40vw,360px)] min-w-0 truncate border border-transparent bg-transparent px-1 text-center text-[21px] font-semibold leading-none text-[#F5F9CE] outline-none hover:border-[#F5F9CE]/30 focus:border-[#FFA102] focus:ring-2 focus:ring-[#FFA102]/30\" data-kid=\"1-1-2-4\" data-name=\"project title input field\" id=\"project-title\" value=\"Top Three Video Editing Tricks\"/>\n        </div>\n        <div class=\"flex items-center justify-end gap-2.5\" data-kid=\"1-1-3\">\n            <span class=\"mono inline-flex h-8 items-center gap-2 rounded-full border border-[#F5F9CE]/20 bg-[#450E16]/20 px-3 text-[10px] tracking-[.06em] text-[#F5F9CE]/80\" data-kid=\"1-1-3-1\" data-name=\"save status indicator\" title=\"All changes saved\">\n                <span class=\"size-1.5 rounded-full bg-[#2DD4BF]\" data-kid=\"1-1-3-1-1\">\n                </span>\n                Saved\n            </span>\n            <button class=\"editor-button inline-flex h-9 items-center gap-2 rounded-[10px] border border-[#F5F9CE]/55 bg-transparent px-3 text-[11px] font-medium text-[#F5F9CE] hover:border-[#FFA102] hover:text-[#FFA102]\" data-kid=\"1-1-3-2\" title=\"Generate a new set of edits\" type=\"button\">\n                <i class=\"icon-sm\" data-kid=\"1-1-3-2-1\" data-lucide=\"sparkles\" style=\"color:#FFA102\">\n                </i>\n                <span class=\"hidden md:inline\" data-kid=\"1-1-3-2-2\">\n                    Generate edits\n                </span>\n            </button>\n            <div class=\"flex h-9 overflow-hidden rounded-[10px] border-2 border-[#450E16] shadow-[3px_3px_0_#450E16]\" data-kid=\"1-1-3-3\">\n                <button class=\"editor-button inline-flex items-center gap-2 bg-[#FFA102] px-3 text-[11px] font-semibold text-[#450E16] hover:bg-[#ffb62e]\" data-kid=\"1-1-3-3-1\" title=\"Export the edited video\" type=\"button\">\n                    <i class=\"icon-sm\" data-kid=\"1-1-3-3-1-1\" data-lucide=\"cloud-upload\" style=\"color:#450E16\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-3-3-1-2\">\n                        Export video\n                    </span>\n                </button>\n                <button aria-label=\"Open export options\" class=\"editor-button grid w-8 place-items-center border-l border-[#450E16]/40 bg-[#FFA102] text-[#450E16] hover:bg-[#ffb62e]\" data-kid=\"1-1-3-3-2\" title=\"Open export options\" type=\"button\">\n                    <i class=\"icon-sm\" data-kid=\"1-1-3-3-2-1\" data-lucide=\"chevron-down\" style=\"color:#450E16\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main aria-label=\"Video editor workspace\" class=\"editor-workspace grid h-[520px] min-h-0 min-w-0 grid-cols-[210px_minmax(0,1fr)_330px] border-b-2 border-[#450E16]\" data-kid=\"1-2\">\n        <aside aria-label=\"Edit asset rail\" class=\"asset-rail min-h-0 overflow-hidden border-r-2 border-[#450E16] bg-[#BC2D29] px-3 py-3 text-[#F5F9CE]\" data-kid=\"1-2-1\">\n            <div class=\"mb-4 flex items-center justify-between border-b border-[#F5F9CE]/25 pb-3\" data-kid=\"1-2-1-1\">\n                <span class=\"mono text-[9px] font-semibold tracking-[.18em] text-[#F5F9CE]/70 uppercase\" data-kid=\"1-2-1-1-1\">\n                    Edit tools\n                </span>\n                <button aria-label=\"Collapse asset rail\" class=\"toolbar-button rounded-[8px] p-1.5 text-[#F5F9CE]/70 hover:bg-[#450E16]/30 hover:text-[#FFA102]\" data-kid=\"1-2-1-1-2\" title=\"Collapse asset rail\" type=\"button\">\n                    <i class=\"icon-sm\" data-kid=\"1-2-1-1-2-1\" data-lucide=\"panel-left-close\" style=\"color:currentColor\">\n                    </i>\n                </button>\n            </div>\n            <div aria-label=\"Asset categories\" class=\"mb-4 grid grid-cols-4 gap-1 rounded-[10px] border border-[#F5F9CE]/25 bg-[#450E16]/20 p-1\" data-kid=\"1-2-1-2\" role=\"tablist\">\n                <button aria-label=\"A-roll assets\" class=\"tab rounded-[7px] px-1 py-2 text-[9px] text-[#F5F9CE]/65\" data-kid=\"1-2-1-2-1\" role=\"tab\" type=\"button\">\n                    A-roll\n                </button>\n                <button aria-label=\"B-roll assets\" class=\"tab rounded-[7px] px-1 py-2 text-[9px] text-[#F5F9CE]/65\" data-kid=\"1-2-1-2-2\" role=\"tab\" type=\"button\">\n                    B-roll\n                </button>\n                <button aria-label=\"VFX assets\" aria-selected=\"true\" class=\"tab rounded-[7px] bg-[#450E16] px-1 py-2 text-[9px] font-semibold text-[#FFA102] shadow-[2px_2px_0_rgba(245,249,206,.18)]\" data-kid=\"1-2-1-2-3\" role=\"tab\" type=\"button\">\n                    VFX\n                </button>\n                <button aria-label=\"Transitions assets\" class=\"tab rounded-[7px] px-1 py-2 text-[9px] text-[#F5F9CE]/65\" data-kid=\"1-2-1-2-4\" role=\"tab\" type=\"button\">\n                    Trans.\n                </button>\n            </div>\n            <div class=\"space-y-2.5\" data-kid=\"1-2-1-3\">\n                <button class=\"asset-card flex w-full items-center gap-3 rounded-[12px] border-2 border-[#F5F9CE]/25 bg-[#450E16]/35 px-3 py-3 text-left text-[#F5F9CE] hover:border-[#FFA102]\" data-kid=\"1-2-1-3-1\" title=\"Add a quote card\" type=\"button\">\n                    <span class=\"grid size-8 shrink-0 place-items-center rounded-[8px] bg-[#DD5533] text-[#450E16]\" data-kid=\"1-2-1-3-1-1\">\n                        <i class=\"icon\" data-kid=\"1-2-1-3-1-1-1\" data-lucide=\"quote\" style=\"color:#450E16\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0\" data-kid=\"1-2-1-3-1-2\">\n                        <span class=\"display block truncate text-[17px] font-semibold leading-none\" data-kid=\"1-2-1-3-1-2-1\">\n                            Quote\n                        </span>\n                        <span class=\"mono mt-1 block text-[8px] tracking-[.12em] text-[#F5F9CE]/55 uppercase\" data-kid=\"1-2-1-3-1-2-2\">\n                            VFX / 04\n                        </span>\n                    </span>\n                </button>\n                <button class=\"asset-card flex w-full items-center gap-3 rounded-[12px] border-2 border-[#F5F9CE]/25 bg-[#450E16]/35 px-3 py-3 text-left text-[#F5F9CE] hover:border-[#FFA102]\" data-kid=\"1-2-1-3-2\" title=\"Add a text overlay\" type=\"button\">\n                    <span class=\"grid size-8 shrink-0 place-items-center rounded-[8px] bg-[#DD5533] text-[#450E16]\" data-kid=\"1-2-1-3-2-1\">\n                        <i class=\"icon\" data-kid=\"1-2-1-3-2-1-1\" data-lucide=\"type\" style=\"color:#450E16\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0\" data-kid=\"1-2-1-3-2-2\">\n                        <span class=\"display block truncate text-[17px] font-semibold leading-none\" data-kid=\"1-2-1-3-2-2-1\">\n                            Text\n                        </span>\n                        <span class=\"mono mt-1 block text-[8px] tracking-[.12em] text-[#F5F9CE]/55 uppercase\" data-kid=\"1-2-1-3-2-2-2\">\n                            VFX / 06\n                        </span>\n                    </span>\n                </button>\n                <button class=\"asset-card flex w-full items-center gap-3 rounded-[12px] border-2 border-[#F5F9CE]/25 bg-[#450E16]/35 px-3 py-3 text-left text-[#F5F9CE] hover:border-[#FFA102]\" data-kid=\"1-2-1-3-3\" title=\"Add a listicle treatment\" type=\"button\">\n                    <span class=\"grid size-8 shrink-0 place-items-center rounded-[8px] bg-[#FFA102] text-[#450E16]\" data-kid=\"1-2-1-3-3-1\">\n                        <i class=\"icon\" data-kid=\"1-2-1-3-3-1-1\" data-lucide=\"list-ordered\" style=\"color:#450E16\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0\" data-kid=\"1-2-1-3-3-2\">\n                        <span class=\"display block truncate text-[17px] font-semibold leading-none\" data-kid=\"1-2-1-3-3-2-1\">\n                            Listicle\n                        </span>\n                        <span class=\"mono mt-1 block text-[8px] tracking-[.12em] text-[#F5F9CE]/55 uppercase\" data-kid=\"1-2-1-3-3-2-2\">\n                            VFX / 03\n                        </span>\n                    </span>\n                </button>\n                <button class=\"asset-card flex w-full items-center gap-3 rounded-[12px] border-2 border-[#F5F9CE]/25 bg-[#450E16]/35 px-3 py-3 text-left text-[#F5F9CE] hover:border-[#FFA102]\" data-kid=\"1-2-1-3-4\" title=\"Add a shake effect\" type=\"button\">\n                    <span class=\"grid size-8 shrink-0 place-items-center rounded-[8px] bg-[#432E6F] text-[#F5F9CE]\" data-kid=\"1-2-1-3-4-1\">\n                        <i class=\"icon\" data-kid=\"1-2-1-3-4-1-1\" data-lucide=\"move-horizontal\" style=\"color:#F5F9CE\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0\" data-kid=\"1-2-1-3-4-2\">\n                        <span class=\"display block truncate text-[17px] font-semibold leading-none\" data-kid=\"1-2-1-3-4-2-1\">\n                            Shake\n                        </span>\n                        <span class=\"mono mt-1 block text-[8px] tracking-[.12em] text-[#F5F9CE]/55 uppercase\" data-kid=\"1-2-1-3-4-2-2\">\n                            VFX / 02\n                        </span>\n                    </span>\n                </button>\n            </div>\n            <div class=\"mt-6 border-t border-[#F5F9CE]/20 pt-3\" data-kid=\"1-2-1-4\">\n                <div class=\"mono mb-2 text-[8px] tracking-[.16em] text-[#F5F9CE]/55 uppercase\" data-kid=\"1-2-1-4-1\">\n                    Drag to a word\n                </div>\n                <div class=\"flex items-center gap-2 text-[9px] text-[#F5F9CE]/70\" data-kid=\"1-2-1-4-2\">\n                    <span class=\"size-1.5 rounded-full bg-[#FFA102]\" data-kid=\"1-2-1-4-2-1\">\n                    </span>\n                    treatment follows the transcript\n                </div>\n            </div>\n        </aside>\n        <section aria-label=\"Word-based transcript\" class=\"transcript-panel relative min-h-0 min-w-0 overflow-hidden bg-[#F5F9CE]\" data-kid=\"1-2-2\">\n            <div class=\"flex h-[58px] items-center justify-between gap-4 border-b-2 border-[#450E16] px-5\" data-kid=\"1-2-2-1\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"mono text-[9px] font-semibold tracking-[.18em] text-[#432E6F] uppercase\" data-kid=\"1-2-2-1-1-1\">\n                        Transcript\n                    </span>\n                    <span class=\"h-4 w-px bg-[#450E16]/25\" data-kid=\"1-2-2-1-1-2\">\n                    </span>\n                    <span class=\"mono text-[10px] text-[#450E16]/55\" data-kid=\"1-2-2-1-1-3\" data-name=\"video duration timestamp\">\n                        00:00 / 00:22\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-1.5\" data-kid=\"1-2-2-1-2\">\n                    <button class=\"toolbar-button inline-flex h-8 items-center gap-2 rounded-[10px] border border-[#450E16]/25 bg-[#F5F9CE] px-2.5 text-[10px] font-medium hover:border-[#FFA102]\" data-kid=\"1-2-2-1-2-1\" title=\"Edit visibility\" type=\"button\">\n                        <i class=\"icon-sm\" data-kid=\"1-2-2-1-2-1-1\" data-lucide=\"layers-2\" style=\"color:#432E6F\">\n                        </i>\n                        22 edits\n                        <i class=\"icon-sm\" data-kid=\"1-2-2-1-2-1-2\" data-lucide=\"chevron-down\" style=\"color:#450E16\">\n                        </i>\n                    </button>\n                    <button class=\"toolbar-button hidden h-8 items-center gap-1.5 rounded-[10px] px-2.5 text-[10px] text-[#432E6F] hover:bg-[#FFA102]/15 hover:text-[#450E16] sm:inline-flex\" data-kid=\"1-2-2-1-2-2\" title=\"Open caption style inspector\" type=\"button\">\n                        <i class=\"icon-sm\" data-kid=\"1-2-2-1-2-2-1\" data-lucide=\"captions\" style=\"color:#432E6F\">\n                        </i>\n                        Captions\n                    </button>\n                    <button class=\"toolbar-button hidden h-8 items-center gap-1.5 rounded-[10px] px-2.5 text-[10px] text-[#432E6F] hover:bg-[#FFA102]/15 hover:text-[#450E16] md:inline-flex\" data-kid=\"1-2-2-1-2-3\" title=\"Open project settings\" type=\"button\">\n                        <i class=\"icon-sm\" data-kid=\"1-2-2-1-2-3-1\" data-lucide=\"sliders-horizontal\" style=\"color:#432E6F\">\n                        </i>\n                        Settings\n                    </button>\n                </div>\n            </div>\n            <div class=\"relative h-[calc(100%-58px)] overflow-hidden px-7 py-7 pr-[230px] sm:px-9 sm:pr-[235px]\" data-kid=\"1-2-2-2\">\n                <div class=\"mono mb-5 flex items-center justify-between text-[9px] tracking-[.16em] text-[#432E6F]/70 uppercase\" data-kid=\"1-2-2-2-1\">\n                    <span data-kid=\"1-2-2-2-1-1\">\n                        Word editing / selected pass\n                    </span>\n                    <span data-kid=\"1-2-2-2-1-2\">\n                        1.0x\n                    </span>\n                </div>\n                <div class=\"space-y-4\" data-kid=\"1-2-2-2-2\">\n                    <p class=\"display m-0 max-w-[620px] text-[clamp(1.8rem,2.8vw,2.55rem)] font-semibold leading-[1.13] tracking-[-.035em]\" data-kid=\"1-2-2-2-2-1\">\n                        <span class=\"word rounded-[5px] px-1\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"transcript word button\">\n                       