        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  .ticket-canvas,\n  .ticket-canvas * { box-sizing: border-box; }\n\n  .ticket-canvas {\n    --cream: #f5f9ce;\n    --cream-deep: #ecefc0;\n    --ink: #450e16;\n    --orange: #ffa102;\n    --purple: #432e6f;\n    --crimson: #bc2d29;\n    --muted: #75677f;\n    min-height: 100dvh;\n    overflow: hidden;\n    position: relative;\n    isolation: isolate;\n    display: grid;\n    place-items: center;\n    padding: clamp(24px, 4vw, 56px);\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    background:\n      radial-gradient(circle at 12% 12%, rgb(255 161 2 / .22) 0 1px, transparent 1.5px) 0 0 / 18px 18px,\n      linear-gradient(132deg, #e7e8b7 0%, #f5f9ce 46%, #d8ddb3 100%);\n  }\n\n  .ticket-canvas::before,\n  .ticket-canvas::after {\n    content: '';\n    position: absolute;\n    pointer-events: none;\n    z-index: -2;\n    border: 2px solid rgb(69 14 22 / .18);\n    border-radius: 24px;\n    filter: blur(7px);\n  }\n\n  .ticket-canvas::before {\n    width: 540px;\n    height: 320px;\n    left: 8%;\n    top: 9%;\n    transform: rotate(-7deg);\n    background: linear-gradient(135deg, rgb(67 46 111 / .56), rgb(245 249 206 / .4));\n  }\n\n  .ticket-canvas::after {\n    width: 620px;\n    height: 390px;\n    right: 5%;\n    bottom: 7%;\n    transform: rotate(8deg);\n    background: linear-gradient(135deg, rgb(188 45 41 / .52), rgb(255 161 2 / .4));\n  }\n\n  .backdrop-card {\n    position: absolute;\n    z-index: -1;\n    border: 2px solid rgb(69 14 22 / .14);\n    border-radius: 24px;\n    filter: blur(8px);\n    opacity: .72;\n  }\n\n  .backdrop-card.one { left: 8%; top: 24%; width: 280px; height: 190px; background: #bc2d29; transform: rotate(-8deg); }\n  .backdrop-card.two { right: 11%; top: 16%; width: 320px; height: 220px; background: #432e6f; transform: rotate(7deg); }\n  .backdrop-card.three { left: 15%; bottom: 8%; width: 410px; height: 160px; background: #ffa102; transform: rotate(5deg); }\n  .backdrop-card.four { right: 10%; bottom: 10%; width: 270px; height: 180px; background: #f5f9ce; transform: rotate(-6deg); }\n\n  .ticket-modal {\n    width: min(1060px, 100%);\n    max-height: min(756px, calc(100dvh - 48px));\n    overflow: auto;\n    position: relative;\n    display: grid;\n    grid-template-columns: minmax(340px, .9fr) minmax(0, 1.25fr);\n    border: 2px solid var(--ink);\n    border-radius: 24px;\n    background: var(--cream);\n    box-shadow: 12px 13px 0 var(--ink), 0 28px 62px rgb(69 14 22 / .22);\n    scrollbar-color: var(--orange) transparent;\n  }\n\n  .ticket-modal::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    opacity: .28;\n    background-image: radial-gradient(rgb(255 161 2 / .26) .7px, transparent .8px);\n    background-size: 9px 9px;\n    mix-blend-mode: multiply;\n  }\n\n  .modal-pane { position: relative; z-index: 1; min-width: 0; }\n\n  .queue-pane {\n    display: flex;\n    min-height: 680px;\n    flex-direction: column;\n    padding: 34px 30px 30px;\n    border-right: 1.5px solid rgb(69 14 22 / .2);\n  }\n\n  .preview-pane {\n    display: flex;\n    min-height: 680px;\n    flex-direction: column;\n    padding: 34px 34px 28px;\n    background: linear-gradient(145deg, rgb(245 249 206 / .3), rgb(236 239 192 / .82));\n  }\n\n  .eyebrow {\n    margin: 0 0 8px;\n    color: var(--crimson);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    line-height: 1.4;\n    text-transform: uppercase;\n  }\n\n  .modal-title {\n    margin: 0;\n    font-size: clamp(43px, 5vw, 62px);\n    font-weight: 700;\n    letter-spacing: -.06em;\n    line-height: .82;\n  }\n\n  .modal-copy {\n    max-width: 28ch;\n    margin: 13px 0 0;\n    color: var(--purple);\n    font-size: 16px;\n    line-height: 1.25;\n  }\n\n  .close-button,\n  .icon-button,\n  .remove-button,\n  .move-button {\n    display: inline-grid;\n    min-width: 44px;\n    min-height: 44px;\n    place-items: center;\n    border: 1.5px solid var(--ink);\n    border-radius: 999px;\n    color: var(--ink);\n    background: transparent;\n    cursor: pointer;\n    font: inherit;\n  }\n\n  .close-button {\n    position: absolute;\n    top: 27px;\n    right: 28px;\n    border: 0;\n    font-size: 24px;\n  }\n\n  .close-button:hover,\n  .icon-button:hover,\n  .remove-button:hover,\n  .move-button:hover { background: rgb(255 161 2 / .18); }\n\n  .queue-head {\n    display: flex;\n    align-items: end;\n    justify-content: space-between;\n    gap: 14px;\n    margin-top: 31px;\n  }\n\n  .queue-heading {\n    margin: 0;\n    font-size: 25px;\n    font-weight: 700;\n    letter-spacing: -.03em;\n    line-height: 1;\n  }\n\n  .queue-count {\n    color: var(--purple);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .add-zone {\n    display: flex;\n    min-height: 56px;\n    align-items: center;\n    gap: 9px;\n    margin-top: 18px;\n    padding: 10px 14px;\n    border: 1.5px dashed var(--ink);\n    border-radius: 16px;\n    color: var(--purple);\n    background: rgb(245 249 206 / .54);\n    cursor: pointer;\n    font-size: 17px;\n    line-height: 1;\n  }\n\n  .add-zone strong { color: var(--ink); font-weight: 700; }\n  .add-zone:hover,\n  .add-zone.is-over { border-color: var(--orange); background: rgb(255 161 2 / .15); }\n  .add-zone .ti { color: var(--orange); font-size: 20px; }\n\n  .clip-list {\n    display: flex;\n    flex: 1;\n    min-height: 0;\n    flex-direction: column;\n    gap: 13px;\n    margin: 18px 0 0;\n    padding: 0 5px 4px 0;\n    list-style: none;\n  }\n\n  .clip-card {\n    position: relative;\n    display: grid;\n    grid-template-columns: 44px minmax(0, 1fr) 44px;\n    min-height: 107px;\n    align-items: center;\n    gap: 11px;\n    padding: 15px 10px 15px 13px;\n    border: 1.5px solid var(--ink);\n    border-radius: 16px;\n    background: rgb(245 249 206 / .78);\n    box-shadow: 4px 4px 0 rgb(69 14 22 / .18);\n    cursor: pointer;\n    outline: none;\n    user-select: none;\n  }\n\n  .clip-card:nth-child(1) { transform: rotate(-1.1deg); }\n  .clip-card:nth-child(3) { transform: rotate(.85deg); }\n  .clip-card:hover { transform: translateX(3px) rotate(0); }\n  .clip-card.is-selected {\n    border-color: var(--ink);\n    background: var(--orange);\n    box-shadow: inset 0 0 0 2px rgb(255 249 180 / .46), 6px 7px 0 var(--ink);\n    transform: translateX(8px) rotate(0);\n  }\n  .clip-card.is-dragging { opacity: .46; transform: rotate(-2deg) scale(.98); }\n  .clip-card:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }\n\n  .clip-index {\n    display: grid;\n    width: 40px;\n    height: 40px;\n    place-items: center;\n    border: 1.5px solid var(--ink);\n    border-radius: 999px;\n    background: var(--cream);\n    color: var(--ink);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    font-weight: 700;\n  }\n  .is-selected .clip-index { background: var(--ink); color: var(--orange); }\n\n  .clip-main { min-width: 0; }\n  .clip-topline { display: flex; align-items: center; gap: 7px; min-width: 0; }\n  .clip-topline .ti { flex: 0 0 auto; font-size: 17px; }\n  .clip-name {\n    min-width: 0;\n    overflow: hidden;\n    color: var(--ink);\n    font-size: 19px;\n    font-weight: 700;\n    line-height: 1.05;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .clip-meta {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 7px;\n    margin-top: 7px;\n    color: var(--purple);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n  }\n  .is-selected .clip-meta { color: var(--ink); }\n  .playing-label {\n    display: none;\n    width: fit-content;\n    margin-top: 8px;\n    padding: 3px 7px;\n    border-radius: 999px;\n    background: var(--ink);\n    color: var(--orange);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: .12em;\n  }\n  .is-selected .playing-label { display: block; }\n\n  .clip-actions { display: flex; flex-direction: column; align-items: center; gap: 2px; }\n  .drag-button,\n  .remove-button,\n  .move-button {\n    display: inline-grid;\n    width: 40px;\n    min-width: 40px;\n    height: 40px;\n    min-height: 40px;\n    border: 0;\n    border-radius: 10px;\n    color: var(--purple);\n    cursor: grab;\n  }\n  .drag-button:active { cursor: grabbing; }\n  .drag-button .ti { font-size: 20px; }\n  .remove-button { color: var(--crimson); cursor: pointer; }\n  .is-selected .drag-button,\n  .is-selected .remove-button { color: var(--ink); }\n\n  .queue-hint {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 13px;\n    color: var(--purple);\n    font-size: 14px;\n    line-height: 1.1;\n  }\n  .queue-hint .ti { color: var(--orange); font-size: 17px; }\n\n  .preview-header { display: flex; align-items: start; justify-content: space-between; gap: 24px; }\n  .preview-heading { margin: 0; font-size: 28px; font-weight: 700; line-height: .95; letter-spacing: -.035em; }\n  .preview-copy { max-width: 28ch; margin: 8px 0 0; color: var(--purple); font-size: 15px; line-height: 1.2; }\n  .sequence-badge {\n    flex: 0 0 auto;\n    padding: 9px 11px;\n    border: 1.5px solid var(--ink);\n    border-radius: 999px;\n    background: var(--ink);\n    color: var(--cream);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: .08em;\n  }\n\n  .monitor {\n    position: relative;\n    margin-top: 24px;\n    padding: 13px 13px 16px;\n    border: 2px solid var(--ink);\n    border-radius: 20px;\n    background: var(--crimson);\n    box-shadow: 8px 9px 0 var(--ink), 0 17px 30px rgb(69 14 22 / .17);\n  }\n  .monitor::before,\n  .monitor::after {\n    content: '';\n    position: absolute;\n    top: 18px;\n    width: 10px;\n    height: 10px;\n    border: 2px solid var(--ink);\n    border-radius: 999px;\n    background: var(--orange);\n  }\n  .monitor::before { left: 18px; }\n  .monitor::after { right: 18px; }\n  .monitor-screen {\n    position: relative;\n    overflow: hidden;\n    aspect-ratio: 16 / 9;\n    border: 2px solid var(--ink);\n    border-radius: 12px;\n    background: #24151a;\n  }\n  .preview-video { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .preview-fallback { width: 100%; height: 100%; object-fit: cover; }\n  .screen-vignette { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgb(69 14 22 / .16), transparent 42%, rgb(69 14 22 / .32)); }\n  .screen-badge {\n    position: absolute;\n    top: 12px;\n    left: 12px;\n    padding: 7px 9px;\n    border-radius: 999px;\n    background: var(--orange);\n    color: var(--ink);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: .1em;\n  }\n  .play-overlay {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-items: center;\n    border: 0;\n    background: transparent;\n    color: var(--cream);\n    cursor: pointer;\n    font-size: 54px;\n    text-shadow: 3px 4px 0 var(--ink);\n  }\n  .play-overlay:hover { color: var(--orange); }\n  .monitor-controls { display: flex; align-items: center; gap: 13px; padding: 12px 4px 0; }\n  .monitor-controls .icon-button { width: 36px; min-width: 36px; height: 36px; min-height: 36px; border-color: var(--cream); color: var(--cream); }\n  .timeline { flex: 1; height: 5px; overflow: hidden; border-radius: 999px; background: rgb(245 249 206 / .34); }\n  .timeline-fill { width: 38%; height: 100%; border-radius: inherit; background: var(--orange); }\n  .timecode { color: var(--cream); font-family: 'JetBrains Mono', monospace; font-size: 10px; white-space: nowrap; }\n\n  .active-file { margin-top: 22px; }\n  .active-file-label { margin: 0 0 5px; color: var(--crimson); font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }\n  .active-file-name { margin: 0; overflow: hidden; font-size: 32px; font-weight: 700; letter-spacing: -.045em; line-height: .92; text-overflow: ellipsis; white-space: nowrap; }\n  .active-file-caption { max-width: 54ch; margin: 10px 0 0; color: var(--purple); font-size: 15px; line-height: 1.22; }\n\n  .action-footer { display: flex; align-items: center; justify-content: flex-end; gap: 13px; margin-top: auto; padding-top: 28px; }\n  .cancel-button { min-height: 48px; padding: 10px 14px; border: 0; background: transparent; color: var(--purple); cursor: pointer; font: 600 16px 'Cormorant Garamond', Georgia, serif; }\n  .cancel-button:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }\n  .create-button {\n    min-height: 54px;\n    padding: 12px 19px;\n    border: 2px solid var(--ink);\n    border-radius: 16px;\n    background: var(--orange);\n    color: var(--ink);\n    box-shadow: 4px 5px 0 var(--ink);\n    cursor: pointer;\n    font: 700 17px 'Cormorant Garamond', Georgia, serif;\n  }\n  .create-button:hover { transform: translate(1px, 1px); box-shadow: 2px 3px 0 var(--ink); }\n  .create-button:disabled { cursor: not-allowed; opacity: .48; transform: none; box-shadow: 4px 5px 0 rgb(69 14 22 / .45); }\n\n  .empty-message { display: none; padding: 22px 12px; border: 1.5px dashed var(--ink); border-radius: 16px; color: var(--purple); text-align: center; font-size: 17px; }\n  .clip-list.is-empty .empty-message { display: block; }\n  .status-line { min-height: 18px; margin-top: 11px; color: var(--purple); font-family: 'JetBrains Mono', monospace; font-size: 10px; }\n  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n\n  @media (max-width: 900px) {\n    .ticket-canvas { padding: 20px; }\n    .ticket-modal { grid-template-columns: 1fr; max-height: calc(100dvh - 40px); }\n    .queue-pane { min-height: auto; border-right: 0; border-bottom: 1.5px solid rgb(69 14 22 / .2); }\n    .preview-pane { min-height: auto; }\n  }\n  @media (max-width: 600px) {\n    .ticket-canvas { padding: 12px; }\n    .ticket-modal { box-shadow: 7px 8px 0 var(--ink); }\n    .queue-pane, .preview-pane { padding: 26px 20px 22px; }\n    .clip-card { grid-template-columns: 40px minmax(0, 1fr) 44px; }\n    .modal-title { font-size: 47px; }\n    .preview-header { display: block; }\n    .sequence-badge { display: inline-block; margin-top: 14px; }\n    .active-file-name { font-size: 28px; }\n    .action-footer { justify-content: stretch; }\n    .create-button { flex: 1; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .clip-card, .create-button { transition: none; }\n    .clip-card:hover, .clip-card.is-selected, .create-button:hover { transform: none; }\n  }\n</style>\n<div aria-label=\"New project upload modal redesign\" class=\"ticket-canvas\" data-kid=\"1\">\n    <div aria-hidden=\"true\" class=\"backdrop-card one\" data-kid=\"1-1\">\n    </div>\n    <div aria-hidden=\"true\" class=\"backdrop-card two\" data-kid=\"1-2\">\n    </div>\n    <div aria-hidden=\"true\" class=\"backdrop-card three\" data-kid=\"1-3\">\n    </div>\n    <div aria-hidden=\"true\" class=\"backdrop-card four\" data-kid=\"1-4\">\n    </div>\n    <main aria-labelledby=\"ticket-title\" aria-modal=\"true\" class=\"ticket-modal\" data-kid=\"1-5\" role=\"dialog\">\n        <section class=\"modal-pane queue-pane\" data-kid=\"1-5-1\">\n            <button aria-label=\"Close new project dialog\" class=\"close-button\" data-kid=\"1-5-1-1\" title=\"Close\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"1-5-1-1-1\">\n                </i>\n            </button>\n            <p class=\"eyebrow\" data-kid=\"1-5-1-2\">\n                A-roll / new sequence\n            </p>\n            <h1 class=\"modal-title\" data-kid=\"1-5-1-3\" id=\"ticket-title\">\n                New project\n            </h1>\n            <p class=\"modal-copy\" data-kid=\"1-5-1-4\">\n                Arrange your footage first. Your edit will begin in this order.\n            </p>\n            <div class=\"queue-head\" data-kid=\"1-5-1-5\">\n                <h2 class=\"queue-heading\" data-kid=\"1-5-1-5-1\">\n                    Clip stack\n                </h2>\n                <span class=\"queue-count\" data-dynamic=\"true\" data-kid=\"1-5-1-5-2\" data-name=\"queue clip count\" data-reason=\"text updated by script when clips are added/removed\" id=\"queue-count\">\n                    3 clips\n                </span>\n            </div>\n            <input accept=\"video/mp4,video/quicktime,video/webm,.m4v\" class=\"sr-only\" data-kid=\"1-5-1-6\" data-name=\"hidden file input\" id=\"more-videos\" multiple=\"\" type=\"file\"/>\n            <div aria-controls=\"more-videos\" aria-label=\"Add more videos\" class=\"add-zone\" data-kid=\"1-5-1-7\" id=\"add-zone\" role=\"button\" tabindex=\"0\">\n                <i aria-hidden=\"true\" class=\"ti ti-cloud-upload\" data-kid=\"1-5-1-7-1\">\n                </i>\n                <span data-kid=\"1-5-1-7-2\">\n                    <strong data-kid=\"1-5-1-7-2-1\">\n                        + Add more videos\n                    </strong>\n                    <span data-kid=\"1-5-1-7-2-2\">\n                        or drop them here\n                    </span>\n                </span>\n            </div>\n            <ol aria-label=\"Video sequence\" class=\"clip-list\" data-dynamic=\"true\" data-kid=\"1-5-1-8\" data-name=\"clip sequence list\" data-reason=\"list items are dynamically rendered by script based on clip data\" id=\"clip-list\">\n                <li class=\"empty-message\" data-kid=\"1-5-1-8-1\">\n                    Drop a few videos here to build your sequence.\n                </li>\n            </ol>\n            <p class=\"queue-hint\" data-kid=\"1-5-1-9\">\n                <i aria-hidden=\"true\" class=\"ti ti-arrows-left-right\" data-kid=\"1-5-1-9-1\">\n                </i>\n                <span data-kid=\"1-5-1-9-2\">\n                    Drag the grip or use Alt + ↑ / ↓ to reorder.\n                </span>\n            </p>\n            <p aria-live=\"polite\" class=\"status-line\" data-dynamic=\"true\" data-kid=\"1-5-1-10\" data-name=\"aria-live status announcer\" data-reason=\"text content updated by script to announce user actions\" id=\"status-line\" role=\"status\">\n                Ready to review clip 2.\n            </p>\n        </section>\n        <section class=\"modal-pane preview-pane\" data-kid=\"1-5-2\">\n            <header class=\"preview-header\" data-kid=\"1-5-2-1\">\n                <div data-kid=\"1-5-2-1-1\">\n                    <p class=\"eyebrow\" data-kid=\"1-5-2-1-1-1\">\n                        Preview the handoff\n                    </p>\n                    <h2 class=\"preview-heading\" data-kid=\"1-5-2-1-1-2\">\n                        Your edit starts here.\n                    </h2>\n                    <p class=\"preview-copy\" data-kid=\"1-5-2-1-1-3\">\n                        Select a card to check the footage, then set the order your story should follow.\n                    </p>\n                </div>\n                <span class=\"sequence-badge\" data-dynamic=\"true\" data-kid=\"1-5-2-1-2\" data-name=\"preview sequence badge\" data-reason=\"text replaced by script when clip selection or order changes\" id=\"sequence-badge\">\n                    CLIP 2 OF 3\n                </span>\n            </header>\n            <div class=\"monitor\" data-kid=\"1-5-2-2\">\n                <div class=\"monitor-screen\" data-kid=\"1-5-2-2-1\">\n                    <video aria-label=\"Preview footage poster by J.S. McDuff on Pexels\" autoplay=\"\" class=\"preview-video\" data-dynamic=\"true\" data-kid=\"1-5-2-2-1-1\" data-name=\"preview video player\" data-reason=\"src and poster replaced by script on clip selection\" id=\"preview-video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/31938875/1950s-1960s-1970s-8mm-31938875.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\">\n                        <img alt=\"Vintage film reel countdown poster — J.S. McDuff on Pexels\" class=\"preview-fallback\" data-dynamic=\"true\" data-kid=\"1-5-2-2-1-1-1\" data-name=\"preview video fallback image\" data-reason=\"src and alt replaced by script on clip selection\" decoding=\"async\" id=\"preview-fallback\" loading=\"lazy\" src=\"https://images.pexels.com/videos/31938875/1950s-1960s-1970s-8mm-31938875.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\"/>\n                    </video>\n                    <div aria-hidden=\"true\" class=\"screen-vignette\" data-kid=\"1-5-2-2-1-2\">\n                    </div>\n                    <span class=\"screen-badge\" data-dynamic=\"true\" data-kid=\"1-5-2-2-1-3\" data-name=\"screen sequence badge\" data-reason=\"text replaced by script when clip selection or order changes\" id=\"screen-badge\">\n                        CLIP 2 OF 3\n                    </span>\n                    <button aria-label=\"Pause preview\" class=\"play-overlay\" data-dynamic=\"true\" data-kid=\"1-5-2-2-1-4\" data-name=\"play overlay button\" data-reason=\"icon and aria-label toggled by playback state\" id=\"play-overlay\" title=\"Pause preview\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-player-play-filled\" data-kid=\"1-5-2-2-1-4-1\">\n                        </i>\n                    </button>\n                </div>\n                <div aria-label=\"Preview controls\" class=\"monitor-controls\" data-kid=\"1-5-2-2-2\">\n                    <button aria-label=\"Pause preview\" class=\"icon-button\" data-dynamic=\"true\" data-kid=\"1-5-2-2-2-1\" data-name=\"play button\" data-reason=\"icon and aria-label toggled by playback state\" id=\"play-button\" title=\"Pause preview\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"ti ti-player-pause-filled\" data-kid=\"1-5-2-2-2-1-1\">\n                        </i>\n                    </button>\n                    <div aria-hidden=\"true\" class=\"timeline\" data-kid=\"1-5-2-2-2-2\">\n                        <div class=\"timeline-fill\" data-kid=\"1-5-2-2-2-2-1\">\n                        </div>\n                    </div>\n                    <span class=\"timecode\" data-dynamic=\"true\" data-kid=\"1-5-2-2-2-3\" data-name=\"video timecode\" data-reason=\"text updated by script to show duration/time\" id=\"timecode\">\n                        00:00 / 00:18\n                    </span>\n                </div>\n            </div>\n            <div class=\"active-file\" data-kid=\"1-5-2-3\">\n                <p class=\"active-file-label\" data-kid=\"1-5-2-3-1\">\n                    Now previewing\n                </p>\n                <h3 class=\"active-file-name\" data-dynamic=\"true\" data-kid=\"1-5-2-3-2\" data-name=\"active file name\" data-reason=\"text replaced by script when clip selection changes\" id=\"active-file-name\">\n                    B-roll_02-film-room.mov\n                </h3>\n                <p class=\"active-file-caption\" data-dynamic=\"true\" data-kid=\"1-5-2-3-3\" data-name=\"active file caption\" data-reason=\"text dynamically updated by script on clip selection\" id=\"active-file-caption\">\n                    This is the second clip in your sequence. Reorder the cards to change the handoff order before upload.\n                </p>\n            </div>\n            <footer class=\"action-footer\" data-kid=\"1-5-2-4\">\n                <button class=\"cancel-button\" data-kid=\"1-5-2-4-1\" type=\"button\">\n                    Cancel\n                </button>\n                <button class=\"create-button\" data-dynamic=\"true\" data-kid=\"1-5-2-4-2\" data-name=\"create project button\" data-reason=\"text and disabled state managed by script based on clip count\" id=\"create-button\" type=\"button\">\n                    Create project · 3 clips\n                </button>\n            </footer>\n        </section>\n    </main>\n</div>\n<script>\n    (() => {\n    const previewAssets = [\n      {\n        id: 'clip-1', name: 'A-roll_01-opening.mp4', duration: '00:12', format: 'MP4',\n        src: 'https://videos.pexels.com/video-files/31800810/13547675_640_360_24fps.mp4',\n        poster: 'https://images.pexels.com/videos/31800810/pexels-photo-31800810.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200',\n        credit: 'Sajjad Sabbir on Pexels'\n      },\n      {\n        id: 'clip-2', name: 'B-roll_02-film-room.mov', duration: '00:18', format: 'MOV',\n        src: 'https://videos.pexels.com/video-files/31938875/13604873_640_360_30fps.mp4',\n        poster: 'https://images.pexels.com/videos/31938875/1950s-1960s-1970s-8mm-31938875.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200',\n        credit: 'J.S. McDuff on Pexels'\n      },\n      {\n        id: 'clip-3', name: 'A-roll_03-close.mp4', duration: '00:09', format: 'MP4',\n        src: 'https://videos.pexels.com/video-files/31481035/13422642_640_360_25fps.mp4',\n        poster: 'https://images.pexels.com/videos/31481035/super-8-film-texture-overlay-8mm-31481035.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200',\n        credit: 'refilm. app on Pexels'\n      }\n    ];\n\n    let clips = [...previewAssets];\n    let activeId = 'clip-2';\n    let draggedId = null;\n\n    const list = document.getElementById('clip-list');\n    const addZone = document.getElementById('add-zone');\n    const fileInput = document.getElementById('more-videos');\n    const video = document.getElementById('preview-video');\n    const fallback = document.getElementById('preview-fallback');\n    const playButton = document.getElementById('play-button');\n    const playOverlay = document.getElementById('play-overlay');\n    const queueCount = document.getElementById('queue-count');\n    const sequenceBadge = document.getElementById('sequence-badge');\n    const screenBadge = document.getElementById('screen-badge');\n    const activeName = document.getElementById('active-file-name');\n    const activeCaption = document.getElementById('active-file-caption');\n    const status = document.getElementById('status-line');\n    const createButton = document.getElementById('create-button');\n    const timecode = document.getElementById('timecode');\n\n    const activeClip = () => clips.find((clip) => clip.id === activeId) || clips[0] || null;\n    const formatCount = () => `${clips.length} ${clips.length === 1 ? 'clip' : 'clips'}`;\n\n    function escapeText(value) {\n      return value.replace(/[&<>'\"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', \"'\": '&#39;', '\"': '&quot;' })[character]);\n    }\n\n    function setActive(id, announce = true) {\n      if (!clips.length) return;\n      activeId = clips.some((clip) => clip.id === id) ? id : clips[0].id;\n      const clip = activeClip();\n      const index = clips.findIndex((item) => item.id === activeId) + 1;\n      const badge = `CLIP ${index} OF ${clips.length}`;\n      sequenceBadge.textContent = badge;\n      screenBadge.textContent = badge;\n      activeName.textContent = clip.name;\n      activeCaption.textContent = `This is clip ${index} in your sequence. Reorder the cards to change the handoff order before upload.`;\n      timecode.textContent = `00:00 / ${clip.duration === '—' ? '—' : clip.duration}`;\n      video.poster = clip.poster;\n      video.setAttribute('aria-label', `Preview footage poster by ${clip.credit}`);\n      fallback.src = clip.poster;\n      fallback.alt = `Preview poster for ${clip.name} — ${clip.credit}`;\n      if (video.src !== clip.src) {\n        video.src = clip.src;\n        video.load();\n      }\n      void video.play().catch(() => undefined);\n      if (announce) status.textContent = `Previewing clip ${index}: ${clip.name}`;\n      renderList();\n    }\n\n    function moveClip(id, direction) {\n      const index = clips.findIndex((clip) => clip.id === id);\n      const nextIndex = index + direction;\n      if (index < 0 || nextIndex < 0 || nextIndex >= clips.length) return;\n      const next = [...clips];\n      [next[index], next[nextIndex]] = [next[nextIndex], next[index]];\n      clips = next;\n      setActive(activeId, false);\n      status.textContent = `${clips.findIndex((clip) => clip.id === activeId) + 1}. ${activeClip().name} is now in the sequence.`;\n    }\n\n    function removeClip(id) {\n      const removedIndex = clips.findIndex((clip) => clip.id === id);\n      const removed = clips[removedIndex];\n      clips = clips.filter((clip) => clip.id !== id);\n      if (id === activeId) {\n        activeId = clips[Math.min(removedIndex, clips.length - 1)]?.id || null;\n      }\n      if (clips.length) setActive(activeId, false);\n      else {\n        list.classList.add('is-empty');\n        activeName.textContent = 'No clip selected';\n        activeCaption.textContent = 'Add a video to preview the first frame and set your sequence.';\n        sequenceBadge.textContent = 'NO CLIPS';\n        screenBadge.textContent = 'NO CLIPS';\n        video.removeAttribute('src');\n        video.removeAttribute('poster');\n      }\n      renderList();\n      status.textContent = removed ? `Removed ${removed.name}.` : 'Clip removed.';\n    }\n\n    function renderList() {\n      list.classList.toggle('is-empty', clips.length === 0);\n      queueCount.textContent = formatCount();\n      createButton.textContent = `Create project · ${clips.length} ${clips.length === 1 ? 'clip' : 'clips'}`;\n      createButton.disabled = clips.length === 0;\n      const emptyMessage = '<li class=\"empty-message\">Drop a few videos here to build your sequence.</li>';\n      if (!clips.length) {\n        list.innerHTML = emptyMessage;\n        return;\n      }\n      list.innerHTML = clips.map((clip, index) => {\n        const selected = clip.id === activeId;\n        return `<li class=\"clip-card${selected ? ' is-selected' : ''}\" draggable=\"true\" data-id=\"${escapeText(clip.id)}\" tabindex=\"0\" role=\"option\" aria-selected=\"${selected}\" aria-label=\"Clip ${index + 1}, ${escapeText(clip.name)}. Use Alt plus arrow keys to reorder.\">\n          <span class=\"clip-index\" aria-hidden=\"true\">${index + 1}</span>\n          <div class=\"clip-main\">\n            <div class=\"clip-topline\"><i class=\"ti ti-movie\" aria-hidden=\"true\"></i><span class=\"clip-name\">${escapeText(clip.name)}</span></div>\n            <div class=\"clip-meta\"><span>${escapeText(clip.duration)}</span><span>·</span><span>${escapeText(clip.format)}</span><span>·</span><span>A-ROLL</span></div>\n            <span class=\"playing-label\">PLAYING NOW</span>\n          </div>\n          <div class=\"clip-actions\">\n            <button class=\"drag-button\" type=\"button\" data-action=\"drag\" aria-label=\"Drag to reorder ${escapeText(clip.name)}\" title=\"Drag to reorder\"><i class=\"ti ti-grip-vertical\" aria-hidden=\"true\"></i></button>\n            <button class=\"remove-button\" type=\"button\" data-action=\"remove\" aria-label=\"Remove ${escapeText(clip.name)}\" title=\"Remove clip\"><i class=\"ti ti-trash\" aria-hidden=\"true\"></i></button>\n          </div>\n        </li>`;\n      }).join('');\n    }\n\n    function appendFiles(files) {\n      const incoming = Array.from(files).filter((file) => file.type.startsWith('video/') || /\\.(mp4|mov|webm|m4v)$/i.test(file.name));\n      const additions = incoming.map((file, index) => ({\n        id: `local-${Date.now()}-${index}`,\n        name: file.name,\n        duration: '—',\n        format: (file.name.split('.').pop() || 'VIDEO').toUpperCase(),\n        src: URL.createObjectURL(file),\n        poster: '',\n        credit: 'local upload'\n      }));\n      if (!additions.length) {\n        status.textContent = 'Add MP4, MOV, WebM, or M4V videos.';\n        return;\n      }\n      clips = [...clips, ...additions];\n      if (!activeId) activeId = additions[0].id;\n      setActive(activeId, false);\n      status.textContent = `${additions.length} video${additions.length === 1 ? '' : 's'} added to the end of the sequence.`;\n    }\n\n    list.addEventListener('click', (event) => {\n      const target = event.target.closest('[data-action]');\n      const card = event.target.closest('.clip-card');\n      if (!card) return;\n      const id = card.dataset.id;\n      if (target?.dataset.action === 'remove') {\n        event.stopPropagation();\n        removeClip(id);\n        return;\n      }\n      if (target?.dataset.action === 'drag') return;\n      setActive(id);\n    });\n\n    list.addEventListener('keydown', (event) => {\n      const card = event.target.closest('.clip-card');\n      if (!card) return;\n      if (event.key === 'Enter' || event.key === ' ') {\n        event.preventDefault();\n        setActive(card.dataset.id);\n      }\n      if (event.altKey && event.key === 'ArrowUp') {\n        event.preventDefault();\n        moveClip(card.dataset.id, -1);\n      }\n      if (event.altKey && event.key === 'ArrowDown') {\n        event.preventDefault();\n        moveClip(card.dataset.id, 1);\n      }\n    });\n\n    list.addEventListener('dragstart', (event) => {\n      const card = event.target.closest('.clip-card');\n      if (!card) return;\n      draggedId = card.dataset.id;\n      card.classList.add('is-dragging');\n      event.dataTransfer.effectAllowed = 'move';\n      event.dataTransfer.setData('text/plain', draggedId);\n    });\n\n    list.addEventListener('dragend', (event) => {\n      event.target.closest('.clip-card')?.classList.remove('is-dragging');\n      draggedId = null;\n    });\n\n    list.addEventListener('dragover', (event) => {\n      if (draggedId) event.preventDefault();\n    });\n\n    list.addEventListener('drop', (event) => {\n      event.preventDefault();\n      const targetCard = event.target.closest('.clip-card');\n      if (!draggedId || !targetCard || draggedId === targetCard.dataset.id) return;\n      const from = clips.findIndex((clip) => clip.id === draggedId);\n      const to = clips.findIndex((clip) => clip.id === targetCard.dataset.id);\n      if (from < 0 || to < 0) return;\n      const next = [...clips];\n      const [moved] = next.splice(from, 1);\n      next.splice(to, 0, moved);\n      clips = next;\n      setActive(activeId, false);\n      status.textContent = `Sequence updated. ${activeClip().name} remains selected.`;\n      draggedId = null;\n    });\n\n    addZone.addEventListener('click', () => fileInput.click());\n    addZone.addEventListener('keydown', (event) => {\n      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); fileInput.click(); }\n    });\n    addZone.addEventListener('dragover', (event) => { event.preventDefault(); addZone.classList.add('is-over'); });\n    addZone.addEventListener('dragleave', () => addZone.classList.remove('is-over'));\n    addZone.addEventListener('drop', (event) => { event.preventDefault(); addZone.classList.remove('is-over'); appendFiles(event.dataTransfer.files); });\n    fileInput.addEventListener('change', () => { appendFiles(fileInput.files); fileInput.value = ''; });\n\n    function togglePlayback() {\n      if (video.paused) {\n        void video.play().catch(() => undefined);\n        playButton.innerHTML = '<i class=\"ti ti-player-pause-filled\" aria-hidden=\"true\"></i>';\n        playButton.setAttribute('aria-label', 'Pause preview');\n        playButton.title = 'Pause preview';\n        playOverlay.innerHTML = '<i class=\"ti ti-player-pause-filled\" aria-hidden=\"true\"></i>';\n        playOverlay.setAttribute('aria-label', 'Pause preview');\n        playOverlay.title = 'Pause preview';\n      } else {\n        video.pause();\n        playButton.innerHTML = '<i class=\"ti ti-player-play-filled\" aria-hidden=\"true\"></i>';\n        playButton.setAttribute('aria-label', 'Play preview');\n        playButton.title = 'Play preview';\n        playOverlay.innerHTML = '<i class=\"ti ti-player-play-filled\" aria-hidden=\"true\"></i>';\n        playOverlay.setAttribute('aria-label', 'Play preview');\n        playOverlay.title = 'Play preview';\n      }\n    }\n    playButton.addEventListener('click', togglePlayback);\n    playOverlay.addEventListener('click', togglePlayback);\n    createButton.addEventListener('click', () => { status.textContent = clips.length ? `Ready to create a project from ${clips.length} ordered clips.` : 'Add a video before creating a project.'; });\n\n    renderList();\n    setActive(activeId, false);\n  })();\n</script>\n",
