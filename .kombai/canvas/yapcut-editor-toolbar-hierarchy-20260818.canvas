        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --ember-cream: #f5f9ce;\n    --ember-ink: #450e16;\n    --ember-purple: #432e6f;\n    --ember-orange: #ffa102;\n    --ember-crimson: #bc2d29;\n    --editor: #12141a;\n    --panel: #1a1d26;\n    --panel-raised: #20232d;\n    --line: rgba(245, 249, 206, 0.14);\n    --muted: rgba(245, 249, 206, 0.64);\n    --dim: rgba(245, 249, 206, 0.38);\n  }\n\n  body {\n    margin: 0;\n    background: var(--editor);\n    color: var(--ember-cream);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .editor-frame {\n    min-height: 100vh;\n    overflow: hidden;\n    background: var(--editor);\n  }\n\n  .editor-toolbar {\n    position: relative;\n    z-index: 10;\n    min-height: 72px;\n    border-bottom: 1px solid rgba(245, 249, 206, 0.08);\n    background: var(--panel);\n  }\n\n  .editor-toolbar::after {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    height: 2px;\n    background: linear-gradient(90deg, var(--ember-purple) 0%, rgba(67, 46, 111, 0.32) 34%, rgba(255, 161, 2, 0.18) 72%, var(--ember-orange) 100%);\n    content: '';\n  }\n\n  .toolbar-inner {\n    display: flex;\n    min-height: 72px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    padding: 0 24px;\n  }\n\n  .toolbar-left,\n  .toolbar-right,\n  .project-context,\n  .action-rail,\n  .action-button,\n  .status {\n    display: flex;\n    align-items: center;\n  }\n\n  .toolbar-left {\n    min-width: 0;\n    gap: 16px;\n  }\n\n  .back-link {\n    display: inline-flex;\n    min-height: 38px;\n    align-items: center;\n    gap: 8px;\n    padding: 0 10px 0 5px;\n    border: 1px solid rgba(245, 249, 206, 0.22);\n    border-radius: 10px;\n    color: var(--ember-cream);\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    text-decoration: none;\n    transition: transform 180ms ease-out, opacity 180ms ease-out;\n  }\n\n  .back-link:hover {\n    opacity: 0.86;\n    transform: translateY(-1px);\n  }\n\n  .back-arrow {\n    display: grid;\n    width: 24px;\n    height: 24px;\n    place-items: center;\n    color: var(--ember-orange);\n    font-family: Georgia, serif;\n    font-size: 22px;\n    line-height: 1;\n  }\n\n  .project-context {\n    min-width: 0;\n    gap: 12px;\n    padding-left: 16px;\n    border-left: 1px solid var(--line);\n  }\n\n  .project-eyebrow {\n    color: var(--dim);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.2em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .project-name {\n    overflow: hidden;\n    max-width: 260px;\n    color: var(--ember-cream);\n    font-size: 18px;\n    font-weight: 600;\n    line-height: 1;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .toolbar-right {\n    flex: 0 1 auto;\n    justify-content: flex-end;\n  }\n\n  .action-rail {\n    min-height: 48px;\n    gap: 5px;\n    padding: 5px 5px 5px 8px;\n    border: 1px solid rgba(245, 249, 206, 0.15);\n    border-left: 3px solid var(--ember-orange);\n    border-radius: 14px;\n    background: var(--panel-raised);\n  }\n\n  .status {\n    flex: 0 0 auto;\n    gap: 8px;\n    padding: 0 12px 0 7px;\n    color: var(--muted);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 500;\n    letter-spacing: 0.08em;\n    line-height: 1;\n    text-transform: uppercase;\n  }\n\n  .status-dot {\n    width: 7px;\n    height: 7px;\n    border: 1px solid rgba(245, 249, 206, 0.65);\n    border-radius: 999px;\n    background: rgba(245, 249, 206, 0.32);\n  }\n\n  .action-button {\n    min-height: 36px;\n    justify-content: center;\n    border: 1px solid transparent;\n    border-radius: 10px;\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    white-space: nowrap;\n    transition: transform 180ms ease-out, opacity 180ms ease-out, background-color 180ms ease-out;\n  }\n\n  .action-button:hover {\n    opacity: 0.9;\n    transform: translateY(-1px);\n  }\n\n  .ai-action {\n    padding: 0 14px;\n    color: rgba(245, 249, 206, 0.72);\n  }\n\n  .ai-action:hover {\n    background: rgba(245, 249, 206, 0.06);\n  }\n\n  .export-action {\n    min-width: 164px;\n    gap: 13px;\n    padding: 0 13px 0 18px;\n    border-color: var(--ember-ink);\n    background: var(--ember-orange);\n    color: var(--ember-ink);\n    box-shadow: 3px 3px 0 var(--ember-ink);\n    font-weight: 700;\n  }\n\n  .export-hint {\n    padding: 5px 7px 4px;\n    border: 1px solid rgba(69, 14, 22, 0.32);\n    border-radius: 6px;\n    color: rgba(69, 14, 22, 0.68);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.02em;\n  }\n\n  .workspace {\n    position: relative;\n    min-height: calc(100vh - 72px);\n    overflow: hidden;\n    background: var(--editor);\n  }\n\n  .workspace::before {\n    position: absolute;\n    top: 0;\n    right: 0;\n    left: 0;\n    height: 1px;\n    background: rgba(67, 46, 111, 0.3);\n    content: '';\n  }\n\n  .workspace-meta {\n    display: flex;\n    justify-content: space-between;\n    padding: 22px 24px;\n    color: rgba(245, 249, 206, 0.28);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n  }\n\n  .workspace-stage {\n    position: absolute;\n    top: 88px;\n    right: 24px;\n    bottom: 24px;\n    left: 24px;\n    border: 1px solid rgba(245, 249, 206, 0.05);\n    background: linear-gradient(135deg, rgba(67, 46, 111, 0.08), transparent 44%), #151820;\n  }\n\n  .workspace-stage::after {\n    position: absolute;\n    right: 5%;\n    bottom: 12%;\n    left: 5%;\n    height: 1px;\n    background: rgba(245, 249, 206, 0.05);\n    content: '';\n  }\n\n  @media (max-width: 820px) {\n    .toolbar-inner {\n      gap: 12px;\n      padding: 0 16px;\n    }\n\n    .project-context {\n      display: none;\n    }\n\n    .action-rail {\n      max-width: calc(100vw - 144px);\n    }\n\n    .ai-action {\n      padding: 0 10px;\n    }\n  }\n\n  @media (max-width: 560px) {\n    .toolbar-inner {\n      min-height: 64px;\n      padding: 0 12px;\n    }\n\n    .editor-toolbar {\n      min-height: 64px;\n    }\n\n    .workspace {\n      min-height: calc(100vh - 64px);\n    }\n\n    .back-link {\n      min-height: 34px;\n      padding-right: 8px;\n      font-size: 14px;\n    }\n\n    .action-rail {\n      min-height: 42px;\n      max-width: calc(100vw - 110px);\n      padding: 3px 3px 3px 5px;\n      border-left-width: 2px;\n      border-radius: 11px;\n    }\n\n    .status {\n      padding-right: 6px;\n      padding-left: 4px;\n    }\n\n    .status-copy {\n      display: none;\n    }\n\n    .ai-action {\n      padding: 0 7px;\n      font-size: 14px;\n    }\n\n    .export-action {\n      min-width: 112px;\n      gap: 0;\n      padding: 0 12px;\n      font-size: 15px;\n    }\n\n    .export-hint {\n      display: none;\n    }\n\n    .workspace-meta {\n      padding: 18px 14px;\n    }\n\n    .workspace-stage {\n      top: 70px;\n      right: 14px;\n      bottom: 14px;\n      left: 14px;\n    }\n  }\n</style>\n<div class=\"editor-frame\" data-kid=\"1\" data-name=\"editor frame container\">\n    <header aria-label=\"Project editor toolbar\" class=\"editor-toolbar\" data-kid=\"1-1\" data-name=\"project editor toolbar\">\n        <div class=\"toolbar-inner\" data-kid=\"1-1-1\" data-name=\"toolbar inner wrapper\">\n            <div class=\"toolbar-left\" data-kid=\"1-1-1-1\" data-name=\"toolbar left section\">\n                <a aria-label=\"Back to projects\" class=\"back-link\" data-kid=\"1-1-1-1-1\" data-name=\"back to projects link\" href=\"#projects\">\n                    <span aria-hidden=\"true\" class=\"back-arrow\" data-kid=\"1-1-1-1-1-1\" data-name=\"back arrow icon\">\n                        ‹\n                    </span>\n                    <span data-kid=\"1-1-1-1-1-2\" data-name=\"back link text\">\n                        Projects\n                    </span>\n                </a>\n                <div aria-label=\"Current project\" class=\"project-context\" data-kid=\"1-1-1-1-2\" data-name=\"project context container\">\n                    <span class=\"project-eyebrow\" data-kid=\"1-1-1-1-2-1\" data-name=\"project eyebrow label\">\n                        Editing\n                    </span>\n                    <span class=\"project-name\" data-dynamic=\"true\" data-kid=\"1-1-1-1-2-2\" data-name=\"project name text\" data-reason=\"name replaced by active project title script\">\n                        Untitled project\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Editor actions\" class=\"toolbar-right\" data-kid=\"1-1-1-2\" data-name=\"editor actions navigation\">\n                <div class=\"action-rail\" data-kid=\"1-1-1-2-1\" data-name=\"action rail container\">\n                    <span aria-label=\"Project saved\" class=\"status\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1\" data-name=\"status message indicator\" data-reason=\"status text/dot updated by save state script\" role=\"status\">\n                        <span aria-hidden=\"true\" class=\"status-dot\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"status dot icon\">\n                        </span>\n                        <span class=\"status-copy\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-1-2\" data-name=\"status copy text\" data-reason=\"text replaced by save state script\">\n                            Saved\n                        </span>\n                    </span>\n                    <button aria-label=\"Generate edits with AI\" class=\"action-button ai-action\" data-kid=\"1-1-1-2-1-2\" data-name=\"ai generate edits button\" type=\"button\">\n                        Generate edits\n                    </button>\n                    <button aria-label=\"Export video\" class=\"action-button export-action\" data-kid=\"1-1-1-2-1-3\" data-name=\"export video button\" type=\"button\">\n                        <span data-kid=\"1-1-1-2-1-3-1\" data-name=\"export button label text\">\n                            Export video\n                        </span>\n                        <span aria-hidden=\"true\" class=\"export-hint\" data-kid=\"1-1-1-2-1-3-2\" data-name=\"export shortcut hint\">\n                            ⌘ E\n                        </span>\n                    </button>\n                </div>\n            </nav>\n        </div>\n    </header>\n    <main aria-label=\"Dark video editing workspace\" class=\"workspace\" data-kid=\"1-2\" data-name=\"video editing workspace main\">\n        <div class=\"workspace-meta\" data-kid=\"1-2-1\" data-name=\"workspace meta information bar\">\n            <span data-kid=\"1-2-1-1\" data-name=\"canvas label text\">\n                Editor canvas\n            </span>\n            <span data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"workspace timecode display\" data-reason=\"timecode replaced every frame by video playback script\">\n                00:00 / 00:42\n            </span>\n        </div>\n        <div aria-hidden=\"true\" class=\"workspace-stage\" data-kid=\"1-2-2\" data-name=\"workspace stage visual area\">\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-08-18T16:32:39.459799+00:00",
      "modified": "2026-08-18T16:32:59.096399+00:00",
      "id": "var_0395e823e5af"
    }
  },
