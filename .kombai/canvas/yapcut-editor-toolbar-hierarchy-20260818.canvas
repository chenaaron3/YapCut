    "var_d181097623de": {
      "type": "variant",
      "label": "Quiet chrome · centered title",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  :root {\n    --cream: #f5f9ce;\n    --ink: #450e16;\n    --purple: #432e6f;\n    --orange: #ffa102;\n    --crimson: #bc2d29;\n    --tomato: #dd5533;\n    --canvas: #12141a;\n    --panel: #1a1d26;\n    --rail: #20232d;\n    --line: #453239;\n    --muted: #a69aa6;\n  }\n\n  .frame {\n    min-height: 620px;\n    overflow: hidden;\n    background: var(--canvas);\n    color: var(--cream);\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .toolbar {\n    position: relative;\n    z-index: 2;\n    min-height: 72px;\n    border-bottom: 1px solid rgba(245, 249, 206, 0.12);\n    background: var(--panel);\n    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);\n  }\n\n  .toolbar::after {\n    position: absolute;\n    right: 0;\n    bottom: -1px;\n    left: 0;\n    height: 2px;\n    background: linear-gradient(90deg, var(--purple) 0%, var(--purple) 48%, var(--orange) 100%);\n    content: '';\n    opacity: 0.8;\n  }\n\n  .toolbar-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n    align-items: center;\n    gap: 24px;\n    min-height: 72px;\n    padding: 0 28px;\n  }\n\n  .projects-link {\n    display: inline-flex;\n    width: fit-content;\n    align-items: center;\n    gap: 10px;\n    min-height: 38px;\n    padding: 8px 12px 8px 4px;\n    border: 1px solid transparent;\n    border-radius: 12px;\n    color: rgba(245, 249, 206, 0.72);\n    font-size: 17px;\n    font-weight: 600;\n    line-height: 1;\n    text-decoration: none;\n    transition: transform 180ms ease-out, opacity 180ms ease-out, border-color 180ms ease-out, color 180ms ease-out;\n  }\n\n  .projects-link .arrow {\n    color: var(--orange);\n    font-family: Georgia, serif;\n    font-size: 23px;\n    line-height: 0.8;\n  }\n\n  .projects-link:hover,\n  .projects-link:focus-visible {\n    border-color: rgba(255, 161, 2, 0.42);\n    color: var(--cream);\n    opacity: 1;\n    outline: none;\n    transform: translateX(2px);\n  }\n\n  .project-context {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 13px;\n    min-width: 0;\n    text-align: center;\n  }\n\n  .context-copy {\n    display: grid;\n    justify-items: center;\n    gap: 1px;\n    min-width: 0;\n  }\n\n  .eyebrow {\n    color: var(--orange);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.2em;\n    line-height: 1.2;\n    text-transform: uppercase;\n  }\n\n  .project-name {\n    max-width: 300px;\n    overflow: hidden;\n    color: var(--cream);\n    font-size: 22px;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n    line-height: 1.1;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .context-divider {\n    width: 1px;\n    height: 28px;\n    background: rgba(245, 249, 206, 0.16);\n  }\n\n  .save-status {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    color: rgba(245, 249, 206, 0.62);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 500;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .save-dot {\n    width: 7px;\n    height: 7px;\n    border: 1px solid rgba(245, 249, 206, 0.7);\n    border-radius: 999px;\n    background: #2dd4bf;\n    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.1);\n  }\n\n  .action-group {\n    display: inline-flex;\n    align-items: center;\n    justify-self: end;\n    gap: 5px;\n    padding: 5px;\n    border: 1px solid rgba(166, 154, 166, 0.26);\n    border-radius: 14px;\n    background: var(--rail);\n  }\n\n  .action {\n    display: inline-flex;\n    min-height: 40px;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid transparent;\n    border-radius: 10px;\n    padding: 9px 14px;\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    text-decoration: none;\n    white-space: nowrap;\n    transition: transform 180ms ease-out, opacity 180ms ease-out, border-color 180ms ease-out, background-color 180ms ease-out;\n  }\n\n  .action:focus-visible {\n    outline: 2px solid var(--orange);\n    outline-offset: 2px;\n  }\n\n  .action-secondary {\n    color: rgba(245, 249, 206, 0.76);\n  }\n\n  .action-secondary:hover {\n    border-color: rgba(245, 249, 206, 0.18);\n    background: rgba(245, 249, 206, 0.06);\n    color: var(--cream);\n    transform: translateY(-1px);\n  }\n\n  .action-primary {\n    min-width: 144px;\n    border-color: var(--ink);\n    background: var(--orange);\n    color: var(--ink);\n    font-weight: 700;\n    box-shadow: 3px 3px 0 rgba(69, 14, 22, 0.75);\n  }\n\n  .action-primary:hover {\n    opacity: 0.92;\n    transform: translateY(-1px);\n  }\n\n  .action-primary:active,\n  .action-secondary:active,\n  .projects-link:active {\n    transform: translateY(0);\n  }\n\n  .workspace {\n    position: relative;\n    min-height: 548px;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 50% 0%, rgba(67, 46, 111, 0.16), transparent 40%),\n      linear-gradient(180deg, rgba(18, 20, 26, 0.96), var(--canvas));\n  }\n\n  .workspace::before {\n    position: absolute;\n    top: 36px;\n    right: 7%;\n    left: 7%;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(245, 249, 206, 0.08), transparent);\n    content: '';\n  }\n\n  .workspace-label {\n    position: absolute;\n    top: 51px;\n    left: 7%;\n    color: rgba(245, 249, 206, 0.26);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .workspace-hint {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    color: rgba(245, 249, 206, 0.12);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    transform: translate(-50%, -50%);\n  }\n\n  @media (max-width: 900px) {\n    .toolbar-grid {\n      gap: 12px;\n      padding: 0 16px;\n    }\n\n    .project-context {\n      gap: 9px;\n    }\n\n    .project-name {\n      max-width: 210px;\n    }\n\n    .action {\n      padding-inline: 11px;\n    }\n  }\n\n  @media (max-width: 720px) {\n    .toolbar-grid {\n      grid-template-columns: auto minmax(0, 1fr);\n    }\n\n    .project-context {\n      display: none;\n    }\n\n    .action-group {\n      gap: 3px;\n    }\n\n    .action-secondary {\n      padding-inline: 9px;\n    }\n  }\n\n  @media (max-width: 500px) {\n    .toolbar {\n      min-height: 64px;\n    }\n\n    .toolbar-grid {\n      min-height: 64px;\n      padding-inline: 10px;\n    }\n\n    .projects-link {\n      padding-right: 6px;\n      font-size: 15px;\n    }\n\n    .action-group {\n      padding: 4px;\n    }\n\n    .action {\n      min-height: 36px;\n      padding-inline: 9px;\n      font-size: 15px;\n    }\n\n    .action-primary {\n      min-width: 126px;\n    }\n\n    .action-secondary {\n      display: none;\n    }\n  }\n</style>\n<div class=\"frame\" data-kid=\"1\" data-name=\"editor frame container\">\n    <header aria-label=\"Editor command bar\" class=\"toolbar\" data-kid=\"1-1\" data-name=\"editor command bar\">\n        <div class=\"toolbar-grid\" data-kid=\"1-1-1\" data-name=\"command bar grid layout\">\n            <a aria-label=\"Back to projects\" class=\"projects-link\" data-kid=\"1-1-1-1\" data-name=\"back to projects navigation link\" href=\"#projects\">\n                <span aria-hidden=\"true\" class=\"arrow\" data-kid=\"1-1-1-1-1\" data-name=\"left arrow icon\">\n                    ←\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"projects link text\">\n                    Projects\n                </span>\n            </a>\n            <div aria-label=\"Current project status\" class=\"project-context\" data-kid=\"1-1-1-2\" data-name=\"current project status indicator\">\n                <div class=\"context-copy\" data-kid=\"1-1-1-2-1\" data-name=\"project metadata container\">\n                    <span class=\"eyebrow\" data-kid=\"1-1-1-2-1-1\" data-name=\"project type eyebrow label\">\n                        Editor\n                    </span>\n                    <span class=\"project-name\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-2\" data-name=\"project name text\" data-reason=\"text content replaced by project title script\">\n                        Untitled project\n                    </span>\n                </div>\n                <span aria-hidden=\"true\" class=\"context-divider\" data-kid=\"1-1-1-2-2\" data-name=\"metadata separator\">\n                </span>\n                <span class=\"save-status\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3\" data-name=\"save status indicator\" data-reason=\"text and color state toggled by save status script\">\n                    <span aria-hidden=\"true\" class=\"save-dot\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3-1\" data-name=\"save status dot\" data-reason=\"color state toggled by save status script\">\n                    </span>\n                    Saved\n                </span>\n            </div>\n            <div aria-label=\"Project actions\" class=\"action-group\" data-kid=\"1-1-1-3\" data-name=\"project action button group\">\n                <button class=\"action action-secondary\" data-kid=\"1-1-1-3-1\" data-name=\"generate edits action button\" type=\"button\">\n                    Generate edits\n                </button>\n                <button class=\"action action-primary\" data-kid=\"1-1-1-3-2\" data-name=\"export video action button\" type=\"button\">\n                    Export video\n                </button>\n            </div>\n        </div>\n    </header>\n    <main aria-label=\"Editor workspace preview\" class=\"workspace\" data-kid=\"1-2\" data-name=\"editor workspace preview\">\n        <span class=\"workspace-label\" data-kid=\"1-2-1\" data-name=\"workspace area label\">\n            Timeline / canvas\n        </span>\n        <span class=\"workspace-hint\" data-kid=\"1-2-2\" data-name=\"empty workspace helper text\">\n            Editor workspace\n        </span>\n    </main>\n</div>\n",
