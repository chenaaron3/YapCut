    "var_e5bd081a8e44": {
      "type": "variant",
      "label": "Quiet chrome · context-led",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');\n\n  .yapcut-context-design {\n    min-height: 620px;\n    overflow: hidden;\n    background: #12141a;\n    color: #f5f9ce;\n    font-family: 'Cormorant Garamond', Georgia, serif;\n  }\n\n  .yapcut-toolbar {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    min-height: 72px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    padding: 12px 32px;\n    background: #1a1d26;\n    border-bottom: 1px solid rgba(245, 249, 206, 0.12);\n    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);\n  }\n\n  .yapcut-toolbar::after {\n    position: absolute;\n    right: 0;\n    bottom: -2px;\n    left: 0;\n    height: 2px;\n    content: '';\n    background: linear-gradient(90deg, transparent 0%, #432e6f 24%, #ffa102 72%, transparent 100%);\n    opacity: 0.82;\n  }\n\n  .yapcut-left,\n  .yapcut-actions,\n  .yapcut-back,\n  .yapcut-context,\n  .yapcut-status,\n  .yapcut-action {\n    display: flex;\n    align-items: center;\n  }\n\n  .yapcut-left {\n    min-width: 0;\n    gap: 18px;\n  }\n\n  .yapcut-back {\n    flex: 0 0 auto;\n    gap: 8px;\n    min-height: 40px;\n    padding: 0 12px 0 8px;\n    color: rgba(245, 249, 206, 0.78);\n    font-size: 16px;\n    font-weight: 600;\n    letter-spacing: 0.01em;\n    text-decoration: none;\n    border: 1px solid rgba(245, 249, 206, 0.2);\n    border-radius: 12px;\n    transition: transform 180ms ease-out, border-color 180ms ease-out, color 180ms ease-out, background-color 180ms ease-out;\n  }\n\n  .yapcut-back:hover,\n  .yapcut-back:focus-visible {\n    color: #f5f9ce;\n    background: rgba(67, 46, 111, 0.34);\n    border-color: rgba(245, 249, 206, 0.48);\n    transform: translateY(-1px);\n    outline: none;\n  }\n\n  .yapcut-arrow {\n    color: #ffa102;\n    font-family: Georgia, serif;\n    font-size: 20px;\n    line-height: 1;\n  }\n\n  .yapcut-divider {\n    width: 1px;\n    height: 34px;\n    flex: 0 0 auto;\n    background: rgba(245, 249, 206, 0.16);\n  }\n\n  .yapcut-context {\n    min-width: 0;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 2px;\n  }\n\n  .yapcut-eyebrow,\n  .yapcut-status,\n  .yapcut-shortcut {\n    font-family: 'JetBrains Mono', monospace;\n    text-transform: uppercase;\n  }\n\n  .yapcut-eyebrow {\n    color: rgba(245, 249, 206, 0.48);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: 0.18em;\n    line-height: 1;\n  }\n\n  .yapcut-title {\n    min-width: 0;\n    max-width: 320px;\n    overflow: hidden;\n    color: #f5f9ce;\n    font-size: 20px;\n    font-weight: 600;\n    letter-spacing: -0.015em;\n    line-height: 1.05;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .yapcut-actions {\n    flex: 0 0 auto;\n    gap: 10px;\n  }\n\n  .yapcut-status {\n    gap: 8px;\n    min-height: 38px;\n    padding: 0 10px;\n    color: rgba(245, 249, 206, 0.58);\n    font-size: 10px;\n    font-weight: 500;\n    letter-spacing: 0.1em;\n  }\n\n  .yapcut-status-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 999px;\n    background: #2dd4bf;\n    box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.1);\n  }\n\n  .yapcut-action {\n    justify-content: center;\n    min-height: 40px;\n    border-radius: 12px;\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    cursor: pointer;\n    transition: transform 180ms ease-out, border-color 180ms ease-out, background-color 180ms ease-out, box-shadow 180ms ease-out;\n  }\n\n  .yapcut-action:focus-visible {\n    outline: 2px solid #ffa102;\n    outline-offset: 3px;\n  }\n\n  .yapcut-ai {\n    padding: 0 15px;\n    color: rgba(245, 249, 206, 0.82);\n    background: transparent;\n    border: 1px solid rgba(245, 249, 206, 0.25);\n  }\n\n  .yapcut-ai:hover,\n  .yapcut-ai:focus-visible {\n    background: rgba(67, 46, 111, 0.42);\n    border-color: rgba(245, 249, 206, 0.5);\n    transform: translateY(-1px);\n  }\n\n  .yapcut-export {\n    min-width: 152px;\n    gap: 12px;\n    padding: 0 14px 0 18px;\n    color: #450e16;\n    background: #ffa102;\n    border: 1px solid #450e16;\n    box-shadow: 3px 3px 0 #450e16;\n  }\n\n  .yapcut-export:hover,\n  .yapcut-export:focus-visible {\n    background: #ffb52f;\n    box-shadow: 4px 4px 0 #450e16;\n    transform: translate(-1px, -1px);\n  }\n\n  .yapcut-export-label {\n    white-space: nowrap;\n  }\n\n  .yapcut-shortcut {\n    padding: 4px 6px;\n    color: rgba(69, 14, 22, 0.7);\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: 0.06em;\n    border: 1px solid rgba(69, 14, 22, 0.26);\n    border-radius: 6px;\n  }\n\n  .yapcut-workspace {\n    position: relative;\n    min-height: 548px;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 76% 18%, rgba(67, 46, 111, 0.14), transparent 28%),\n      radial-gradient(circle at 14% 86%, rgba(255, 161, 2, 0.06), transparent 24%),\n      #12141a;\n  }\n\n  .yapcut-workspace::before {\n    position: absolute;\n    inset: 0;\n    content: '';\n    opacity: 0.24;\n    background-image: linear-gradient(rgba(245, 249, 206, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(245, 249, 206, 0.035) 1px, transparent 1px);\n    background-size: 64px 64px;\n    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent 70%);\n  }\n\n  .yapcut-workspace-label {\n    position: absolute;\n    top: 30px;\n    left: 34px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    color: rgba(245, 249, 206, 0.28);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 9px;\n    font-weight: 500;\n    letter-spacing: 0.16em;\n  }\n\n  .yapcut-workspace-label::before {\n    width: 24px;\n    height: 1px;\n    content: '';\n    background: #432e6f;\n  }\n\n  @media (max-width: 760px) {\n    .yapcut-toolbar {\n      min-height: 64px;\n      gap: 12px;\n      padding: 10px 16px;\n    }\n\n    .yapcut-left {\n      gap: 12px;\n    }\n\n    .yapcut-divider,\n    .yapcut-context {\n      display: none;\n    }\n\n    .yapcut-actions {\n      gap: 6px;\n    }\n\n    .yapcut-status {\n      min-height: 36px;\n      padding: 0 5px;\n    }\n\n    .yapcut-status-copy,\n    .yapcut-shortcut {\n      display: none;\n    }\n\n    .yapcut-ai {\n      min-width: 40px;\n      padding: 0 10px;\n      font-size: 0;\n    }\n\n    .yapcut-ai::after {\n      content: 'AI';\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 10px;\n      letter-spacing: 0.08em;\n    }\n\n    .yapcut-export {\n      min-width: 124px;\n      padding: 0 12px;\n      font-size: 15px;\n    }\n  }\n\n  @media (max-width: 420px) {\n    .yapcut-back {\n      min-height: 36px;\n      padding-right: 9px;\n      font-size: 15px;\n    }\n\n    .yapcut-export {\n      min-width: 112px;\n      font-size: 14px;\n    }\n  }\n</style>\n<div class=\"yapcut-context-design\" data-kid=\"1\" data-name=\"project editor application wrapper\">\n    <header aria-label=\"Project editor toolbar\" class=\"yapcut-toolbar\" data-kid=\"1-1\" data-name=\"header project editor toolbar\">\n        <div class=\"yapcut-left\" data-kid=\"1-1-1\" data-name=\"left toolbar section\">\n            <a aria-label=\"Back to Projects\" class=\"yapcut-back\" data-kid=\"1-1-1-1\" data-name=\"back to projects link button\" href=\"#projects\">\n                <span aria-hidden=\"true\" class=\"yapcut-arrow\" data-kid=\"1-1-1-1-1\" data-name=\"back arrow icon\">\n                    ←\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"back link label text\">\n                    Projects\n                </span>\n            </a>\n            <span aria-hidden=\"true\" class=\"yapcut-divider\" data-kid=\"1-1-1-2\" data-name=\"vertical separator line\">\n            </span>\n            <div aria-label=\"Current project\" class=\"yapcut-context\" data-kid=\"1-1-1-3\" data-name=\"current project context container\">\n                <span class=\"yapcut-eyebrow\" data-kid=\"1-1-1-3-1\" data-name=\"editor context eyebrow text\">\n                    Editor\n                </span>\n                <span class=\"yapcut-title\" data-kid=\"1-1-1-3-2\" data-name=\"active project title text\">\n                    Untitled project\n                </span>\n            </div>\n        </div>\n        <div aria-label=\"Editor actions\" class=\"yapcut-actions\" data-kid=\"1-1-2\" data-name=\"toolbar actions group\" role=\"group\">\n            <div aria-label=\"Project saved\" class=\"yapcut-status\" data-kid=\"1-1-2-1\" data-name=\"project save status indicator\" role=\"status\">\n                <span aria-hidden=\"true\" class=\"yapcut-status-dot\" data-kid=\"1-1-2-1-1\" data-name=\"status online dot icon\">\n                </span>\n                <span class=\"yapcut-status-copy\" data-kid=\"1-1-2-1-2\" data-name=\"save status text\">\n                    Saved\n                </span>\n            </div>\n            <button aria-label=\"Generate edits with AI\" class=\"yapcut-action yapcut-ai\" data-kid=\"1-1-2-2\" data-name=\"generate with ai button\" type=\"button\">\n                Generate edits\n            </button>\n            <button aria-label=\"Export video\" class=\"yapcut-action yapcut-export\" data-kid=\"1-1-2-3\" data-name=\"export video action button\" type=\"button\">\n                <span class=\"yapcut-export-label\" data-kid=\"1-1-2-3-1\" data-name=\"export button label text\">\n                    Export video\n                </span>\n                <span aria-hidden=\"true\" class=\"yapcut-shortcut\" data-kid=\"1-1-2-3-2\" data-name=\"export shortcut key label\">\n                    ⌘ E\n                </span>\n            </button>\n        </div>\n    </header>\n    <main aria-label=\"Editor workspace\" class=\"yapcut-workspace\" data-kid=\"1-2\" data-name=\"main editor workspace area\">\n        <div class=\"yapcut-workspace-label\" data-kid=\"1-2-1\" data-name=\"workspace area identifier label\">\n            Editor workspace\n        </div>\n    </main>\n</div>\n",
